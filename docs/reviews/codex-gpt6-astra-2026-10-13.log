ntropy threshold\", path: \"method.RUN_H_MAX\", fmt: \"num2\", value: RUN_H_MAX, def: true },\n     1\timport { Fragment, useEffect, useLayoutEffect, useMemo, useRef, useState } from \"react\";\n     2\timport { Link, useNavigate, useSearchParams } from \"react-router-dom\";\n     3\timport { useBundle, useLoaded } from \"../data/BundleContext\";\n     4\timport {\n     5\t  compareOverall,\n     6\t  familiesOf,\n     7\t  fmtParams,\n     8\t  ladder,\n     9\t  ladderColumns,\n    10\t  nAvailable,\n    11\t  params,\n    12\t  ranked,\n    13\t  SIZE_LABEL,\n    14\t  sizeBucket,\n    15\t  STAGE_CODE,\n    16\t  stageOrder,\n    17\t  type SizeBucket,\n    18\t} from \"../data/derive\";\n    19\timport { RAMPS, SUB_META } from \"../data/method\";\n    20\timport { SUB_KEYS, type Model, type Stage, type SubKey } from \"../data/types\";\n    21\timport { fmt, fmtNum } from \"../lib/numfmt\";\n    22\timport { useReducedMotion } from \"../lib/motion\";\n    23\timport { Glyph, GlyphShape, StageLegend } from \"../components/Glyph\";\n    24\timport { RampCell, ScoreBar } from \"../components/Bars\";\n    25\timport { Plate, Chevron } from \"../components/Plate\";\n    26\timport { LadderStrip } from \"../components/LadderStrip\";\n    27\timport { Num } from \"../components/Num\";\n    28\timport { linear } from \"../lib/scale\";\n    29\t\n    30\ttype SortKey = \"overall\" | SubKey | \"model\" | \"stage\" | \"size\";\n    31\tconst SIZES: SizeBucket[] = [\"lt15\", \"15to100\", \"gt100\", \"unknown\"];\n    32\t\n    33\tfunction csv(v: string | null): string[] {\n    34\t  return v ? v.split(\",\").filter(Boolean) : [];\n    35\t}\n    36\t\n    37\tfunction rawFmt(k: SubKey, v: number | null): string {\n    38\t  if (SUB_META[k].unit === \"share\") return fmt(v, \"pct\");\n    39\t  return k === \"calib\" ? fmt(v, \"gap\") : fmt(v, \"nats\");\n    40\t}\n    41\t\n    42\texport function anchorsText(k: SubKey): string {\n    43\t  const [one, zero] = RAMPS[k];\n    44\t  const f = (x: number) => (SUB_META[k].unit === \"share\" ? fmt(x, \"pct\") : fmtNum(x, k === \"calib\" ? \"signed\" : \"num3\").replace(/^\\+/, \"\"));\n    45\t  return `1 at ${f(one)}, 0 at ${f(zero)}`;\n    46\t}\n    47\t\n    48\texport function cellTitle(m: Model, k: SubKey): string {\n    49\t  const s = m.subscores?.[k];\n    50\t  if (!s || s.score === null) return `${k}: not measured; overall is the mean of the ${nAvailable(m)} available`;\n    51\t  return `${k} ${fmtNum(s.score, \"score\")} ← ${s.source ?? SUB_META[k].feature} ${rawFmt(k, s.value)} (${anchorsText(k)})`;\n    52\t}\n    53\t\n    54\tfunction headerTitle(k: SubKey): string {\n    55\t  const m = SUB_META[k];\n    56\t  return `${m.name}: ${m.feature}; ${anchorsText(k)}. Reads as ${m.readsAs}.`;\n    57\t}\n    58\t\n    59\tfunction SubCell({ m, k, raw }: { m: Model; k: SubKey; raw: boolean }) {\n    60\t  const s = m.subscores?.[k] ?? null;\n    61\t  const title = cellTitle(m, k);\n    62\t  if (raw) {\n    63\t    const [good, bad] = RAMPS[k];\n    64\t    return (\n    65\t      <span className=\"subcell\" title={title}>\n    66\t        <RampCell value={s?.value ?? null} good={good} bad={bad} title={title} />\n    67\t        <span className=\"v\">{rawFmt(k, s?.value ?? null)}</span>\n    68\t      </span>\n    69\t    );\n    70\t  }\n    71\t  return (\n    72\t    <span className=\"subcell\" title={title}>\n    73\t      <ScoreBar value={s?.score ?? null} width={64} height={6} title={title} />\n    74\t      <span className=\"v\">{fmtNum(s?.score ?? null, \"score\")}</span>\n    75\t    </span>\n    76\t  );\n    77\t}\n    78\t\n    79\tfunction MicroBars({ m }: { m: Model }) {\n    80\t  return (\n    81\t    <span className=\"micro\">\n    82\t      {SUB_KEYS.map((k) => (\n    83\t        <span key={k} title={cellTitle(m, k)}>\n    84\t          <span className=\"k\">{SUB_META[k].short}</span>\n    85\t          <ScoreBar value={m.subscores?.[k]?.score ?? null} width={36} height={5} />\n    86\t          <span className=\"v\">{fmtNum(m.subscores?.[k]?.score ?? null, \"score\")}</span>\n    87\t        </span>\n    88\t      ))}\n    89\t    </span>\n    90\t  );\n    91\t}\n    92\t\n    93\tfunction Comb({ m }: { m: Model }) {\n    94\t  const h = 24;\n    95\t  return (\n    96\t    <svg width={4 * 12} height={h + 12} role=\"img\" aria-label={SUB_KEYS.map((k) => `${SUB_META[k].name} ${fmtNum(m.subscores?.[k]?.score ?? null, \"score\")}`).join(\", \")}>\n    97\t      {SUB_KEYS.map((k, i) => {\n    98\t        const v = m.subscores?.[k]?.score ?? null;\n    99\t        return (\n   100\t          <g key={k} transform={`translate(${i * 12},0)`}>\n   101\t            <title>{cellTitle(m, k)}</title>\n   102\t            <rect width={6} height={h} fill={v === null ? \"url(#hatch)\" : \"var(--track)\"} />\n   103\t            {v !== null && <rect y={h - v * h} width={6} height={v * h} fill=\"var(--bar)\" />}\n   104\t            <text x={3} y={h + 11} textAnchor=\"middle\">\n   105\t              {SUB_META[k].short}\n   106\t            </text>\n   107\t          </g>\n   108\t        );\n   109\t      })}\n   110\t    </svg>\n   111\t  );\n   112\t}\n   113\t\n   114\tfunction Sparkline({ rungs }: { rungs: Model[] }) {\n   115\t  const w = 120;\n   116\t  const h = 28;\n   117\t  const pts = rungs.filter((r) => r.score !== null);\n   118\t  if (pts.length < 2) return null;\n   119\t  const x = linear([0, rungs.length - 1], [5, w - 5]);\n   120\t  const y = linear([0, 1], [h - 4, 4]);\n   121\t  return (\n   122\t    <svg width={w} height={h} role=\"img\" aria-label={`overall across rungs: ${pts.map((p) => fmtNum(p.score, \"score\")).join(\", \")}`}>\n   123\t      <line x1={0} x2={w} y1={y(0.5)} y2={y(0.5)} stroke=\"var(--rule)\" />\n   124\t      <polyline points={rungs.map((r, i) => (r.score === null ? \"\" : `${x(i)},${y(r.score)}`)).join(\" \")} fill=\"none\" stroke=\"var(--ink-3)\" />\n   125\t      {rungs.map((r, i) => (r.score === null ? null : <GlyphShape key={r.id} stage={r.stage} x={x(i)} y={y(r.score)} size={6} />))}\n   126\t    </svg>\n   127\t  );\n   128\t}\n   129\t\n   130\t/** Distinct sizes across a family's rungs, largest first (\"405B / 70B\"); \"—\" when none is known. */\n   131\texport function familySizes(rungs: Model[]): string {\n   132\t  const seen = new Map<string, number>();\n   133\t  for (const r of rungs) {\n   134\t    const p = params(r);\n   135\t    if (p.total_b !== null) seen.set(fmtParams(p), p.total_b);\n   136\t  }\n   137\t  if (!seen.size) return \"—\";\n   138\t  return [...seen.entries()]\n   139\t    .sort((a, b) => b[1] - a[1])\n   140\t    .map(([t]) => t)\n   141\t    .join(\" / \");\n   142\t}\n   143\t\n   144\t/** Raw feature as a ramp position, oriented like the score (1 at the true-base anchor, 0 at the post-trained one), unclipped. */\n   145\tfunction rampPosition(m: Model, k: SubKey): number | null {\n   146\t  const v = m.subscores?.[k]?.value;\n   147\t  if (typeof v !== \"number\" || !Number.isFinite(v)) return null;\n   148\t  const [good, bad] = RAMPS[k];\n   149\t  return (v - bad) / (good - bad);\n   150\t}\n   151\t\n   152\tfunction LaddersView({ models }: { models: Model[] }) {\n   153\t  const bundle = useBundle();\n   154\t  const ids = new Set(models.map((m) => m.id));\n   155\t  const fams = familiesOf(bundle)\n   156\t    .map((f) => ({ f, rungs: ladder(bundle, f).filter((m) => ids.has(m.id)) }))\n   157\t    .filter((x) => x.rungs.length);\n   158\t  const maxScore = (rs: Model[]) => Math.max(...rs.map((r) => r.score ?? -1));\n   159\t  const multi = fams.filter((x) => ladder(bundle, x.f).length > 1).sort((a, b) => maxScore(b.rungs) - maxScore(a.rungs));\n   160\t  const single = fams.filter((x) => ladder(bundle, x.f).length <= 1).sort((a, b) => maxScore(b.rungs) - maxScore(a.rungs));\n   161\t  const block = (f: string, rungs: Model[]) => (\n   162\t    <section key={f} className=\"lad-block\" aria-label={`${f} ladder`}>\n   163\t      <header className=\"lad-head\">\n   164\t        <h3>{f}</h3>\n   165\t        <span className=\"ink3 small\">\n   166\t          {familySizes(rungs)} · {rungs.length} rung{rungs.length > 1 ? \"s\" : \"\"}\n   167\t        </span>\n   168\t        <Sparkline rungs={rungs} />\n   169\t      </header>\n   170\t      <ol className=\"lad-rungs\">\n   171\t        {ladderColumns(rungs).map((col, ci) => (\n   172\t          <li key={ci} className=\"lad-col\">\n   173\t            {ci > 0 && (\n   174\t              <svg className=\"lad-chev\" width=\"10\" height=\"12\" viewBox=\"0 0 10 12\" aria-hidden=\"true\">\n   175\t                <path d=\"M2 1l6 5-6 5\" fill=\"none\" stroke=\"var(--ink-3)\" />\n   176\t              </svg>\n   177\t            )}\n   178\t            <div className=\"lad-stack\">\n   179\t              {col.length > 1 && <span className=\"kicker\">parallel</span>}\n   180\t              {col.map((m) => (\n   181\t                <Link key={m.id} to={`/model/${encodeURIComponent(m.id)}`} className=\"lad-rung\">\n   182\t                  <span className=\"lad-label\">\n   183\t                    <Glyph stage={m.stage} title={m.stage} /> {m.label}\n   184\t                  </span>\n   185\t                  <span className=\"lad-score\">\n   186\t                    <strong>{fmtNum(m.score, \"score\")}</strong>\n   187\t                    <ScoreBar value={m.score} width={64} height={6} />\n   188\t                  </span>\n   189\t                  <Comb m={m} />\n   190\t                </Link>\n   191\t              ))}\n   192\t            </div>\n   193\t          </li>\n   194\t        ))}\n   195\t      </ol>\n   196\t    </section>\n   197\t  );\n   198\t  return (\n   199\t    <div className=\"ladders\">\n   200\t      {multi.map((x) => block(x.f, x.rungs))}\n   201\t      {single.length > 0 && (\n   202\t        <>\n   203\t          <h3 className=\"kicker\" style={{ marginTop: 24 }}>\n   204\t            Single checkpoints\n   205\t          </h3>\n   206\t          <div className=\"lad-singles\">{single.map((x) => block(x.f, x.rungs))}</div>\n   207\t        </>\n   208\t      )}\n   209\t    </div>\n   210\t  );\n   211\t}\n   212\t\n   213\texport default function Leaderboard() {\n   214\t  const bundle = useBundle();\n   215\t  const loaded = useLoaded();\n   216\t  const [sp, setSp] = useSearchParams();\n   217\t  const navigate = useNavigate();\n   218\t  const reduced = useReducedMotion();\n   219\t  const [hlFamily, setHlFamily] = useState<string | null>(null);\n   220\t  const [famOpen, setFamOpen] = useState(false);\n   360\t          <h1>True Base Bench</h1>\n   361\t          <p className=\"lede\">\n   362\t            How far each of <Num path=\"n_models\" fmt=\"count\" /> checkpoints sits from a pre-anneal pretraining base, read from its next-token\n   363\t            distributions alone. 1 = indistinguishable from a pre-anneal checkpoint; higher is not “better”.\n   364\t          </p>\n   365\t          <p>\n   366\t            <Link to=\"/methodology#score\">How the score is built →</Link>\n   367\t          </p>\n   368\t        </div>\n   369\t        <aside className=\"bundle-card\" aria-label=\"Bundle\">\n   370\t          <p className=\"kicker\">Bundle</p>\n   371\t          <dl className=\"statlist\">\n   372\t            <dt>file</dt>\n   373\t            <dd className=\"mono small\">{loaded.file}</dd>\n   374\t            <dt>schema_version</dt>\n   375\t            <dd>{bundle.schema_version}</dd>\n   376\t            <dt>generated</dt>\n   377\t            <dd>{bundle.generated}</dd>\n   378\t            <dt>n_models</dt>\n   379\t            <dd>{bundle.n_models}</dd>\n   380\t            <dt>n_families</dt>\n   381\t            <dd>{nFam}</dd>\n   382\t          </dl>\n   383\t          <a className=\"btn\" href={loaded.url} download>\n   384\t            Download JSON\n   385\t          </a>\n   386\t        </aside>\n   387\t      </div>\n   388\t\n   389\t      <Plate\n   390\t        label=\"Plate 0 · Ladder strip: overall score by training stage\"\n   391\t        caption={\n   392\t          <>\n   393\t            Each glyph is one checkpoint, on the same 0–1 scale as the table bars; the vertical tick in each row is the stage median. Hover or focus\n   394\t            a glyph (or a table row) to join its family’s rungs in ladder order.\n   395\t          </>\n   396\t        }\n   397\t        sources={[\"models[*].score\", \"models[*].stage\"]}\n   398\t        data={{\n   399\t          columns: [\"stage\", \"n\", \"median overall\", \"checkpoints\"],\n   400\t          numeric: [false, true, true, false],\n   401\t          rows: stageOrder.map((s) => {\n   402\t            const ms = stageStrip.filter((m) => m.stage === s && m.score !== null);\n   403\t            const xs = ms.map((m) => m.score!).sort((a, b) => a - b);\n   404\t            const med = xs.length ? (xs.length % 2 ? xs[xs.length >> 1] : (xs[xs.length / 2 - 1] + xs[xs.length / 2]) / 2) : null;\n   405\t            return [s, ms.length, fmtNum(med, \"score\"), ms.map((m) => `${m.label} (${m.family}) ${fmtNum(m.score, \"score\")}`).join(\"; \")];\n   406\t          }),\n   407\t        }}\n   408\t      >\n   409\t        <StageLegend />\n   410\t        <LadderStrip bundle={bundle} models={stageStrip} highlightFamily={hlFamily} onFamily={setHlFamily} />\n   411\t      </Plate>\n   412\t\n   413\t      <div className=\"lb-controls\" role=\"region\" aria-label=\"Table controls\" ref={ctlRef}>\n   414\t        <div className=\"seg\" role=\"group\" aria-label=\"View\">\n   415\t          <button type=\"button\" className=\"btn\" aria-pressed={view === \"ranked\"} onClick={() => update(\"view\", null)}>\n   416\t            Ranked\n   417\t          </button>\n   418\t          <button type=\"button\" className=\"btn\" aria-pressed={view === \"ladders\"} onClick={() => update(\"view\", \"ladders\")}>\n   419\t            Ladders\n   420\t          </button>\n   421\t        </div>\n   422\t        <div className=\"ctl-group\" role=\"group\" aria-label=\"Stage filter\">\n   423\t          <span className=\"ctl-label\">Stage</span>\n   424\t          {stageOrder.map((s) => (\n   425\t            <button key={s} type=\"button\" className=\"btn chip\" aria-pressed={stages.includes(s)} onClick={() => toggleIn(\"stage\", stages, s)} title={s}>\n   426\t              <Glyph stage={s} size={8} /> {STAGE_CODE[s]}\n   427\t            </button>\n   428\t          ))}\n   429\t        </div>\n   430\t        <div className=\"ctl-group fam-filter\">\n   431\t          <button type=\"button\" className=\"btn\" aria-expanded={famOpen} aria-controls=\"fam-list\" onClick={() => setFamOpen(!famOpen)}>\n   432\t            Family{famSel.length ? ` (${famSel.length})` : \"\"} <Chevron />\n   433\t          </button>\n   434\t          {famOpen && (\n   435\t            <fieldset id=\"fam-list\" className=\"fam-list\">\n   436\t              <legend className=\"visually-hidden\">Families</legend>\n   437\t              {familiesOf(bundle).map((f) => (\n   438\t                <label key={f}>\n   439\t                  <input type=\"checkbox\" checked={famSel.includes(f)} onChange={() => toggleIn(\"family\", famSel, f)} /> {f}{\" \"}\n   440\t                  <span className=\"ink3\">{famCounts.get(f)}</span>\n   441\t                </label>\n   442\t              ))}\n   443\t              {famSel.length > 0 && (\n   444\t                <button type=\"button\" className=\"linkbtn\" onClick={() => update(\"family\", null)}>\n   445\t                  Clear\n   446\t                </button>\n   447\t              )}\n   448\t            </fieldset>\n   449\t          )}\n   450\t        </div>\n   451\t        <div className=\"ctl-group\" role=\"group\" aria-label=\"Size filter\">\n   452\t          <span className=\"ctl-label\">Size</span>\n   453\t          {sizesPresent.map((s) => (\n   454\t            <button key={s} type=\"button\" className=\"btn chip\" aria-pressed={sizes.includes(s)} onClick={() => toggleIn(\"size\", sizes, s)}>\n   455\t              {SIZE_LABEL[s]}\n   456\t            </button>\n   457\t          ))}\n   458\t        </div>\n   459\t        <label className=\"ctl-group\">\n   460\t          <span className=\"visually-hidden\">Search</span>\n   461\t          <input type=\"search\" placeholder=\"Search label, id, family\" value={q} onChange={(e) => update(\"q\", e.target.value)} />\n   462\t        </label>\n   463\t        <button type=\"button\" className=\"btn\" aria-pressed={raw} onClick={() => update(\"raw\", raw ? null : \"1\")}>\n   464\t          Raw features\n   465\t        </button>\n   466\t        <label className=\"ctl-group sort-select\">\n   467\t          <span className=\"ctl-label\">Sort</span>\n   468\t          <select\n   469\t            value={`${sort}:${dir}`}\n   470\t            onChange={(e) => {\n   471\t              const [k, d] = e.target.value.split(\":\");\n   472\t              const n = new URLSearchParams(sp);\n   473\t              if (k === \"overall\" && d === \"desc\") {\n   474\t                n.delete(\"sort\");\n   475\t                n.delete(\"dir\");\n   476\t              } else {\n   477\t                n.set(\"sort\", k);\n   478\t                n.set(\"dir\", d);\n   479\t              }\n   480\t              setSp(n, { replace: true });\n   481\t            }}\n   482\t          >\n   483\t            <option value=\"overall:desc\">Overall, high first</option>\n   484\t            <option value=\"overall:asc\">Overall, low first</option>\n   485\t            {SUB_KEYS.map((k) => (\n   486\t              <Fragment key={k}>\n   487\t                <option value={`${k}:desc`}>{SUB_META[k].name}, high first</option>\n   488\t                <option value={`${k}:asc`}>{SUB_META[k].name}, low first</option>\n   489\t              </Fragment>\n   490\t            ))}\n   491\t            <option value=\"model:asc\">Model A–Z</option>\n   492\t            <option value=\"stage:asc\">Stage order</option>\n   493\t          </select>\n   494\t        </label>\n   495\t        <span className=\"ctl-count\" aria-live=\"polite\">\n   496\t          showing {filtered.length} of {bundle.models.length}\n   497\t        </span>\n   498\t      </div>\n   499\t\n   500\t      {view === \"ranked\" ? (\n   501\t        <table className=\"tbl lb-table\">\n   502\t          <caption className=\"visually-hidden\">\n   503\t            Checkpoints ranked by overall score (higher is not better: 1 means indistinguishable from a pre-anneal checkpoint)\n   504\t          </caption>\n   505\t          <thead>\n   506\t            <tr>\n   507\t              <SortTh k=\"overall\" className=\"n c-rank\">\n   508\t                #\n   509\t              </SortTh>\n   510\t              <SortTh k=\"stage\" className=\"c-stage\">\n   511\t                Stage\n   512\t              </SortTh>\n   513\t              <SortTh k=\"model\" className=\"c-model\">\n   514\t                Model\n   515\t              </SortTh>\n   516\t              <SortTh k=\"size\" className=\"c-size\">\n   517\t                Size\n   518\t              </SortTh>\n   519\t              <SortTh k=\"overall\" className=\"c-overall\" title=\"Overall = mean of available sub-scores. 1 = indistinguishable from a pre-anneal checkpoint; higher is not better.\">\n   520\t                Overall <span className=\"ink3 small\">(not “better”)</span>\n   521\t              </SortTh>\n   522\t              {SUB_KEYS.map((k) => (\n   523\t                <SortTh key={k} k={k} className=\"c-sub\" title={headerTitle(k)}>\n   524\t                  {SUB_META[k].name}\n   525\t                </SortTh>\n   526\t              ))}\n   527\t            </tr>\n   528\t          </thead>\n   529\t          <tbody ref={tbodyRef}>\n   530\t            {rows.map((m) => {\n   531\t              const r = rankInfo.get(m.id)!;\n   532\t              const n = nAvailable(m);\n   533\t              const href = `/model/${encodeURIComponent(m.id)}`;\n   534\t              return (\n   535\t                <tr\n   536\t                  key={m.id}\n   537\t                  data-id={m.id}\n   538\t                  className={hlFamily === m.family ? \"hl\" : undefined}\n   539\t                  onMouseEnter={() => setHlFamily(m.family)}\n   540\t                  onMouseLeave={() => setHlFamily(null)}\n   541\t                  onClick={(e) => {\n   542\t                    if ((e.target as HTMLElement).closest(\"a,button\")) return;\n   543\t                    navigate(href);\n   544\t                  }}\n   545\t                >\n   546\t                  <td className=\"n c-rank ink3\">\n   547\t                    {r.tie ? \"=\" : \"\"}\n   548\t                    {r.rank}\n   549\t                  </td>\n   550\t                  <td className=\"c-stage\">\n   551\t                    <span className=\"stage-tag\" title={m.stage}>\n   552\t                      <Glyph stage={m.stage} />\n   553\t                      <span className=\"code\">{STAGE_CODE[m.stage]}</span>\n   554\t                      <span className=\"visually-hidden\">{m.stage}</span>\n   555\t                    </span>\n   556\t                  </td>\n   557\t                  <td className=\"c-model\">\n   558\t                    <div className=\"l1\">\n   559\t                      <span className=\"fam\">{m.family}</span> · <Link to={href}>{m.label}</Link>\n   560\t                      {n < 4 && (\n   561\t                        <span className=\"cov\" title={`${n} of 4 sub-scores measured; overall is the mean of the ${n} available`}>\n   562\t                          {n}/4\n   563\t                        </span>\n   564\t                      )}\n   565\t                    </div>\n   566\t                    <div className=\"l2 mono\">\n   567\t                      {m.id}\n   568\t                      <span className=\"size-inline\"> · {fmtParams(params(m))}</span>\n   569\t                    </div>\n   570\t                  </td>\n   571\t                  <td className=\"c-size\">{fmtParams(params(m))}</td>\n   572\t                  <td className=\"c-overall\">\n   573\t                    <span className=\"ov\">\n   574\t                      <strong>{fmtNum(m.score, \"score\")}</strong>\n   575\t                      <ScoreBar value={m.score} width={90} height={8} ticks title={`overall ${fmtNum(m.score, \"score\")}`} />\n   576\t                    </span>\n   577\t                  </td>\n   578\t                  {SUB_KEYS.map((k) => (\n   579\t                    <td key={k} className=\"c-sub\">\n   580\t                      <SubCell m={m} k={k} raw={raw} />\n   581\t                    </td>\n   582\t                  ))}\n   583\t                  <td className=\"c-micro\" aria-hidden=\"true\">\n   584\t                    <MicroBars m={m} />\n   585\t                  </td>\n   586\t                </tr>\n   587\t              );\n   588\t            })}\n   589\t          </tbody>\n   590\t        </table>\n   591\t      ) : (\n   592\t        <LaddersView models={filtered} />\n   593\t      )}\n   594\t      {filtered.length === 0 && <p className=\"ink2\">No checkpoints match these filters.</p>}\n   595\t    </div>\n   596\t  );\n   597\t}\n","exit_code":0,"status":"completed"}}
