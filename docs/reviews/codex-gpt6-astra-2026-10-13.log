{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/bin/zsh -lc \"nl -ba site/src/pages/ModelPage.tsx | sed -n '1,245p'\nnl -ba site/src/pages/Findings.tsx | sed -n '1,260p'\"","aggregated_output":"     1\timport { useEffect, useMemo, useRef, useState } from \"react\";\n     2\timport { Link, useParams, useSearchParams } from \"react-router-dom\";\n     3\timport { useBundle, useLoaded } from \"../data/BundleContext\";\n     4\timport { byId, fp, get, path } from \"../data/bundle\";\n     5\timport { defaultCompare, fmtParams, nAvailable, params, preAnnealBand, ranked } from \"../data/derive\";\n     6\timport { describe, GROUPS } from \"../data/glossary\";\n     7\timport { SUB_META } from \"../data/method\";\n     8\timport { meanOfStored } from \"../data/scoring\";\n     9\timport { SUB_KEYS, type Model, type TailKey } from \"../data/types\";\n    10\timport { NotFound } from \"../App\";\n    11\timport { Glyph, StageLegend } from \"../components/Glyph\";\n    12\timport { Num } from \"../components/Num\";\n    13\timport { DataNote, NullPlate, Plate, SourceLine } from \"../components/Plate\";\n    14\timport { ScoreBar, DivergingBar } from \"../components/Bars\";\n    15\timport { CopyButton, downloadJson } from \"../components/CopyButton\";\n    16\timport { TransferPlot } from \"../charts/TransferPlot\";\n    17\timport { DotRows, domainRows, Gauge, HBars, Kv, ReliabilityDiagram, SiblingRail, StageDotStrip } from \"../charts/ModelCharts\";\n    18\timport { TopNamesChart, topNamesOf } from \"../charts/TopNames\";\n    19\timport { cmpNullsLast, fmt, fmtNum, isNum, MINUS, type Fmt } from \"../lib/numfmt\";\n    20\timport { useWidth } from \"../components/Chart\";\n    21\timport { useScrollSpy } from \"../lib/useScrollSpy\";\n    22\timport methodologySource from \"../content/methodology.md?raw\";\n    23\timport { headingsOf } from \"../components/Markdown\";\n    24\timport { extent } from \"../lib/scale\";\n    25\timport { Chevron } from \"../components/Plate\";\n    26\t\n    27\tconst SECTIONS = [\n    28\t  { id: \"ramps\", n: 1, title: \"Sub-score ramps\", explainer: \"score\" },\n    29\t  { id: \"calibration\", n: 2, title: \"Calibration on unseen text\", explainer: \"calibration-gap\" },\n    30\t  { id: \"tail\", n: 3, title: \"Tail\", explainer: \"tail\" },\n    31\t  { id: \"surnames\", n: 4, title: \"Surnames\", explainer: \"surnames\" },\n    32\t  { id: \"genres\", n: 5, title: \"Rare genres\", explainer: \"verbatim-runs\" },\n    33\t  { id: \"samples\", n: 6, title: \"Own samples\", explainer: \"lexical\" },\n    34\t  { id: \"fingerprint\", n: 7, title: \"Full fingerprint\", explainer: \"pipeline\" },\n    35\t];\n    36\tconst SECTION_IDS = SECTIONS.map((s) => s.id);\n    37\t/** Methodology h2 text by anchor id, read from the page's own markdown, so the link names what the reader will find. */\n    38\tconst METHOD_HEADINGS: Record<string, string> = Object.fromEntries(headingsOf(methodologySource, 2).map((h) => [h.id, h.text]));\n    39\t\n    40\tfunction Section({ id, n, title, explainer, children }: { id: string; n: number; title: string; explainer: string; children: React.ReactNode }) {\n    41\t  return (\n    42\t    <section id={id} className=\"section\" aria-labelledby={`h-${id}`}>\n    43\t      <div className=\"with-margin\">\n    44\t        <div className=\"wm-main\">\n    45\t          <p className=\"kicker\">§{n}</p>\n    46\t          <h2 id={`h-${id}`}>{title}</h2>\n    47\t        </div>\n    48\t        <aside className=\"wm-margin\">\n    49\t          <Link className=\"margin-link\" to={`/methodology#${explainer}`}>\n    50\t            Explained in Methodology: {METHOD_HEADINGS[explainer] ?? explainer} →\n    51\t          </Link>\n    52\t        </aside>\n    53\t      </div>\n    54\t      {children}\n    55\t    </section>\n    56\t  );\n    57\t}\n    58\t\n    59\tfunction Rail({ active }: { active: string }) {\n    60\t  return (\n    61\t    <nav className=\"rail\" aria-label=\"Sections\">\n    62\t      <div className=\"rail-inner\">\n    63\t        <ol>\n    64\t          {SECTIONS.map((s) => (\n    65\t            <li key={s.id}>\n    66\t              <a href={`#${s.id}`} aria-current={active === s.id ? \"true\" : undefined}>\n    67\t                §{s.n} {s.title}\n    68\t              </a>\n    69\t            </li>\n    70\t          ))}\n    71\t        </ol>\n    72\t      </div>\n    73\t    </nav>\n    74\t  );\n    75\t}\n    76\t\n    77\t/** \"any model…\" type-ahead combobox over label, family and id. */\n    78\texport function ModelCombo({ models, onPick, label = \"Add a model to compare\" }: { models: Model[]; onPick: (m: Model) => void; label?: string }) {\n    79\t  const [q, setQ] = useState(\"\");\n    80\t  const [open, setOpen] = useState(false);\n    81\t  const [idx, setIdx] = useState(0);\n    82\t  const ql = q.trim().toLowerCase();\n    83\t  const hits = models.filter((m) => !ql || `${m.label} ${m.family} ${m.id}`.toLowerCase().includes(ql)).slice(0, 12);\n    84\t  const listId = useRef(\"combo-\" + Math.random().toString(36).slice(2)).current;\n    85\t  const pick = (m: Model) => {\n    86\t    onPick(m);\n    87\t    setQ(\"\");\n    88\t    setOpen(false);\n    89\t  };\n    90\t  return (\n    91\t    <span className=\"combo\">\n    92\t      <input\n    93\t        type=\"search\"\n    94\t        role=\"combobox\"\n    95\t        aria-label={label}\n    96\t        aria-expanded={open}\n    97\t        aria-controls={listId}\n    98\t        aria-autocomplete=\"list\"\n    99\t        aria-activedescendant={open && hits[idx] ? `${listId}-${idx}` : undefined}\n   100\t        placeholder=\"any model…\"\n   101\t        value={q}\n   102\t        onChange={(e) => {\n   103\t          setQ(e.target.value);\n   104\t          setOpen(true);\n   105\t          setIdx(0);\n   106\t        }}\n   107\t        onFocus={() => setOpen(true)}\n   108\t        onBlur={() => window.setTimeout(() => setOpen(false), 150)}\n   109\t        onKeyDown={(e) => {\n   110\t          if (e.key === \"ArrowDown\") {\n   111\t            e.preventDefault();\n   112\t            setIdx((i) => Math.min(hits.length - 1, i + 1));\n   113\t          } else if (e.key === \"ArrowUp\") {\n   114\t            e.preventDefault();\n   115\t            setIdx((i) => Math.max(0, i - 1));\n   116\t          } else if (e.key === \"Enter\" && hits[idx]) {\n   117\t            e.preventDefault();\n   118\t            pick(hits[idx]);\n   119\t          } else if (e.key === \"Escape\") setOpen(false);\n   120\t        }}\n   121\t      />\n   122\t      {open && hits.length > 0 && (\n   123\t        <ul id={listId} role=\"listbox\">\n   124\t          {hits.map((m, i) => (\n   125\t            <li\n   126\t              key={m.id}\n   127\t              id={`${listId}-${i}`}\n   128\t              role=\"option\"\n   129\t              aria-selected={i === idx}\n   130\t              onMouseDown={(e) => {\n   131\t                e.preventDefault();\n   132\t                pick(m);\n   133\t              }}\n   134\t            >\n   135\t              <Glyph stage={m.stage} /> {m.family} · {m.label}\n   136\t            </li>\n   137\t          ))}\n   138\t        </ul>\n   139\t      )}\n   140\t    </span>\n   141\t  );\n   142\t}\n   143\t\n   144\tconst TAIL_ROWS: { key: string; label: string; kind: Fmt; rate: boolean }[] = [\n   145\t  { key: \"s>7\", label: \"s > 7 nats\", kind: \"pct\", rate: true },\n   146\t  { key: \"s>10\", label: \"s > 10 nats\", kind: \"pct\", rate: true },\n   147\t  { key: \"rank>100\", label: \"rank > 100\", kind: \"pct\", rate: true },\n   148\t  { key: \"rank>1000\", label: \"rank > 1000\", kind: \"pct\", rate: true },\n   149\t  { key: \"CE\", label: \"CE\", kind: \"nats\", rate: false },\n   150\t  { key: \"H\", label: \"H\", kind: \"nats\", rate: false },\n   151\t  { key: \"s_p99\", label: \"s, 99th pct\", kind: \"nats\", rate: false },\n   152\t  { key: \"gap_hiH\", label: \"gap where H > 4\", kind: \"gap\", rate: false },\n   153\t];\n   154\tconst TAIL_PASSES: { key: TailKey; label: string }[] = [\n   155\t  { key: \"tf\", label: \"tf (Pile)\" },\n   156\t  { key: \"tf_fresh\", label: \"tf_fresh (post-cutoff)\" },\n   157\t  { key: \"tf_weird\", label: \"tf_weird (rare genres)\" },\n   158\t];\n   159\t\n   160\texport default function ModelPage() {\n   161\t  const bundle = useBundle();\n   162\t  const { file } = useLoaded();\n   163\t  const { id = \"\" } = useParams();\n   164\t  const [sp, setSp] = useSearchParams();\n   165\t  const model = byId(bundle, decodeURIComponent(id));\n   166\t  const active = useScrollSpy(SECTION_IDS);\n   167\t\n   168\t  useEffect(() => {\n   169\t    if (model) document.title = `${model.label} · ${model.family} · True Base Bench`;\n   170\t  }, [model]);\n   171\t\n   172\t  const compare: Model[] = useMemo(() => {\n   173\t    if (!model) return [];\n   174\t    const raw = sp.get(\"compare\");\n   175\t    if (raw === null) {\n   176\t      const d = defaultCompare(bundle, model);\n   177\t      return d ? [d] : [];\n   178\t    }\n   179\t    return raw\n   180\t      .split(\",\")\n   181\t      .map((x) => byId(bundle, x))\n   182\t      .filter((m): m is Model => !!m && m.id !== model.id)\n   183\t      .slice(0, 3);\n   184\t  }, [bundle, model, sp]);\n   185\t\n   186\t  if (!model)\n   187\t    return (\n   188\t      <>\n   189\t        <NotFound />\n   190\t        <p className=\"container\">\n   191\t          No checkpoint with id <code>{decodeURIComponent(id)}</code> in {file}. <Link to=\"/\">Back to the leaderboard</Link>.\n   192\t        </p>\n   193\t      </>\n   194\t    );\n   195\t\n   196\t  const setCompare = (ms: Model[]) => {\n   197\t    const n = new URLSearchParams(sp);\n   198\t    n.set(\"compare\", ms.map((m) => m.id).join(\",\"));\n   199\t    setSp(n, { replace: true });\n   200\t  };\n   201\t  const rk = ranked(bundle).find((r) => r.model.id === model.id)!;\n   202\t  const nAvail = nAvailable(model);\n   203\t  const arith = meanOfStored(model.subscores);\n   204\t  const diff = arith.mean !== null && model.score !== null ? arith.mean - model.score : null;\n   205\t  const band = preAnnealBand(bundle);\n   206\t  const both = [model, ...compare];\n   207\t  const rel = model.selfboot?.reliability ?? null;\n   208\t  const s = model.surnames;\n   209\t  const effMax = isNum(bundle.reference.census_entropy_top2000) ? Math.exp(bundle.reference.census_entropy_top2000) : null;\n   210\t  const P = (k: string) => path(model, k);\n   211\t  const lexKeys = [\"ttr\", \"hapax\", \"distinct4\", \"zipf_slope\", \"gzip_ratio\"] as const;\n   212\t  const topNames = topNamesOf(model, bundle);\n   213\t\n   214\t  return (\n   215\t    <div className=\"container\">\n   216\t      <div className=\"reading\">\n   217\t        <Rail active={active} />\n   218\t        <div className=\"wide\">\n   219\t          <header className=\"page-head\">\n   220\t            <nav className=\"crumb\" aria-label=\"Breadcrumb\">\n   221\t              <Link to=\"/\">Leaderboard</Link> / <Link to={`/?family=${encodeURIComponent(model.family)}`}>{model.family}</Link>\n   222\t            </nav>\n   223\t            <h1>{model.label}</h1>\n   224\t            <div className=\"mp-sub\">\n   225\t              <span>{model.family}</span>\n   226\t              <span>·</span>\n   227\t              <span>{fmtParams(params(model))}</span>\n   228\t              <span>·</span>\n   229\t              <span className=\"stage-tag\">\n   230\t                <Glyph stage={model.stage} size={10} /> {model.stage}\n   231\t              </span>\n   232\t            </div>\n   233\t            <div className=\"mp-id\">\n   234\t              <code>{model.id}</code>\n   235\t              <CopyButton text={model.id} label=\"Copy id\" />\n   236\t            </div>\n   237\t            <div className=\"mp-overall\">\n   238\t              <span className=\"big\">\n   239\t                <Num path={P(\"score\")} fmt=\"score\" />\n   240\t              </span>\n   241\t              <ScoreBar value={model.score} width={240} height={10} ticks title={`overall ${fmtNum(model.score, \"score\")}`} />\n   242\t              <span className=\"ink2\">\n   243\t                rank {rk.tie ? \"=\" : \"\"}\n   244\t                {rk.rank} of {bundle.models.length} · mean of {nAvail} sub-scores\n   245\t              </span>\n     1\timport { Fragment, useMemo, useState, type ReactNode } from \"react\";\n     2\timport source from \"../content/findings.md?raw\";\n     3\timport { Markdown, sectionsOf, splitTitle, type BlockMap } from \"../components/Markdown\";\n     4\timport type { FindingsPlate } from \"../content/slots\";\n     5\timport { Link } from \"react-router-dom\";\n     6\timport { useBundle } from \"../data/BundleContext\";\n     7\timport { fp, get, path } from \"../data/bundle\";\n     8\timport { ladder } from \"../data/derive\";\n     9\timport { ROLL_H_LOW, RUN_MIN_LEN } from \"../data/method\";\n    10\timport type { Model } from \"../data/types\";\n    11\timport { allFindings, FINDING_DEFS, type Check } from \"../findings\";\n    12\timport { Num } from \"../components/Num\";\n    13\timport { Chevron, DataNote, Plate } from \"../components/Plate\";\n    14\timport { StageLegend } from \"../components/Glyph\";\n    15\timport { CombMatrix, GapPriorScatter, KLDumbbells, LadderChart, LadderSmallMultiples, PairedArrows, ProfileChart, type Metric } from \"../charts/FindingCharts\";\n    16\timport { StageDotStrip } from \"../charts/ModelCharts\";\n    17\timport { useScrollSpy } from \"../lib/useScrollSpy\";\n    18\timport { fmt, isNum, type Fmt } from \"../lib/numfmt\";\n    19\t\n    20\tinterface ReadOff {\n    21\t  model: Model;\n    22\t  key: string;\n    23\t  fmt: Fmt;\n    24\t  what: string;\n    25\t}\n    26\t\n    27\tfunction N({ m, k, f }: { m: Model; k: string; f: Fmt }) {\n    28\t  return <Num path={path(m, k)} fmt={f} />;\n    29\t}\n    30\t\n    31\tfunction ReadOffList({ items }: { items: ReadOff[] }) {\n    32\t  const seen = new Set<string>();\n    33\t  const uniq = items.filter((i) => {\n    34\t    const key = i.model.id + i.key;\n    35\t    if (seen.has(key)) return false;\n    36\t    seen.add(key);\n    37\t    return true;\n    38\t  });\n    39\t  return (\n    40\t    <details className=\"disclosure\" style={{ marginTop: 8 }}>\n    41\t      <summary>\n    42\t        <Chevron /> Read-off: {uniq.length} values used\n    43\t      </summary>\n    44\t      <ul className=\"readoff\">\n    45\t        {uniq.map((i) => (\n    46\t          <li key={i.model.id + i.key}>\n    47\t            <Link to={`/model/${encodeURIComponent(i.model.id)}`}>\n    48\t              {i.model.family} · {i.model.label}\n    49\t            </Link>{\" \"}\n    50\t            {i.what}: <Num path={path(i.model, i.key)} fmt={i.fmt} />\n    51\t          </li>\n    52\t        ))}\n    53\t      </ul>\n    54\t    </details>\n    55\t  );\n    56\t}\n    57\t\n    58\tfunction Notes({ checks }: { checks: Record<string, Check> }) {\n    59\t  return (\n    60\t    <>\n    61\t      {Object.entries(checks)\n    62\t        .filter(([, c]) => !c.ok)\n    63\t        .map(([k, c]) => (\n    64\t          <DataNote key={k}>In this bundle, {c.note}.</DataNote>\n    65\t        ))}\n    66\t    </>\n    67\t  );\n    68\t}\n    69\t\n    70\tfunction joinList(nodes: ReactNode[], sep: ReactNode = \", \"): ReactNode {\n    71\t  return nodes.map((n, i) => (\n    72\t    <Fragment key={i}>\n    73\t      {i > 0 && sep}\n    74\t      {n}\n    75\t    </Fragment>\n    76\t  ));\n    77\t}\n    78\t\n    79\tfunction Def({ name, f }: { name: keyof typeof FINDING_DEFS; f: Fmt }) {\n    80\t  return <Num path={`findings.${name}`} value={FINDING_DEFS[name]} fmt={f} def />;\n    81\t}\n    82\t\n    83\texport default function Findings() {\n    84\t  const bundle = useBundle();\n    85\t  const F = useMemo(() => allFindings(bundle), [bundle]);\n    86\t  // Plate L opens on surname KL: the calibration-gap view repeats Plate F1b, so it is one click away, not the default\n    87\t  const [metricKey, setMetricKey] = useState<\"gap\" | \"kl\" | \"ece\">(\"kl\");\n    88\t\n    89\t  const band = F.f1.band?.band;\n    90\t  const gapMetric: Metric = {\n    91\t    key: \"gap\",\n    92\t    name: \"calibration gap\",\n    93\t    value: (m) => fp(m, \"F_calib_gap\"),\n    94\t    pathOf: (m) => path(m, \"fingerprint.F_calib_gap\"),\n    95\t    fmtKind: \"gap\",\n    96\t    axis: \"calibration gap on post-cutoff text, mean(H − s), nats\",\n    97\t    zero: true,\n    98\t    band,\n    99\t  };\n   100\t  const metrics: Record<string, Metric> = {\n   101\t    gap: gapMetric,\n   102\t    kl: {\n   103\t      key: \"kl\",\n   104\t      name: \"few-shot surname KL\",\n   105\t      value: (m) => get(m, \"surnames.KL_few\"),\n   106\t      pathOf: (m) => path(m, \"surnames.KL_few\"),\n   107\t      fmtKind: \"kl\",\n   108\t      axis: \"KL(Census‖model), few-shot frames, nats\",\n   109\t      zero: true,\n   110\t    },\n   111\t    ece: {\n   112\t      key: \"ece\",\n   113\t      name: \"ECE\",\n   114\t      value: (m) => get(m, \"selfboot.reliability.ECE\"),\n   115\t      pathOf: (m) => path(m, \"selfboot.reliability.ECE\"),\n   116\t      fmtKind: \"num3\",\n   117\t      axis: \"expected calibration error of top-1, post-cutoff text\",\n   118\t      zero: true,\n   119\t    },\n   120\t  };\n   121\t\n   122\t  // ---------- F1 ----------\n   123\t  const f1 = F.f1;\n   124\t  const famRungs = f1.family ? ladder(bundle, f1.family) : [];\n   125\t  const gapVals = famRungs.map((m) => fp(m, \"F_calib_gap\")).filter(isNum);\n   126\t  const f1Domain: [number, number] = [Math.min(-1.0, Math.min(...gapVals) - 0.05), Math.max(0.1, Math.max(...gapVals) + 0.02)];\n   127\t  const nPre = bundle.models.filter((m) => m.stage === \"pre-anneal\").length;\n   128\t  const r1: ReadOff[] = [\n   129\t    ...(f1.band ? [{ model: f1.band.model, key: \"fingerprint.F_calib_gap\", fmt: \"gap\" as Fmt, what: \"F_calib_gap (sets the band)\" }] : []),\n   130\t    ...f1.steps.map((m) => ({ model: m, key: \"fingerprint.F_calib_gap\", fmt: \"gap\" as Fmt, what: \"F_calib_gap\" })),\n   131\t  ];\n   132\t\n   133\t  // ---------- F2 ----------\n   134\t  const f2 = F.f2;\n   135\t  const memoKey = (m: Model) => (isNum(fp(m, \"X_runfrac_wiki\")) ? \"fingerprint.X_runfrac_wiki\" : \"fingerprint.verbatim_run_frac_wiki\");\n   136\t  const minAnneal = f2.priorAnneal.reduce<Model | null>((a, m) => (!a || (fp(m, \"roll_instr_marker_rate\") ?? 9) < (fp(a, \"roll_instr_marker_rate\") ?? 9) ? m : a), null);\n   137\t  const maxAnneal = f2.priorAnneal.reduce<Model | null>((a, m) => (!a || (fp(m, \"roll_instr_marker_rate\") ?? -9) > (fp(a, \"roll_instr_marker_rate\") ?? -9) ? m : a), null);\n   138\t  const profileFams = [f2.memo?.[0].family, f2.priorFamily].filter((f, i, a): f is string => !!f && a.indexOf(f) === i);\n   139\t  const r2: ReadOff[] = [\n   140\t    ...(f2.memo ?? []).map((m) => ({ model: m, key: memoKey(m), fmt: \"pct\" as Fmt, what: \"Wikipedia verbatim share\" })),\n   141\t    ...(f2.priorPre ? [f2.priorPre, ...f2.priorAnneal] : []).map((m) => ({ model: m, key: \"fingerprint.roll_instr_marker_rate\", fmt: \"pct\" as Fmt, what: \"marker rate\" })),\n   142\t  ];\n   143\t\n   144\t  // ---------- F3 ----------\n   145\t  const f3 = F.f3;\n   146\t  const r3: ReadOff[] = [\n   147\t    ...(f3.student ? [{ model: f3.student, key: \"fingerprint.F_calib_gap\", fmt: \"gap\" as Fmt, what: \"F_calib_gap\" }] : []),\n   148\t    ...(f3.otherBaseMin ? [{ model: f3.otherBaseMin.model, key: \"fingerprint.F_calib_gap\", fmt: \"gap\" as Fmt, what: \"F_calib_gap (lowest other base)\" }] : []),\n   149\t    ...(f3.postMax ? [{ model: f3.postMax.model, key: \"fingerprint.F_calib_gap\", fmt: \"gap\" as Fmt, what: \"F_calib_gap (highest post-trained)\" }] : []),\n   150\t    ...(f3.studentPost ? [{ model: f3.studentPost, key: \"fingerprint.F_calib_gap\", fmt: \"gap\" as Fmt, what: \"F_calib_gap\" }] : []),\n   151\t  ];\n   152\t\n   153\t  // ---------- F4 ----------\n   154\t  const f4 = F.f4;\n   155\t  const sp4 = f4.specimen;\n   156\t  const next4 = sp4 ? f4.family.find((r) => r.order > sp4.order && r.stage !== \"post-trained\") : undefined;\n   157\t  const r4: ReadOff[] = f4.family.flatMap((m) => [\n   158\t    { model: m, key: 'fingerprint[\"roll_frac_H<0.1\"]', fmt: \"pct\" as Fmt, what: \"steps with H < 0.1\" },\n   159\t    { model: m, key: \"fingerprint.roll_rep8_q4\", fmt: \"pct\" as Fmt, what: \"late 8-gram repetition\" },\n   160\t  ]);\n   161\t\n   162\t  // ---------- F5 ----------\n   163\t  const f5 = F.f5;\n   164\t  const cleanLo = f5.clean.reduce<Model | null>((a, m) => (!a || m.surnames!.KL_few! < a.surnames!.KL_few! ? m : a), null);\n   165\t  const cleanHi = f5.clean.reduce<Model | null>((a, m) => (!a || m.surnames!.KL_few! > a.surnames!.KL_few! ? m : a), null);\n   166\t  const effMetric: Metric = {\n   167\t    key: \"eff\",\n   168\t    name: \"exp(H_few)\",\n   169\t    value: (m) => (isNum(get(m, \"surnames.H_few\")) ? Math.exp(get(m, \"surnames.H_few\")!) : null),\n   170\t    pathOf: (m) => `exp(${path(m, \"surnames.H_few\")})`,\n   171\t    fmtKind: \"eff\",\n   172\t    axis: \"effective number of surnames, exp(H_few), linear\",\n   173\t    ref: isNum(bundle.reference.census_entropy_top2000) ? { value: Math.exp(bundle.reference.census_entropy_top2000), label: \"Census, top 2,000\" } : undefined,\n   174\t  };\n   175\t  const r5: ReadOff[] = [\n   176\t    ...f5.clean.map((m) => ({ model: m, key: \"surnames.KL_few\", fmt: \"kl\" as Fmt, what: \"few-shot KL\" })),\n   177\t    ...(f5.B ? [{ model: f5.B, key: \"surnames.KL_few\", fmt: \"kl\" as Fmt, what: \"few-shot KL\" }, { model: f5.B, key: \"surnames.H_few\", fmt: \"nats\" as Fmt, what: \"few-shot entropy\" }] : []),\n   178\t  ];\n   179\t\n   180\t  // ---------- F6 ----------\n   181\t  const f6 = F.f6;\n   182\t  const rLo = f6.rateSupport.reduce<(typeof f6.pairs)[number] | null>((a, p) => (!a || p.rise < a.rise ? p : a), null);\n   183\t  const rHi = f6.rateSupport.reduce<(typeof f6.pairs)[number] | null>((a, p) => (!a || p.rise > a.rise ? p : a), null);\n   184\t  const gLo = f6.gapSupport.reduce<(typeof f6.pairs)[number] | null>((a, p) => (!a || -p.hiDelta! < -a.hiDelta! ? p : a), null);\n   185\t  const gHi = f6.gapSupport.reduce<(typeof f6.pairs)[number] | null>((a, p) => (!a || -p.hiDelta! > -a.hiDelta! ? p : a), null);\n   186\t  const r6: ReadOff[] = f6.pairs.flatMap((p) => [\n   187\t    { model: p.base, key: 'tail.tf_fresh[\"s>10\"]', fmt: \"pct\" as Fmt, what: \"s > 10 rate\" },\n   188\t    { model: p.post, key: 'tail.tf_fresh[\"s>10\"]', fmt: \"pct\" as Fmt, what: \"s > 10 rate\" },\n   189\t    { model: p.base, key: \"tail.tf_fresh.gap_hiH\", fmt: \"gap\" as Fmt, what: \"gap at H > 4\" },\n   190\t    { model: p.post, key: \"tail.tf_fresh.gap_hiH\", fmt: \"gap\" as Fmt, what: \"gap at H > 4\" },\n   191\t  ]);\n   192\t\n   193\t  // ---------- claims (computed sentences with live numbers), keyed by finding id ----------\n   194\t  const claims: Record<string, ReactNode> = {\n   195\t    f1: (\n   196\t      <>\n   197\t        Pre-anneal checkpoints are calibrated on unseen text: all {nPre} sit within ±\n   198\t        {f1.band ? <Num path={path(f1.band.model, \"fingerprint.F_calib_gap\")} value={f1.band.band} fmt=\"nats\" derived=\"max |F_calib_gap| over pre-anneal checkpoints\" /> : \"—\"}{\" \"}\n   199\t        of zero. Every later stage pushes the gap negative, monotonically along {f1.family}:{\" \"}\n   200\t        {joinList(\n   201\t          f1.steps.map((m) => <N key={m.id} m={m} k=\"fingerprint.F_calib_gap\" f=\"signed\" />),\n   202\t          \" → \",\n   203\t        )}\n   204\t        .\n   205\t      </>\n   206\t    ),\n   207\t    f2: (\n   208\t      <>\n   209\t        “Annealed” is not one thing.{\" \"}\n   210\t        {joinList(\n   211\t          [\n   212\t            f2.memo && f2.memo.length >= 2 ? (\n   213\t              <span key=\"memo\">\n   214\t                {f2.memo[0].family}’s anneal memorised its up-weighted sources (Wikipedia verbatim share <N m={f2.memo[0]} k={memoKey(f2.memo[0])} f=\"pct\" /> →{\" \"}\n   215\t                <N m={f2.memo[1]} k={memoKey(f2.memo[1])} f=\"pct\" />)\n   216\t              </span>\n   217\t            ) : null,\n   218\t            f2.priorPre && minAnneal && maxAnneal ? (\n   219\t              <span key=\"prior\">\n   220\t                {f2.priorFamily}’s kept calibration but put instruction data into the prior (marker rate{\" \"}\n   221\t                <N m={f2.priorPre} k=\"fingerprint.roll_instr_marker_rate\" f=\"pct\" /> → <N m={minAnneal} k=\"fingerprint.roll_instr_marker_rate\" f=\"pct\" />–\n   222\t                <N m={maxAnneal} k=\"fingerprint.roll_instr_marker_rate\" f=\"pct\" />)\n   223\t              </span>\n   224\t            ) : null,\n   225\t          ].filter(Boolean),\n   226\t          \"; \",\n   227\t        )}\n   228\t        .\n   229\t      </>\n   230\t    ),\n   231\t    f3: f3.student ? (\n   232\t      <>\n   233\t        Distillation looks like post-training on the calibration axis: {f3.student.family} {f3.student.label} sits at <N m={f3.student} k=\"fingerprint.F_calib_gap\" f=\"gap\" />,\n   234\t        below every other base\n   235\t        {f3.otherBaseMin && (\n   236\t          <>\n   237\t            {\" \"}\n   238\t            (the next lowest is {f3.otherBaseMin.model.family} {f3.otherBaseMin.model.label}, <N m={f3.otherBaseMin.model} k=\"fingerprint.F_calib_gap\" f=\"signed\" />)\n   239\t          </>\n   240\t        )}{\" \"}\n   241\t        and inside the post-trained range.\n   242\t      </>\n   243\t    ) : (\n   244\t      \"Distillation: no distilled base in this bundle.\"\n   245\t    ),\n   246\t    f4: sp4 ? (\n   247\t      <>\n   248\t        Free-running collapse is not diagnostic: the pre-anneal {sp4.family} {sp4.label} spends <N m={sp4} k='fingerprint[\"roll_frac_H<0.1\"]' f=\"pct\" /> of its own sampling steps\n   249\t        below <Num path=\"method.ROLL_H_LOW\" value={ROLL_H_LOW} fmt=\"num2\" def /> nats of entropy and repeats <N m={sp4} k=\"fingerprint.roll_rep8_q4\" f=\"pct\" /> of late 8-grams\n   250\t        {next4 && (\n   251\t          <>\n   252\t            ; annealed, it repeats <N m={next4} k=\"fingerprint.roll_rep8_q4\" f=\"pct\" />\n   253\t          </>\n   254\t        )}\n   255\t        , against a post-trained median of{\" \"}\n   256\t        {isNum(f4.postRepMedian) ? (\n   257\t          <Num path=\"median(models[stage=post-trained].fingerprint.roll_rep8_q4)\" value={f4.postRepMedian} fmt=\"pct\" derived=\"median over post-trained checkpoints\" />\n   258\t        ) : (\n   259\t          \"—\"\n   260\t        )}\n","exit_code":0,"status":"completed"}}
