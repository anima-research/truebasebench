ipped feature, oriented like the score\n   276\t          return raw ? rampPosition(m, sort) : m.subscores?.[sort]?.score ?? null;\n   277\t      }\n   278\t    };\n   279\t    const out = [...filtered].sort((a, b) => {\n   280\t      const va = val(a);\n   281\t      const vb = val(b);\n   282\t      if (va === null && vb === null) return compareOverall(a, b);\n   283\t      if (va === null) return 1;\n   284\t      if (vb === null) return -1;\n   285\t      const c = typeof va === \"string\" ? va.localeCompare(vb as string) : (va as number) - (vb as number);\n   286\t      return c !== 0 ? (dir === \"asc\" ? c : -c) : compareOverall(a, b);\n   287\t    });\n   288\t    return out;\n   289\t  }, [filtered, sort, dir, raw]);\n   290\t\n   291\t  // FLIP re-sort animation (DESIGN §7.1), off under reduced motion\n   292\t  const tbodyRef = useRef<HTMLTableSectionElement>(null);\n   293\t  const prevTops = useRef(new Map<string, number>());\n   294\t  const sortSig = `${sort}:${dir}`;\n   295\t  const prevSig = useRef(sortSig);\n   296\t  useLayoutEffect(() => {\n   297\t    const body = tbodyRef.current;\n   298\t    if (!body) return;\n   299\t    const trs = Array.from(body.querySelectorAll<HTMLTableRowElement>(\"tr[data-id]\"));\n   300\t    const now = new Map(trs.map((tr) => [tr.dataset.id!, tr.getBoundingClientRect().top]));\n   301\t    if (!reduced && prevSig.current !== sortSig) {\n   302\t      for (const tr of trs) {\n   303\t        const before = prevTops.current.get(tr.dataset.id!);\n   304\t        const after = now.get(tr.dataset.id!)!;\n   305\t        if (before === undefined || before === after) continue;\n   306\t        tr.style.transition = \"none\";\n   307\t        tr.style.transform = `translateY(${before - after}px)`;\n   308\t        void tr.offsetHeight;\n   309\t        tr.style.transition = \"transform var(--dur-2) var(--ease-inout)\";\n   310\t        tr.style.transform = \"\";\n   311\t      }\n   312\t    }\n   313\t    prevSig.current = sortSig;\n   314\t    prevTops.current = now;\n   315\t  });\n   316\t\n   317\t  const setSort = (k: SortKey) => {\n   318\t    const n = new URLSearchParams(sp);\n   319\t    const defDir = k === \"model\" || k === \"stage\" ? \"asc\" : \"desc\";\n   320\t    if (sort === k) n.set(\"dir\", dir === \"asc\" ? \"desc\" : \"asc\");\n   321\t    else {\n   322\t      n.set(\"dir\", defDir);\n   323\t    }\n   324\t    if (k === \"overall\" && n.get(\"dir\") === \"desc\") {\n   325\t      n.delete(\"sort\");\n   326\t      n.delete(\"dir\");\n   327\t    } else n.set(\"sort\", k);\n   328\t    setSp(n, { replace: true });\n   329\t  };\n   330\t  const ariaSort = (k: SortKey) => (sort === k ? (dir === \"asc\" ? \"ascending\" : \"descending\") : \"none\");\n   331\t  const SortTh = ({ k, children, className, title }: { k: SortKey; children: React.ReactNode; className?: string; title?: string }) => (\n   332\t    <th scope=\"col\" aria-sort={ariaSort(k) as \"none\"} className={className} title={title}>\n   333\t      <button type=\"button\" className=\"sort-btn\" onClick={() => setSort(k)}>\n   334\t        {children}\n   335\t        <span className=\"tri\" aria-hidden=\"true\">\n   336\t          {sort === k ? (dir === \"asc\" ? \"▲\" : \"▼\") : \"\"}\n   337\t        </span>\n   338\t      </button>\n   339\t    </th>\n   340\t  );\n   341\t\n   342\t  // sticky thead sits under the sticky controls row\n   343\t  const ctlRef = useRef<HTMLDivElement>(null);\n   344\t  const [ctlH, setCtlH] = useState(0);\n   345\t  useLayoutEffect(() => {\n   346\t    const el = ctlRef.current;\n   347\t    if (!el || typeof ResizeObserver === \"undefined\") return;\n   348\t    const ro = new ResizeObserver(() => setCtlH(el.offsetHeight));\n   349\t    ro.observe(el);\n   350\t    return () => ro.disconnect();\n   351\t  }, []);\n   352\t\n   353\t  const nFam = familiesOf(bundle).length;\n   354\t  const stageStrip = bundle.models.filter((m) => filtered.includes(m));\n   355\t\n   356\t  return (\n   357\t    <div className=\"container lb\" style={{ [\"--ctl-h\" as string]: `${ctlH}px` }}>\n     1\timport { fmt, fmtNum, isNum } from \"../lib/numfmt\";\n     2\timport { linear } from \"../lib/scale\";\n     3\t\n     4\t/** Monochrome score bar on a track, 0–1 (DESIGN §7.1). Null shows a hatched track. */\n     5\texport function ScoreBar({\n     6\t  value,\n     7\t  width = 90,\n     8\t  height = 8,\n     9\t  ticks = false,\n    10\t  title,\n    11\t}: {\n    12\t  value: number | null;\n    13\t  width?: number;\n    14\t  height?: number;\n    15\t  ticks?: boolean;\n    16\t  title?: string;\n    17\t}) {\n    18\t  const id = \"hatch\";\n    19\t  return (\n    20\t    <svg\n    21\t      width={width}\n    22\t      height={height}\n    23\t      viewBox={`0 0 ${width} ${height}`}\n    24\t      preserveAspectRatio=\"none\"\n    25\t      role=\"img\"\n    26\t      aria-label={title ?? (isNum(value) ? fmt(value, \"score\") : \"not measured\")}\n    27\t      style={{ display: \"block\", flex: \"none\" }}\n    28\t    >\n    29\t      {title && <title>{title}</title>}\n    30\t      <rect width={width} height={height} fill={isNum(value) ? \"var(--track)\" : `url(#${id})`} />\n    31\t      {isNum(value) && <rect width={Math.max(0, Math.min(1, value)) * width} height={height} fill=\"var(--bar)\" />}\n    32\t      {ticks &&\n    33\t        [0.5, 1].map((t) => (\n    34\t          <line key={t} x1={t * width - (t === 1 ? 0.5 : 0)} x2={t * width - (t === 1 ? 0.5 : 0)} y1={-2} y2={height + 2} stroke=\"var(--rule-strong)\" />\n    35\t        ))}\n    36\t    </svg>\n    37\t  );\n    38\t}\n    39\t\n    40\t/** Shared SVG defs (hatch pattern). Mounted once in the app shell. */\n    41\texport function SvgDefs() {\n    42\t  return (\n    43\t    <svg width=\"0\" height=\"0\" style={{ position: \"absolute\" }} aria-hidden=\"true\">\n    44\t      <defs>\n    45\t        <pattern id=\"hatch\" width=\"6\" height=\"6\" patternUnits=\"userSpaceOnUse\" patternTransform=\"rotate(45)\">\n    46\t          <rect width=\"6\" height=\"6\" fill=\"var(--bg-plate)\" />\n    47\t          <line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"6\" stroke=\"var(--rule-strong)\" strokeWidth=\"1.5\" />\n    48\t        </pattern>\n    49\t        <marker id=\"arrow\" viewBox=\"0 0 8 8\" refX=\"7\" refY=\"4\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto-start-reverse\">\n    50\t          <path d=\"M0,0 L8,4 L0,8 z\" fill=\"var(--ink)\" />\n    51\t        </marker>\n    52\t        <marker id=\"arrow-2\" viewBox=\"0 0 8 8\" refX=\"7\" refY=\"4\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto-start-reverse\">\n    53\t          <path d=\"M0,0 L8,4 L0,8 z\" fill=\"var(--ink-2)\" />\n    54\t        </marker>\n    55\t      </defs>\n    56\t    </svg>\n    57\t  );\n    58\t}\n    59\t\n    60\t/**\n    61\t * RampCell (DESIGN §5): the raw feature on its ramp's own axis. Track shaded --band from the 1-anchor outward,\n    62\t * a tick at the 0-anchor, the value as a 2px --ink tick.\n    63\t */\n    64\texport function RampCell({\n    65\t  value,\n    66\t  good,\n    67\t  bad,\n    68\t  width = 64,\n    69\t  height = 10,\n    70\t  title,\n    71\t}: {\n    72\t  value: number | null;\n    73\t  good: number;\n    74\t  bad: number;\n    75\t  width?: number;\n    76\t  height?: number;\n    77\t  title?: string;\n    78\t}) {\n    79\t  // Axis spans from the good anchor outward past the bad anchor, oriented so \"good\" is on the right.\n    80\t  const span = bad - good;\n    81\t  const lo = good - span * 0.25;\n    82\t  const hi = bad + span * 0.25;\n    83\t  const s = linear([hi, lo], [0, width]); // bad side on the left\n    84\t  const clamp = (x: number) => Math.max(0, Math.min(width, x));\n    85\t  const goodX = s(good);\n    86\t  const badX = s(bad);\n    87\t  return (\n    88\t    <svg width={width} height={height} role=\"img\" aria-label={title} style={{ display: \"block\", flex: \"none\" }}>\n    89\t      {title && <title>{title}</title>}\n    90\t      <rect width={width} height={height} fill=\"var(--track)\" />\n    91\t      <rect x={Math.min(goodX, width)} width={Math.max(0, width - goodX)} height={height} fill=\"var(--band)\" />\n    92\t      <line x1={badX} x2={badX} y1={0} y2={height} stroke=\"var(--rule-strong)\" strokeWidth={1} />\n    93\t      <line x1={goodX} x2={goodX} y1={0} y2={height} stroke=\"var(--rule-strong)\" strokeWidth={1} strokeDasharray=\"2 1\" />\n    94\t      {isNum(value) ? (\n    95\t        <line x1={clamp(s(value))} x2={clamp(s(value))} y1={-1} y2={height + 1} stroke=\"var(--ink)\" strokeWidth={2} />\n    96\t      ) : (\n    97\t        <rect width={width} height={height} fill=\"url(#hatch)\" />\n    98\t      )}\n    99\t    </svg>\n   100\t  );\n   101\t}\n   102\t\n   103\t/** Bar growing from a 1px zero line; sign carried by direction and the label. */\n   104\texport function DivergingBar({\n   105\t  value,\n   106\t  max,\n   107\t  width = 160,\n   108\t  height = 10,\n   109\t  band,\n   110\t  ghosts = [],\n   111\t}: {\n   112\t  value: number | null;\n   113\t  max: number;\n   114\t  width?: number;\n   115\t  height?: number;\n   116\t  band?: number;\n   117\t  ghosts?: (number | null)[];\n   118\t}) {\n   119\t  const s = linear([-max, max], [0, width]);\n   120\t  return (\n   121\t    <svg width={width} height={height + 4} role=\"img\" aria-label={fmt(value, \"gap\")} style={{ display: \"block\", flex: \"none\" }}>\n   122\t      {band !== undefined && <rect x={s(-band)} width={s(band) - s(-band)} y={0} height={height + 4} fill=\"var(--band)\" />}\n   123\t      {isNum(value) && (\n   124\t        <rect x={Math.min(s(0), s(value))} width={Math.abs(s(value) - s(0))} y={2} height={height} fill=\"var(--bar)\" />\n   125\t      )}\n   126\t      <line x1={s(0)} x2={s(0)} y1={0} y2={height + 4} stroke=\"var(--zero)\" strokeWidth={1} />\n   127\t      {ghosts.map((g, i) => (isNum(g) ? <line key={i} x1={s(g)} x2={s(g)} y1={0} y2={height + 4} stroke=\"var(--ink-2)\" strokeWidth={1.5} strokeDasharray=\"2 1\" /> : null))}\n   128\t    </svg>\n   129\t  );\n   130\t}\n   131\t\n   132\texport function BarWithValue({ value, width = 64, kind = \"score\" as const }: { value: number | null; width?: number; kind?: \"score\" }) {\n   133\t  return (\n   134\t    <span style={{ display: \"inline-flex\", alignItems: \"center\", gap: 6 }}>\n   135\t      <ScoreBar value={value} width={width} height={6} />\n   136\t      <span className=\"small ink2\">{fmtNum(value, kind)}</span>\n   137\t    </span>\n   138\t  );\n   139\t}\n   228\t        </div>\n   229\t      ))}\n   230\t    </div>\n   231\t  );\n   232\t}\n   233\t\n   234\tconst DASH: Record<string, string | undefined> = { calib: undefined, spread: \"6 3\", memo: \"1.5 3\", prior: \"7 3 1.5 3\" };\n   235\t\n   236\t/** F2: four sub-score lines across a family's rungs, labelled at their right ends (no legend). */\n   237\texport function ProfileChart({ rungs }: { rungs: Model[] }) {\n   238\t  const aria = `Sub-scores along ${rungs[0]?.family}: ` + SUB_KEYS.map((k) => `${SUB_META[k].name} ${rungs.map((r) => fmtNum(r.subscores?.[k]?.score ?? null, \"score\")).join(\" → \")}`).join(\"; \");\n   239\t  return (\n   240\t    <ChartFrame ariaLabel={aria}>\n   241\t      {(w) => {\n   242\t        const L = 34;\n   243\t        const R = 54;\n   244\t        const T = 12;\n   245\t        const H = 150;\n   246\t        const x = linear([0, Math.max(1, rungs.length - 1)], [L + 8, w - R]);\n   247\t        const y = linear([0, 1], [T + H, T]);\n   248\t        const short = rungShortLabels(rungs, 14);\n   249\t        const ends = SUB_KEYS.map((k) => ({ k, v: rungs[rungs.length - 1].subscores?.[k]?.score ?? null }));\n   250\t        // de-collide end labels: 12px apart, kept inside the plot so they never reach the rung labels below it\n   251\t        const endOrder = ends.filter((e) => isNum(e.v)).sort((a, b) => b.v! - a.v!);\n   252\t        const ys = endOrder.map((e) => y(e.v!));\n   253\t        for (let i = 1; i < ys.length; i++) ys[i] = Math.max(ys[i], ys[i - 1] + 12);\n   254\t        const over = ys.length ? ys[ys.length - 1] - (T + H) : 0;\n   255\t        if (over > 0) {\n   256\t          ys[ys.length - 1] -= over;\n   257\t          for (let i = ys.length - 2; i >= 0; i--) ys[i] = Math.min(ys[i], ys[i + 1] - 12);\n   258\t        }\n   259\t\n   260\t        return (\n   261\t          <svg width={w} height={T + H + 70}>\n   262\t            <YAxis scale={y} x={L} ticks={[0, 0.25, 0.5, 0.75, 1]} format={(v) => String(v)} gridRight={w - R} />\n   263\t            {SUB_KEYS.map((k) => (\n   264\t              <polyline\n   265\t                key={k}\n   266\t                points={rungs.map((r, i) => (isNum(r.subscores?.[k]?.score) ? `${x(i)},${y(r.subscores![k]!.score!)}` : \"\")).join(\" \")}\n   267\t                fill=\"none\"\n   268\t                stroke=\"var(--ink)\"\n   269\t                strokeWidth={1.5}\n   270\t                strokeDasharray={DASH[k]}\n   271\t              />\n   272\t            ))}\n   273\t            {rungs.map((r, i) => (\n   274\t              <g key={r.id}>\n   275\t                <GlyphShape stage={r.stage} x={x(i)} y={T + H + 10} size={8} />\n   276\t                <text transform={`translate(${x(i)},${T + H + 22}) rotate(35)`} style={{ fontSize: 11 }}>\n   277\t                  {short.get(r.id)}\n   278\t                </text>\n   279\t              </g>\n   280\t            ))}\n   281\t            {endOrder.map((e, i) => (\n   282\t              <text key={e.k} x={w - R + 6} y={ys[i]} dy=\"0.32em\" style={{ fill: \"var(--ink)\" }}>\n   283\t                {SUB_META[e.k].name}\n   284\t              </text>\n   285\t            ))}\n   286\t          </svg>\n   287\t        );\n   288\t      }}\n   289\t    </ChartFrame>\n   290\t  );\n   291\t}\n   292\t\n   293\t/** F2: comb matrix of C S M P for anneal and base checkpoints. */\n   294\texport function CombMatrix({ models }: { models: Model[] }) {\n   295\t  return (\n   296\t    <div className=\"tbl-scroll\">\n   297\t      {/* a minimum width keeps bar and number side by side; narrower screens scroll the table, not the page */}\n   298\t      <table className=\"tbl\" style={{ minWidth: 600 }}>\n   299\t        <thead>\n   300\t          <tr>\n   301\t            <th scope=\"col\">checkpoint</th>\n   302\t            {SUB_KEYS.map((k) => (\n   303\t              <th key={k} scope=\"col\" title={SUB_META[k].readsAs}>\n   304\t                {SUB_META[k].short} · {SUB_META[k].name}\n   305\t              </th>\n   306\t            ))}\n   307\t          </tr>\n   308\t        </thead>\n   309\t        <tbody>\n   310\t          {models.map((m) => (\n   311\t            <tr key={m.id}>\n   312\t              <th scope=\"row\" style={{ fontWeight: 400, background: \"none\" }}>\n   313\t                <span className=\"stage-tag\">\n    30\tconst eligible = (m: Model) => isNum(sv(m, \"H_desc\")) && isNum(sv(m, \"H_few\")) && isNum(sv(m, \"KL_few\"));\n    31\t\n    32\t/** Frame texts: reference.surname_frames when present, else method.ts (SURNAME_PROMPTS). */\n    33\tfunction frames(bundle: Bundle): { desc: string; few: string; descName: string; fewName: string } {\n    34\t  const ref = bundle.reference.surname_frames;\n    35\t  const di = SURNAME_FRAMES.desc.indexOf(\"plain\");\n    36\t  const refDesc = ref?.desc?.[di];\n    37\t  const refFew = ref?.few?.[0];\n    38\t  const isText = (s: unknown): s is string => typeof s === \"string\" && s.includes(\"\\n\");\n    39\t  return {\n    40\t    desc: isText(refDesc) ? refDesc : SURNAME_PROMPTS.plain,\n    41\t    few: isText(refFew) ? refFew : SURNAME_PROMPTS.fewshot1,\n    42\t    descName: \"plain\",\n    43\t    fewName: SURNAME_FRAMES.few[0],\n    44\t  };\n    45\t}\n    46\t\n    47\tfunction Field({ total, lit, pitch }: { total: number; lit: number; pitch: number }) {\n    48\t  const rows = Math.ceil(total / COLS);\n    49\t  const r = Math.max(1.2, pitch * 0.32);\n    50\t  const w = COLS * pitch;\n    51\t  const h = rows * pitch;\n    52\t  const n = Math.round(lit);\n    53\t  return (\n    54\t    <svg width={w} height={h} viewBox={`0 0 ${w} ${h}`} aria-hidden=\"true\">\n    55\t      {Array.from({ length: total }, (_, i) => {\n    56\t        const cx = (i % COLS) * pitch + pitch / 2;\n    57\t        const cy = Math.floor(i / COLS) * pitch + pitch / 2;\n    58\t        return i < n ? <circle key={i} cx={cx} cy={cy} r={r} fill=\"var(--ink)\" /> : <circle key={i} cx={cx} cy={cy} r={r - 0.4} fill=\"none\" stroke=\"var(--rule-strong)\" strokeWidth={0.8} />;\n    59\t      })}\n    60\t    </svg>\n    61\t  );\n    62\t}\n    63\t\n    64\tfunction HBarRows({ width, rows, prog }: { width: number; rows: { name: string; v: number | null; on: boolean; fmtKind: \"pct\" | \"num3\" }[]; prog: number }) {\n   327\t    <div ref={ref}>\n   328\t      <div className=\"xp-cards\">\n   329\t        <pre className={`xp-card${st.step >= 3 ? \" dim\" : \"\"}`}>\n   330\t          <span className=\"xp-card-head\">E1 · Described · {fr.descName}</span>\n   331\t          {fr.desc}\n   332\t          {descSlot ? <mark aria-label=\"next item\">{\"      \"}</mark> : null}\n   333\t        </pre>\n   334\t        <pre className={`xp-card${st.step < 3 ? \" dim\" : \"\"}`}>\n   335\t          <span className=\"xp-card-head\">E1 · Few-shot · {fr.fewName}</span>\n   336\t          {fewText}\n   337\t          {fewSlot ? <mark aria-label=\"next item\">{\"      \"}</mark> : null}\n   338\t        </pre>\n   339\t      </div>\n   340\t      <div className={side ? \"xp-row2\" : undefined}>\n   341\t        <div>\n   342\t          <p className=\"xp-sub-label\">E2 · Effective number of surnames</p>\n   343\t          <p className=\"small\" style={{ margin: \"0 0 6px\" }}>\n   344\t            {who.m && <InlineGlyph stage={who.m.stage} size={8} hollow={who.m === B} />} <span className=\"ink2\">{fieldLabel}:</span>{\" \"}\n   345\t            {settled ? (\n   346\t              <Num path={fieldPath} value={fieldValue} fmt=\"eff\" derived={who.m ? `exp(${who.frame === \"described\" ? \"H_desc\" : \"H_few\"})` : \"exp(census_entropy_top2000)\"} />\n   347\t            ) : (\n   348\t              <span aria-hidden=\"true\">{fmtNum(Math.round(lit), \"eff\")}</span>\n   349\t            )}{\" \"}\n   350\t            <span className=\"ink3\">of {fmtCount(total)}</span>\n   351\t          </p>\n   352\t          <Field total={total} lit={lit} pitch={pitch} />\n   353\t          <p className=\"xp-tag-line\">one dot per effective name, rank 1 top left; outlines mark the Census extent</p>\n   354\t        </div>\n   355\t        <div>\n   356\t          <p className=\"xp-sub-label\">p(Smith) as item 1 · plain frame</p>\n   357\t          <HBarRows width={side ? W / 2 - 8 : W} rows={smithRows} prog={st.step >= 1 ? at(1) : 0} />\n   358\t          <p className=\"xp-sub-label\" style={{ marginTop: 10 }}>\n   359\t            E3 · Top-10 mass · {curM === A ? \"A\" : \"B\"} {curM.label}\n","exit_code":0,"status":"completed"}}
