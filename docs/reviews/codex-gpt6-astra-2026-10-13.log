{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/bin/zsh -lc 'nl -ba Dockerfile && nl -ba infra/caddy/Caddyfile && nl -ba site/vite.config.ts && nl -ba site/package.json && nl -ba site/vitest.config.ts && nl -ba tools/csp.mjs && nl -ba .github/workflows/ci.yml && nl -ba .dockerignore && nl -ba railway.json'","aggregated_output":"     1\t# True Base Bench: build the static site (Vite) and serve it with Caddy. Used by Railway (railway.json).\n     2\t#\n     3\t#   docker build -t truebasebench --build-arg VITE_DATA_BASE_URL=https://<bucket>.s3.<region>.io.cloud.ovh.net .\n     4\t#   docker run --rm -p 8080:8080 truebasebench        # http://localhost:8080\n     5\t#\n     6\t# Build args (on Railway: service variables of the same name are passed as build args automatically):\n     7\t#   VITE_DATA_BASE_URL    public base URL of the OVH bucket holding manifest.json + bench_v<N>.json.\n     8\t#                         Empty = serve only the repo copy in data/ (bundled into the image at /data/).\n     9\t#   VITE_SOURCE_REPO_URL  e.g. https://github.com/anima-research/truebasebench (links script names).\n    10\t#   RUN_TESTS             1 (default) runs the site's data-contract and scoring tests before building.\n    11\t\n    12\t# ---------------------------------------------------------------- build\n    13\tFROM node:20.18.1-bookworm-slim AS build\n    14\tWORKDIR /app/site\n    15\t\n    16\t# Dependencies first, for layer caching.\n    17\tCOPY site/package.json site/package-lock.json ./\n    18\tRUN npm ci --no-audit --no-fund\n    19\t\n    20\t# Sources (explicit list: never the host's node_modules or dist).\n    21\tCOPY data /app/data\n    22\t# docs/ holds the measurement scripts; the tests check the site's method constants against them.\n    23\tCOPY docs /app/docs\n    24\tCOPY site/index.html site/tsconfig.json site/vite.config.ts site/vitest.config.ts ./\n    25\tCOPY site/public ./public\n    26\tCOPY site/src ./src\n    27\tCOPY tools/csp.mjs /app/tools/csp.mjs\n    28\t\n    29\tARG VITE_DATA_BASE_URL=\"\"\n    30\tARG VITE_SOURCE_REPO_URL=\"\"\n    31\tARG RUN_TESTS=1\n    32\tENV VITE_DATA_BASE_URL=${VITE_DATA_BASE_URL} \\\n    33\t    VITE_SOURCE_REPO_URL=${VITE_SOURCE_REPO_URL}\n    34\t\n    35\tRUN if [ \"$RUN_TESTS\" = \"1\" ]; then npm test; fi \\\n    36\t && npm run build \\\n    37\t && test -f dist/index.html && test -f dist/data/manifest.json \\\n    38\t && node /app/tools/csp.mjs dist/index.html /app/csp.caddy\n    39\t\n    40\t# ---------------------------------------------------------------- serve\n    41\tFROM caddy:2.8.4-alpine AS serve\n    42\tCOPY infra/caddy/Caddyfile /etc/caddy/Caddyfile\n    43\tCOPY --from=build /app/csp.caddy /etc/caddy/csp.caddy\n    44\tCOPY --from=build /app/site/dist /srv\n    45\tRUN caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile\n    46\t\n    47\t# Railway sets PORT; 8080 when run elsewhere. Caddy needs no writable state here (no TLS, no admin API);\n    48\t# its data/config dirs point at /tmp so it can run unprivileged.\n    49\tENV PORT=8080 \\\n    50\t    XDG_DATA_HOME=/tmp/caddy-data \\\n    51\t    XDG_CONFIG_HOME=/tmp/caddy-config\n    52\tEXPOSE 8080\n    53\tUSER 1000:1000\n    54\tHEALTHCHECK --interval=30s --timeout=3s --start-period=5s CMD wget -qO- \"http://127.0.0.1:${PORT}/healthz\" || exit 1\n    55\tCMD [\"caddy\", \"run\", \"--config\", \"/etc/caddy/Caddyfile\", \"--adapter\", \"caddyfile\"]\n     1\t# True Base Bench: static site server (Railway). Serves the Vite build from /srv.\n     2\t# Railway terminates TLS and injects $PORT; Caddy only speaks plain HTTP behind it.\n     3\t{\n     4\t\tadmin off\n     5\t\tauto_https off\n     6\t\tpersist_config off\n     7\t\tservers {\n     8\t\t\ttrusted_proxies static private_ranges\n     9\t\t\tclient_ip_headers X-Forwarded-For X-Real-IP\n    10\t\t}\n    11\t\tlog {\n    12\t\t\toutput stdout\n    13\t\t\tformat json\n    14\t\t\tlevel WARN\n    15\t\t}\n    16\t}\n    17\t\n    18\t# Security headers, applied to normal and error responses.\n    19\t(security_headers) {\n    20\t\theader {\n    21\t\t\t-Server\n    22\t\t\tX-Content-Type-Options \"nosniff\"\n    23\t\t\tX-Frame-Options \"DENY\"\n    24\t\t\tReferrer-Policy \"strict-origin-when-cross-origin\"\n    25\t\t\tCross-Origin-Opener-Policy \"same-origin\"\n    26\t\t\tCross-Origin-Resource-Policy \"same-site\"\n    27\t\t\tPermissions-Policy \"accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), browsing-topics=()\"\n    28\t\t\tStrict-Transport-Security \"max-age=31536000; includeSubDomains\"\n    29\t\t}\n    30\t\t# Content-Security-Policy, generated at image build time (tools/csp.mjs).\n    31\t\timport /etc/caddy/csp.caddy\n    32\t}\n    33\t\n    34\t:{$PORT:8080} {\n    35\t\troot * /srv\n    36\t\tencode zstd gzip\n    37\t\n    38\t\timport security_headers\n    39\t\n    40\t\t# Caching. Vite fingerprints everything under /assets, so those never change.\n    41\t\theader /assets/* Cache-Control \"public, max-age=31536000, immutable\"\n    42\t\t# The manifest is the pointer to the latest bundle: always revalidate.\n    43\t\theader /data/manifest.json Cache-Control \"no-cache\"\n    44\t\t@bundle path_regexp bundle ^/data/bench_v[0-9]+\\.json$\n    45\t\theader @bundle Cache-Control \"public, max-age=3600\"\n    46\t\t# The data copy is public; let notebooks and other sites read it like the bucket.\n    47\t\theader /data/* Access-Control-Allow-Origin \"*\"\n    48\t\theader /favicon.svg Cache-Control \"public, max-age=86400\"\n    49\t\t# Everything else (index.html, SPA routes): revalidate on every load. \"?\" = only if not set above.\n    50\t\theader ?Cache-Control \"no-cache\"\n    51\t\n    52\t\thandle /healthz {\n    53\t\t\theader Cache-Control \"no-store\"\n    54\t\t\trespond \"ok\" 200\n    55\t\t}\n    56\t\n    57\t\t# Real files only: a missing asset or bundle is a 404, never index.html.\n    58\t\thandle /assets/* {\n    59\t\t\tfile_server\n    60\t\t}\n    61\t\thandle /data/* {\n    62\t\t\tfile_server\n    63\t\t}\n    64\t\n    65\t\t# SPA fallback: client-side routes (/model/<id>, /findings, ...) get index.html.\n    66\t\thandle {\n    67\t\t\ttry_files {path} /index.html\n    68\t\t\tfile_server\n    69\t\t}\n    70\t\n    71\t\thandle_errors {\n    72\t\t\timport security_headers\n    73\t\t\theader Cache-Control \"no-store\"\n    74\t\t\trespond \"{err.status_code} {err.status_text}\"\n    75\t\t}\n    76\t}\n     1\timport { defineConfig, type Plugin } from \"vite\";\n     2\timport react from \"@vitejs/plugin-react\";\n     3\timport { createReadStream, existsSync, mkdirSync, readdirSync, copyFileSync, statSync } from \"node:fs\";\n     4\timport { dirname, join, resolve } from \"node:path\";\n     5\timport { fileURLToPath } from \"node:url\";\n     6\t\n     7\tconst here = dirname(fileURLToPath(import.meta.url));\n     8\t/** The repo copy of the data bundles (../data). Served at /data/ in dev and copied to dist/data/ on build. */\n     9\tconst DATA_DIR = resolve(here, \"..\", \"data\");\n    10\t\n    11\tfunction repoData(): Plugin {\n    12\t  return {\n    13\t    name: \"tbb-repo-data\",\n    14\t    configureServer(server) {\n    15\t      server.middlewares.use(\"/data\", (req, res, next) => {\n    16\t        const name = decodeURIComponent((req.url ?? \"/\").split(\"?\")[0]).replace(/^\\/+/, \"\");\n    17\t        if (!/^[\\w.-]+\\.json$/.test(name)) return next();\n    18\t        const file = join(DATA_DIR, name);\n    19\t        if (!existsSync(file) || !statSync(file).isFile()) return next();\n    20\t        res.setHeader(\"Content-Type\", \"application/json; charset=utf-8\");\n    21\t        res.setHeader(\"Cache-Control\", \"no-cache\");\n    22\t        createReadStream(file).pipe(res);\n    23\t      });\n    24\t    },\n    25\t    writeBundle(options) {\n    26\t      const outDir = options.dir ?? resolve(here, \"dist\");\n    27\t      const target = join(outDir, \"data\");\n    28\t      mkdirSync(target, { recursive: true });\n    29\t      for (const f of readdirSync(DATA_DIR)) {\n    30\t        if (f.endsWith(\".json\")) copyFileSync(join(DATA_DIR, f), join(target, f));\n    31\t      }\n    32\t    },\n    33\t  };\n    34\t}\n    35\t\n    36\texport default defineConfig({\n    37\t  plugins: [react(), repoData()],\n    38\t  server: { port: 5173 },\n    39\t  build: { target: \"es2020\", sourcemap: false },\n    40\t});\n     1\t{\n     2\t  \"name\": \"truebasebench-site\",\n     3\t  \"private\": true,\n     4\t  \"version\": \"1.0.0\",\n     5\t  \"description\": \"True Base Bench, by Anima Labs: static site (Vite + React + TypeScript).\",\n     6\t  \"type\": \"module\",\n     7\t  \"engines\": {\n     8\t    \"node\": \">=20\"\n     9\t  },\n    10\t  \"scripts\": {\n    11\t    \"dev\": \"vite\",\n    12\t    \"build\": \"tsc --noEmit -p tsconfig.json && vite build\",\n    13\t    \"preview\": \"vite preview\",\n    14\t    \"test\": \"vitest run\",\n    15\t    \"test:watch\": \"vitest\",\n    16\t    \"typecheck\": \"tsc --noEmit -p tsconfig.json\"\n    17\t  },\n    18\t  \"dependencies\": {\n    19\t    \"@fontsource-variable/source-serif-4\": \"5.1.0\",\n    20\t    \"@fontsource/ibm-plex-mono\": \"5.1.0\",\n    21\t    \"@fontsource/ibm-plex-sans-condensed\": \"5.1.0\",\n    22\t    \"marked\": \"14.1.2\",\n    23\t    \"react\": \"18.3.1\",\n    24\t    \"react-dom\": \"18.3.1\",\n    25\t    \"react-router-dom\": \"6.26.2\"\n    26\t  },\n    27\t  \"devDependencies\": {\n    28\t    \"@types/node\": \"20.16.10\",\n    29\t    \"@types/react\": \"18.3.11\",\n    30\t    \"@types/react-dom\": \"18.3.0\",\n    31\t    \"@vitejs/plugin-react\": \"4.3.2\",\n    32\t    \"ajv\": \"8.17.1\",\n    33\t    \"typescript\": \"5.6.2\",\n    34\t    \"vite\": \"5.4.8\",\n    35\t    \"vitest\": \"2.1.2\"\n    36\t  }\n    37\t}\n     1\timport { defineConfig } from \"vitest/config\";\n     2\t\n     3\texport default defineConfig({\n     4\t  test: {\n     5\t    environment: \"node\",\n     6\t    include: [\"src/**/*.test.ts\"],\n     7\t  },\n     8\t});\n     1\t#!/usr/bin/env node\n     2\t// Writes the Content-Security-Policy header for the built site as a Caddyfile snippet.\n     3\t//\n     4\t//   node tools/csp.mjs site/dist/index.html /etc/caddy/csp.caddy\n     5\t//\n     6\t// - script-src: 'self' plus the sha256 of every inline <script> in the built index.html (the theme bootstrap),\n     7\t//   so no 'unsafe-inline' is needed for scripts.\n     8\t// - connect-src: 'self' plus the origin of VITE_DATA_BASE_URL (the OVH bucket), read from the environment.\n     9\t// - style-src keeps 'unsafe-inline' because React renders style=\"\" attributes.\n    10\timport { createHash } from \"node:crypto\";\n    11\timport { readFileSync, writeFileSync } from \"node:fs\";\n    12\t\n    13\tconst [, , htmlPath = \"site/dist/index.html\", outPath = \"-\"] = process.argv;\n    14\tconst html = readFileSync(htmlPath, \"utf8\");\n    15\t\n    16\tconst hashes = [];\n    17\tfor (const m of html.matchAll(/<script\\b([^>]*)>([\\s\\S]*?)<\\/script>/gi)) {\n    18\t  if (/\\bsrc\\s*=/.test(m[1])) continue;\n    19\t  hashes.push(`'sha256-${createHash(\"sha256\").update(m[2], \"utf8\").digest(\"base64\")}'`);\n    20\t}\n    21\t\n    22\tconst connect = [\"'self'\"];\n    23\tconst dataBase = (process.env.VITE_DATA_BASE_URL || \"\").trim();\n    24\tif (dataBase) {\n    25\t  let origin;\n    26\t  try {\n    27\t    origin = new URL(dataBase).origin;\n    28\t  } catch {\n    29\t    console.error(`csp: VITE_DATA_BASE_URL is not an absolute URL: ${dataBase}`);\n    30\t    process.exit(1);\n    31\t  }\n    32\t  if (!origin.startsWith(\"https://\") && !origin.startsWith(\"http://localhost\")) {\n    33\t    console.error(`csp: VITE_DATA_BASE_URL must be https: ${dataBase}`);\n    34\t    process.exit(1);\n    35\t  }\n    36\t  connect.push(origin);\n    37\t}\n    38\t\n    39\tconst policy = [\n    40\t  \"default-src 'self'\",\n    41\t  `script-src 'self' ${hashes.join(\" \")}`.trim(),\n    42\t  \"style-src 'self' 'unsafe-inline'\",\n    43\t  \"img-src 'self' data:\",\n    44\t  \"font-src 'self' data:\",\n    45\t  `connect-src ${connect.join(\" \")}`,\n    46\t  \"object-src 'none'\",\n    47\t  \"base-uri 'self'\",\n    48\t  \"form-action 'self'\",\n    49\t  \"frame-ancestors 'none'\",\n    50\t  \"manifest-src 'self'\",\n    51\t  \"worker-src 'self'\",\n    52\t].join(\"; \");\n    53\t\n    54\tconst snippet = `# generated by tools/csp.mjs at build time; do not edit\\nheader Content-Security-Policy \"${policy}\"\\n`;\n    55\tif (outPath === \"-\") process.stdout.write(snippet);\n    56\telse writeFileSync(outPath, snippet);\n    57\tconsole.error(`csp: ${hashes.length} inline script hash(es); connect-src ${connect.join(\" \")}`);\n     1\tname: CI\n     2\t\n     3\ton:\n     4\t  pull_request:\n     5\t  push:\n     6\t    branches: [main]\n     7\t  workflow_dispatch:\n     8\t\n     9\tpermissions:\n    10\t  contents: read\n    11\t\n    12\tconcurrency:\n    13\t  group: ci-${{ github.ref }}\n    14\t  cancel-in-progress: true\n    15\t\n    16\tjobs:\n    17\t  site:\n    18\t    name: Site (install, test, build)\n    19\t    runs-on: ubuntu-latest\n    20\t    defaults:\n    21\t      run:\n    22\t        working-directory: site\n    23\t    steps:\n    24\t      - uses: actions/checkout@v4\n    25\t      - uses: actions/setup-node@v4\n    26\t        with:\n    27\t          node-version: 20\n    28\t          cache: npm\n    29\t          cache-dependency-path: site/package-lock.json\n    30\t      - run: npm ci --no-audit --no-fund\n    31\t      - name: Validate data bundles and manifest\n    32\t        run: node ../tools/validate_data.mjs\n    33\t      - run: npm test\n    34\t      - run: npm run build\n    35\t      - name: Check build output\n    36\t        run: |\n    37\t          test -f dist/index.html\n    38\t          test -f dist/data/manifest.json\n    39\t          node ../tools/csp.mjs dist/index.html -\n    40\t\n    41\t  tools:\n    42\t    name: Data tools (Python)\n    43\t    runs-on: ubuntu-latest\n    44\t    steps:\n    45\t      - uses: actions/checkout@v4\n    46\t      - uses: actions/setup-python@v5\n    47\t        with:\n    48\t          python-version: \"3.12\"\n    49\t          cache: pip\n    50\t          cache-dependency-path: tools/requirements.txt\n    51\t      - run: pip install -r tools/requirements.txt\n    52\t      - run: python -m unittest discover -s tools/tests -v\n    53\t      - name: Upload plan (dry run, no credentials)\n    54\t        run: python tools/upload_data.py --dry-run\n    55\t\n    56\t  image:\n    57\t    name: Docker image (Railway build)\n    58\t    runs-on: ubuntu-latest\n    59\t    steps:\n    60\t      - uses: actions/checkout@v4\n    61\t      - name: Build\n    62\t        run: docker build -t truebasebench:ci .\n    63\t      - name: Smoke test\n    64\t        run: |\n    65\t          docker run -d --name tbb -p 8080:8080 truebasebench:ci\n    66\t          for i in $(seq 1 20); do curl -fsS http://127.0.0.1:8080/healthz && break; sleep 1; done\n    67\t          curl -fsS -o /dev/null http://127.0.0.1:8080/\n    68\t          curl -fsS -o /dev/null http://127.0.0.1:8080/data/manifest.json\n    69\t          # SPA fallback for client routes; real 404 for missing assets\n    70\t          curl -fsS http://127.0.0.1:8080/findings | grep -q '<div id=\"root\">'\n    71\t          test \"$(curl -s -o /dev/null -w '%{http_code}' http://127.0.0.1:8080/assets/missing.js)\" = 404\n    72\t          curl -sI http://127.0.0.1:8080/ | grep -qi '^cache-control: no-cache'\n    73\t          curl -sI http://127.0.0.1:8080/ | grep -qi '^content-security-policy:'\n    74\t      - name: Logs\n    75\t        if: always()\n    76\t        run: docker logs tbb || true\n     1\t# Keep the build context small and host-independent: the Dockerfile copies explicit paths,\n     2\t# but the whole context is still uploaded to the builder.\n     3\t.git\n     4\t**/node_modules\n     5\tsite/dist\n     6\t**/.DS_Store\n     7\t**/__pycache__\n     8\t*.log\n     9\t.env\n    10\t.env.*\n    11\t!.env.example\n     1\t{\n     2\t  \"$schema\": \"https://railway.com/railway.schema.json\",\n     3\t  \"build\": {\n     4\t    \"builder\": \"DOCKERFILE\",\n     5\t    \"dockerfilePath\": \"Dockerfile\",\n     6\t    \"watchPatterns\": [\"site/**\", \"data/**\", \"docs/**\", \"infra/caddy/**\", \"tools/csp.mjs\", \"Dockerfile\", \"railway.json\"]\n     7\t  },\n     8\t  \"deploy\": {\n     9\t    \"numReplicas\": 1,\n    10\t    \"healthcheckPath\": \"/healthz\",\n    11\t    \"healthcheckTimeout\": 30,\n    12\t    \"restartPolicyType\": \"ON_FAILURE\",\n    13\t    \"restartPolicyMaxRetries\": 5\n    14\t  }\n    15\t}\n","exit_code":0,"status":"completed"}}
