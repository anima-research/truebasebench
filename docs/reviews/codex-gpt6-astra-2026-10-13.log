{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/bin/zsh -lc \"nl -ba docs/vh_tail.py && nl -ba docs/vh_memo.py | sed -n '1,190p'\nnl -ba docs/vh_score_vllm.py | sed -n '1,270p'\nnl -ba docs/vh_lp.py | sed -n '1,240p'\"","aggregated_output":"     1\timport os, json, numpy as np\n     2\tres = \"/models/varentropy/results\"\n     3\trows = []\n     4\tfor m in sorted(os.listdir(res)):\n     5\t    d = os.path.join(res, m)\n     6\t    if m.startswith((\"smoke\", \"vsmoke\")) or not os.path.exists(os.path.join(d, \"tf_fresh.npz\")):\n     7\t        continue\n     8\t    out = {\"model\": m}\n     9\t    for tag in [\"tf\", \"tf_fresh\", \"tf_weird\"]:\n    10\t        p = os.path.join(d, tag + \".npz\")\n    11\t        if not os.path.exists(p):\n    12\t            continue\n    13\t        z = np.load(p); s = z[\"s\"].astype(np.float32); r = z[\"rank\"]; H = z[\"H\"].astype(np.float32)\n    14\t        out[tag] = {\"s>7\": float((s > 7).mean()), \"s>10\": float((s > 10).mean()), \"rank>100\": float((r > 100).mean()),\n    15\t                    \"rank>1000\": float((r > 1000).mean()), \"CE\": float(s.mean()), \"H\": float(H.mean()),\n    16\t                    \"s_p99\": float(np.percentile(s, 99)), \"gap_hiH\": float((H - s)[H > 4].mean()) if (H > 4).any() else None}\n    17\t    rows.append(out)\n    18\tprint(f\"{'model':28}{'corpus':9}{'CE':>6}{'s>7':>7}{'s>10':>7}{'rk>100':>8}{'rk>1k':>7}{'s_p99':>7}{'gap|H>4':>9}\")\n    19\tfor o in rows:\n    20\t    for tag in [\"tf_fresh\", \"tf_weird\", \"tf\"]:\n    21\t        if tag in o:\n    22\t            v = o[tag]\n    23\t            print(f\"{o['model'][:28]:28}{tag[3:] or 'pile':9}{v['CE']:6.2f}{v['s>7']:7.3f}{v['s>10']:7.3f}{v['rank>100']:8.3f}{v['rank>1000']:7.3f}{v['s_p99']:7.1f}{(v['gap_hiH'] if v['gap_hiH'] is not None else float('nan')):9.3f}\")\n    24\tjson.dump(rows, open(os.path.join(res, \"analysis\", \"tail_realised.json\"), \"w\"), indent=1)\n     1\t#!/usr/bin/env python\n     2\t\"\"\"Memorization / verbatim-run analysis on teacher-forced results.\n     3\tUsage: vh_memo.py RESULTS_DIR MODEL [MODEL ...]   (first model = reference if >1)\n     4\tReference-free per-model features: per-doc CE distribution (memorized tail), fraction of tokens inside\n     5\tlong verbatim runs (consecutive tokens with rank==0 and H<0.2), per Pile set. With a reference model,\n     6\talso the per-doc CE ratio and where the runs appear that the reference does not have.\"\"\"\n     7\timport sys, os, json\n     8\timport numpy as np\n     9\tsys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))\n    10\timport vh_analyze as A\n    11\t\n    12\t\n    13\tdef runs_mask(H, rank, doc, minlen=16, hthr=0.2):\n    14\t    \"\"\"boolean mask of tokens inside a verbatim run (>= minlen consecutive confident-correct tokens within one doc).\"\"\"\n    15\t    ok = (rank == 0) & (H < hthr)\n    16\t    out = np.zeros_like(ok)\n    17\t    n = len(ok)\n    18\t    i = 0\n    19\t    while i < n:\n    20\t        if ok[i]:\n    21\t            j = i\n    22\t            while j + 1 < n and ok[j + 1] and doc[j + 1] == doc[i]:\n    23\t                j += 1\n    24\t            if j - i + 1 >= minlen:\n    25\t                out[i:j + 1] = True\n    26\t            i = j + 1\n    27\t        else:\n    28\t            i += 1\n    29\t    return out\n    30\t\n    31\t\n    32\tdef per_doc(tf):\n    33\t    docs = np.unique(tf[\"doc\"])\n    34\t    ce = np.array([tf[\"s\"][tf[\"doc\"] == d].mean() for d in docs])\n    35\t    H = np.array([tf[\"H\"][tf[\"doc\"] == d].mean() for d in docs])\n    36\t    n = np.array([(tf[\"doc\"] == d).sum() for d in docs])\n    37\t    return docs, ce, H, n\n    38\t\n    39\t\n    40\tdef main():\n    41\t    res, names = sys.argv[1], sys.argv[2:]\n    42\t    tfs = {n: A.load_tf(os.path.join(res, n)) for n in names}\n    43\t    docset = {m[\"doc\"]: m[\"set\"] for m in tfs[names[0]][\"docs\"]}\n    44\t    print(\"=== per-model reference-free memorization features\")\n    45\t    feats = {}\n    46\t    for n, tf in tfs.items():\n    47\t        docs, ce, H, cnt = per_doc(tf)\n    48\t        med = np.median(ce)\n    49\t        rm = runs_mask(tf[\"H\"], tf[\"rank\"], tf[\"doc\"])\n    50\t        f = {\"doc_CE_median\": float(med), \"doc_CE_p10\": float(np.percentile(ce, 10)), \"doc_CE_p5\": float(np.percentile(ce, 5)),\n    51\t             \"frac_docs_CE<0.33med\": float((ce < med / 3).mean()), \"frac_docs_CE<0.5med\": float((ce < med / 2).mean()),\n    52\t             \"doc_CE_skew\": float(((ce - ce.mean()) ** 3).mean() / ce.std() ** 3),\n    53\t             \"verbatim_run_frac\": float(rm.mean()),\n    54\t             \"verbatim_run_frac_wiki\": float(rm[np.array([docset[int(d)] == \"Wikipedia (en)\" for d in tf[\"doc\"]])].mean()),\n    55\t             \"verbatim_run_frac_nocode\": float(rm[np.array([docset[int(d)] not in (\"Github\",) for d in tf[\"doc\"]])].mean())}\n    56\t        feats[n] = f\n    57\t        print(n, json.dumps({k: round(v, 4) for k, v in f.items()}))\n    58\t        tf[\"_rm\"] = rm; tf[\"_doc\"] = (docs, ce, H, cnt)\n    59\t    # per-set table\n    60\t    print(\"\\n=== per Pile set: CE / H / gap(H-CE) / verbatim-run frac, per model\")\n    61\t    sets = sorted(set(docset.values()), key=lambda s: -sum(1 for d in docset if docset[d] == s))\n    62\t    hdr = f\"{'set':22}\" + \"\".join(f\"{n[-14:]:>15}{'':>15}{'':>15}{'':>15}\" for n in names)\n    63\t    print(f\"{'':22}\" + \"\".join(f\"{'CE':>15}{'H':>15}{'gap':>15}{'runfrac':>15}\" for n in names))\n    64\t    for s in sets:\n    65\t        line = f\"{s:22}\"\n    66\t        for n in names:\n    67\t            tf = tfs[n]\n    68\t            m = np.array([docset[int(d)] == s for d in tf[\"doc\"]])\n    69\t            if m.sum() == 0:\n    70\t                line += \" \" * 60; continue\n    71\t            line += f\"{tf['s'][m].mean():15.3f}{tf['H'][m].mean():15.3f}{(tf['H'][m]-tf['s'][m]).mean():+15.3f}{tf['_rm'][m].mean():15.3f}\"\n    72\t        print(line + f\"   n={m.sum()}\")\n    73\t    if len(names) > 1:\n    74\t        ref = tfs[names[0]]\n    75\t        d0, ce0, H0, n0 = ref[\"_doc\"]\n    76\t        for n in names[1:]:\n    77\t            tf = tfs[n]\n    78\t            d1, ce1, H1, n1 = tf[\"_doc\"]\n    79\t            assert np.array_equal(d0, d1)\n    80\t            ratio = ce1 / np.maximum(ce0, 1e-3)\n    81\t            order = np.argsort(ratio)\n    82\t            print(f\"\\n=== docs where {n} CE collapsed relative to {names[0]} (CE ratio), top 15\")\n    83\t            for i in order[:15]:\n    84\t                print(f\"doc{int(d0[i]):4d} [{docset[int(d0[i])]:>18}] n={int(n0[i]):5d} CE_ref={ce0[i]:.3f} CE={ce1[i]:.3f} ratio={ratio[i]:.2f} H_ref={H0[i]:.2f} H={H1[i]:.2f}\")\n    85\t            print(f\"docs with ratio<0.5: {(ratio<0.5).sum()}  <0.7: {(ratio<0.7).sum()}  of {len(ratio)}; median ratio {np.median(ratio):.3f}\")\n    86\t            # verbatim runs present in `n` but not in ref, by set\n    87\t            ia, ib = A.align(ref, tf)\n    88\t            new = tf[\"_rm\"][ib] & ~ref[\"_rm\"][ia]\n    89\t            from collections import Counter\n    90\t            c = Counter(docset[int(d)] for d in tf[\"doc\"][ib][new])\n    91\t            print(f\"tokens in verbatim runs new in {n}: {int(new.sum())} ({new.mean()*100:.2f}% of aligned); by set: {c.most_common(8)}\")\n    92\t    json.dump(feats, open(os.path.join(res, \"analysis\", f\"memo_{'_'.join(x[-12:] for x in names)}.json\"), \"w\"), indent=1)\n    93\t\n    94\t\n    95\tif __name__ == \"__main__\":\n    96\t    main()\n     1\t#!/usr/bin/env python\n     2\t\"\"\"vLLM-backed twin of vh_score.py (same corpora, same output files) for checkpoints HF transformers\n     3\tcannot load (FP8 custom-code MoE such as MiMo-V2.5). Exact per-step statistics come from the\n     4\tVHRecorder logits processor (vh_lp.py); teacher forcing is done by replaying each document token by\n     5\ttoken with the realised token forced through the logits mask.\"\"\"\n     6\timport argparse, json, os, sys, time, glob, shutil\n     7\timport numpy as np\n     8\t\n     9\tsys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))\n    10\timport vh_score as base  # corpus helpers + log\n    11\t\n    12\t\n    13\tdef collect(tmp, prefix):\n    14\t    out = {}\n    15\t    for f in glob.glob(os.path.join(tmp, f\"{prefix}*.npz\")):\n    16\t        out[os.path.basename(f)[:-4]] = dict(np.load(f))\n    17\t    return out\n    18\t\n    19\t\n    20\tdef run_tf(llm, tok, docs, max_len, tag, tmp, sp_kwargs):\n    21\t    from vllm import SamplingParams\n    22\t    prompts, params, meta, forces = [], [], [], {}\n    23\t    for di, d in enumerate(docs):\n    24\t        ids = tok(d[\"text\"], add_special_tokens=True, truncation=True, max_length=max_len)[\"input_ids\"]\n    25\t        if len(ids) < 8:\n    26\t            continue\n    27\t        prompts.append({\"prompt_token_ids\": ids[:1]})\n    28\t        params.append(SamplingParams(max_tokens=len(ids) - 1, temperature=1.0, top_p=1.0, ignore_eos=True,\n    29\t                                     extra_args={\"vh_id\": f\"{tag}_{di:04d}\", \"vh_out\": tmp, \"force\": ids[1:]}, **sp_kwargs))\n    30\t        meta.append({\"doc\": di, \"idx\": d[\"idx\"], \"set\": d[\"set\"], \"ntok\": len(ids)}); forces[di] = ids[1:]\n    31\t    t0 = time.time()\n    32\t    outs = llm.generate(prompts, params, use_tqdm=False)\n    33\t    base.log(f\"{tag}: {len(prompts)} docs replayed in {time.time()-t0:.0f}s\")\n    34\t    rec = collect(tmp, tag + \"_\")\n    35\t    cols = {k: [] for k in [\"H\", \"V\", \"s\", \"p1\", \"top1\", \"rank\", \"tok\", \"doc\", \"pos\"]}\n    36\t    mism = 0\n    37\t    for m, o in zip(meta, outs):\n    38\t        r = rec.get(f\"{tag}_{m['doc']:04d}\")\n    39\t        if r is None:\n    40\t            continue\n    41\t        n = len(r[\"H\"])\n    42\t        gen = list(o.outputs[0].token_ids)\n    43\t        k = min(n, len(gen), len(r[\"tok\"]))\n    44\t        if gen[:k] != list(r[\"tok\"][:k]):\n    45\t            mism += 1\n    46\t        for k in [\"H\", \"V\", \"s\", \"p1\", \"top1\", \"rank\"]:\n    47\t            cols[k].append(r[k][:n])\n    48\t        cols[\"tok\"].append(np.array(forces[m[\"doc\"]][:n], np.int32))  # the forced targets (vLLM's output list can differ at the final step)\n    49\t        cols[\"doc\"].append(np.full(n, m[\"doc\"], np.int32)); cols[\"pos\"].append(np.arange(n, dtype=np.int32))\n    50\t    if mism:\n    51\t        base.log(f\"WARNING: {mism} docs where forced tokens != generated tokens\")\n    52\t    arrs = {k: np.concatenate(v) for k, v in cols.items()}\n    53\t    arrs[\"H\"], arrs[\"V\"], arrs[\"s\"], arrs[\"p1\"] = (arrs[k].astype(np.float16) for k in [\"H\", \"V\", \"s\", \"p1\"])\n    54\t    return arrs, meta\n    55\t\n    56\t\n    57\tdef names_probe_vllm(llm, tok, out_dir, names_path, args, tmp):\n    58\t    \"\"\"Surname/first-name distribution probe through vLLM: exact log P(name|frame) by forced decode of the\n    59\t    name tokens (Title + UPPER spellings, logsumexp), sampled lists via free generation. Same names.json format.\"\"\"\n    60\t    from vllm import SamplingParams\n    61\t    data = json.load(open(names_path))\n    62\t    res = {\"surnames\": {}, \"firstnames\": {}}\n    63\t    for key, prompts, ref in [(\"surnames\", base.SURNAME_PROMPTS, data[\"surnames\"]), (\"firstnames\", base.FIRSTNAME_PROMPTS, data.get(\"firstnames\", []))]:\n    64\t        if not ref:\n    65\t            continue\n    66\t        top = ref[: args.names_topk]; cands = [n for n, _ in top]; counts = [c for _, c in top]\n    67\t        ref_by_name = {n: c for n, c in ref}; ref_total = sum(c for _, c in ref)\n    68\t        for pname, prompt in prompts.items():\n    69\t            t0 = time.time()\n    70\t            pid = tok(prompt, add_special_tokens=True)[\"input_ids\"]\n    71\t            reqs, params = [], []\n    72\t            for ci, c in enumerate(cands):\n    73\t                for vi, spell in enumerate([\" \" + c, \" \" + c.upper()]):\n    74\t                    f = tok(spell, add_special_tokens=False)[\"input_ids\"]\n    75\t                    reqs.append({\"prompt_token_ids\": pid})\n    76\t                    params.append(SamplingParams(max_tokens=len(f), temperature=1.0, top_p=1.0, ignore_eos=True,\n    77\t                                                 extra_args={\"vh_id\": f\"nm_{key}_{pname}_{ci:04d}_{vi}\", \"vh_out\": tmp, \"force\": f}))\n    78\t            llm.generate(reqs, params, use_tqdm=False)\n    79\t            rec = collect(tmp, f\"nm_{key}_{pname}_\")\n    80\t            lp = np.full((len(cands), 2), -np.inf)\n    81\t            for ci in range(len(cands)):\n    82\t                for vi in range(2):\n    83\t                    r = rec.get(f\"nm_{key}_{pname}_{ci:04d}_{vi}\")\n    84\t                    if r is not None and len(r[\"s\"]):\n    85\t                        lp[ci, vi] = -float(r[\"s\"].sum())\n    86\t            lp = np.logaddexp(lp[:, 0], lp[:, 1])\n    87\t            m = base.dist_metrics(lp, counts); m[\"top5_model\"] = [(cands[i], p) for i, p in m[\"top5_model\"]]\n    88\t            m[\"logp_top50\"] = {cands[i]: round(float(lp[i]), 3) for i in np.argsort(-lp)[:50]}\n    89\t            sm = {\"n\": 0}\n    90\t            if args.names_lists > 0:\n    91\t                B = args.names_lists\n    92\t                sp = [SamplingParams(max_tokens=args.names_steps, temperature=1.0, top_p=1.0, ignore_eos=True, seed=args.seed + 7 + i,\n    93\t                                     extra_args={\"vh_id\": f\"nl_{key}_{pname}_{i:03d}\", \"vh_out\": tmp, \"force\": None}) for i in range(B)]\n    94\t                outs = llm.generate([{\"prompt_token_ids\": pid}] * B, sp, use_tqdm=False)\n    95\t                texts = [o.outputs[0].text for o in outs]\n    96\t                gen, pld = [], []\n    97\t                for t in texts:\n    98\t                    ns = base.parse_list(\"1.\" + t); gen += ns; pld.append(len(set(ns)) / max(len(ns), 1))\n    99\t                sm = base.sample_metrics(gen, ref_by_name, ref_total)\n   100\t                sm[\"within_list_distinct_frac\"] = float(np.mean(pld)); sm[\"sample_text\"] = texts[0][:600]\n   101\t                recl = collect(tmp, f\"nl_{key}_{pname}_\")\n   102\t                Hs = [r[\"H\"] for r in recl.values() if len(r[\"H\"])]\n   103\t                sm[\"mean_step_H\"] = float(np.concatenate(Hs).mean()) if Hs else None\n   104\t            res[key][pname] = {\"exact\": m, \"sampled\": sm, \"secs\": time.time() - t0}\n   105\t            base.log(f\"names[{key}/{pname}] KL(ref||m)={m['KL(ref||model)']:.3f} H_m={m['H_model']:.2f} H_ref={m['H_ref']:.2f} top10_m={m['top10_model']:.3f} mass_in_set={m['mass_in_set']:.3f} | sampled n={sm.get('n')} distinct={sm.get('distinct_frac')} junk={sm.get('junk_frac')} surprise={sm.get('mean_ref_surprise_nats')}\")\n   106\t    json.dump(res, open(os.path.join(out_dir, \"names.json\"), \"w\"), indent=1)\n   107\t    base.log(\"names probe done\")\n   108\t\n   109\t\n   110\tdef main():\n   111\t    ap = argparse.ArgumentParser()\n   112\t    ap.add_argument(\"--model\", required=True); ap.add_argument(\"--name\", default=None)\n   113\t    ap.add_argument(\"--out\", default=\"/models/varentropy/results\")\n   114\t    ap.add_argument(\"--corpus\", default=\"/models/varentropy/corpus/pile10k_sel.json\")\n   115\t    ap.add_argument(\"--n-tf\", type=int, default=400); ap.add_argument(\"--max-len\", type=int, default=2048)\n   116\t    ap.add_argument(\"--n-bos\", type=int, default=32); ap.add_argument(\"--n-openers\", type=int, default=32)\n   117\t    ap.add_argument(\"--opener-len\", type=int, default=32); ap.add_argument(\"--rollout-steps\", type=int, default=1536)\n   118\t    ap.add_argument(\"--seed\", type=int, default=1234)\n   119\t    ap.add_argument(\"--extra-corpus\", action=\"append\", default=[])\n   120\t    ap.add_argument(\"--tp\", type=int, default=8); ap.add_argument(\"--max-model-len\", type=int, default=4096)\n   121\t    ap.add_argument(\"--gpu-mem\", type=float, default=0.90); ap.add_argument(\"--max-num-seqs\", type=int, default=64)\n   122\t    ap.add_argument(\"--skip-tf\", action=\"store_true\"); ap.add_argument(\"--skip-rollouts\", action=\"store_true\")\n   123\t    ap.add_argument(\"--trust-remote-code\", action=\"store_true\")\n   124\t    ap.add_argument(\"--enforce-eager\", action=\"store_true\")\n   125\t    ap.add_argument(\"--prepend-bos\", action=\"store_true\", help=\"prepend bos_token_id when the tokenizer does not (DeepSeek V4)\")\n   126\t    ap.add_argument(\"--names-probe\", default=None); ap.add_argument(\"--names-topk\", type=int, default=2000)\n   127\t    ap.add_argument(\"--names-lists\", type=int, default=16); ap.add_argument(\"--names-steps\", type=int, default=400)\n   128\t    ap.add_argument(\"--max-num-batched-tokens\", type=int, default=None)\n   129\t    args = ap.parse_args()\n   130\t\n   131\t    from vllm import LLM, SamplingParams\n   132\t    from transformers import AutoTokenizer\n   133\t    name = args.name or os.path.basename(args.model.rstrip(\"/\"))\n   134\t    out_dir = os.path.join(args.out, name); os.makedirs(out_dir, exist_ok=True)\n   135\t    tmp = os.path.join(out_dir, \"_vllm_tmp\"); shutil.rmtree(tmp, ignore_errors=True); os.makedirs(tmp)\n   136\t    corpus = base.load_corpus(args.corpus)\n   137\t    tok = AutoTokenizer.from_pretrained(args.model, trust_remote_code=args.trust_remote_code)\n   138\t    if args.prepend_bos:\n   139\t        _orig_call = tok.__call__\n   140\t        _bos = tok.bos_token_id\n   141\t        class _Wrap:\n   142\t            def __init__(self, t): self._t = t\n   143\t            def __getattr__(self, k): return getattr(self._t, k)\n   144\t            def __call__(self, text, add_special_tokens=True, **kw):\n   145\t                out = _orig_call(text, add_special_tokens=add_special_tokens, **kw)\n   146\t                if add_special_tokens and _bos is not None and (not out[\"input_ids\"] or out[\"input_ids\"][0] != _bos):\n   147\t                    out[\"input_ids\"] = [_bos] + out[\"input_ids\"][: (kw.get(\"max_length\") or 10**9) - 1]\n   148\t                return out\n   149\t        tok = _Wrap(tok)\n   150\t        base.log(f\"prepend_bos active (bos={_bos})\")\n   151\t    t0 = time.time()\n   152\t    llm = LLM(model=args.model, tensor_parallel_size=args.tp, max_model_len=args.max_model_len, gpu_memory_utilization=args.gpu_mem,\n   153\t              max_num_seqs=args.max_num_seqs, logits_processors=[\"vh_lp:VHRecorder\"], trust_remote_code=args.trust_remote_code,\n   154\t              seed=args.seed, enable_prefix_caching=False, enforce_eager=args.enforce_eager,\n   155\t              **({\"max_num_batched_tokens\": args.max_num_batched_tokens} if args.max_num_batched_tokens else {}))\n   156\t    base.log(f\"vLLM engine up in {time.time()-t0:.0f}s\")\n   157\t    json.dump({\"args\": vars(args), \"backend\": \"vllm\", \"vocab\": tok.vocab_size, \"bos\": tok.bos_token_id, \"eos\": tok.eos_token_id,\n   158\t               \"load_s\": time.time() - t0}, open(os.path.join(out_dir, \"run.json\"), \"w\"), indent=1)\n   159\t    sp = {}\n   160\t    if not args.skip_tf:\n   161\t        arrs, meta = run_tf(llm, tok, corpus[\"tf\"][: args.n_tf], args.max_len, \"tf\", tmp, sp)\n   162\t        np.savez_compressed(os.path.join(out_dir, \"tf.npz\"), **arrs)\n   163\t        json.dump(meta, open(os.path.join(out_dir, \"tf_docs.json\"), \"w\"))\n   164\t        base.log(f\"tf done: {len(arrs['H'])} tokens; mean CE {arrs['s'].astype(np.float32).mean():.3f} H {arrs['H'].astype(np.float32).mean():.3f}\")\n   165\t    if not args.skip_rollouts:\n   166\t        start_id = tok.bos_token_id if tok.bos_token_id is not None else tok.eos_token_id\n   167\t        groups = {\"bos\": [[start_id]] * args.n_bos}\n   168\t        ops = []\n   169\t        for d in corpus[\"openers\"][: args.n_openers]:\n   170\t            ids = tok(d[\"text\"], add_special_tokens=True, truncation=True, max_length=args.opener_len)[\"input_ids\"]\n   171\t            if len(ids) == args.opener_len:\n   172\t                ops.append(ids)\n   173\t        groups[\"openers\"] = ops\n   174\t        res = {}\n   175\t        for g, prompts in groups.items():\n   176\t            params = [SamplingParams(max_tokens=args.rollout_steps, temperature=1.0, top_p=1.0, ignore_eos=True, seed=args.seed + i,\n   177\t                                     extra_args={\"vh_id\": f\"ro_{g}_{i:03d}\", \"vh_out\": tmp, \"force\": None}) for i in range(len(prompts))]\n   178\t            t0 = time.time()\n   179\t            outs = llm.generate([{\"prompt_token_ids\": p} for p in prompts], params, use_tqdm=False)\n   180\t            base.log(f\"rollouts[{g}]: {len(prompts)} x {args.rollout_steps} in {time.time()-t0:.0f}s\")\n   181\t            rec = collect(tmp, f\"ro_{g}_\")\n   182\t            B, T = len(prompts), args.rollout_steps\n   183\t            for k in [\"H\", \"V\", \"s\", \"p1\"]:\n   184\t                res[f\"{g}_{k}\"] = np.zeros((B, T), np.float16)\n   185\t            for k in [\"top1\", \"tok\"]:\n   186\t                res[f\"{g}_{k}\"] = np.zeros((B, T), np.int32)\n   187\t            for i, o in enumerate(outs):\n   188\t                r = rec.get(f\"ro_{g}_{i:03d}\")\n   189\t                gen = np.array(o.outputs[0].token_ids[:T], np.int32)\n   190\t                res[f\"{g}_tok\"][i, :len(gen)] = gen\n   191\t                if r is None:\n   192\t                    continue\n   193\t                n = min(T, len(r[\"H\"]))\n   194\t                for k in [\"H\", \"V\", \"p1\"]:\n   195\t                    res[f\"{g}_{k}\"][i, :n] = r[k][:n]\n   196\t                res[f\"{g}_top1\"][i, :n] = r[\"top1\"][:n]\n   197\t                ns = min(T, len(r[\"s\"])); res[f\"{g}_s\"][i, :ns] = r[\"s\"][:ns]\n   198\t            res[f\"{g}_prompt\"] = np.array(prompts, np.int32)\n   199\t        res[\"start_id\"] = np.array(start_id)\n   200\t        np.savez_compressed(os.path.join(out_dir, \"rollouts.npz\"), **res)\n   201\t        with open(os.path.join(out_dir, \"rollouts.jsonl\"), \"w\") as f:\n   202\t            for g in groups:\n   203\t                for i in range(res[f\"{g}_tok\"].shape[0]):\n   204\t                    f.write(json.dumps({\"group\": g, \"i\": i, \"prompt\": tok.decode(res[f\"{g}_prompt\"][i].tolist()),\n   205\t                                        \"text\": tok.decode(res[f\"{g}_tok\"][i].tolist()),\n   206\t                                        \"meanH\": float(res[f\"{g}_H\"][i].astype(np.float32).mean()),\n   207\t                                        \"meanV\": float(res[f\"{g}_V\"][i].astype(np.float32).mean())}) + \"\\n\")\n   208\t        base.log(\"rollouts done\")\n   209\t    for spec in args.extra_corpus:\n   210\t        nm, path = spec.split(\"=\", 1) if \"=\" in spec else (\"tf_wiki\", spec)\n   211\t        if os.path.exists(os.path.join(out_dir, f\"{nm}.npz\")):\n   212\t            continue\n   213\t        extra = base.load_corpus(path)\n   214\t        arrs, meta = run_tf(llm, tok, extra[\"tf\"], args.max_len, nm, tmp, sp)\n   215\t        np.savez_compressed(os.path.join(out_dir, f\"{nm}.npz\"), **arrs)\n   216\t        json.dump(meta, open(os.path.join(out_dir, f\"{nm}_docs.json\"), \"w\"))\n   217\t        base.log(f\"{nm} done: {len(arrs['H'])} tokens\")\n   218\t    if args.names_probe:\n   219\t        names_probe_vllm(llm, tok, out_dir, args.names_probe, args, tmp)\n   220\t    shutil.rmtree(tmp, ignore_errors=True)\n   221\t    base.log(\"ALL DONE\")\n   222\t\n   223\t\n   224\tif __name__ == \"__main__\":\n   225\t    main()\n     1\t\"\"\"vLLM V1 logits processor that records the exact next-token distribution statistics\n     2\t(entropy H, varentropy V, top-1 prob/id, surprisal s of the realised token, rank of a forced token)\n     3\tat every sampling step, and optionally *forces* the realised token (teacher forcing) by masking the\n     4\tlogits to the known next token. Per-request configuration arrives via SamplingParams.extra_args:\n     5\t    {\"vh_id\": \"<name>\", \"vh_out\": \"<dir>\", \"force\": [token ids...] | None}\n     6\tAt request removal the per-step arrays are written to <vh_out>/<vh_id>.npz.\n     7\t\"\"\"\n     8\timport os\n     9\timport numpy as np\n    10\timport torch\n    11\tfrom vllm.v1.sample.logits_processor import LogitsProcessor, BatchUpdate\n    12\t\n    13\t\n    14\tclass _Req:\n    15\t    __slots__ = (\"vid\", \"out\", \"force\", \"out_ids\", \"step\", \"H\", \"V\", \"p1\", \"t1\", \"s\", \"rank\", \"last_logp\")\n    16\t\n    17\t    def __init__(self, vid, out, force, out_ids):\n    18\t        self.vid, self.out, self.force, self.out_ids = vid, out, force, out_ids\n    19\t        self.step = 0\n    20\t        self.H, self.V, self.p1, self.t1, self.s, self.rank = [], [], [], [], [], []\n    21\t        self.last_logp = None  # (V,) float32 cpu tensor of the previous step (for s of a free-sampled token)\n    22\t\n    23\t\n    24\tclass VHRecorder(LogitsProcessor):\n    25\t    def __init__(self, vllm_config, device, is_pin_memory):\n    26\t        self.device = device\n    27\t        self.slots: dict[int, _Req] = {}\n    28\t        try:\n    29\t            self.rank = torch.distributed.get_rank() if torch.distributed.is_initialized() else 0\n    30\t        except Exception:\n    31\t            self.rank = 0\n    32\t\n    33\t    def is_argmax_invariant(self) -> bool:\n    34\t        return False\n    35\t\n    36\t    @classmethod\n    37\t    def validate_params(cls, params):\n    38\t        return\n    39\t\n    40\t    def _finalize(self, r: _Req):\n    41\t        # surprisal of the last free-sampled token (its logp was stored at the previous step)\n    42\t        if r.force is None and r.last_logp is not None and len(r.out_ids) >= r.step and r.step > 0:\n    43\t            tok = r.out_ids[r.step - 1]\n    44\t            if len(r.s) < r.step:\n    45\t                r.s.append(float(-r.last_logp[tok]))\n    46\t        if self.rank == 0 and r.out:\n    47\t            os.makedirs(r.out, exist_ok=True)\n    48\t            n = min(len(r.H), len(r.s)) if r.s else len(r.H)\n    49\t            np.savez(os.path.join(r.out, f\"{r.vid}.npz\"),\n    50\t                     H=np.array(r.H[:n], np.float32), V=np.array(r.V[:n], np.float32), p1=np.array(r.p1[:n], np.float32),\n    51\t                     top1=np.array(r.t1[:n], np.int32), s=np.array(r.s[:n], np.float32),\n    52\t                     rank=np.array(r.rank[:n] if r.rank else [], np.int32),\n    53\t                     tok=np.array(list(r.out_ids)[:n], np.int32), forced=np.array(r.force is not None))\n    54\t\n    55\t    def update_state(self, batch_update: BatchUpdate | None):\n    56\t        if batch_update is None:\n    57\t            return\n    58\t        # vLLM contract: process removed, then added, then moved (added/moved may reuse an index).\n    59\t        for index in batch_update.removed:\n    60\t            r = self.slots.pop(index, None)\n    61\t            if r is not None:\n    62\t                self._finalize(r)\n    63\t        for index, params, prompt_tok_ids, output_tok_ids in batch_update.added:\n    64\t            ea = getattr(params, \"extra_args\", None) or {}\n    65\t            old = self.slots.pop(index, None)\n    66\t            if old is not None:\n    67\t                self._finalize(old)\n    68\t            if \"vh_id\" in ea:\n    69\t                self.slots[index] = _Req(ea[\"vh_id\"], ea.get(\"vh_out\"), ea.get(\"force\"), output_tok_ids)\n    70\t        for a, b, direction in batch_update.moved:\n    71\t            ra, rb = self.slots.pop(a, None), self.slots.pop(b, None)\n    72\t            if str(direction).endswith(\"SWAP\"):\n    73\t                if ra is not None:\n    74\t                    self.slots[b] = ra\n    75\t                if rb is not None:\n    76\t                    self.slots[a] = rb\n    77\t            else:\n    78\t                if rb is not None:\n    79\t                    self._finalize(rb)\n    80\t                if ra is not None:\n    81\t                    self.slots[b] = ra\n    82\t\n    83\t    def apply(self, logits: torch.Tensor) -> torch.Tensor:\n    84\t        if not self.slots:\n    85\t            return logits\n    86\t        idx = sorted(i for i in self.slots if i < logits.shape[0])\n    87\t        if not idx:\n    88\t            return logits\n    89\t        rows = torch.tensor(idx, device=logits.device)\n    90\t        lg = logits[rows].float()\n    91\t        logp = torch.log_softmax(lg, dim=-1)\n    92\t        p = logp.exp()\n    93\t        H = -(p * logp).sum(-1)\n    94\t        V = (p * (logp + H[:, None]) ** 2).sum(-1)\n    95\t        p1, t1 = p.max(-1)\n    96\t        Hc, Vc, p1c, t1c = H.cpu(), V.cpu(), p1.cpu(), t1.cpu()\n    97\t        logp_cpu = None\n    98\t        forced_rows, forced_toks = [], []\n    99\t        for k, i in enumerate(idx):\n   100\t            r = self.slots[i]\n   101\t            # surprisal of the token sampled at the previous step (free rows)\n   102\t            if r.force is None and r.last_logp is not None and len(r.out_ids) >= r.step and r.step > 0:\n   103\t                r.s.append(float(-r.last_logp[r.out_ids[r.step - 1]]))\n   104\t            r.H.append(float(Hc[k])); r.V.append(float(Vc[k])); r.p1.append(float(p1c[k])); r.t1.append(int(t1c[k]))\n   105\t            if r.force is not None:\n   106\t                if r.step < len(r.force):\n   107\t                    t = int(r.force[r.step])\n   108\t                    r.s.append(float(-logp[k, t]))\n   109\t                    r.rank.append(int((lg[k] > lg[k, t]).sum()))\n   110\t                    forced_rows.append(i); forced_toks.append(t)\n   111\t            else:\n   112\t                if logp_cpu is None:\n   113\t                    logp_cpu = logp.cpu()\n   114\t                r.last_logp = logp_cpu[k]\n   115\t            r.step += 1\n   116\t        if forced_rows:\n   117\t            fr = torch.tensor(forced_rows, device=logits.device)\n   118\t            ft = torch.tensor(forced_toks, device=logits.device)\n   119\t            masked = torch.full_like(logits[fr], float(\"-inf\"))\n   120\t            masked[torch.arange(len(forced_rows), device=logits.device), ft] = 0.0\n   121\t            logits[fr] = masked\n   122\t        return logits\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/zsh -lc \"PYTHONDONTWRITEBYTECODE=1 python3 -c 'import json,sys,math,collections\nsys.path.insert(0,\\\"docs\\\")\nimport vh_truebase\nb=json.load(open(\\\"data/bench_v3.json\\\")); ms=b[\\\"models\\\"]\nmaxerr=0; bad=[]\nfor m in ms:\n r=vh_truebase.score(m[\\\"fingerprint\\\"]); maxerr=max(maxerr,abs(r[\\\"overall\\\"]-m[\\\"score\\\"]))\n for k in vh_truebase.RAMPS:\n  s=m[\\\"subscores\\\"][k]\n  if abs(r[k][0]-s[\\\"score\\\"])>1e-12 or r[k][1]\"'!=s[\"value\"] or r[k][2]!=s[\"source\"]: bad.append((m[\"id\"],k,r[k],s))\nprint(\"recomputed overall max error\",maxerr,\"subscore/value/source mismatches\",bad)\nprint(\"stages\",collections.Counter(m[\"stage\"] for m in ms),\"families\",len(set(m[\"family\"] for m in ms)))\nfor m in ms:\n f=m[\"fingerprint\"];s=m.get(\"surnames\") or {};rel=(m.get(\"selfboot\") or {}).get(\"reliability\") or {};t=(m.get(\"tail\") or {}).get(\"tf_fresh\") or {}\n print(json.dumps({\"id\":m[\"id\"],\"domain_min\":f.get(\"F_gap_domain_min\"),\"domain_CE_n\":len([k for k in f if k.startswith(\"F_CE_\")]),\"fresh_tokens\":sum(r[2] for r in rel.get(\"bins\",[])),\"inset\":s.get(\"inset\"),\"top10_desc\":s.get(\"top10_desc\"),\"smith\":s.get(\"smith_plain\"),\"tail10\":t.get(\"s>10\"),\"hiH\":t.get(\"gap_hiH\"),\"lex_n\":((m.get(\"selfboot\") or {}).get(\"lexical\") or {}).get(\"n_texts\")}))\nprint(\"absent optional fields\", {k:sum(k not in m for m in ms) for k in [\"params\",\"revision\",\"run\",\"corpus_hash\"]})\nprint(\"ref keys\",list(b[\"reference\"]))\nprint(\"missing blocks\",{k:[m[\"id\"] for m in ms if not m.get(k)] for k in [\"surnames\",\"weird\",\"selfboot\",\"tail\"]})\nfor m in ms:\n if m[\"stage\"]!=\"post-trained\": continue\n prev=sorted([x for x in ms if x[\"family\"]==m[\"family\"] and x[\"order\"]<m[\"order\"] and x[\"stage\"]!=\"post-trained\"],key=lambda x:x[\"order\"])\n if not prev: continue\n a=prev[-1];t=a[\"tail\"][\"tf_fresh\"];u=m[\"tail\"][\"tf_fresh\"]\n print(\"PAIR\",a[\"id\"],m[\"id\"],\"tailrise\",u[\"s>10\"]/t[\"s>10\"]-1,\"hiHdelta\",u[\"gap_hiH\"]-t[\"gap_hiH\"],\"markerchange\",m[\"fingerprint\"][\"roll_instr_marker_rate\"]-a[\"fingerprint\"][\"roll_instr_marker_rate\"])\nfor k,n in [(0,32),(2,32),(7,32),(10,32),(15,32)]:\n z=1.9599639845;p=k/n;d=1+z*z/n;c=(p+z*z/(2*n))/d;h=z*math.sqrt(p*(1-p)/n+z*z/(4*n*n))/d;print(\"Wilson\",k,n,c-h,c+h)'\"'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
