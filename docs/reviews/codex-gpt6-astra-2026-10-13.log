  124\t        \"selfboot\": {\n   125\t          \"oneOf\": [\n   126\t            { \"type\": \"null\" },\n   127\t            {\n   128\t              \"type\": \"object\",\n   129\t              \"properties\": {\n   130\t                \"reliability\": {\n   131\t                  \"oneOf\": [\n   132\t                    { \"type\": \"null\" },\n   133\t                    {\n   134\t                      \"type\": \"object\",\n   135\t                      \"properties\": {\n   136\t                        \"ECE\": { \"$ref\": \"#/definitions/numOrNull\" },\n   137\t                        \"top1_acc\": { \"$ref\": \"#/definitions/numOrNull\" },\n   138\t                        \"mean_p1\": { \"$ref\": \"#/definitions/numOrNull\" },\n   139\t                        \"bins\": { \"type\": [\"array\", \"null\"], \"items\": { \"$ref\": \"#/definitions/bin\" } }\n   140\t                      }\n   141\t                    }\n   142\t                  ]\n   143\t                },\n   144\t                \"lexical\": { \"oneOf\": [{ \"type\": \"null\" }, { \"$ref\": \"#/definitions/numMap\" }] }\n   145\t              }\n   146\t            }\n   147\t          ]\n   148\t        },\n   149\t        \"tail\": {\n   150\t          \"oneOf\": [\n   151\t            { \"type\": \"null\" },\n   152\t            {\n   153\t              \"type\": \"object\",\n   154\t              \"properties\": {\n   155\t                \"tf\": { \"$ref\": \"#/definitions/tailPass\" },\n   156\t                \"tf_fresh\": { \"$ref\": \"#/definitions/tailPass\" },\n   157\t                \"tf_weird\": { \"$ref\": \"#/definitions/tailPass\" }\n   158\t              },\n   159\t              \"additionalProperties\": { \"$ref\": \"#/definitions/tailPass\" }\n   160\t            }\n   161\t          ]\n   162\t        },\n   163\t        \"params\": {\n   164\t          \"oneOf\": [\n   165\t            { \"type\": \"null\" },\n   166\t            {\n   167\t              \"type\": \"object\",\n   168\t              \"properties\": { \"total_b\": { \"$ref\": \"#/definitions/numOrNull\" }, \"active_b\": { \"$ref\": \"#/definitions/numOrNull\" } }\n   169\t            }\n   170\t          ]\n   171\t        }\n   172\t      }\n   173\t    }\n   174\t  }\n   175\t}\n     1\t{\n     2\t  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n     3\t  \"title\": \"True Base Bench manifest\",\n     4\t  \"type\": \"object\",\n     5\t  \"required\": [\"bundles\"],\n     6\t  \"properties\": {\n     7\t    \"manifest_version\": { \"type\": \"integer\" },\n     8\t    \"latest\": { \"type\": \"string\" },\n     9\t    \"bundles\": {\n    10\t      \"type\": \"array\",\n    11\t      \"minItems\": 1,\n    12\t      \"items\": {\n    13\t        \"oneOf\": [\n    14\t          { \"type\": \"string\", \"pattern\": \"^bench_v\\\\d+\\\\.json$\" },\n    15\t          {\n    16\t            \"type\": \"object\",\n    17\t            \"required\": [\"file\"],\n    18\t            \"properties\": {\n    19\t              \"file\": { \"type\": \"string\", \"pattern\": \"^bench_v\\\\d+\\\\.json$\" },\n    20\t              \"schema_version\": { \"type\": \"integer\" },\n    21\t              \"generated\": { \"type\": \"string\" },\n    22\t              \"n_models\": { \"type\": \"integer\" }\n    23\t            }\n    24\t          }\n    25\t        ]\n    26\t      }\n    27\t    }\n    28\t  }\n    29\t}\n   580\t                </button>\n   581\t              </div>\n   582\t              <Fingerprint model={model} compare={compare} />\n   583\t            </details>\n   584\t          </Section>\n   585\t        </div>\n   586\t      </div>\n   587\t    </div>\n   588\t  );\n   589\t}\n   590\t\n   591\t/**\n   592\t * smith_plain is recorded only when Smith is the model's most likely first name under the plain frame\n   593\t * (docs/vh_names_table.py), so a null there is a result, not a missing measurement.\n   594\t */\n   595\texport const SMITH_NOT_FIRST = \"Smith was not the most likely first name under the plain frame, so p(Smith) as item 1 was not recorded\";\n   596\tfunction nullMeaning(key: string): { nullText?: string; nullTitle?: string } {\n   597\t  return key === \"smith_plain\" ? { nullText: \"not 1st\", nullTitle: SMITH_NOT_FIRST } : {};\n   598\t}\n   599\t\n   600\tfunction SurnameStats({ model, compare }: { model: Model; compare: Model[] }) {\n   601\t  const bundle = useBundle();\n   602\t  const rows: { label: string; key: string; kind: Fmt; ref?: { path: string; kind: Fmt } }[] = [\n   603\t    { label: \"KL(Census‖model), few-shot\", key: \"KL_few\", kind: \"kl\" },\n   604\t    { label: \"KL(Census‖model), described\", key: \"KL_desc\", kind: \"kl\" },\n   605\t    { label: \"top-10 mass, few-shot\", key: \"top10_few\", kind: \"pct\", ref: { path: \"top10_r\", kind: \"pct\" } },\n   606\t    { label: \"top-10 mass, described\", key: \"top10_desc\", kind: \"pct\", ref: { path: \"top10_r\", kind: \"pct\" } },\n   607\t    { label: \"p(Smith) as item 1, plain frame (when Smith is the top name)\", key: \"smith_plain\", kind: \"pct\" },\n   608\t    { label: \"sampled: junk share (not a Census surname)\", key: \"junk\", kind: \"pct\" },\n   609\t    { label: \"sampled: distinct share\", key: \"distinct\", kind: \"pct\" },\n   610\t    { label: \"sampled: mean −log p_Census\", key: \"surpr\", kind: \"nats\" },\n   611\t  ];\n   612\t  return (\n   613\t    <div className=\"tbl-scroll\">\n   614\t      <table className=\"tbl\">\n   615\t        <caption>\n   616\t          Surname test. Census entropy over the same set: <Num path=\"reference.census_entropy_top2000\" fmt=\"nats\" />; Census self-entropy (all names):{\" \"}\n   617\t          <Num path=\"reference.census_self_entropy_all\" fmt=\"nats1\" />.\n   618\t        </caption>\n   619\t        <thead>\n   620\t          <tr>\n   621\t            <th scope=\"col\">statistic</th>\n   622\t            <th scope=\"col\" className=\"n\">\n   623\t              {model.label}\n   624\t            </th>\n   625\t            {compare.map((c) => (\n   626\t              <th key={c.id} scope=\"col\" className=\"n\">\n   627\t                {c.label}\n   628\t              </th>\n   629\t            ))}\n   630\t            <th scope=\"col\" className=\"n\">\n   631\t              Census\n   632\t            </th>\n   633\t          </tr>\n   634\t        </thead>\n   635\t        <tbody>\n   636\t          {rows.map((r) => (\n   637\t            <tr key={r.key}>\n   638\t              <th scope=\"row\" style={{ fontWeight: 400, background: \"none\" }}>\n   382\t    f5: (\n   383\t      <p>\n   384\t        Under a verbal description (“random”, “in proportion to the Census”), every checkpoint puts more mass on the top ten names than the Census does; post-training\n   385\t        sharpens that into recitation in {f5.sharpenPairs.length} of the base → post pairs with surname data. “Clean bases” here means base checkpoints with an overall\n   386\t        score of at least <Def name=\"CLEAN_BASE_MIN_OVERALL\" f=\"score\" />:{\" \"}\n   387\t        {f5.clean\n   388\t          .filter((m) => m.stage === \"base\")\n   389\t          .map((m) => `${m.family} ${m.label}`)\n   390\t          .join(\", \") || \"none in this bundle\"}\n   391\t        .\n   392\t      </p>\n   393\t    ),\n   394\t    f6: (\n   395\t      <p>\n   396\t        Each post-trained rung is paired with the nearest preceding rung of its family that is not post-trained. The rate range covers the {f6.rateSupport.length} of{\" \"}\n   397\t        {f6.pairs.length} pairs where the rise is at least <Def name=\"F6_RATE_SUPPORT\" f=\"pct\" />\n   398\t        {f6.rateExceptions.length > 0 && (\n   399\t          <>\n   400\t            {\" \"}\n   401\t            (smaller:{\" \"}\n   402\t            {joinList(\n   403\t              f6.rateExceptions.map((p) => (\n   404\t                <span key={p.post.id}>\n   405\t                  {p.post.family} {p.post.label}{\" \"}\n   406\t                  <Num path={`${path(p.post, 'tail.tf_fresh[\"s>10\"]')} / ${path(p.base, 'tail.tf_fresh[\"s>10\"]')} − 1`} value={p.rise} fmt=\"pctSigned\" derived=\"relative change\" />\n   407\t                </span>\n   408\t              )),\n   409\t            )}\n   410\t            )\n   411\t          </>\n   412\t        )}\n   413\t        ; the gap range covers the {f6.gapSupport.length} pairs whose gap at H &gt; 4 falls by more than <Def name=\"F6_GAP_SUPPORT\" f=\"nats\" />.\n   414\t      </p>\n   415\t    ),\n   416\t  };\n   417\t\n   418\t  // ---------- plates, by the slot names used in content/findings.md ----------\n   419\t  const plates: Record<FindingsPlate, () => ReactNode> = {\n   420\t    \"ladder-calib\": () =>\n   421\t      f1.family ? (\n   422\t        <Plate\n   423\t          label={`Plate F1a · Calibration gap along the ${f1.family} ladder`}\n","exit_code":0,"status":"completed"}}
