26\t          \"—\"\n   327\t        )}\n   328\t        {f6.baseHiExceptions.length > 0 && (\n   329\t          <>\n   330\t            ; except{\" \"}\n   331\t            {joinList(\n   332\t              f6.baseHiExceptions.map((x) => (\n   333\t                <span key={x.model.id}>\n   334\t                  {x.model.family} {x.model.label}, <N m={x.model} k=\"tail.tf_fresh.gap_hiH\" f=\"signed\" />\n   335\t                </span>\n   336\t              )),\n   337\t              \"; \",\n   338\t            )}\n   339\t          </>\n   340\t        )}\n   341\t        ).\n   342\t      </>\n   343\t    ),\n   344\t  };\n   345\t  const checks: Record<string, Record<string, Check>> = { f1: f1.checks, f2: f2.checks, f3: f3.checks, f4: f4.checks, f5: f5.checks, f6: f6.checks };\n   346\t  const readoffs: Record<string, ReadOff[]> = { f1: r1, f2: r2, f3: r3, f4: r4, f5: r5, f6: r6 };\n   347\t\n   348\t  // ---------- computed detail paragraphs ----------\n   349\t  const details: Record<string, ReactNode> = {\n   350\t    f1: (\n   351\t      <p>\n   352\t        The steps in the claim are the last rung of each stage, then each post-training stage in order ({f1.steps.map((m) => m.label).join(\" → \")}); inside a stage, rises\n   353\t        up to <Def name=\"STAGE_TOL\" f=\"nats\" /> are tolerated. The most negative per-domain gap of any pre-anneal checkpoint is{\" \"}\n   354\t        {f1.preDomainMin.length ? <N m={f1.preDomainMin.reduce((a, b) => (b.value < a.value ? b : a)).model} k=\"fingerprint.F_gap_domain_min\" f=\"gap\" /> : \"—\"}.\n   355\t      </p>\n   356\t    ),\n   357\t    f2: (\n   358\t      <p>\n   359\t        The memo score reads recitation of the anneal mix (verbatim runs of at least <Num path=\"method.RUN_MIN_LEN\" value={RUN_MIN_LEN} fmt=\"count\" def /> confident,\n   360\t        correct tokens); the prior score reads instruction-shaped text in samples from a bare BOS token. One anneal moved the first and not the second; the other did\n   361\t        the opposite.\n   362\t      </p>\n   363\t    ),\n   364\t    f3: (\n   365\t      <p>\n   366\t        On the prior axis the student still looks like a base: its instruction-marker rate is{\" \"}\n   367\t        {f3.student ? <N m={f3.student} k=\"fingerprint.roll_instr_marker_rate\" f=\"pct\" /> : \"—\"}\n   368\t        {f3.studentPost && (\n   369\t          <>\n   370\t            , against <N m={f3.studentPost} k=\"fingerprint.roll_instr_marker_rate\" f=\"pct\" /> for its instruction-tuned sibling ({f3.studentPost.label})\n   371\t          </>\n   372\t        )}\n   373\t        . Where it is uncertain (H &gt; 4) its gap is {f3.student ? <N m={f3.student} k=\"tail.tf_fresh.gap_hiH\" f=\"gap\" /> : \"—\"}\n   374\t        {f3.studentPost && (\n   375\t          <>\n   376\t            , against <N m={f3.studentPost} k=\"tail.tf_fresh.gap_hiH\" f=\"gap\" /> for the sibling\n   377\t          </>\n   378\t        )}\n   379\t        .\n   380\t      </p>\n   381\t    ),\n   382\t    f5: (\n   383\t      <p>\n   384\t        Under a verbal description (“random”, “in proportion to the Census”), every checkpoint puts more mass on the top ten names than the Census does; post-training\n   385\t        sharpens that into recitation in {f5.sharpenPairs.length} of the base → post pairs with surname data. “Clean bases” here means base checkpoints with an overall\n   386\t        score of at least <Def name=\"CLEAN_BASE_MIN_OVERALL\" f=\"score\" />:{\" \"}\n   387\t        {f5.clean\n   388\t          .filter((m) => m.stage === \"base\")\n   389\t          .map((m) => `${m.family} ${m.label}`)\n   390\t          .join(\", \") || \"none in this bundle\"}\n   391\t        .\n   392\t      </p>\n   393\t    ),\n   394\t    f6: (\n   395\t      <p>\n   396\t        Each post-trained rung is paired with the nearest preceding rung of its family that is not post-trained. The rate range covers the {f6.rateSupport.length} of{\" \"}\n   397\t        {f6.pairs.length} pairs where the rise is at least <Def name=\"F6_RATE_SUPPORT\" f=\"pct\" />\n   398\t        {f6.rateExceptions.length > 0 && (\n   399\t          <>\n   400\t            {\" \"}\n   401\t            (smaller:{\" \"}\n   402\t            {joinList(\n   403\t              f6.rateExceptions.map((p) => (\n   404\t                <span key={p.post.id}>\n   405\t                  {p.post.family} {p.post.label}{\" \"}\n   406\t                  <Num path={`${path(p.post, 'tail.tf_fresh[\"s>10\"]')} / ${path(p.base, 'tail.tf_fresh[\"s>10\"]')} − 1`} value={p.rise} fmt=\"pctSigned\" derived=\"relative change\" />\n   407\t                </span>\n   408\t              )),\n   409\t            )}\n   410\t            )\n   411\t          </>\n   412\t        )}\n   413\t        ; the gap range covers the {f6.gapSupport.length} pairs whose gap at H &gt; 4 falls by more than <Def name=\"F6_GAP_SUPPORT\" f=\"nats\" />.\n   414\t      </p>\n   415\t    ),\n   416\t  };\n   417\t\n   418\t  // ---------- plates, by the slot names used in content/findings.md ----------\n   419\t  const plates: Record<FindingsPlate, () => ReactNode> = {\n   420\t    \"ladder-calib\": () =>\n   421\t      f1.family ? (\n   422\t        <Plate\n   423\t          label={`Plate F1a · Calibration gap along the ${f1.family} ladder`}\n   424\t          caption=\"Linear axis; the shaded band is ± the widest pre-anneal gap. The lens repeats the region near zero on its own linear scale; rungs outside the lens are hollow and marked with an arrow.\"\n   425\t          sources={[`models[family=${f1.family}].fingerprint.F_calib_gap`]}\n   426\t          data={{\n   427\t            columns: [\"rung\", \"stage\", \"F_calib_gap\"],\n   428\t            numeric: [false, false, true],\n   429\t            rows: famRungs.map((m) => [m.label, m.stage, fmt(fp(m, \"F_calib_gap\"), \"gap\")]),\n   430\t          }}\n   431\t        >\n   432\t          <LadderChart rungs={famRungs} metric={gapMetric} domain={f1Domain} lens={[-0.12, 0.04]} height={220} />\n   433\t        </Plate>\n   434\t      ) : null,\n   435\t    \"ladder-calib-families\": () => (\n   436\t      <Plate\n   437\t        label=\"Plate F1b · Calibration gap, every family with two or more rungs\"\n   438\t        caption=\"Shared linear y scale across panels; ladder order left to right; parallel releases share a column.\"\n   439\t        sources={[\"models[*].fingerprint.F_calib_gap\"]}\n   440\t      >\n   441\t        <LadderSmallMultiples bundle={bundle} metric={gapMetric} />\n   442\t      </Plate>\n   443\t    ),\n   444\t    \"anneal-profiles\": () => (\n   445\t      <Plate\n   446\t        label=\"Plate F2a · Sub-score profiles across rungs\"\n   447\t        caption=\"Calib solid, spread dashed, memo dotted, prior dash-dot; each line is labelled at its right end.\"\n   448\t        sources={[\"models[*].subscores.{calib,spread,memo,prior}.score\"]}\n   449\t      >\n   450\t        <div className=\"grid-2\">\n   451\t          {profileFams.map((f) => (\n   452\t            <div key={f} className=\"cell-plate\">\n   453\t              <h3>{f}</h3>\n   454\t              <ProfileChart rungs={ladder(bundle, f)} />\n   455\t            </div>\n   456\t          ))}\n   457\t        </div>\n   458\t      </Plate>\n   459\t    ),\n   460\t    \"subscore-matrix\": () => (\n   461\t      <Plate label=\"Plate F2b · Sub-score comb, anneal and base checkpoints\" sources={[\"models[stage∈{anneal,base}].subscores\"]}>\n   462\t        <CombMatrix models={bundle.models.filter((m) => m.stage === \"anneal\" || m.stage === \"base\").sort((a, b) => (b.score ?? 0) - (a.score ?? 0))} />\n   463\t      </Plate>\n   464\t    ),\n   465\t    \"gap-prior\": () => (\n   466\t      <Plate\n   467\t        label=\"Plate F3 · Calibration gap against instruction-shaped prior\"\n   468\t        caption=\"Every checkpoint as its stage glyph. The distilled base is highlighted and labelled; the arrow joins it to its post-trained sibling.\"\n   469\t        sources={[\"models[*].fingerprint.F_calib_gap\", \"models[*].fingerprint.roll_instr_marker_rate\"]}\n   470\t      >\n   471\t        <GapPriorScatter bundle={bundle} label={f3.student} arrowTo={f3.studentPost} />\n   472\t      </Plate>\n   473\t    ),\n   474\t    \"collapse-strip\": () => (\n   475\t      <div className=\"grid-2\">\n   476\t        <Plate label=\"Plate F4a · Near-deterministic own-sample steps\" sources={['models[*].fingerprint[\"roll_frac_H<0.1\"]']}>\n   477\t          <StageDotStrip\n   478\t            bundle={bundle}\n   479\t            value={(m) => fp(m, \"roll_frac_H<0.1\")}\n   480\t            valuePath={(m) => path(m, 'fingerprint[\"roll_frac_H<0.1\"]')}\n   481\t            fmtKind=\"pct\"\n   482\t            axisTitle=\"share of own-sample steps with H < 0.1\"\n   483\t            labelIds={f4.family.map((m) => m.id)}\n   484\t            joinIds={f4.family.map((m) => m.id)}\n   485\t          />\n   486\t        </Plate>\n   487\t        <Plate label=\"Plate F4b · Late 8-gram repetition\" sources={[\"models[*].fingerprint.roll_rep8_q4\"]}>\n   488\t          <StageDotStrip\n   489\t            bundle={bundle}\n   490\t            value={(m) => fp(m, \"roll_rep8_q4\")}\n   491\t            valuePath={(m) => path(m, \"fingerprint.roll_rep8_q4\")}\n   492\t            fmtKind=\"pct\"\n   493\t            axisTitle=\"repeated 8-grams, last quarter of samples\"\n   494\t            labelIds={f4.family.map((m) => m.id)}\n   495\t            joinIds={f4.family.map((m) => m.id)}\n   496\t          />\n   497\t        </Plate>\n   498\t      </div>\n   499\t    ),\n   500\t    \"surname-kl\": () => (\n   501\t      <Plate\n   502\t        label=\"Plate F5a · KL(Census‖model): described (hollow) and few-shot (filled)\"\n   503\t        caption=\"Log axis with labelled decades. Rows grouped by stage, sorted by few-shot KL.\"\n   504\t        sources={[\"models[*].surnames.KL_few\", \"models[*].surnames.KL_desc\"]}\n   505\t      >\n   506\t        <KLDumbbells bundle={bundle} />\n   507\t      </Plate>\n   508\t    ),\n   509\t    \"ladder-surname-kl\": () =>\n   510\t      f1.family ? (\n   245\t              </span>\n   246\t            </div>\n   247\t            <p className=\"small ink3\" style={{ marginTop: 6 }}>\n   248\t              1 = indistinguishable from a pre-anneal checkpoint; higher is not “better”.\n   249\t            </p>\n   250\t            <ul className=\"chiprow\" aria-label=\"Sections\">\n   251\t              {SECTIONS.map((x) => (\n   252\t                <li key={x.id}>\n   253\t                  <a href={`#${x.id}`} aria-current={active === x.id ? \"true\" : undefined}>\n   254\t                    §{x.n} {x.title}\n   255\t                  </a>\n   256\t                </li>\n   257\t              ))}\n   258\t            </ul>\n   259\t          </header>\n   260\t\n   261\t          <Plate label={`Plate M1 · ${model.family} ladder`} caption=\"Rungs in ladder order; parallel releases stack. This checkpoint sits on the highlighted band.\" sources={[\"models[*].order\", \"models[*].score\"]}>\n   262\t            <SiblingRail bundle={bundle} model={model} />\n   263\t          </Plate>\n   264\t\n   265\t          <div className=\"compare-row\" role=\"group\" aria-label=\"Compare with\">\n   266\t            <span className=\"ink2\">Compare with</span>\n   267\t            {compare.map((c) => (\n   268\t              <span key={c.id} className=\"compare-chip\">\n   269\t                <Glyph stage={c.stage} hollow /> {c.family === model.family ? c.label : `${c.family} · ${c.label}`}\n   270\t                <button type=\"button\" aria-label={`Remove ${c.label} from comparison`} onClick={() => setCompare(compare.filter((x) => x.id !== c.id))}>\n   271\t                  ×\n   272\t                </button>\n   273\t              </span>\n   274\t            ))}\n   275\t            {compare.length < 3 && (\n   276\t              <ModelCombo models={bundle.models.filter((m) => m.id !== model.id && !compare.some((c) => c.id === m.id))} onPick={(m) => setCompare([...compare, m])} />\n   277\t            )}\n   278\t            {sp.get(\"compare\") !== null && (\n   279\t              <button\n   280\t                type=\"button\"\n   281\t                className=\"linkbtn small\"\n   282\t                onClick={() => {\n   283\t                  const n = new URLSearchParams(sp);\n   284\t                  n.delete(\"compare\");\n   285\t                  setSp(n, { replace: true });\n   286\t                }}\n   287\t              >\n   288\t                reset to default\n   289\t              </button>\n   290\t            )}\n   291\t          </div>\n   292\t          <StageLegend stages={Array.from(new Set(both.map((m) => m.stage)))} hollowNote={compare.length ? \"hollow = compare model\" : undefined} />\n   293\t\n   294\t          {/* §1 */}\n   295\t          <Section {...SECTIONS[0]}>\n   296\t            <Plate\n   297\t              label=\"Plate M2 · Raw features on their ramps\"\n   298\t              caption=\"Each sub-score is a clipped linear ramp between a true-base anchor (1) and a post-trained anchor (0). Shaded zones are clipped. Hollow glyphs on the x axis are compare models.\"\n   299\t              sources={SUB_KEYS.map((k) => path(model, `subscores.${k}`))}\n   300\t              data={{\n   301\t                columns: [\"sub-score\", \"feature (source)\", \"value\", \"score\", ...compare.map((c) => c.label)],\n   302\t                numeric: [false, false, true, true, ...compare.map(() => true)],\n   303\t                rows: SUB_KEYS.map((k) => [\n   304\t                  SUB_META[k].name,\n   305\t                  model.subscores?.[k]?.source ?? \"—\",\n   306\t                  fmtNum(model.subscores?.[k]?.value ?? null, \"raw\"),\n   307\t                  fmtNum(model.subscores?.[k]?.score ?? null, \"score\"),\n   308\t                  ...compare.map((c) => fmtNum(c.subscores?.[k]?.score ?? null, \"score\")),\n   309\t                ]),\n   310\t              }}\n   311\t            >\n   312\t              <div className=\"ramps-grid\">\n   313\t                {SUB_KEYS.map((k) => {\n   314\t                  const src = model.subscores?.[k]?.source;\n   315\t                  return (\n   316\t                    <div key={k}>\n   317\t                      <h3 style={{ fontFamily: \"var(--f-sans)\", fontSize: 13, display: \"flex\", gap: 8, alignItems: \"center\", flexWrap: \"wrap\" }}>\n   318\t                        {SUB_META[k].name}\n   319\t                        {src && (\n   320\t                          <span className=\"src-chip\" title=\"subscores.source\">\n   321\t                            {src}\n   322\t                            {src !== SUB_META[k].feature ? (k === \"calib\" ? \" (Pile fallback)\" : \" (fallback)\") : \"\"}\n   323\t                          </span>\n   324\t                        )}\n   325\t                      </h3>\n   326\t                      {model.subscores?.[k]?.score === null || !model.subscores?.[k] ? (\n   327\t                        <NullPlate>Not measured for this checkpoint; the overall is the mean of the {nAvail} available.</NullPlate>\n   328\t                      ) : (\n   329\t                        <TransferPlot k={k} model={model} compare={compare} width={300} height={64} />\n   330\t                      )}\n   331\t                    </div>\n   332\t                  );\n   333\t                })}\n   334\t              </div>\n   335\t              <p className=\"arith\">\n   336\t                ({arith.parts.map((p) => (p === null ? \"—\" : fmtNum(p, \"score\"))).join(\" + \")}) / {arith.n} = {fmtNum(arith.mean, \"score\")}\n   337\t                {diff !== null && Math.abs(diff) <= 1e-9 ? <span className=\"ink3\"> · matches bundle score</span> : null}\n   338\t              </p>\n   339\t              {diff !== null && Math.abs(diff) > 1e-9 && <DataNote>recomputed differs from the bundle score by {fmt(diff, \"raw\")}.</DataNote>}\n   340\t            </Plate>\n   341\t          </Section>\n   342\t\n   343\t          {/* §2 */}\n   344\t          <Section {...SECTIONS[1]}>\n   345\t            {rel ? (\n   346\t              <div className=\"with-margin\">\n   347\t                <div className=\"wm-main\">\n   348\t                  <Plate\n   349\t                    label=\"Plate M3 · Top-1 reliability on post-cutoff text\"\n   350\t                    caption=\"x = mean top-1 confidence per bin, y = accuracy; glyph area ∝ positions in the bin. Points below the diagonal are over-confident. The key is named selfboot but it is computed on teacher-forced post-cutoff text.\"\n   351\t                    sources={[P(\"selfboot.reliability.bins\"), ...compare.map((c) => path(c, \"selfboot.reliability.bins\"))]}\n   352\t                    data={{\n   353\t                      columns: [\"bin\", \"positions\", \"confidence\", \"accuracy\", ...compare.map((c) => `${c.label} acc.`)],\n   354\t                      numeric: [false, true, true, true, ...compare.map(() => true)],\n   355\t                      rows: (rel.bins ?? []).map((b) => [\n   356\t                        `${fmtNum(b[0], \"num2\")}–${fmtNum(b[1], \"num2\")}`,\n   357\t                        fmt(b[2], \"count\"),\n   358\t                        fmtNum(b[3], \"num3\"),\n   359\t                        fmtNum(b[4], \"num3\"),\n   360\t                        // bins are matched on their lower edge: vh_selfboot.py skips empty bins, so indices can differ\n   361\t                        ...compare.map((c) => fmtNum(binAt(c, b[0])?.[4] ?? null, \"num3\")),\n   362\t                      ]),\n   363\t                    }}\n   364\t                  >\n   365\t                    <ReliabilityDiagram model={model} compare={compare} />\n   366\t                  </Plate>\n   367\t                </div>\n   368\t                <aside className=\"wm-margin\">\n   369\t                  <Kv\n   370\t                    items={[\n   371\t                      [\"ECE\", <Num path={P(\"selfboot.reliability.ECE\")} fmt=\"num3\" />],\n   372\t                      [\"top-1 accuracy\", <Num path={P(\"selfboot.reliability.top1_acc\")} fmt=\"pct\" />],\n   373\t                      [\"mean top-1 p\", <Num path={P(\"selfboot.reliability.mean_p1\")} fmt=\"num3\" />],\n   374\t                      [\"share p1 > 0.9\", <Num path={P('selfboot.reliability[\"frac_p1>0.9\"]')} fmt=\"pct\" />],\n   375\t                      [\"acc − conf | p1 > 0.9\", <Num path={P('selfboot.reliability[\"acc_minus_conf_p1>0.9\"]')} fmt=\"signed\" />],\n   376\t                    ]}\n   377\t                  />\n   378\t                </aside>\n   379\t              </div>\n   380\t            ) : (\n   381\t              <NullPlate>Reliability not measured for this checkpoint.</NullPlate>\n   382\t            )}\n   383\t            <Kv\n   384\t              items={[\n   385\t                [\"F_calib_gap (post-cutoff)\", <Num path={P(\"fingerprint.F_calib_gap\")} fmt=\"gap\" />],\n   386\t                [\"calib_gap (Pile)\", <Num path={P(\"fingerprint.calib_gap\")} fmt=\"gap\" />],\n   387\t                [\"F_gap_domain_absmean\", <Num path={P(\"fingerprint.F_gap_domain_absmean\")} fmt=\"nats\" />],\n   388\t                [\"F_gap_domain_min\", <Num path={P(\"fingerprint.F_gap_domain_min\")} fmt=\"gap\" />],\n   389\t                [\"tail.tf_fresh.gap_hiH\", <Num path={P(\"tail.tf_fresh.gap_hiH\")} fmt=\"gap\" />],\n   390\t                ...(band\n   391\t                  ? ([[\n   392\t                      \"pre-anneal band\",\n   393\t                      <>\n   394\t                        ±<Num path={path(band.model, \"fingerprint.F_calib_gap\")} value={band.band} fmt=\"nats\" derived=\"max |F_calib_gap| over pre-anneal checkpoints\" />\n   395\t                      </>,\n   396\t                    ]] as [React.ReactNode, React.ReactNode][])\n   397\t                  : []),\n   398\t              ]}\n   399\t            />\n   400\t            <Plate\n   401\t              label=\"Plate M3b · Cross-entropy per post-cutoff domain\"\n   402\t              caption=\"Cross-entropy alone cannot say whether a model is miscalibrated; it is shown for context. Sorted by this checkpoint’s value; compare models hollow.\"\n   403\t              sources={[P(\"fingerprint.F_CE_*\")]}\n   404\t              data={{\n   405\t                columns: [\"domain\", model.label, ...compare.map((c) => c.label)],\n   406\t                numeric: [false, true, ...compare.map(() => true)],\n   407\t                rows: domainRows(both, \"F_CE_\", model).map((r) => [r.label, fmtNum(r.values[model.id], \"nats\"), ...compare.map((c) => fmtNum(r.values[c.id], \"nats\"))]),\n   408\t              }}\n   409\t            >\n   410\t              <DotRows rows={domainRows(both, \"F_CE_\", model)} model={model} compare={compare} axisTitle=\"cross-entropy on post-cutoff text, nats\" />\n   411\t            </Plate>\n   412\t          </Section>\n   413\t\n   414\t          {/* §3 */}\n   415\t          <Section {...SECTIONS[2]}>\n   416\t            {model.tail ? (\n   417\t              <div className=\"tbl-scroll\">\n   418\t                <table className=\"tbl tail-table\">\n   419\t                  <caption>\n   420\t                    Realised tail statistics per pass{compare[0] ? `; deltas against ${compare[0].label}` : \"\"}.\n   421\t                  </caption>\n   422\t                  <thead>\n   423\t                    <tr>\n   424\t                      <th scope=\"col\">statistic</th>\n   425\t                      {TAIL_PASSES.filter((p) => model.tail?.[p.key]).map((p) => (\n   426\t                        <th key={p.key} scope=\"col\" className=\"n\">\n   427\t                          {p.label}\n   428\t                        </th>\n   429\t                      ))}\n   430\t                    </tr>\n   431\t                  </thead>\n   432\t                  <tbody>\n   433\t                    {TAIL_ROWS.map((r) => (\n   434\t                      <tr key={r.key}>\n   435\t                        <th scope=\"row\" style={{ fontWeight: 400, background: \"none\" }}>\n   436\t                          {r.label}\n   437\t                        </th>\n   438\t                        {TAIL_PASSES.filter((p) => model.tail?.[p.key]).map((p) => {\n   439\t                          const v = get(model, [\"tail\", p.key, r.key]);\n   440\t                          const c = compare[0] ? get(compare[0], [\"tail\", p.key, r.key]) : null;\n   441\t                          let delta: string | null = null;\n   442\t                          if (isNum(v) && isNum(c)) {\n   443\t                            if (r.rate) delta = c > 0 ? `${fmt(v / c, \"ratio\")} vs ${compare[0].label}` : null;\n   444\t                            else delta = `${fmt(v - c, \"signed\")} vs ${compare[0].label}`;\n   445\t                          }\n   446\t                          return (\n   447\t                            <td key={p.key} className=\"n\">\n   448\t                              <Num path={path(model, [\"tail\", p.key, r.key])} fmt={r.kind} />\n   449\t                              {delta && <span className=\"delta\">{delta}</span>}\n   450\t                            </td>\n   451\t                          );\n   452\t                        })}\n   453\t                      </tr>\n   454\t                    ))}\n   455\t                  </tbody>\n   456\t                </table>\n   457\t                {TAIL_PASSES.filter((p) => !model.tail?.[p.key]).map((p) => (\n   458\t                  <p key={p.key} className=\"small ink3\">\n   459\t                    {p.label}: not run for this checkpoint.\n   460\t                  </p>\n   461\t                ))}\n   462\t              </div>\n   463\t            ) : (\n   464\t              <NullPlate>Tail statistics not measured for this checkpoint.</NullPlate>\n   465\t            )}\n   466\t            <Plate\n   467\t              label=\"Plate M4 · Gap where the model is uncertain (H > 4), every checkpoint\"\n   468\t              caption=\"Calibration gap restricted to post-cutoff positions with entropy above 4 nats. Negative = over-confident exactly where uncertain. This checkpoint is highlighted; compare models are outlined.\"\n   469\t              sources={[\"models[*].tail.tf_fresh.gap_hiH\"]}\n   470\t            >\n   471\t              <StageDotStrip\n   472\t                bundle={bundle}\n   473\t                value={(m) => get(m, \"tail.tf_fresh.gap_hiH\")}\n   474\t                valuePath={(m) => path(m, \"tail.tf_fresh.gap_hiH\")}\n   475\t                fmtKind=\"gap\"\n   476\t                axisTitle=\"gap at H > 4, mean(H − s), nats (post-cutoff)\"\n   477\t                highlight={model.id}\n   478\t                compare={compare.map((c) => c.id)}\n   479\t                zero\n   480\t              />\n   481\t            </Plate>\n   482\t          </Section>\n   483\t\n   484\t          {/* §4 */}\n   485\t          <Section {...SECTIONS[3]}>\n   486\t            {!s ? (\n   487\t              <NullPlate>Surname test not run for this checkpoint.</NullPlate>\n   488\t            ) : (\n   489\t              <>\n   490\t                {effMax !== null && (\n   491\t                  <Plate\n   492\t                    label=\"Plate M5 · Effective number of surnames, exp(H)\"\n   493\t                    caption=\"exp(entropy) of the model’s distribution over the 2,000 most common Census surnames, against the Census itself over the same set. Secondary labels give entropy in nats.\"\n   494\t                    sources={[\"reference.census_entropy_top2000\", P(\"surnames.H_few\"), P(\"surnames.H_desc\")]}\n   495\t                  >\n   496\t                    <HBars\n   497\t                      // the axis reaches the longest bar: a model above the Census entropy is not clamped to it\n   498\t                      max={Math.max(effMax, ...[s.H_few, s.H_desc].filter(isNum).map(Math.exp))}\n   499\t                      fmtKind=\"eff\"\n   500\t                      axisTitle=\"effective number of surnames (linear); secondary labels: nats\"\n   501\t                      secondary={(v) => `${fmtNum(Math.log(v), \"num2\")} nats`}\n   502\t                      bars={[\n   503\t                        { label: \"Census (top 2,000)\", value: effMax, path: \"exp(reference.census_entropy_top2000)\" },\n   504\t                        { label: \"few-shot, exp(H_few)\", value: isNum(s.H_few) ? Math.exp(s.H_few) : null, path: `exp(${P(\"surnames.H_few\")})` },\n   505\t                        { label: \"described, exp(H_desc)\", value: isNum(s.H_desc) ? Math.exp(s.H_desc) : null, path: `exp(${P(\"surnames.H_desc\")})` },\n   506\t                      ]}\n   507\t                    />\n   508\t                  </Plate>\n   509\t                )}\n   510\t                <SurnameStats model={model} compare={compare} />\n   511\t                {topNames ? (\n   512\t                  <Plate label=\"Plate M5b · Top Census surnames: model vs Census\" caption={topNames.caption} sources={topNames.sources}>\n   513\t                    <TopNamesChart data={topNames} />\n   514\t                  </Plate>\n   515\t                ) : (\n   516\t                  <p className=\"small ink3\">Per-name distribution not in this bundle.</p>\n   517\t                )}\n   518\t              </>\n   519\t            )}\n   520\t          </Section>\n   521\t\n   522\t          {/* §5 */}\n   523\t          <Section {...SECTIONS[4]}>\n   524\t            {!model.weird ? (\n   525\t              <NullPlate>Rare-genre pass not run for this checkpoint.</NullPlate>\n   526\t            ) : (\n   527\t              <GenreTable model={model} compare={compare} band={band?.band} />\n   528\t            )}\n   529\t          </Section>\n   530\t\n   531\t          {/* §6 */}\n   532\t          <Section {...SECTIONS[5]}>\n   533\t            {model.selfboot?.lexical ? (\n   534\t              <Plate\n   535\t                label=\"Plate M6 · Own-sample lexical statistics vs the Pile\"\n   536\t                caption=\"Each axis spans the bundle-wide range; the labelled tick is the Pile reference. Compare models hollow.\"\n   537\t                sources={lexKeys.map((k) => P(`selfboot.lexical.${k}`)).concat([\"reference.pile_lexical\"])}\n   538\t              >\n   539\t                <div className=\"gauges\">\n   540\t                  {lexKeys.map((k) => {\n   541\t                    const val = (m: Model) => get(m, [\"selfboot\", \"lexical\", k]);\n   542\t                    const ref = get(bundle.reference as never, [\"pile_lexical\", k]);\n   543\t                    const ex = extent([...bundle.models.map(val), ref]) ?? [0, 1];\n   544\t                    return (\n   545\t                      <Gauge\n   546\t                        key={k}\n   547\t                        name={k}\n   548\t                        model={model}\n   549\t                        compare={compare}\n   550\t                        value={val}\n   551\t                        pathOf={(m) => path(m, `selfboot.lexical.${k}`)}\n   552\t                        refValue={ref}\n   553\t                        refLabel=\"Pile\"\n   554\t                        domain={ex}\n   555\t                        fmtKind={k === \"zipf_slope\" ? \"signed\" : \"num3\"}\n   556\t                      />\n   557\t                    );\n   558\t                  })}\n   559\t                </div>\n   560\t              </Plate>\n   561\t            ) : (\n   562\t              <NullPlate>Own-sample statistics not measured for this checkpoint.</NullPlate>\n   563\t            )}\n   564\t            <p className=\"prose small\" style={{ fontSize: 14 }}>\n   565\t              Free-running collapse is not diagnostic of training stage (<Link to=\"/findings#f4\">Finding 4</Link>). Share of near-deterministic steps\n   566\t              (H &lt; 0.1): <Num path={P('fingerprint[\"roll_frac_H<0.1\"]')} fmt=\"pct\" />; late 8-gram repetition: <Num path={P(\"fingerprint.roll_rep8_q4\")} fmt=\"pct\" />.\n   567\t            </p>\n   568\t          </Section>\n   569\t\n   570\t          {/* §7 */}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/zsh -lc \"nl -ba tools/export_bundle.py | sed -n '1,300p' && nl -ba tools/models.json && nl -ba data/manifest.json && nl -ba site/src/test/helpers.ts && nl -ba site/src/test/scoring.test.ts && nl -ba site/src/test/method.test.ts\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_35","type":"command_execution","command":"/bin/zsh -lc \"nl -ba tools/export_bundle.py | sed -n '1,300p' && nl -ba tools/models.json && nl -ba data/manifest.json && nl -ba site/src/test/helpers.ts && nl -ba site/src/test/scoring.test.ts && nl -ba site/src/test/method.test.ts\"","aggregated_output":"     1\t#!/usr/bin/env python3\n     2\t\"\"\"Turn a measurement analysis directory into a True Base Bench data bundle.\n     3\t\n     4\tReads the files the measurement scripts write into results/analysis/ (see docs/vh_*.py):\n     5\t\n     6\t    fingerprints.json     vh_analyze.py --all       {model: {feature: value}}           required\n     7\t    truebase_scores.json  vh_truebase.py            {model: {calib|spread|memo|prior: {score,value,source}, overall, n_avail}}\n     8\t    names_summary.json    vh_names_table.py         {model: {KL_desc, KL_few, ...}}\n     9\t    weird_summary.json    vh_names_table.py         {model: {ALL: [gap, runfrac, CE], <genre>: [...]}}\n    10\t    selfboot.json         vh_selfboot.py            {reference: {...}, models: {model: {reliability, lexical}}}\n    11\t    tail_realised.json    vh_tail.py                [{model, tf: {...}, tf_fresh: {...}, tf_weird: {...}}]\n    12\t\n    13\tOnly fingerprints.json is required; every other file is optional and missing entries become null\n    14\t(\"not measured\"). truebase_scores.json is cross-checked against a recomputation from the fingerprint\n    15\twith the ramps of docs/SPEC.md (same code as docs/vh_truebase.py); if it is missing, the scores are\n    16\trecomputed.\n    17\t\n    18\tModel metadata (family, stage, label, order) comes from the registry tools/models.json: only models listed\n    19\tthere and not in its \"exclude\" map are exported. Models present in the analysis but not in the registry are\n    20\treported and skipped (use --strict to make that an error).\n    21\t\n    22\tModels in the latest existing bundle that are not in the analysis directory are carried over unchanged\n    23\t(--no-merge to export only what was measured; --base to pick another bundle), so a run that measured one new\n    24\tcheckpoint still produces a complete bundle. Published bundles are never modified.\n    25\t\n    26\tWrites data/bench_v<N>.json (N = one more than the highest existing bundle unless --version is given) and\n    27\tadds it to data/manifest.json. NaN/Infinity are written as null so the bundle is strict JSON.\n    28\t\n    29\tUsage:\n    30\t    python tools/export_bundle.py /models/varentropy/results/analysis\n    31\t    python tools/export_bundle.py ANALYSIS_DIR --version 2 --generated 2026-11-01 --dry-run\n    32\t    python tools/export_bundle.py ANALYSIS_DIR --no-merge      # bundle = exactly the analysed models\n    33\t\"\"\"\n    34\tfrom __future__ import annotations\n    35\t\n    36\timport argparse\n    37\timport datetime as _dt\n    38\timport json\n    39\timport math\n    40\timport os\n    41\timport re\n    42\timport sys\n    43\tfrom typing import Any, Dict, List, Optional, Tuple\n    44\t\n    45\tHERE = os.path.dirname(os.path.abspath(__file__))\n    46\tREPO = os.path.dirname(HERE)\n    47\tDEFAULT_DATA_DIR = os.path.join(REPO, \"data\")\n    48\tDEFAULT_REGISTRY = os.path.join(HERE, \"models.json\")\n    49\t\n    50\tSCHEMA_VERSION = 1\n    51\tMANIFEST_VERSION = 1\n    52\tSTAGES = (\"pre-anneal\", \"anneal\", \"base\", \"post-trained\")\n    53\tSUBSCORES = (\"calib\", \"spread\", \"memo\", \"prior\")\n    54\tBUNDLE_RE = re.compile(r\"^bench_v(\\d+)\\.json$\")\n    55\t\n    56\t# Ramps (docs/SPEC.md, docs/vh_truebase.py): sub-score -> (value scoring 1, value scoring 0).\n    57\tRAMPS: Dict[str, Tuple[float, float]] = {\n    58\t    \"calib\": (0.0, -0.10),\n    59\t    \"spread\": (0.015, 0.10),\n    60\t    \"memo\": (0.02, 0.12),\n    61\t    \"prior\": (0.0, 0.40),\n    62\t}\n    63\t# Feature preference per sub-score (first available wins), as in docs/vh_truebase.py.\n    64\tSOURCES: Dict[str, Tuple[str, ...]] = {\n    65\t    \"calib\": (\"F_calib_gap\", \"calib_gap\"),\n    66\t    \"spread\": (\"F_gap_domain_absmean\", \"calib_gap_domain_absmean\"),\n    67\t    \"memo\": (\"X_runfrac_wiki\", \"verbatim_run_frac_wiki\"),\n    68\t    \"prior\": (\"roll_instr_marker_rate\",),\n    69\t}\n    70\tTOL = 1e-9\n    71\t\n    72\t\n    73\tclass ExportError(Exception):\n    74\t    pass\n    75\t\n    76\t\n    77\t# ---------------------------------------------------------------- helpers\n    78\t\n    79\tdef is_missing(v: Any) -> bool:\n    80\t    return v is None or (isinstance(v, float) and (math.isnan(v) or math.isinf(v)))\n    81\t\n    82\t\n    83\tdef clean(obj: Any) -> Any:\n    84\t    \"\"\"Recursively replace NaN/Infinity with None and tuples with lists.\"\"\"\n    85\t    if isinstance(obj, float):\n    86\t        return None if (math.isnan(obj) or math.isinf(obj)) else obj\n    87\t    if isinstance(obj, dict):\n    88\t        return {str(k): clean(v) for k, v in obj.items()}\n    89\t    if isinstance(obj, (list, tuple)):\n    90\t        return [clean(v) for v in obj]\n    91\t    return obj\n    92\t\n    93\t\n    94\tdef load_json(path: str) -> Any:\n    95\t    with open(path, encoding=\"utf-8\") as fh:\n    96\t        return json.load(fh)  # Python's json accepts the bare NaN tokens the scripts write\n    97\t\n    98\t\n    99\tdef load_optional(adir: str, name: str, warnings: List[str]) -> Any:\n   100\t    p = os.path.join(adir, name)\n   101\t    if not os.path.exists(p):\n   102\t        warnings.append(f\"{name} not found in {adir}: the corresponding fields will be null\")\n   103\t        return None\n   104\t    return load_json(p)\n   105\t\n   106\t\n   107\t# ---------------------------------------------------------------- scoring (mirrors docs/vh_truebase.py)\n   108\t\n   109\tdef ramp(x: Optional[float], good: float, bad: float) -> Optional[float]:\n   110\t    if is_missing(x):\n   111\t        return None\n   112\t    t = (x - bad) / (good - bad)\n   113\t    return max(0.0, min(1.0, t))\n   114\t\n   115\t\n   116\tdef pick(f: Dict[str, Any], keys: Tuple[str, ...]) -> Tuple[Optional[float], Optional[str]]:\n   117\t    for k in keys:\n   118\t        v = f.get(k)\n   119\t        if not is_missing(v):\n   120\t            return v, k\n   121\t    return None, None\n   122\t\n   123\t\n   124\tdef score_fingerprint(f: Dict[str, Any]) -> Dict[str, Any]:\n   125\t    out: Dict[str, Any] = {}\n   126\t    for name in SUBSCORES:\n   127\t        value, src = pick(f, SOURCES[name])\n   128\t        x = value\n   129\t        if name == \"calib\" and value is not None:\n   130\t            x = min(value, 0.0)  # a positive gap (under-confident) is not penalised\n   131\t        out[name] = {\"score\": ramp(x, *RAMPS[name]), \"value\": value, \"source\": src}\n   132\t    avail = [out[k][\"score\"] for k in SUBSCORES if out[k][\"score\"] is not None]\n   133\t    out[\"overall\"] = sum(avail) / len(avail) if avail else None\n   134\t    out[\"n_avail\"] = len(avail)\n   135\t    return out\n   136\t\n   137\t\n   138\tdef close(a: Optional[float], b: Optional[float]) -> bool:\n   139\t    if is_missing(a) or is_missing(b):\n   140\t        return is_missing(a) and is_missing(b)\n   141\t    return abs(a - b) <= TOL\n   142\t\n   143\t\n   144\t# ---------------------------------------------------------------- bundle assembly\n   145\t\n   146\tdef load_registry(path: str) -> Dict[str, Any]:\n   147\t    reg = load_json(path)\n   148\t    models = reg.get(\"models\") or {}\n   149\t    for mid, meta in models.items():\n   150\t        for k in (\"family\", \"stage\", \"label\", \"order\"):\n   151\t            if k not in meta:\n   152\t                raise ExportError(f\"registry {path}: model {mid!r} lacks {k!r}\")\n   153\t        if meta[\"stage\"] not in STAGES:\n   154\t            raise ExportError(f\"registry {path}: model {mid!r} has stage {meta['stage']!r}, expected one of {STAGES}\")\n   155\t        if not isinstance(meta[\"order\"], int) or meta[\"order\"] < 0:\n   156\t            raise ExportError(f\"registry {path}: model {mid!r} order must be a non-negative integer\")\n   157\t    reg[\"models\"] = models\n   158\t    reg[\"exclude\"] = reg.get(\"exclude\") or {}\n   159\t    return reg\n   160\t\n   161\t\n   162\tdef tail_by_model(tail: Any) -> Dict[str, Dict[str, Any]]:\n   163\t    if tail is None:\n   164\t        return {}\n   165\t    if isinstance(tail, dict):  # tolerate a {model: {...}} layout too\n   166\t        return {m: {k: v for k, v in row.items() if k != \"model\"} for m, row in tail.items()}\n   167\t    out = {}\n   168\t    for row in tail:\n   169\t        out[row[\"model\"]] = {k: v for k, v in row.items() if k != \"model\"}\n   170\t    return out\n   171\t\n   172\t\n   173\tdef build_bundle(adir: str, registry: Dict[str, Any], generated: str, strict: bool = False,\n   174\t                 base: Optional[Dict[str, Any]] = None, base_name: str = \"base bundle\") -> Tuple[Dict[str, Any], List[str]]:\n   175\t    \"\"\"Assemble a bundle from an analysis directory. With `base` (a previous bundle), models that are not in the\n   176\t    analysis are carried over unchanged, so a run that measured only new checkpoints still yields a full bundle.\"\"\"\n   177\t    warnings: List[str] = []\n   178\t    fp_path = os.path.join(adir, \"fingerprints.json\")\n   179\t    if not os.path.exists(fp_path):\n   180\t        raise ExportError(f\"{fp_path} not found (run docs/vh_analyze.py RESULTS --all first)\")\n   181\t    fps: Dict[str, Dict[str, Any]] = load_json(fp_path)\n   182\t    scores = load_optional(adir, \"truebase_scores.json\", warnings) or {}\n   183\t    names = load_optional(adir, \"names_summary.json\", warnings) or {}\n   184\t    weird = load_optional(adir, \"weird_summary.json\", warnings) or {}\n   185\t    selfboot_raw = load_optional(adir, \"selfboot.json\", warnings) or {}\n   186\t    tails = tail_by_model(load_optional(adir, \"tail_realised.json\", warnings))\n   187\t    selfboot = selfboot_raw.get(\"models\", {}) if isinstance(selfboot_raw, dict) else {}\n   188\t\n   189\t    reg_models: Dict[str, Dict[str, Any]] = registry[\"models\"]\n   190\t    excluded: Dict[str, str] = registry[\"exclude\"]\n   191\t\n   192\t    measured = [m for m in fps if not m.startswith((\"smoke\", \"vsmoke\"))]\n   193\t    unknown = sorted(m for m in measured if m not in reg_models and m not in excluded)\n   194\t    if unknown:\n   195\t        msg = \"measured but not in the registry (skipped; add them to tools/models.json): \" + \", \".join(unknown)\n   196\t        if strict:\n   197\t            raise ExportError(msg)\n   198\t        warnings.append(msg)\n   199\t    for m in sorted(set(measured) & set(excluded)):\n   200\t        warnings.append(f\"{m}: excluded by registry ({excluded[m]})\")\n   201\t    missing = sorted(m for m in reg_models if m not in fps and m not in excluded)\n   202\t    if missing:\n   203\t        warnings.append(\"in the registry but not in fingerprints.json (not exported): \" + \", \".join(missing))\n   204\t\n   205\t    models: List[Dict[str, Any]] = []\n   206\t    for mid in measured:\n   207\t        if mid not in reg_models or mid in excluded:\n   208\t            continue\n   209\t        meta = reg_models[mid]\n   210\t        fp = fps[mid]\n   211\t        recomputed = score_fingerprint(fp)\n   212\t        given = scores.get(mid)\n   213\t        if given is None:\n   214\t            if scores:\n   215\t                warnings.append(f\"{mid}: not in truebase_scores.json, scores recomputed from the fingerprint\")\n   216\t            sc = recomputed\n   217\t        else:\n   218\t            sc = given\n   219\t            for k in SUBSCORES:\n   220\t                g, r = given.get(k) or {}, recomputed[k]\n   221\t                if not close(g.get(\"score\"), r[\"score\"]) or not close(g.get(\"value\"), r[\"value\"]):\n   222\t                    raise ExportError(f\"{mid}: truebase_scores.json {k} = {g} disagrees with recomputation {r}; \"\n   223\t                                      f\"re-run docs/vh_truebase.py on this fingerprints.json\")\n   224\t            if not close(given.get(\"overall\"), recomputed[\"overall\"]):\n   225\t                raise ExportError(f\"{mid}: truebase_scores.json overall {given.get('overall')} != recomputed {recomputed['overall']}\")\n   226\t        models.append({\n   227\t            \"id\": mid,\n   228\t            \"family\": meta[\"family\"],\n   229\t            \"stage\": meta[\"stage\"],\n   230\t            \"label\": meta[\"label\"],\n   231\t            \"order\": meta[\"order\"],\n   232\t            \"score\": sc.get(\"overall\"),\n   233\t            \"subscores\": {k: sc.get(k) for k in SUBSCORES},\n   234\t            \"fingerprint\": fp,\n   235\t            \"surnames\": names.get(mid),\n   236\t            \"weird\": weird.get(mid),\n   237\t            \"selfboot\": selfboot.get(mid),\n   238\t            \"tail\": tails.get(mid),\n   239\t        })\n   240\t        for part in (\"surnames\", \"weird\", \"selfboot\", \"tail\"):\n   241\t            if models[-1][part] is None:\n   242\t                warnings.append(f\"{mid}: no {part} data (null)\")\n   243\t\n   244\t    if base is not None:\n   245\t        fresh = {m[\"id\"] for m in models}\n   246\t        for old in base.get(\"models\", []):\n   247\t            if old[\"id\"] in fresh:\n   248\t                warnings.append(f\"{old['id']}: re-measured, replaces the entry in {base_name}\")\n   249\t            elif old[\"id\"] in excluded:\n   250\t                warnings.append(f\"{old['id']}: in {base_name} but excluded by the registry (dropped)\")\n   251\t            else:\n   252\t                models.append(dict(old))\n   253\t        warnings.append(f\"carried over {len(models) - len(fresh)} model(s) from {base_name}\")\n   254\t\n   255\t    if not models:\n   256\t        raise ExportError(\"no models to export (check tools/models.json against fingerprints.json)\")\n   257\t\n   258\t    # Duplicate (family, order) pairs make ladder charts ambiguous.\n   259\t    seen: Dict[Tuple[str, int], str] = {}\n   260\t    for m in models:\n   261\t        key = (m[\"family\"], m[\"order\"])\n   262\t        if key in seen:\n   263\t            raise ExportError(f\"{m['id']} and {seen[key]} share family {key[0]!r} and order {key[1]}\")\n   264\t        seen[key] = m[\"id\"]\n   265\t\n   266\t    def sort_key(m: Dict[str, Any]):\n   267\t        s = m[\"score\"]\n   268\t        return (1, 0.0, m[\"id\"]) if is_missing(s) else (0, -s, m[\"id\"])\n   269\t\n   270\t    models.sort(key=sort_key)\n   271\t\n   272\t    reference: Dict[str, Any] = dict(registry.get(\"reference\") or {})\n   273\t    if isinstance(selfboot_raw, dict) and selfboot_raw.get(\"reference\") is not None:\n   274\t        reference[\"pile_lexical\"] = selfboot_raw[\"reference\"]\n   275\t    if reference.get(\"pile_lexical\") is None and base is not None:\n   276\t        reference[\"pile_lexical\"] = (base.get(\"reference\") or {}).get(\"pile_lexical\")\n   277\t    reference.setdefault(\"pile_lexical\", None)\n   278\t    # The Census entropy over the 2,000 probed surnames is computed by the names probe itself (H_ref, the\n   279\t    # same for every model); prefer it at full precision over the rounded registry constant.\n   280\t    h_ref = [m[\"surnames\"].get(\"H_r\") for m in models if isinstance(m.get(\"surnames\"), dict)]\n   281\t    h_ref = [h for h in h_ref if not is_missing(h)]\n   282\t    if h_ref:\n   283\t        if max(h_ref) - min(h_ref) > 1e-6:\n   284\t            warnings.append(f\"surnames.H_r differs across models ({min(h_ref)} .. {max(h_ref)}); using the median\")\n   285\t        reference[\"census_entropy_top2000\"] = sorted(h_ref)[len(h_ref) // 2]\n   286\t\n   287\t    bundle = clean({\n   288\t        \"schema_version\": SCHEMA_VERSION,\n   289\t        \"generated\": generated,\n   290\t        \"n_models\": len(models),\n   291\t        \"reference\": reference,\n   292\t        \"models\": models,\n   293\t    })\n   294\t    validate_bundle(bundle)\n   295\t    return bundle, warnings\n   296\t\n   297\t\n   298\t# ---------------------------------------------------------------- validation (mirrors site/src/data/bench.schema.json essentials)\n   299\t\n   300\tdef validate_bundle(b: Dict[str, Any]) -> None:\n     1\t{\n     2\t \"_doc\": \"Model registry for tools/export_bundle.py. Keys are result-directory names (results/<id>/) as they appear in the analysis JSON files. family: ladder the model belongs to; stage: pre-anneal | anneal | base | post-trained; label: short label within the family; order: position within the family ladder (0 = earliest). Only models listed here (and not in 'exclude') are exported.\",\n     3\t \"reference\": {\n     4\t  \"census_entropy_top2000\": 6.93,\n     5\t  \"census_self_entropy_all\": 10.4\n     6\t },\n     7\t \"exclude\": {\n     8\t  \"gemma-4-31B-it\": \"garbage output under this loading path (CE 6.0 nats on Pile, bare-BOS samples are glyph strings) while Gemma-4-31B-Base loads correctly; excluded pending a re-load check\"\n     9\t },\n    10\t \"models\": {\n    11\t  \"Trinity-Large-TrueBase\": {\n    12\t   \"family\": \"Trinity Large 398B-A13B\",\n    13\t   \"stage\": \"pre-anneal\",\n    14\t   \"label\": \"TrueBase (10T, pre-anneal)\",\n    15\t   \"order\": 0\n    16\t  },\n    17\t  \"Trinity-Large-Base\": {\n    18\t   \"family\": \"Trinity Large 398B-A13B\",\n    19\t   \"stage\": \"base\",\n    20\t   \"label\": \"Base (17T, annealed)\",\n    21\t   \"order\": 1\n    22\t  },\n    23\t  \"Trinity-Large-Preview\": {\n    24\t   \"family\": \"Trinity Large 398B-A13B\",\n    25\t   \"stage\": \"post-trained\",\n    26\t   \"label\": \"Preview (instruct)\",\n    27\t   \"order\": 2\n    28\t  },\n    29\t  \"Olmo-3-1125-32B\": {\n    30\t   \"family\": \"OLMo-3 32B\",\n    31\t   \"stage\": \"base\",\n    32\t   \"label\": \"Base\",\n    33\t   \"order\": 1\n    34\t  },\n    35\t  \"olmo2-7b_stage1-2928B\": {\n    36\t   \"family\": \"OLMo-2 7B\",\n    37\t   \"stage\": \"pre-anneal\",\n    38\t   \"label\": \"stage 1 · 2.9T\",\n    39\t   \"order\": 0\n    40\t  },\n    41\t  \"olmo2-7b_stage1-3896B\": {\n    42\t   \"family\": \"OLMo-2 7B\",\n    43\t   \"stage\": \"pre-anneal\",\n    44\t   \"label\": \"stage 1 · 3.9T (pre-anneal)\",\n    45\t   \"order\": 1\n    46\t  },\n    47\t  \"olmo2-7b_stage2-ing1-5B\": {\n    48\t   \"family\": \"OLMo-2 7B\",\n    49\t   \"stage\": \"anneal\",\n    50\t   \"label\": \"stage 2 · +5B\",\n    51\t   \"order\": 2\n    52\t  },\n    53\t  \"olmo2-7b_stage2-ing1-17B\": {\n    54\t   \"family\": \"OLMo-2 7B\",\n    55\t   \"stage\": \"anneal\",\n    56\t   \"label\": \"stage 2 · +17B\",\n    57\t   \"order\": 3\n    58\t  },\n    59\t  \"olmo2-7b_stage2-ing1-50B\": {\n    60\t   \"family\": \"OLMo-2 7B\",\n    61\t   \"stage\": \"anneal\",\n    62\t   \"label\": \"stage 2 · +50B\",\n    63\t   \"order\": 4\n    64\t  },\n    65\t  \"olmo2-7b_main\": {\n    66\t   \"family\": \"OLMo-2 7B\",\n    67\t   \"stage\": \"base\",\n    68\t   \"label\": \"Base (soup)\",\n    69\t   \"order\": 5\n    70\t  },\n    71\t  \"olmo2-7b_sft\": {\n    72\t   \"family\": \"OLMo-2 7B\",\n    73\t   \"stage\": \"post-trained\",\n    74\t   \"label\": \"SFT\",\n    75\t   \"order\": 6\n    76\t  },\n    77\t  \"olmo2-7b_dpo\": {\n    78\t   \"family\": \"OLMo-2 7B\",\n    79\t   \"stage\": \"post-trained\",\n    80\t   \"label\": \"DPO\",\n    81\t   \"order\": 7\n    82\t  },\n    83\t  \"olmo2-7b_instruct\": {\n    84\t   \"family\": \"OLMo-2 7B\",\n    85\t   \"stage\": \"post-trained\",\n    86\t   \"label\": \"Instruct (RLVR)\",\n    87\t   \"order\": 8\n    88\t  },\n    89\t  \"Llama-3.1-405B\": {\n    90\t   \"family\": \"Llama 3.1\",\n    91\t   \"stage\": \"base\",\n    92\t   \"label\": \"405B base\",\n    93\t   \"order\": 0\n    94\t  },\n    95\t  \"Llama-3.1-70B\": {\n    96\t   \"family\": \"Llama 3.1\",\n    97\t   \"stage\": \"base\",\n    98\t   \"label\": \"70B base\",\n    99\t   \"order\": 1\n   100\t  },\n   101\t  \"Llama-3.1-70B-Instruct-new\": {\n   102\t   \"family\": \"Llama 3.1\",\n   103\t   \"stage\": \"post-trained\",\n   104\t   \"label\": \"70B Instruct\",\n   105\t   \"order\": 2\n   106\t  },\n   107\t  \"Qwen2.5-72B\": {\n   108\t   \"family\": \"Qwen2.5 72B\",\n   109\t   \"stage\": \"base\",\n   110\t   \"label\": \"Base\",\n   111\t   \"order\": 0\n   112\t  },\n   113\t  \"Qwen2.5-72B-Instruct\": {\n   114\t   \"family\": \"Qwen2.5 72B\",\n   115\t   \"stage\": \"post-trained\",\n   116\t   \"label\": \"Instruct\",\n   117\t   \"order\": 1\n   118\t  },\n   119\t  \"Qwen3-30B-A3B-Base\": {\n   120\t   \"family\": \"Qwen3 30B-A3B\",\n   121\t   \"stage\": \"base\",\n   122\t   \"label\": \"Base\",\n   123\t   \"order\": 0\n   124\t  },\n   125\t  \"Qwen3-30B-A3B\": {\n   126\t   \"family\": \"Qwen3 30B-A3B\",\n   127\t   \"stage\": \"post-trained\",\n   128\t   \"label\": \"Instruct/thinking\",\n   129\t   \"order\": 1\n   130\t  },\n   131\t  \"GLM-4-32B-Base-0414\": {\n   132\t   \"family\": \"GLM-4 32B\",\n   133\t   \"stage\": \"base\",\n   134\t   \"label\": \"Base\",\n   135\t   \"order\": 0\n   136\t  },\n   137\t  \"GLM-4-32B-0414\": {\n   138\t   \"family\": \"GLM-4 32B\",\n   139\t   \"stage\": \"post-trained\",\n   140\t   \"label\": \"Chat\",\n   141\t   \"order\": 1\n   142\t  },\n   143\t  \"gemma-2-9b\": {\n   144\t   \"family\": \"Gemma 2 9B\",\n   145\t   \"stage\": \"base\",\n   146\t   \"label\": \"base (distilled)\",\n   147\t   \"order\": 0\n   148\t  },\n   149\t  \"gemma-2-9b-it\": {\n   150\t   \"family\": \"Gemma 2 9B\",\n   151\t   \"stage\": \"post-trained\",\n   152\t   \"label\": \"it\",\n   153\t   \"order\": 1\n   154\t  },\n   155\t  \"Gemma-4-31B-Base\": {\n   156\t   \"family\": \"Gemma 4 31B\",\n   157\t   \"stage\": \"base\",\n   158\t   \"label\": \"Base\",\n   159\t   \"order\": 0\n   160\t  },\n   161\t  \"gemma-4-31B-it\": {\n   162\t   \"family\": \"Gemma 4 31B\",\n   163\t   \"stage\": \"post-trained\",\n   164\t   \"label\": \"it\",\n   165\t   \"order\": 1\n   166\t  },\n   167\t  \"DeepSeek-V4-Flash-Base\": {\n   168\t   \"family\": \"DeepSeek V4 Flash\",\n   169\t   \"stage\": \"base\",\n   170\t   \"label\": \"Base\",\n   171\t   \"order\": 0\n   172\t  },\n   173\t  \"DeepSeek-V4-Flash\": {\n   174\t   \"family\": \"DeepSeek V4 Flash\",\n   175\t   \"stage\": \"post-trained\",\n   176\t   \"label\": \"Instruct\",\n   177\t   \"order\": 1\n   178\t  },\n   179\t  \"DeepSeek-V3-Base\": {\n   180\t   \"family\": \"DeepSeek V3 671B-A37B\",\n   181\t   \"stage\": \"base\",\n   182\t   \"label\": \"Base\",\n   183\t   \"order\": 0\n   184\t  },\n   185\t  \"cogito-671b-v2.1\": {\n   186\t   \"family\": \"DeepSeek V3 671B-A37B\",\n   187\t   \"stage\": \"post-trained\",\n   188\t   \"label\": \"Cogito v2.1 (light finetune of Base)\",\n   189\t   \"order\": 1\n   190\t  },\n   191\t  \"DeepSeek-V3\": {\n   192\t   \"family\": \"DeepSeek V3 671B-A37B\",\n   193\t   \"stage\": \"post-trained\",\n   194\t   \"label\": \"Chat\",\n   195\t   \"order\": 2\n   196\t  },\n   197\t  \"kimi-k2-base\": {\n   198\t   \"family\": \"Kimi K2 1T-A32B\",\n   199\t   \"stage\": \"base\",\n   200\t   \"label\": \"Base\",\n   201\t   \"order\": 0\n   202\t  },\n   203\t  \"Kimi-K2-Instruct\": {\n   204\t   \"family\": \"Kimi K2 1T-A32B\",\n   205\t   \"stage\": \"post-trained\",\n   206\t   \"label\": \"Instruct\",\n   207\t   \"order\": 1\n   208\t  },\n   209\t  \"MiMo-V2.5-Base\": {\n   210\t   \"family\": \"MiMo V2.5\",\n   211\t   \"stage\": \"base\",\n   212\t   \"label\": \"Base\",\n   213\t   \"order\": 0\n   214\t  },\n   215\t  \"MiMo-V2.5\": {\n   216\t   \"family\": \"MiMo V2.5\",\n   217\t   \"stage\": \"post-trained\",\n   218\t   \"label\": \"Instruct\",\n   219\t   \"order\": 1\n   220\t  },\n   221\t  \"Olmo-3-32B-stage1\": {\n   222\t   \"family\": \"OLMo-3 32B\",\n   223\t   \"stage\": \"pre-anneal\",\n   224\t   \"label\": \"stage 1 · step 656k (pre-mid-training)\",\n   225\t   \"order\": 0\n   226\t  }\n   227\t }\n   228\t}     1\t{\n     2\t  \"manifest_version\": 1,\n     3\t  \"latest\": \"bench_v3.json\",\n     4\t  \"bundles\": [\n     5\t    {\n     6\t      \"file\": \"bench_v1.json\",\n     7\t      \"schema_version\": 1,\n     8\t      \"generated\": \"2026-10-13\",\n     9\t      \"n_models\": 32\n    10\t    },\n    11\t    {\n    12\t      \"file\": \"bench_v2.json\",\n    13\t      \"schema_version\": 1,\n    14\t      \"generated\": \"2026-10-13\",\n    15\t      \"n_models\": 34\n    16\t    },\n    17\t    {\n    18\t      \"file\": \"bench_v3.json\",\n    19\t      \"schema_version\": 1,\n    20\t      \"generated\": \"2026-10-13\",\n    21\t      \"n_models\": 35\n    22\t    }\n    23\t  ]\n    24\t}\n     1\timport { readFileSync, readdirSync } from \"node:fs\";\n     2\timport { fileURLToPath } from \"node:url\";\n     3\timport { dirname, join, resolve } from \"node:path\";\n     4\timport { parseBundleJson } from \"../data/parse\";\n     5\timport { latestFromManifest } from \"../data/load\";\n     6\timport type { Bundle, Manifest } from \"../data/types\";\n     7\t\n     8\tconst here = dirname(fileURLToPath(import.meta.url));\n     9\texport const REPO = resolve(here, \"..\", \"..\", \"..\");\n    10\texport const DATA = join(REPO, \"data\");\n    11\texport const DOCS = join(REPO, \"docs\");\n    12\t\n    13\texport function readManifest(): Manifest {\n    14\t  return parseBundleJson<Manifest>(readFileSync(join(DATA, \"manifest.json\"), \"utf8\"));\n    15\t}\n    16\t\n    17\t/** Every bench_v<N>.json in data/ (the contract applies to all shipped bundles). */\n    18\texport function bundleFiles(): string[] {\n    19\t  return readdirSync(DATA).filter((f) => /^bench_v\\d+\\.json$/.test(f));\n    20\t}\n    21\t\n    22\texport function readBundle(file?: string): Bundle {\n    23\t  const f = file ?? latestFromManifest(readManifest());\n    24\t  return parseBundleJson<Bundle>(readFileSync(join(DATA, f), \"utf8\"));\n    25\t}\n    26\t\n    27\texport function readRaw(file: string): string {\n    28\t  return readFileSync(join(DATA, file), \"utf8\");\n    29\t}\n    30\t\n    31\texport function readDoc(name: string): string {\n    32\t  return readFileSync(join(DOCS, name), \"utf8\");\n    33\t}\n     1\timport { describe, expect, it } from \"vitest\";\n     2\timport { recompute, subScore } from \"../data/scoring\";\n     3\timport { SUB_KEYS } from \"../data/types\";\n     4\timport { bundleFiles, readBundle } from \"./helpers\";\n     5\t\n     6\tconst TOL = 1e-9; // stricter than the 1e-6 the contract allows\n     7\t\n     8\tfor (const file of bundleFiles()) {\n     9\t  const b = readBundle(file);\n    10\t  describe(`score recomputation from the fingerprint: ${file}`, () => {\n    11\t    for (const m of b.models) {\n    12\t      it(`${m.id}`, () => {\n    13\t        const r = recompute(m.fingerprint);\n    14\t        if (m.score === null) expect(r.overall).toBeNull();\n    15\t        else {\n    16\t          expect(r.overall).not.toBeNull();\n    17\t          expect(Math.abs(r.overall! - m.score)).toBeLessThanOrEqual(TOL);\n    18\t        }\n    19\t        for (const k of SUB_KEYS) {\n    20\t          const stored = m.subscores[k];\n    21\t          const got = r.subscores[k];\n    22\t          if (!stored || stored.score === null) {\n    23\t            expect(got.score).toBeNull();\n    24\t            continue;\n    25\t          }\n    26\t          expect(got.score).not.toBeNull();\n    27\t          expect(Math.abs(got.score! - stored.score)).toBeLessThanOrEqual(TOL);\n    28\t          expect(got.source).toBe(stored.source);\n    29\t          if (stored.value !== null) expect(Math.abs(got.value! - stored.value)).toBeLessThanOrEqual(TOL);\n    30\t        }\n    31\t      });\n    32\t    }\n    33\t  });\n    34\t}\n    35\t\n    36\tdescribe(\"ramp behaviour\", () => {\n    37\t  it(\"clips calib positive gaps to 1 and saturates at the anchors\", () => {\n    38\t    expect(subScore(\"calib\", 0.05)).toBe(1);\n    39\t    expect(subScore(\"calib\", -0.05)).toBeCloseTo(0.5, 12);\n    40\t    expect(subScore(\"calib\", -0.5)).toBe(0);\n    41\t    expect(subScore(\"spread\", 0.015)).toBe(1);\n    42\t    expect(subScore(\"spread\", 0.1)).toBe(0);\n    43\t    expect(subScore(\"memo\", 0.07)).toBeCloseTo(0.5, 12);\n    44\t    expect(subScore(\"prior\", 0.2)).toBeCloseTo(0.5, 12);\n    45\t    expect(subScore(\"prior\", null)).toBeNull();\n    46\t  });\n    47\t  it(\"falls back to the Pile features when post-cutoff ones are missing\", () => {\n    48\t    const r = recompute({ calib_gap: -0.02, calib_gap_domain_absmean: 0.05, verbatim_run_frac_wiki: 0.02, roll_instr_marker_rate: 0 });\n    49\t    expect(r.subscores.calib.source).toBe(\"calib_gap\");\n    50\t    expect(r.subscores.spread.source).toBe(\"calib_gap_domain_absmean\");\n    51\t    expect(r.subscores.memo.source).toBe(\"verbatim_run_frac_wiki\");\n    52\t    expect(r.nAvail).toBe(4);\n    53\t  });\n    54\t  it(\"averages only the available sub-scores\", () => {\n    55\t    const r = recompute({ F_calib_gap: 0, F_gap_domain_absmean: 0.015, X_runfrac_wiki: 0.12 });\n    56\t    expect(r.nAvail).toBe(3);\n    57\t    expect(r.overall).toBeCloseTo(2 / 3, 12);\n    58\t  });\n    59\t});\n     1\timport { describe, expect, it } from \"vitest\";\n     2\timport { RAMPS, RUN_H_MAX, RUN_MIN_LEN, SURNAME_PROMPTS } from \"../data/method\";\n     3\timport { SUB_KEYS } from \"../data/types\";\n     4\timport { bundleFiles, readBundle, readDoc } from \"./helpers\";\n     5\t\n     6\t/** Parse a Python dict literal of string -> string from the script source (simple, literal-only). */\n     7\tfunction pyStringDict(src: string, name: string): Record<string, string> {\n     8\t  const start = src.indexOf(`${name} = {`);\n     9\t  expect(start).toBeGreaterThanOrEqual(0);\n    10\t  const body = src.slice(start, src.indexOf(\"\\n}\", start));\n    11\t  const out: Record<string, string> = {};\n    12\t  const re = /\"(\\w+)\":\\s*\"((?:[^\"\\\\]|\\\\.)*)\",?/g;\n    13\t  let m: RegExpExecArray | null;\n    14\t  while ((m = re.exec(body))) out[m[1]] = JSON.parse(`\"${m[2]}\"`);\n    15\t  return out;\n    16\t}\n    17\t\n    18\tdescribe(\"method.ts mirrors the measurement scripts\", () => {\n    19\t  it(\"RAMPS equal docs/vh_truebase.py\", () => {\n    20\t    const src = readDoc(\"vh_truebase.py\");\n    21\t    const block = src.slice(src.indexOf(\"RAMPS = {\"), src.indexOf(\"}\", src.indexOf(\"RAMPS = {\")));\n    22\t    const re = /\"(\\w+)\":\\s*\\(([-\\d.e]+),\\s*([-\\d.e]+)\\)/g;\n    23\t    const py: Record<string, [number, number]> = {};\n    24\t    let m: RegExpExecArray | null;\n    25\t    while ((m = re.exec(block))) py[m[1]] = [parseFloat(m[2]), parseFloat(m[3])];\n    26\t    expect(Object.keys(py).sort()).toEqual([...SUB_KEYS].sort());\n    27\t    for (const k of SUB_KEYS) expect(RAMPS[k]).toEqual(py[k]);\n    28\t  });\n    29\t  it(\"surname frames equal SURNAME_PROMPTS in docs/vh_score.py\", () => {\n    30\t    const py = pyStringDict(readDoc(\"vh_score.py\"), \"SURNAME_PROMPTS\");\n    31\t    expect(Object.keys(py).length).toBeGreaterThanOrEqual(6);\n    32\t    expect(SURNAME_PROMPTS).toEqual(py);\n    33\t  });\n    34\t  it(\"run rule equals the runs_mask defaults in docs/vh_memo.py\", () => {\n    35\t    const m = /def runs_mask\\([^)]*minlen=(\\d+),\\s*hthr=([\\d.]+)\\)/.exec(readDoc(\"vh_memo.py\"));\n    36\t    expect(m).not.toBeNull();\n    37\t    expect(RUN_MIN_LEN).toBe(parseInt(m![1], 10));\n    38\t    expect(RUN_H_MAX).toBe(parseFloat(m![2]));\n    39\t  });\n    40\t});\n    41\t\n    42\tfor (const file of bundleFiles()) {\n    43\t  describe(`bundle reference.* agrees with method.ts when present: ${file}`, () => {\n    44\t    const b = readBundle(file);\n    45\t    it(\"reference.ramps\", () => {\n    46\t      if (!b.reference.ramps) return;\n    47\t      for (const k of SUB_KEYS) expect(b.reference.ramps[k]).toEqual(RAMPS[k]);\n    48\t    });\n    49\t    it(\"reference.method\", () => {\n    50\t      const m = b.reference.method;\n    51\t      if (!m) return;\n    52\t      if (m.run_min_len !== undefined) expect(m.run_min_len).toBe(RUN_MIN_LEN);\n    53\t      if (m.run_H_max !== undefined) expect(m.run_H_max).toBe(RUN_H_MAX);\n    54\t    });\n    55\t    it(\"reference.surname_frames\", () => {\n    56\t      const f = b.reference.surname_frames;\n    57\t      if (!f) return;\n    58\t      const all = Object.values(SURNAME_PROMPTS);\n    59\t      for (const t of [...(f.desc ?? []), ...(f.few ?? [])]) expect(all).toContain(t);\n    60\t    });\n    61\t  });\n    62\t}\n","exit_code":0,"status":"completed"}}
