{"type":"item.completed","item":{"id":"item_52","type":"command_execution","command":"/bin/zsh -lc \"nl -ba site/src/pages/Leaderboard.tsx | sed -n '30,125p'\nnl -ba site/src/pages/Leaderboard.tsx | sed -n '220,357p'\nnl -ba site/src/components/Bars.tsx | sed -n '1,150p'\nnl -ba site/src/charts/FindingCharts.tsx | sed -n '228,313p'\nnl -ba site/src/explainers/surnames.tsx | sed -n '30,64p'\nnl -ba site/src/explainers/surnames.tsx | sed -n '327,359p'\"","aggregated_output":"    30\ttype SortKey = \"overall\" | SubKey | \"model\" | \"stage\" | \"size\";\n    31\tconst SIZES: SizeBucket[] = [\"lt15\", \"15to100\", \"gt100\", \"unknown\"];\n    32\t\n    33\tfunction csv(v: string | null): string[] {\n    34\t  return v ? v.split(\",\").filter(Boolean) : [];\n    35\t}\n    36\t\n    37\tfunction rawFmt(k: SubKey, v: number | null): string {\n    38\t  if (SUB_META[k].unit === \"share\") return fmt(v, \"pct\");\n    39\t  return k === \"calib\" ? fmt(v, \"gap\") : fmt(v, \"nats\");\n    40\t}\n    41\t\n    42\texport function anchorsText(k: SubKey): string {\n    43\t  const [one, zero] = RAMPS[k];\n    44\t  const f = (x: number) => (SUB_META[k].unit === \"share\" ? fmt(x, \"pct\") : fmtNum(x, k === \"calib\" ? \"signed\" : \"num3\").replace(/^\\+/, \"\"));\n    45\t  return `1 at ${f(one)}, 0 at ${f(zero)}`;\n    46\t}\n    47\t\n    48\texport function cellTitle(m: Model, k: SubKey): string {\n    49\t  const s = m.subscores?.[k];\n    50\t  if (!s || s.score === null) return `${k}: not measured; overall is the mean of the ${nAvailable(m)} available`;\n    51\t  return `${k} ${fmtNum(s.score, \"score\")} ← ${s.source ?? SUB_META[k].feature} ${rawFmt(k, s.value)} (${anchorsText(k)})`;\n    52\t}\n    53\t\n    54\tfunction headerTitle(k: SubKey): string {\n    55\t  const m = SUB_META[k];\n    56\t  return `${m.name}: ${m.feature}; ${anchorsText(k)}. Reads as ${m.readsAs}.`;\n    57\t}\n    58\t\n    59\tfunction SubCell({ m, k, raw }: { m: Model; k: SubKey; raw: boolean }) {\n    60\t  const s = m.subscores?.[k] ?? null;\n    61\t  const title = cellTitle(m, k);\n    62\t  if (raw) {\n    63\t    const [good, bad] = RAMPS[k];\n    64\t    return (\n    65\t      <span className=\"subcell\" title={title}>\n    66\t        <RampCell value={s?.value ?? null} good={good} bad={bad} title={title} />\n    67\t        <span className=\"v\">{rawFmt(k, s?.value ?? null)}</span>\n    68\t      </span>\n    69\t    );\n    70\t  }\n    71\t  return (\n    72\t    <span className=\"subcell\" title={title}>\n    73\t      <ScoreBar value={s?.score ?? null} width={64} height={6} title={title} />\n    74\t      <span className=\"v\">{fmtNum(s?.score ?? null, \"score\")}</span>\n    75\t    </span>\n    76\t  );\n    77\t}\n    78\t\n    79\tfunction MicroBars({ m }: { m: Model }) {\n    80\t  return (\n    81\t    <span className=\"micro\">\n    82\t      {SUB_KEYS.map((k) => (\n    83\t        <span key={k} title={cellTitle(m, k)}>\n    84\t          <span className=\"k\">{SUB_META[k].short}</span>\n    85\t          <ScoreBar value={m.subscores?.[k]?.score ?? null} width={36} height={5} />\n    86\t          <span className=\"v\">{fmtNum(m.subscores?.[k]?.score ?? null, \"score\")}</span>\n    87\t        </span>\n    88\t      ))}\n    89\t    </span>\n    90\t  );\n    91\t}\n    92\t\n    93\tfunction Comb({ m }: { m: Model }) {\n    94\t  const h = 24;\n    95\t  return (\n    96\t    <svg width={4 * 12} height={h + 12} role=\"img\" aria-label={SUB_KEYS.map((k) => `${SUB_META[k].name} ${fmtNum(m.subscores?.[k]?.score ?? null, \"score\")}`).join(\", \")}>\n    97\t      {SUB_KEYS.map((k, i) => {\n    98\t        const v = m.subscores?.[k]?.score ?? null;\n    99\t        return (\n   100\t          <g key={k} transform={`translate(${i * 12},0)`}>\n   101\t            <title>{cellTitle(m, k)}</title>\n   102\t            <rect width={6} height={h} fill={v === null ? \"url(#hatch)\" : \"var(--track)\"} />\n   103\t            {v !== null && <rect y={h - v * h} width={6} height={v * h} fill=\"var(--bar)\" />}\n   104\t            <text x={3} y={h + 11} textAnchor=\"middle\">\n   105\t              {SUB_META[k].short}\n   106\t            </text>\n   107\t          </g>\n   108\t        );\n   109\t      })}\n   110\t    </svg>\n   111\t  );\n   112\t}\n   113\t\n   114\tfunction Sparkline({ rungs }: { rungs: Model[] }) {\n   115\t  const w = 120;\n   116\t  const h = 28;\n   117\t  const pts = rungs.filter((r) => r.score !== null);\n   118\t  if (pts.length < 2) return null;\n   119\t  const x = linear([0, rungs.length - 1], [5, w - 5]);\n   120\t  const y = linear([0, 1], [h - 4, 4]);\n   121\t  return (\n   122\t    <svg width={w} height={h} role=\"img\" aria-label={`overall across rungs: ${pts.map((p) => fmtNum(p.score, \"score\")).join(\", \")}`}>\n   123\t      <line x1={0} x2={w} y1={y(0.5)} y2={y(0.5)} stroke=\"var(--rule)\" />\n   124\t      <polyline points={rungs.map((r, i) => (r.score === null ? \"\" : `${x(i)},${y(r.score)}`)).join(\" \")} fill=\"none\" stroke=\"var(--ink-3)\" />\n   125\t      {rungs.map((r, i) => (r.score === null ? null : <GlyphShape key={r.id} stage={r.stage} x={x(i)} y={y(r.score)} size={6} />))}\n   220\t  const [famOpen, setFamOpen] = useState(false);\n   221\t\n   222\t  const stages = csv(sp.get(\"stage\")) as Stage[];\n   223\t  const famSel = csv(sp.get(\"family\"));\n   224\t  const sizes = csv(sp.get(\"size\")) as SizeBucket[];\n   225\t  const view = sp.get(\"view\") === \"ladders\" ? \"ladders\" : \"ranked\";\n   226\t  const sort = (sp.get(\"sort\") ?? \"overall\") as SortKey;\n   227\t  const dir = sp.get(\"dir\") === \"asc\" ? \"asc\" : sp.get(\"dir\") === \"desc\" ? \"desc\" : sort === \"model\" || sort === \"stage\" ? \"asc\" : \"desc\";\n   228\t  const raw = sp.get(\"raw\") === \"1\";\n   229\t  const q = sp.get(\"q\") ?? \"\";\n   230\t\n   231\t  function update(k: string, v: string | null) {\n   232\t    const n = new URLSearchParams(sp);\n   233\t