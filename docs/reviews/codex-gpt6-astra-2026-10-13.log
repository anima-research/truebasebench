; border: 1px solid var(--rule);\n    78\t  border-left: 3px solid var(--rule-strong); padding: 8px 10px; white-space: pre-wrap; overflow-wrap: anywhere; min-width: 0; margin: 0;\n    79\t  color: var(--ink); transition: opacity var(--dur-3);\n    80\t}\n    81\t.xp-card.dim { opacity: 0.45; }\n    82\t.xp-card-head { font-family: var(--f-sans); font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink-3); margin-bottom: 4px; display: block; white-space: normal; }\n    83\t.xp-card mark { background: var(--hl); color: var(--ink); padding: 0 2px; }\n    84\t.xp-card .ghost { color: transparent; }\n    85\t.xp-row2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; align-items: start; }\n    86\t@media (max-width: 559px) { .xp-row2 { grid-template-columns: 1fr; } }\n    87\t.xp-sub { margin-top: 14px; }\n    88\t.xp-sub-label { font-weight: 500; font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink-3); margin: 0 0 4px; }\n    89\t.xp-fade { transition: opacity var(--dur-3); }\n    90\t.xp-table { font-size: 12px; }\n    91\t.xp-toggle { margin: 6px 0; }\n    92\t.xp-editnote { font-size: 12px; color: var(--ink-2); margin: 6px 0 0; }\n    93\t.xp-eq { font-family: var(--f-mono); font-size: 12px; line-height: 18px; color: var(--ink); margin: 8px 0 0; overflow-wrap: anywhere; }\n    94\t.xp-eq .ink3 { color: var(--ink-3); }\n    95\t.xp-slider { cursor: ew-resize; touch-action: none; }\n    96\t.xp-slider:focus { outline: none; }\n    97\t.xp-slider:focus-visible .xp-slider-ring { stroke: var(--focus); }\n    98\t.xp-slider-ring { stroke: transparent; stroke-width: 2; fill: none; }\n    99\t.xp-srcchip { display: inline-block; font-family: var(--f-mono); font-size: 11px; border: 1px solid var(--rule-strong); padding: 0 4px; color: var(--ink-2); background: var(--bg-raised); }\n   100\t.xp-context { margin: 0 0 10px; }\n   101\t.xp-tagline { display: block; font-size: 11px; font-style: italic; color: var(--ink-3); }\n   102\t.xp-context-text { font-family: var(--f-serif); font-size: 17px; line-height: 26px; color: var(--ink); }\n   103\t.xp-caret { display: inline-block; width: 12px; height: 19px; vertical-align: -3px; border: 1.5px solid var(--ink); background: var(--hl); margin-left: 2px; }\n   104\t.xp-key { list-style: none; margin: 6px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 2px 14px; font-size: 12px; color: var(--ink-2); }\n   105\t.xp-key li { display: inline-flex; align-items: center; gap: 4px; padding: 0 2px; }\n   106\t.xp-key li.cur { background: var(--hl); color: var(--ink); }\n   107\t.xp-key-n { font-weight: 600; color: var(--ink); }\n   108\t.xp-sub-row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 6px 12px; margin-bottom: 6px; }\n   109\t.xp-sub-row .xp-sub-label { margin: 0; }\n   110\t.xp-tapes { display: flex; flex-direction: column; gap: 10px; }\n   111\t.xp-tapes.side { flex-direction: row; gap: 16px; }\n   112\t.xp-tape { min-width: 0; }\n   113\t.xp-tape-head { font-size: 12px; margin: 0 0 4px; display: flex; align-items: center; gap: 4px; flex-wrap: wrap; }\n   114\t.xp-tape-head .b { font-weight: 600; }\n   115\t.xp-tape-count { margin-left: auto; font-variant-numeric: tabular-nums; color: var(--ink); padding-left: 6px; }\n   116\t.xp-tag-line { font-size: 11px; font-style: italic; color: var(--ink-3); margin: 4px 0 0; }\n   117\t.xp-ramps { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px 16px; }\n   118\t.xp-ramp { min-width: 0; }\n   119\t.xp-ramp .xp-sub-label { margin-bottom: 2px; }\n   120\t.xp-walk { display: flex; align-items: center; gap: 8px; }\n   121\t/* A panel whose step has not been reached: its marks are dimmed, its text stays readable at --ink-3\n   122\t   (opacity on the whole panel took labels, table cells and focusable numbers far below 4.5:1). */\n   123\t.xp-sub.future :is(rect, circle, line, path, polyline, polygon, ellipse, img),\n   124\t.xp-sub.future :is(.bar, .hbar, .xp-bar, [class*=\"bar-fill\"]),\n   125\t.xp-key.future svg :is(rect, circle, line, path, polyline, polygon) { opacity: 0.3; }\n   126\t.xp-sub.future, .xp-sub.future :is(p, td, th, li, span, .num, .xp-sub-label, .xp-key-n),\n   127\t.xp-key.future, .xp-key.future :is(li, span, .num, .xp-key-n) { color: var(--ink-3); }\n   128\t.xp-sub.future svg text { fill: var(--ink-3); }\n     1\timport type { ReactNode } from \"react\";\n     2\timport { domainName, ladder, ladderColumns, STAGE_CODE, stageOrder } from \"../data/derive\";\n     3\timport { fp, path } from \"../data/bundle\";\n     4\timport type { Bundle, Model, ReliabilityBin, Stage } from \"../data/types\";\n     5\timport { ChartFrame, Mark, TipBody } from \"../components/Chart\";\n     6\timport { GlyphShape } from \"../components/Glyph\";\n     7\timport { XAxis, xTitleExtra, YAxis } from \"../components/Axis\";\n     8\timport { cmpNullsLast, fmt, fmtNum, fmtTick, isNum, type Fmt } from \"../lib/numfmt\";\n     9\timport { beeswarm, extent, linear, niceTicks, textWidth, wrapText } from \"../lib/scale\";\n    10\t\n    11\tconst href = (m: Model) => `/model/${encodeURIComponent(m.id)}`;\n    12\t\n    13\t/** Plate M1: the family's rungs in order, parallel rungs stacked, this model on an --hl band. */\n    14\texport function SiblingRail({ bundle, model }: { bundle: Bundle; model: Model }) {\n    15\t  const cols = ladderColumns(ladder(bundle, model.family));\n    16\t  const maxStack = Math.max(...cols.map((c) => c.length));\n    17\t  const label = `${model.family} ladder: ` + cols.map((c) => c.map((m) => `${m.label} (${m.stage}) ${fmt(m.score, \"score\")}`).join(\" / \")).join(\" → \");\n    18\t  return (\n    19\t    <ChartFrame ariaLabel={label}>\n    20\t      {(w) => {\n    21\t        const colW = Math.max(84, Math.min(150, (w - 20) / Math.max(1, cols.length)));\n    22\t        const narrow = colW * cols.length > w;\n    23\t        const perRow = narrow ? Math.max(1, Math.floor(w / 96)) : cols.length;\n    24\t        const cw = narrow ? w / perRow : colW;\n    25\t        const rowH = 22 + maxStack * 46;\n    26\t        const rows = Math.ceil(cols.length / perRow);\n    27\t        const pos = (ci: number, si: number) => ({\n    28\t          x: (ci % perRow) * cw + cw / 2,\n    29\t          y: Math.floor(ci / perRow) * rowH + 14 + si * 46,\n    30\t        });\n    31\t        return (\n    32\t          <svg width={w} height={rows * rowH}>\n    33\t            {cols.map((_col, ci) => {\n    34\t              const p = pos(ci, 0);\n    35\t              const q = ci + 1 < cols.length ? pos(ci + 1, 0) : null;\n    36\t              return q && q.y === p.y ? <line key={\"l\" + ci} x1={p.x} x2={q.x} y1={p.y} y2={q.y} stroke=\"var(--rule-strong)\" /> : null;\n    37\t            })}\n    38\t            {cols.flatMap((col, ci) =>\n    39\t              col.map((m, si) => {\n    40\t                const p = pos(ci, si);\n    41\t                const me = m.id === model.id;\n    42\t                return (\n    43\t                  <g key={m.id}>\n    44\t                    {me && <rect x={p.x - cw / 2 + 3} y={p.y - 12} width={cw - 6} height={44} fill=\"var(--hl)\" />}\n    45\t                    <Mark\n    46\t                      x={p.x}\n    47\t                      y={p.y}\n    48\t                      href={me ? undefined : href(m)}\n    49\t                      label={`${m.label}, ${m.stage}, overall ${fmt(m.score, \"score\")}${me ? \" (this checkpoint)\" : \"\"}`}\n    50\t                      tip={<TipBody title={m.label} lines={[`${m.stage} · overall ${fmtNum(m.score, \"score\")}`]} path={path(m, \"score\")} />}\n    51\t                    >\n    52\t                      <GlyphShape stage={m.stage} x={p.x} y={p.y} size={9} />\n    53\t                    </Mark>\n    54\t                    <text x={p.x} y={p.y + 17} textAnchor=\"middle\" style={{ fill: \"var(--ink)\", fontSize: 11, fontWeight: me ? 600 : 400 }}>\n    55\t                      {truncate(m.label, Math.floor(cw / 6))}\n    56\t                    </text>\n    57\t                    <text x={p.x} y={p.y + 29} textAnchor=\"middle\" style={me ? { fill: \"var(--ink)\" } : undefined}>\n    58\t                      {fmtNum(m.score, \"score\")}\n    59\t                    </text>\n    60\t                  </g>\n    61\t                );\n    62\t              }),\n    63\t            )}\n    64\t          </svg>\n    65\t        );\n    66\t      }}\n    67\t    </ChartFrame>\n    68\t  );\n    69\t}\n    70\t\n    71\tfunction truncate(s: string, n: number): string {\n    72\t  return s.length > n ? s.slice(0, Math.max(3, n - 1)) + \"…\" : s;\n    73\t}\n    74\t\n    75\t/** Plate M3: top-1 reliability diagram + 24px count histogram. */\n    76\texport function ReliabilityDiagram({ model, compare = [] }: { model: Model; compare?: Model[] }) {\n    77\t  const series = [model, ...compare]\n    78\t    .map((m) => ({ m, bins: (m.selfboot?.reliability?.bins ?? null) as ReliabilityBin[] | null }))\n    79\t    .filter((s) => s.bins && s.bins.length);\n    80\t  const main = series.find((s) => s.m.id === model.id);\n    81\t  const label =\n    82\t    `Top-1 reliability on post-cutoff text for ${model.label}: ` +\n    83\t    (main?.bins ?? []).map((b) => `confidence ${fmtNum(b[3], \"num2\")} accuracy ${fmtNum(b[4], \"num2\")}`).join(\"; \");\n    84\t  return (\n    85\t    <ChartFrame ariaLabel={label} maxWidth={380}>\n    86\t      {(w) => {\n    87\t        const size = Math.max(220, Math.min(340, w - 50));\n    88\t        const L = 40;\n    89\t        const T = 24;\n    90\t        const x = linear([0, 1], [L, L + size]);\n    91\t        const y = linear([0, 1], [T + size, T]);\n    92\t        const maxCount = Math.max(1, ...series.flatMap((s) => s.bins!.map((b) => b[2])));\n    93\t        const hTop = T + size + 40;\n    94\t        const hH = 24;\n    95\t        const mainBins = main?.bins ?? [];\n    96\t        const maxMain = Math.max(1, ...mainBins.map((b) => b[2]));\n    97\t        return (\n    98\t          <svg width={L + size + 10} height={hTop + hH + 30}>\n    99\t            <rect x={L} y={T} width={size} height={size} fill=\"var(--bg)\" opacity={0.5} />\n   100\t            <XAxis scale={x} y={T + size} ticks={[0, 0.2, 0.4, 0.6, 0.8, 1]} format={(v) => String(+v.toFixed(1))} gridTop={T} />\n   101\t            <YAxis scale={y} x={L} ticks={[0, 0.2, 0.4, 0.6, 0.8, 1]} format={(v) => String(+v.toFixed(1))} gridRight={L + size} />\n   102\t            <line x1={x(0)} y1={y(0)} x2={x(1)} y2={y(1)} stroke=\"var(--ink-2)\" strokeDasharray=\"4 3\" />\n   103\t            <text x={x(0.62)} y={y(0.66)} transform={`rotate(-45 ${x(0.62)} ${y(0.66)})`} textAnchor=\"middle\" style={{ fontSize: 11 }}>\n   104\t              perfectly calibrated\n   105\t            </text>\n   106\t            <text x={x(0.97)} y={y(0.06)} textAnchor=\"end\" style={{ fontStyle: \"italic\" }}>\n   107\t              over-confident\n   108\t            </text>\n   109\t            <text x={x(0.03)} y={y(0.92)} style={{ fontStyle: \"italic\" }}>\n   110\t              under-confident\n   111\t            </text>\n   112\t            <text x={L + size} y={T + size + 30} textAnchor=\"end\" style={{ fill: \"var(--ink-2)\" }}>\n   113\t              mean top-1 confidence (bins[i][3])\n   114\t            </text>\n   115\t            <text x={L - 30} y={10} style={{ fill: \"var(--ink-2)\" }}>\n   116\t              accuracy (bins[i][4])\n   117\t            </text>\n   118\t            {series.map((s) => {\n   119\t              const hollow = s.m.id !== model.id;\n   120\t              const pts = s.bins!.filter((b) => isNum(b[3]) && isNum(b[4]) && b[2] > 0);\n   121\t              return (\n   122\t                <g key={s.m.id}>\n   123\t                  <polyline\n   124\t                    points={pts.map((b) => `${x(b[3]!)},${y(b[4]!)}`).join(\" \")}\n   125\t                    fill=\"none\"\n   126\t                    stroke={hollow ? \"var(--ink-3)\" : \"var(--ink)\"}\n   127\t                    strokeWidth={1.5}\n   128\t                    strokeDasharray={hollow ? \"4 3\" : undefined}\n   129\t                  />\n   130\t                  {pts.map((b, i) => {\n   131\t                    const sz = 4 + 10 * Math.sqrt(b[2] / maxCount);\n   132\t                    return (\n   133\t                      <Mark\n   134\t                        key={i}\n   135\t                        x={x(b[3]!)}\n   136\t                        y={y(b[4]!)}\n   137\t                        label={`${s.m.label}, bin ${fmtNum(b[0], \"num2\")}–${fmtNum(b[1], \"num2\")}: confidence ${fmtNum(b[3], \"num3\")}, accuracy ${fmtNum(b[4], \"num3\")}, ${fmt(b[2], \"count\")} positions`}\n   138\t                        tip={\n   139\t                          <TipBody\n   140\t                            title={`${s.m.label} · bin ${fmtNum(b[0], \"num2\")}–${fmtNum(b[1], \"num2\")}`}\n   141\t                            lines={[`confidence ${fmtNum(b[3], \"num3\")}`, `accuracy ${fmtNum(b[4], \"num3\")}`, `${fmt(b[2], \"count\")} positions`]}\n   142\t                            path={`${path(s.m, \"selfboot.reliability.bins\")}[${i}]`}\n   143\t                          />\n   144\t                        }\n   145\t                      >\n   146\t                        <GlyphShape stage={s.m.stage} x={x(b[3]!)} y={y(b[4]!)} size={sz} hollow={hollow} />\n   147\t                      </Mark>\n   148\t                    );\n   149\t                  })}\n   150\t                </g>\n   151\t              );\n   152\t            })}\n   153\t            {/* count histogram */}\n   154\t            {mainBins.map((b, i) => {\n   155\t              const hh = (b[2] / maxMain) * hH;\n   156\t              return <rect key={i} x={x(b[0]) + 1} width={Math.max(1, x(b[1]) - x(b[0]) - 2)} y={hTop + hH - hh} height={hh} fill=\"var(--bar)\" />;\n   157\t            })}\n   158\t            <line x1={L} x2={L + size} y1={hTop + hH} y2={hTop + hH} stroke=\"var(--rule-strong)\" />\n   159\t            <text x={L} y={hTop + hH + 14}>\n   160\t              positions per confidence bin (max {fmt(maxMain, \"count\")})\n   161\t            </text>\n   162\t          </svg>\n   163\t        );\n   164\t      }}\n   165\t    </ChartFrame>\n   166\t  );\n   167\t}\n   168\t\n   169\t/** Rows of labelled dots: model filled, compare hollow, sorted by the model's value. */\n   170\texport function DotRows({\n   171\t  rows,\n   172\t  model,\n   173\t  compare = [],\n   174\t  fmtKind = \"nats\",\n   175\t  axisTitle,\n   176\t  zero = false,\n   177\t  band,\n   178\t}: {\n   179\t  rows: { key: string; label: string; values: Record<string, number | null>; paths?: Record<string, string> }[];\n   180\t  model: Model;\n   181\t  compare?: Model[];\n   182\t  fmtKind?: Fmt;\n   183\t  axisTitle: string;\n   184\t  zero?: boolean;\n   185\t  band?: number;\n   186\t}) {\n   187\t  const all = rows.flatMap((r) => Object.values(r.values));\n   188\t  const ex = extent(zero ? [...all, 0] : all) ?? [0, 1];\n   189\t  const pad = (ex[1] - ex[0]) * 0.06 || 0.1;\n   190\t  const dom: [number, number] = [ex[0] - pad, ex[1] + pad];\n   191\t  const label = `${axisTitle}: ` + rows.map((r) => `${r.label} ${fmt(r.values[model.id], fmtKind)}`).join(\"; \");\n   192\t  return (\n   193\t    <ChartFrame ariaLabel={label}>\n   194\t      {(w) => {\n   195\t        const L = Math.min(150, w * 0.38);\n   196\t        const x = linear(dom, [L, w - 12]);\n   197\t        const rh = 20;\n   198\t        // long axis titles wrap (XAxis) on narrow charts: reserve the extra lines so the unit is never cut off\n   199\t        const H = rows.length * rh + 40 + xTitleExtra(axisTitle, w - 12 - L);\n   200\t        return (\n   201\t          <svg width={w} height={H}>\n   202\t            {band !== undefined && <rect x={x(-band)} width={x(band) - x(-band)} y={0} height={rows.length * rh} fill=\"var(--band)\" />}\n   203\t            {zero && <line x1={x(0)} x2={x(0)} y1={0} y2={rows.length * rh} stroke=\"var(--zero)\" strokeWidth={1.5} />}\n   204\t            {rows.map((r, i) => {\n   205\t              const cy = i * rh + rh / 2;\n   206\t              return (\n   207\t                <g key={r.key}>\n   208\t                  <line x1={L} x2={w - 12} y1={cy} y2={cy} stroke=\"var(--rule)\" />\n   209\t                  <text x={L - 8} y={cy} dy=\"0.32em\" textAnchor=\"end\" style={{ fill: \"var(--ink-2)\" }}>\n   210\t                    {r.label}\n   211\t                  </text>\n   212\t                  {compare.map((c) =>\n   213\t                    isNum(r.values[c.id]) ? (\n   214\t                      <Mark\n   215\t                        key={c.id}\n     1\timport { useEffect, useMemo } from \"react\";\n     2\timport { headingsOf, Markdown, splitTitle, type BlockMap, type ValueMap } from \"./Markdown\";\n     3\timport { useScrollSpy } from \"../lib/useScrollSpy\";\n     4\t\n     5\t/** A reading page rendered from markdown (src/content/*.md): rail from ## headings, prose in the main track. */\n     6\texport function ReadingPage({\n     7\t  source,\n     8\t  blocks,\n     9\t  values,\n    10\t  docTitle,\n    11\t  before,\n    12\t}: {\n    13\t  source: string;\n    14\t  blocks?: BlockMap;\n    15\t  values?: ValueMap;\n    16\t  docTitle: string;\n    17\t  before?: React.ReactNode;\n    18\t}) {\n    19\t  const { title, body } = useMemo(() => splitTitle(source), [source]);\n    20\t  const heads = useMemo(() => headingsOf(body, 2), [body]);\n    21\t  const ids = useMemo(() => heads.map((h) => h.id), [heads]);\n    22\t  const active = useScrollSpy(ids);\n    23\t  useEffect(() => {\n    24\t    document.title = docTitle;\n    25\t  }, [docTitle]);\n    26\t  return (\n    27\t    <div className=\"container\">\n    28\t      <div className=\"reading\">\n    29\t        <nav className=\"rail\" aria-label=\"On this page\">\n    30\t          <div className=\"rail-inner\">\n    31\t            <ol>\n    32\t              {heads.map((h) => (\n    33\t                <li key={h.id}>\n    34\t                  <a href={`#${h.id}`} aria-current={active === h.id ? \"true\" : undefined}>\n    35\t                    {h.text}\n    36\t                  </a>\n    37\t                </li>\n    38\t              ))}\n    39\t            </ol>\n    40\t          </div>\n    41\t        </nav>\n    42\t        <div className=\"wide\">\n    43\t          <header className=\"page-head\">\n    44\t            <h1>{title}</h1>\n    45\t            <ul className=\"chiprow\" aria-label=\"On this page\">\n    46\t              {heads.map((h) => (\n    47\t                <li key={h.id}>\n    48\t                  <a href={`#${h.id}`} aria-current={active === h.id ? \"true\" : undefined}>\n    49\t                    {h.text}\n    50\t                  </a>\n    51\t                </li>\n    52\t              ))}\n    53\t            </ul>\n    54\t          </header>\n    55\t          {before}\n    56\t          <Markdown source={body} blocks={blocks} values={values} />\n    57\t        </div>\n    58\t      </div>\n    59\t    </div>\n    60\t  );\n    61\t}\n     1\t/**\n     2\t * Markdown -> React, via marked's lexer (no innerHTML). Two house extensions:\n     3\t *   inline  {{num:<bundle path>|<fmt>}}   -> <Num> (live, provenance-bearing)\n     4\t *   inline  {{def:<NAME>|<fmt>}}           -> <Num def> from METHOD_DEFS (a definition, not a measurement)\n     5\t *   block   {{explainer:<id>}}             -> mounts registry[id] from src/explainers, or a pending slot\n     6\t */\n     7\timport { Marked, type Token, type Tokens, type TokenizerAndRendererExtension } from \"marked\";\n     8\timport { createContext, Fragment, useContext, useMemo, type ReactNode } from \"react\";\n     9\timport { Link } from \"react-router-dom\";\n    10\timport { METHOD_DEFS } from \"../data/method\";\n    11\timport type { Fmt } from \"../lib/numfmt\";\n    12\timport { Num } from \"./Num\";\n    13\timport { docsLink } from \"../lib/config\";\n    14\timport { CopyButton } from \"./CopyButton\";\n    15\timport { ExplainerSlot } from \"../explainers/ExplainerSlot\";\n    16\t\n    17\tinterface NumToken {\n    18\t  type: \"tbbnum\";\n    19\t  raw: string;\n    20\t  kind: \"num\" | \"def\";\n    21\t  path: string;\n    22\t  fmt: Fmt;\n    23\t}\n    24\tinterface ValToken {\n    25\t  type: \"tbbval\";\n    26\t  raw: string;\n    27\t  name: string;\n    28\t}\n    29\tinterface ExplainerToken {\n    30\t  type: \"tbbexplainer\";\n    31\t  raw: string;\n    32\t  id: string;\n    33\t  kind: \"explainer\" | \"block\";\n    34\t}\n    35\t\n    36\t/** Named blocks a page can provide to its markdown via {{block:<name>}}. */\n    37\texport type BlockMap = Record<string, () => ReactNode>;\n    38\t/** Named inline values (computed on the page, e.g. a derived range) for {{val:<name>}}. */\n    39\texport type ValueMap = Record<string, () => ReactNode>;\n    40\tconst ValuesContext = createContext<ValueMap>({});\n    41\tfunction Val({ name }: { name: string }) {\n    42\t  const values = useContext(ValuesContext);\n    43\t  const v = values[name];\n    44\t  return v ? <>{v()}</> : <span className=\"ink3\">[missing value “{name}”]</span>;\n    45\t}\n    46\t\n    47\tconst numExt: TokenizerAndRendererExtension = {\n    48\t  name: \"tbbnum\",\n    49\t  level: \"inline\",\n    50\t  start: (src: string) => {\n    51\t    const i = src.indexOf(\"{{\");\n    52\t    return i < 0 ? undefined : i;\n    53\t  },\n    54\t  tokenizer(src: string) {\n    55\t    const m = /^\\{\\{(num|def):([^|}]+)(?:\\|(\\w+))?\\}\\}/.exec(src);\n    56\t    if (!m) return undefined;\n    57\t    return { type: \"tbbnum\", raw: m[0], kind: m[1], path: m[2].trim(), fmt: (m[3] ?? \"num3\") as Fmt } as NumToken;\n    58\t  },\n    59\t  renderer: () => \"\",\n    60\t};\n    61\tconst valExt: TokenizerAndRendererExtension = {\n    62\t  name: \"tbbval\",\n    63\t  level: \"inline\",\n    64\t  start: (src: string) => {\n    65\t    const i = src.indexOf(\"{{val:\");\n    66\t    return i < 0 ? undefined : i;\n    67\t  },\n    68\t  tokenizer(src: string) {\n    69\t    const m = /^\\{\\{val:([\\w-]+)\\}\\}/.exec(src);\n    70\t    if (!m) return undefined;\n    71\t    return { type: \"tbbval\", raw: m[0], name: m[1] } as ValToken;\n    72\t  },\n    73\t  renderer: () => \"\",\n    74\t};\n    75\tconst explainerExt: TokenizerAndRendererExtension = {\n    76\t  name: \"tbbexplainer\",\n    77\t  level: \"block\",\n    78\t  start: (src: string) => {\n    79\t    const m = /\\{\\{(explainer|block):/.exec(src);\n    80\t    return m ? m.index : undefined;\n    81\t  },\n    82\t  tokenizer(src: string) {\n    83\t    const m = /^\\{\\{(explainer|block):([\\w-]+)\\}\\}[ \\t]*(?:\\n+|$)/.exec(src);\n    84\t    if (!m) return undefined;\n    85\t    return { type: \"tbbexplainer\", raw: m[0], id: m[2], kind: m[1] } as ExplainerToken;\n    86\t  },\n    87\t  renderer: () => \"\",\n    88\t};\n    89\t\n    90\tconst marked = new Marked({ gfm: true });\n    91\tmarked.use({ extensions: [numExt, valExt, explainerExt] });\n    92\t\n    93\texport function slug(s: string): string {\n    94\t  return s\n    95\t    .toLowerCase()\n    96\t    .replace(/[^\\w\\s-]/g, \"\")\n    97\t    .trim()\n    98\t    .replace(/\\s+/g, \"-\");\n    99\t}\n   100\t\n   101\tfunction plain(tokens: Token[] | undefined): string {\n   102\t  return (tokens ?? []).map((t) => (\"tokens\" in t && t.tokens ? plain(t.tokens as Token[]) : \"text\" in t ? String(t.text) : \"\")).join(\"\");\n   103\t}\n   104\t\n   105\tfunction inline(tokens: Token[] | undefined): ReactNode[] {\n   106\t  return (tokens ?? []).map((t, i) => {\n   107\t    switch (t.type) {\n   108\t      case \"text\": {\n   109\t        const tt = t as Tokens.Text;\n   110\t        return tt.tokens ? <Fragment key={i}>{inline(tt.tokens)}</Fragment> : <Fragment key={i}>{decode(tt.text)}</Fragment>;\n   111\t      }\n   112\t      case \"escape\":\n   113\t        return <Fragment key={i}>{decode((t as Tokens.Escape).text)}</Fragment>;\n   114\t      case \"strong\":\n   115\t        return <strong key={i}>{inline((t as Tokens.Strong).tokens)}</strong>;\n   116\t      case \"em\":\n   117\t        return <em key={i}>{inline((t as Tokens.Em).tokens)}</em>;\n   118\t      case \"del\":\n   119\t        return <del key={i}>{inline((t as Tokens.Del).tokens)}</del>;\n   120\t      case \"codespan\": {\n   121\t        const text = decode((t as Tokens.Codespan).text);\n   122\t        const m = /^(vh_\\w+\\.py)$/.exec(text);\n   123\t        const href = m ? docsLink(m[1]) : null;\n   124\t        return href ? (\n   125\t          <a key={i} href={href}>\n   126\t            <code>{text}</code>\n   127\t          </a>\n   128\t        ) : (\n   129\t          <code key={i}>{text}</code>\n   130\t        );\n   131\t      }\n   132\t      case \"br\":\n   133\t        return <br key={i} />;\n   134\t      case \"link\": {\n   135\t        const l = t as Tokens.Link;\n   136\t        const kids = inline(l.tokens);\n   137\t        if (l.href.startsWith(\"/\") || l.href.startsWith(\"#\"))\n   138\t          return l.href.startsWith(\"#\") ? (\n   139\t            <a key={i} href={l.href}>\n   140\t              {kids}\n   141\t            </a>\n   142\t          ) : (\n   143\t            <Link key={i} to={l.href}>\n   144\t              {kids}\n   145\t            </Link>\n   146\t          );\n   147\t        return (\n   148\t          <a key={i} href={l.href} rel=\"noopener noreferrer\">\n   149\t            {kids}\n   150\t          </a>\n   151\t        );\n   152\t      }\n   153\t      case \"image\": {\n   154\t        const im = t as Tokens.Image;\n   155\t        return <img key={i} src={im.href} alt={im.text} style={{ maxWidth: \"100%\" }} />;\n   156\t      }\n   157\t      case \"tbbval\":\n   158\t        return <Val key={i} name={(t as unknown as ValToken).name} />;\n   159\t      case \"tbbnum\": {\n   160\t        const n = t as unknown as NumToken;\n   161\t        if (n.kind === \"def\") {\n   162\t          const v = METHOD_DEFS[n.path];\n   163\t          return <Num key={i} path={`method.${n.path}`} value={v ?? null} fmt={n.fmt} def />;\n   164\t        }\n   165\t        return <Num key={i} path={n.path} fmt={n.fmt} />;\n   166\t      }\n   167\t      default:\n   168\t        return <Fragment key={i}>{\"raw\" in t ? decode(String(t.raw)) : null}</Fragment>;\n   169\t    }\n   170\t  });\n   171\t}\n   172\t\n   173\tfunction decode(s: string): string {\n   174\t  return s\n   175\t    .replace(/&quot;/g, '\"')\n   176\t    .replace(/&#39;/g, \"'\")\n   177\t    .replace(/&lt;/g, \"<\")\n   178\t    .replace(/&gt;/g, \">\")\n   179\t    .replace(/&amp;/g, \"&\");\n   180\t}\n   181\t\n   182\t/** \"Title {#id}\" -> explicit id */\n   183\tfunction headingId(tokens: Token[] | undefined): { id: string; strip: boolean } {\n   184\t  const text = plain(tokens);\n   185\t  const m = /\\{#([\\w-]+)\\}\\s*$/.exec(text);\n   186\t  return m ? { id: m[1], strip: true } : { id: slug(text), strip: false };\n   187\t}\n   188\tfunction stripId(tokens: Token[] | undefined): Token[] {\n   189\t  const ts = [...(tokens ?? [])];\n   190\t  const last = ts[ts.length - 1];\n   191\t  if (last && last.type === \"text\") ts[ts.length - 1] = { ...last, text: (last as Tokens.Text).text.replace(/\\s*\\{#[\\w-]+\\}\\s*$/, \"\"), tokens: undefined } as Token;\n   192\t  return ts;\n   193\t}\n   194\t\n   195\tfunction blocks(tokens: Token[], extra: BlockMap = {}): ReactNode[] {\n   196\t  return tokens.map((t, i) => {\n   197\t    switch (t.type) {\n   198\t      case \"space\":\n   199\t      case \"html\":\n   200\t        return null;\n   201\t      case \"heading\": {\n   202\t        const h = t as Tokens.Heading;\n   203\t        const { id, strip } = headingId(h.tokens);\n   204\t        const kids = inline(strip ? stripId(h.tokens) : h.tokens);\n   205\t        if (h.depth === 1) return <h1 key={i} id={id}>{kids}</h1>;\n   206\t        if (h.depth === 2) return <h2 key={i} id={id}>{kids}</h2>;\n   207\t        return <h3 key={i} id={id}>{kids}</h3>;\n   208\t      }\n   209\t      case \"paragraph\":\n   210\t        return <p key={i}>{inline((t as Tokens.Paragraph).tokens)}</p>;\n   211\t      case \"text\":\n   212\t        return <p key={i}>{inline((t as Tokens.Text).tokens ?? [t])}</p>;\n   213\t      case \"blockquote\":\n   214\t        return <blockquote key={i}>{blocks((t as Tokens.Blockquote).tokens, extra)}</blockquote>;\n   215\t      case \"hr\":\n   216\t        return <hr key={i} style={{ border: 0, borderTop: \"1px solid var(--rule)\" }} />;\n   217\t      case \"code\": {\n   218\t        const c = t as Tokens.Code;\n   219\t        return (\n   220\t          <pre key={i} className=\"code\">\n   221\t            <code>{c.text}</code>\n   222\t            <CopyButton className=\"copy\" text={c.text} />\n   223\t          </pre>\n   224\t        );\n   225\t      }\n   226\t      case \"list\": {\n   227\t        const l = t as Tokens.List;\n   228\t        const items = l.items.map((it, j) => (\n   229\t          <li key={j}>{it.tokens.length === 1 && it.tokens[0].type === \"text\" ? inline((it.tokens[0] as Tokens.Text).tokens) : blocks(it.tokens, extra)}</li>\n   230\t        ));\n   231\t        return l.ordered ? (\n   232\t          <ol key={i} start={typeof l.start === \"number\" ? l.start : undefined}>\n   233\t            {items}\n   234\t          </ol>\n   235\t        ) : (\n   236\t          <ul key={i}>{items}</ul>\n   237\t        );\n   238\t      }\n   239\t      case \"table\": {\n   240\t        const tb = t as Tokens.Table;\n","exit_code":0,"status":"completed"}}
