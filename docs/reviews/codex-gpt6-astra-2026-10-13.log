{"type":"item.completed","item":{"id":"item_44","type":"command_execution","command":"/bin/zsh -lc \"rg -n 'no-cache|metadata|sha256|validate|latest|corpus|put_object|ContentType|CacheControl' tools/upload_data.py && nl -ba site/src/data/bench.schema.json | sed -n '1,180p'\nnl -ba site/src/data/manifest.schema.json\nnl -ba site/src/pages/ModelPage.tsx | sed -n '580,638p'\nnl -ba site/src/pages/Findings.tsx | sed -n '382,423p'\"","aggregated_output":"5:there yet). With --corpus-dir, also publishes the five fixed measurement corpora under corpus/ together with a\n6:corpus/SHA256SUMS file, so that submitters measure on exactly the same text (see the site's \"Measure your model\"). Every file is parsed and checked before anything is sent; unchanged objects (same MD5 as the\n20:Cache policy (the site always revalidates with fetch(..., {cache: \"no-cache\"}), so these mostly govern\n22:    manifest.json          Cache-Control: no-cache                  (the pointer to the latest bundle)\n24:    corpus/*               Cache-Control: public, max-age=86400     (fixed inputs; checked by SHA256SUMS)\n31:    python tools/upload_data.py --corpus-dir /path/to/corpus --corpus-only --verify   # publish the corpora\n53:CACHE_MANIFEST = \"no-cache\"\n56:CORPUS_PREFIX = \"corpus/\"\n93:def sha256_file(path: str) -> str:\n94:    h = hashlib.sha256()\n101:def plan_corpus(corpus_dir: str) -> List[Tuple[str, str]]:\n102:    \"\"\"Return [(corpus/<file>, path)] for the five corpora plus corpus/SHA256SUMS (written into corpus_dir).\n106:    if not os.path.isdir(corpus_dir):\n107:        raise UploadError(f\"--corpus-dir {corpus_dir} is not a directory\")\n108:    missing = [f for f in CORPUS_FILES if not os.path.exists(os.path.join(corpus_dir, f))]\n110:        raise UploadError(f\"--corpus-dir {corpus_dir} lacks {', '.join(missing)}\")\n113:        path = os.path.join(corpus_dir, f)\n122:        sums.append(f\"{sha256_file(path)}  {f}\\n\")\n123:    with open(os.path.join(corpus_dir, CORPUS_SUMS), \"w\", encoding=\"utf-8\") as fh:\n125:    return [(CORPUS_PREFIX + f, os.path.join(corpus_dir, f)) for f in CORPUS_FILES + (CORPUS_SUMS,)]\n216:        s3.put_object(Bucket=cfg[\"bucket\"], Key=key, Body=body, ACL=\"public-read\", ContentType=ct,\n217:                      CacheControl=cc, ContentMD5=base64.b64encode(hashlib.md5(body).digest()).decode())\n261:    ap.add_argument(\"--dry-run\", action=\"store_true\", help=\"validate and list, send nothing (no credentials needed)\")\n269:    ap.add_argument(\"--corpus-dir\", default=None,\n271:                         \"under corpus/, with a generated corpus/SHA256SUMS\")\n272:    ap.add_argument(\"--corpus-only\", action=\"store_true\", help=\"with --corpus-dir: publish only the corpora, not data/\")\n280:        if args.corpus_only and not args.corpus_dir:\n281:            raise UploadError(\"--corpus-only needs --corpus-dir\")\n282:        files = [] if args.corpus_only else plan(args.data_dir, args.only)\n283:        if args.corpus_dir:\n284:            files = plan_corpus(args.corpus_dir) + files  # corpora first; manifest.json stays last\n     1\t{\n     2\t  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n     3\t  \"$id\": \"https://truebasebench/bench.schema.json\",\n     4\t  \"title\": \"True Base Bench bundle\",\n     5\t  \"description\": \"data/bench_v<N>.json (docs/SPEC.md, Data contract). NaN/Infinity in the raw file are read as null (not measured).\",\n     6\t  \"type\": \"object\",\n     7\t  \"required\": [\"schema_version\", \"generated\", \"n_models\", \"reference\", \"models\"],\n     8\t  \"properties\": {\n     9\t    \"schema_version\": { \"type\": \"integer\", \"enum\": [1] },\n    10\t    \"generated\": { \"type\": \"string\", \"pattern\": \"^\\\\d{4}-\\\\d{2}-\\\\d{2}\" },\n    11\t    \"n_models\": { \"type\": \"integer\", \"minimum\": 0 },\n    12\t    \"reference\": {\n    13\t      \"type\": \"object\",\n    14\t      \"properties\": {\n    15\t        \"census_entropy_top2000\": { \"$ref\": \"#/definitions/numOrNull\" },\n    16\t        \"census_self_entropy_all\": { \"$ref\": \"#/definitions/numOrNull\" },\n    17\t        \"pile_lexical\": { \"oneOf\": [{ \"type\": \"null\" }, { \"$ref\": \"#/definitions/numMap\" }] },\n    18\t        \"ramps\": {\n    19\t          \"oneOf\": [\n    20\t            { \"type\": \"null\" },\n    21\t            {\n    22\t              \"type\": \"object\",\n    23\t              \"additionalProperties\": { \"type\": \"array\", \"items\": { \"type\": \"number\" }, \"minItems\": 2, \"maxItems\": 2 }\n    24\t            }\n    25\t          ]\n    26\t        },\n    27\t        \"method\": { \"type\": [\"object\", \"null\"] },\n    28\t        \"surname_frames\": { \"type\": [\"object\", \"null\"] },\n    29\t        \"passes\": { \"type\": [\"object\", \"null\"] }\n    30\t      }\n    31\t    },\n    32\t    \"models\": { \"type\": \"array\", \"items\": { \"$ref\": \"#/definitions/model\" } },\n    33\t    \"explainers\": { \"type\": [\"object\", \"null\"] }\n    34\t  },\n    35\t  \"definitions\": {\n    36\t    \"numOrNull\": { \"type\": [\"number\", \"null\"] },\n    37\t    \"numMap\": { \"type\": \"object\", \"additionalProperties\": { \"type\": [\"number\", \"null\"] } },\n    38\t    \"subscore\": {\n    39\t      \"oneOf\": [\n    40\t        { \"type\": \"null\" },\n    41\t        {\n    42\t          \"type\": \"object\",\n    43\t          \"required\": [\"score\", \"value\", \"source\"],\n    44\t          \"properties\": {\n    45\t            \"score\": { \"type\": [\"number\", \"null\"], \"minimum\": 0, \"maximum\": 1 },\n    46\t            \"value\": { \"type\": [\"number\", \"null\"] },\n    47\t            \"source\": { \"type\": [\"string\", \"null\"] }\n    48\t          }\n    49\t        }\n    50\t      ]\n    51\t    },\n    52\t    \"triple\": {\n    53\t      \"oneOf\": [\n    54\t        { \"type\": \"null\" },\n    55\t        { \"type\": \"array\", \"items\": { \"type\": [\"number\", \"null\"] }, \"minItems\": 3, \"maxItems\": 3 }\n    56\t      ]\n    57\t    },\n    58\t    \"tailPass\": { \"oneOf\": [{ \"type\": \"null\" }, { \"$ref\": \"#/definitions/numMap\" }] },\n    59\t    \"bin\": {\n    60\t      \"type\": \"array\",\n    61\t      \"minItems\": 5,\n    62\t      \"maxItems\": 5,\n    63\t      \"items\": { \"type\": [\"number\", \"null\"] }\n    64\t    },\n    65\t    \"model\": {\n    66\t      \"type\": \"object\",\n    67\t      \"required\": [\"id\", \"family\", \"stage\", \"label\", \"order\", \"score\", \"subscores\", \"fingerprint\", \"surnames\", \"weird\", \"selfboot\", \"tail\"],\n    68\t      \"properties\": {\n    69\t        \"id\": { \"type\": \"string\", \"minLength\": 1 },\n    70\t        \"family\": { \"type\": \"string\", \"minLength\": 1 },\n    71\t        \"stage\": { \"enum\": [\"pre-anneal\", \"anneal\", \"base\", \"post-trained\"] },\n    72\t        \"label\": { \"type\": \"string\", \"minLength\": 1 },\n    73\t        \"order\": { \"type\": \"integer\", \"minimum\": 0 },\n    74\t        \"score\": { \"type\": [\"number\", \"null\"], \"minimum\": 0, \"maximum\": 1 },\n    75\t        \"subscores\": {\n    76\t          \"type\": \"object\",\n    77\t          \"required\": [\"calib\", \"spread\", \"memo\", \"prior\"],\n    78\t          \"properties\": {\n    79\t            \"calib\": { \"$ref\": \"#/definitions/subscore\" },\n    80\t            \"spread\": { \"$ref\": \"#/definitions/subscore\" },\n    81\t            \"memo\": { \"$ref\": \"#/definitions/subscore\" },\n    82\t            \"prior\": { \"$ref\": \"#/definitions/subscore\" }\n    83\t          }\n    84\t        },\n    85\t        \"fingerprint\": { \"oneOf\": [{ \"type\": \"null\" }, { \"$ref\": \"#/definitions/numMap\" }] },\n    86\t        \"surnames\": {\n    87\t          \"oneOf\": [\n    88\t            { \"type\": \"null\" },\n    89\t            {\n    90\t              \"type\": \"object\",\n  