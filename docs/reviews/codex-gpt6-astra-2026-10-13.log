ath.min(k, nb - 1);\n   130\t    const fromX = L + bw * (bi + 0.5);\n   131\t    const fromY = y(k < N_BARS ? p : barsOf(cur)[nb - 1]);\n   132\t    const d = easeSettle(stagger(prog.drop, bi, nb, 0.45, 0.5));\n   133\t    if (sur > LANE_MAX && d >= 1) {\n   134\t      beyond += 1;\n   135\t      beyondMass += p;\n   136\t      continue;\n   137\t    }\n   138\t    const toX = x(Math.min(sur, LANE_MAX));\n   139\t    const toY = laneY - r;\n   140\t    if (prog.drop <= 0) continue;\n   141\t    dots.push({ cx: lerp(fromX, toX, d), cy: lerp(fromY, toY, d), r, key: k });\n   142\t  }\n   143\t  const fx = lerp(x(0), x(H), easeInOut(prog.fulcrum));\n   144\t  const leftFirst = s < H; // label placement: the smaller value's label goes to the left\n   145\t  const sY = lerp(laneY - 120, laneY - 6, easeSettle(prog.s));\n   146\t  const totalH = axisY + 44;\n   147\t  const tokenLabel = (i: number) => (cur.tokens ? cur.tokens[i] ?? \"\" : `t${i + 1}`);\n   148\t  const showEvery = bw >= 22 ? 1 : 2;\n   149\t  return (\n   150\t    <svg width={W} height={totalH} viewBox={`0 0 ${W} ${totalH}`}>\n   151\t      {/* distribution */}\n   152\t      <text x={L - 34} y={narrow ? 28 : 12} className=\"ink2\">\n   153\t        probability\n   154\t      </text>\n   155\t      <Tag x={narrow ? 0 : W - R} y={12} anchor={narrow ? \"start\" : \"end\"}>\n   156\t        {cur.measured ? \"measured at one post-cutoff position\" : \"distribution shape constructed; H and s from bundle\"}\n   157\t      </Tag>\n   158\t      {yTicks.map((v) => (\n   159\t        <g key={v}>\n   160\t          <line x1={L} x2={L + pw} y1={y(v)} y2={y(v)} stroke=\"var(--rule)\" />\n   161\t          <text x={L - 6} y={y(v)} dy=\"0.32em\" textAnchor=\"end\">\n   162\t            {fmtNum(v, \"num2\")}\n   163\t          </text>\n   164\t        </g>\n   165\t      ))}\n   166\t      {barsA.map((_, i) => {\n   167\t        const v = B ? lerp(barsA[i] ?? 0, barsB[i] ?? 0, mix) : barsA[i];\n   168\t        const h = (barBase - y(v)) * easeSettle(stagger(prog.bars, i, nb, 0.4, 0.55));\n   169\t        const last = i === nb - 1;\n   170\t        return (\n   171\t          <g key={i}>\n   172\t            <rect x={L + bw * i + 1.5} width={Math.max(1, bw - 3)} y={barBase - h} height={h} fill={last ? \"var(--rule-strong)\" : \"var(--bar)\"} />\n   173\t            {(i % showEvery === 0 || last) && (\n   174\t              <text x={L + bw * (i + 0.5)} y={barBase + 13} textAnchor=\"middle\" className={cur.tokens && !last ? \"mono\" : undefined}>\n   175\t                {last ? \"rest\" : tokenLabel(i)}\n   176\t              </text>\n   177\t            )}\n   178\t          </g>\n   179\t        );\n   180\t      })}\n   181\t      <line x1={L} x2={L + pw} y1={barBase} y2={barBase} stroke=\"var(--rule-strong)\" />\n   182\t      <text x={L + pw} y={barBase + 27} textAnchor=\"end\">\n   183\t        “rest” = all other tokens{cur.measured ? \"\" : `, ${N_CAND - N_BARS} pooled`}\n   184\t      </text>\n   185\t\n   186\t      {/* surprisal lane */}\n   187\t      <text x={L} y={laneY - 112} className=\"xp-panel\">\n   188\t        Surprisal lane\n   189\t      </text>\n   190\t      <line x1={L} x2={L + pw} y1={laneY} y2={laneY} stroke=\"var(--ink-2)\" strokeWidth={1} />\n   191\t      {/* ±√V band (constructed, not printed) */}\n   192\t      {prog.band > 0 && sdV > 0 && (\n   193\t        <g opacity={prog.band}>\n   194\t          <line x1={x(Math.max(0, H - sdV))} x2={x(Math.min(LANE_MAX, H + sdV))} y1={laneY - 40} y2={laneY - 40} stroke=\"var(--ink-2)\" />\n   195\t          <line x1={x(Math.max(0, H - sdV))} x2={x(Math.max(0, H - sdV))} y1={laneY - 44} y2={laneY - 36} stroke=\"var(--ink-2)\" />\n   196\t          <line x1={x(Math.min(LANE_MAX, H + sdV))} x2={x(Math.min(LANE_MAX, H + sdV))} y1={laneY - 44} y2={laneY - 36} stroke=\"var(--ink-2)\" />\n   197\t          <text x={x(Math.min(LANE_MAX, H + sdV)) + 4} y={laneY - 40} dy=\"0.32em\" className=\"it\">\n   198\t            ±√V {cur.measured ? \"\" : \"(constructed)\"}\n   199\t          </text>\n   200\t        </g>\n   201\t      )}\n   202\t      {dots.map((d) => (\n   203\t        <circle key={d.key} cx={d.cx} cy={d.cy} r={d.r} fill=\"var(--bar)\" fillOpacity={0.78} stroke=\"var(--bg-plate)\" strokeWidth={0.5} />\n   204\t      ))}\n   205\t      {beyond > 0 && (\n   206\t        <text x={L + pw} y={laneY - 8} textAnchor=\"end\">\n   207\t          +{beyond} beyond {LANE_MAX} nats (p {fmt(beyondMass, \"pct\")}) →\n   208\t        </text>\n   209\t      )}\n   210\t      {/* ghost of A's H and s after the switch */}\n   211\t      {ghost && B && mix >= 1 && (\n   212\t        <g>\n   213\t          <line x1={x(A.H)} x2={x(A.H)} y1={laneY - 24} y2={laneY + 12} stroke=\"var(--ink-3)\" strokeDasharray=\"2 2\" />\n   214\t          <circle cx={x(A.s)} cy={laneY - 6} r={5} fill=\"none\" stroke=\"var(--ink-3)\" strokeWidth={1.5} />\n   215\t          <text x={x(Math.max(A.H, A.s)) + 8} y={laneY + 4} className=\"it\">\n   216\t            A\n   217\t          </text>\n   218\t        </g>\n   219\t      )}\n   220\t      {/* fulcrum: entropy as the balance point */}\n   221\t      {prog.fulcrum > 0 && (\n   222\t        <g>\n   223\t          <polygon points={`${fx},${laneY + 1} ${fx + 7},${laneY + 14} ${fx - 7},${laneY + 14}`} fill=\"var(--ink)\" />\n   224\t          {prog.fulcrum >= 1 && (\n   225\t            <>\n   226\t              <line x1={x(H)} x2={x(H)} y1={laneY - 52} y2={laneY} stroke=\"var(--ink)\" strokeDasharray=\"3 2\" />\n   227\t              <text x={x(H) + (leftFirst ? 4 : -4)} y={laneY - 56} textAnchor={leftFirst ? \"start\" : \"end\"} className=\"ink b\">\n   228\t                H = {fmt(cur.H, \"nats\")}\n   229\t              </text>\n   230\t            </>\n   231\t          )}\n   232\t        </g>\n   233\t      )}\n   234\t      {/* real token */}\n   235\t      {prog.s > 0 && (\n   236\t        <g>\n   237\t          <circle cx={x(s)} cy={sY} r={6} fill=\"var(--hl)\" stroke=\"var(--ink)\" strokeWidth={2} />\n   238\t          {prog.s >= 1 && (\n   239\t            <text x={x(s) + (leftFirst ? -4 : 4)} y={laneY - 56} textAnchor={leftFirst ? \"end\" : \"start\"} className=\"ink\">\n   240\t              s = {fmt(cur.s, \"nats\")}\n   241\t            </text>\n   242\t          )}\n   243\t        </g>\n   244\t      )}\n   245\t      {/* the gap bracket, from s to H */}\n   246\t      {prog.gap > 0 && (\n   247\t        <g>\n   248\t          {(() => {\n   249\t            const x0 = x(s);\n   250\t            const x1 = lerp(x0, x(H), prog.gap);\n   251\t            const by = laneY - 76;\n   252\t            return (\n   253\t              <>\n   254\t                <line x1={x0} x2={x1} y1={by} y2={by} stroke=\"var(--ink)\" strokeWidth={1.5} />\n   255\t                <line x1={x0} x2={x0} y1={by - 4} y2={by + 4} stroke=\"var(--ink)\" strokeWidth={1.5} />\n   256\t                <line x1={x1} x2={x1} y1={by - 4} y2={by + 4} stroke=\"var(--ink)\" strokeWidth={1.5} />\n   257\t                {prog.gap > 0.5 && (\n   258\t                  <text x={Math.min(L + pw - 4, Math.max(L + 4, (x0 + x(H)) / 2))} y={by - 8} textAnchor=\"middle\" className=\"ink b\">\n   259\t                    H − s = {fmt(cur.gap, \"gap\")}\n   260\t                  </text>\n   261\t                )}\n   262\t              </>\n   263\t            );\n   264\t          })()}\n   265\t        </g>\n   266\t      )}\n   267\t      <XAxis scale={x} y={axisY} ticks={[0, 1, 2, 3, 4, 5, 6, 7, 8]} format={(v) => String(v)} title=\"surprisal −log p, nats (linear)\" titleOffset={34} />\n   268\t    </svg>\n   269\t  );\n   270\t}\n    45\t  pile: boolean;\n    46\t}\n    47\t\n    48\t/** The second family with a pre-anneal rung (other than the specimen family), most rungs first. */\n    49\tfunction secondFamily(bundle: Bundle, first: string | null): string | null {\n    50\t  const fams = Array.from(new Set(bundle.models.filter((m) => m.stage === \"pre-anneal\").map((m) => m.family))).filter((f) => f !== first);\n    51\t  fams.sort((a, b) => ladder(bundle, b).length - ladder(bundle, a).length || a.localeCompare(b));\n    52\t  return fams[0] ?? null;\n    53\t}\n    54\t\n    55\tfunction GenreRows({ width, A, B, band }: { width: number; A: Model; B: Model; band: number }) {\n    56\t  const genres = Array.from(new Set([...Object.keys(A.weird ?? {}), ...Object.keys(B.weird ?? {})]));\n    57\t  genres.sort((a, b) => (a === \"ALL\" ? -1 : b === \"ALL\" ? 1 : a.localeCompare(b)));\n    58\t  const val = (m: Model, g: string) => {\n    59\t    const r = m.weird?.[g];\n    60\t    return r && isNum(r[0]) ? r[0] : null;\n    61\t  };\n    62\t  const vals = genres.flatMap((g) => [val(A, g), val(B, g)]).filter(isNum);\n    63\t  if (!genres.length || !vals.length) return <p className=\"small ink3\">Rare-genre pass not run for these checkpoints.</p>;\n    64\t  const m = Math.max(band, ...vals.map(Math.abs)) * 1.08;\n    65\t  const LW = Math.min(112, width * 0.4);\n    66\t  const x = linear([-m, m], [LW, width - 6]);\n    67\t  const rowH = 15;\n    68\t  const top = 6;\n    69\t  const axisY = top + genres.length * rowH + 2;\n    70\t  return (\n    71\t    <svg width={width} height={axisY + 40} viewBox={`0 0 ${width} ${axisY + 40}`}>\n    72\t      <rect x={x(-band)} width={x(band) - x(-band)} y={top} height={genres.length * rowH} fill=\"var(--band)\" />\n    73\t      <line x1={x(0)} x2={x(0)} y1={top} y2={axisY} stroke=\"var(--zero)\" strokeWidth={1.5} />\n    74\t      {genres.map((g, i) => {\n    75\t        const y = top + i * rowH + rowH / 2;\n    76\t        const a = val(A, g);\n    77\t        const b = val(B, g);\n    78\t        return (\n    79\t          <g key={g}>\n    80\t            <text x={LW - 6} y={y} dy=\"0.32em\" textAnchor=\"end\" className={g === \"ALL\" ? \"ink b\" : undefined}>\n    81\t              {g === \"ALL\" ? \"all genres\" : g}\n    82\t            </text>\n    83\t            {isNum(a) && isNum(b) && <line x1={x(a)} x2={x(b)} y1={y} y2={y} stroke=\"var(--rule-strong)\" />}\n    84\t            {isNum(b) && (\n    85\t              <g>\n    86\t                <title>{`${B.label}, ${g}: ${fmt(b, \"gap\")}`}</title>\n    87\t                <GlyphShape stage={B.stage} x={x(b)} y={y} size={7} hollow />\n    88\t              </g>\n    89\t            )}\n    90\t            {isNum(a) && (\n    91\t              <g>\n    92\t                <title>{`${A.label}, ${g}: ${fmt(a, \"gap\")}`}</title>\n    93\t                <GlyphShape stage={A.stage} x={x(a)} y={y} size={7} />\n    94\t              </g>\n    95\t            )}\n    96\t          </g>\n    97\t        );\n    98\t      })}\n    99\t      <XAxis scale={x} y={axisY} ticks={niceTicks(-m, m, 4)} format={(v) => fmtTick(v, { signed: true })} title=\"gap mean(H − s), nats · Pile rare genres\" titleOffset={32} />\n   100\t    </svg>\n   101\t  );\n   102\t}\n   103\t\n   104\texport default function CalibrationGap({ bundle, reducedMotion }: ExplainerProps) {\n   105\t  const sp = specimenPair(bundle);\n   106\t  const [ids, setIds] = useState<(string | null)[]>([sp?.A.id ?? null, sp?.B.id ?? null]);\n   107\t  const [A, B] = resolveIds(bundle, ids, eligible);\n   108\t  const st = useStepper(DURS, reducedMotion);\n   109\t  const [ref, width] = useWidth<HTMLDivElement>(640);\n   110\t  const W = Math.min(640, width);\n   111\t  const clipId = useId().replace(/:/g, \"\");\n   112\t  const bandInfo = preAnnealBand(bundle);\n   113\t  const band = bandInfo?.band ?? 0;\n   114\t  const fam1 = specimenFamily(bundle);\n   115\t  const fam2 = secondFamily(bundle, fam1);\n   116\t  const con = useMemo(() => (A ? geometricWithEntropy(fp(A, \"F_H\")!, 64) : null), [A]);\n   117\t  const draws = useMemo(() => {\n   118\t    if (!A || !con) return [];\n   119\t    const r = rng(`calib:${A.id}`);\n   120\t    return Array.from({ length: N_DRAWS }, () => -Math.log(con.p[drawIndex(con.p, r())]));\n   121\t  }, [A, con]);\n   122\t  if (!A || !B || !con) return <p className=\"pending\">No checkpoint with F_H, F_CE and F_calib_gap in this bundle.</p>;\n   123\t\n   124\t  const pts: Pt[] = bundle.models.flatMap((m) => {\n   125\t    const g = gapOf(m);\n   168\texport default function Surnames({ bundle, reducedMotion }: ExplainerProps) {\n   169\t  const sp = specimenPair(bundle);\n   170\t  const [ids, setIds] = useState<(string | null)[]>([sp?.A.id ?? null, sp?.B.id ?? null]);\n   171\t  const [A, B] = resolveIds(bundle, ids, eligible);\n   172\t  const st = useStepper(DURS, reducedMotion);\n   173\t  const [ref, width] = useWidth<HTMLDivElement>(640);\n   174\t  const W = Math.min(640, width);\n   175\t  const Hc = bundle.reference.census_entropy_top2000;\n   176\t  if (!A || !B) return <p className=\"pending\">Surname test not run for any checkpoint in this bundle.</p>;\n   177\t  if (!isNum(Hc)) return <p className=\"pending\">reference.census_entropy_top2000 is missing from this bundle.</p>;\n   178\t  const total = Math.round(Math.exp(Hc));\n   179\t  const eff = (m: Model, k: string) => Math.exp(sv(m, k)!);\n   180\t  const fr = frames(bundle);\n   181\t  const fiveF = f5(bundle);\n   182\t  const range = fiveF.cleanRange;\n   183\t\n   184\t  const at = st.at;\n   185\t  // field state\n   186\t  let lit = total;\n   187\t  let who: { m: Model | null; frame: string } = { m: null, frame: \"Census\" };\n   188\t  if (st.step >= 2) {\n   189\t    lit = lerp(total, eff(A, \"H_desc\"), easeInOut(at(2)));\n   190\t    who = { m: A, frame: \"described\" };\n   191\t  }\n   192\t  if (st.step >= 3) {\n   193\t    const e = easeInOut(seg(at(3), 0.55, 1));\n   194\t    lit = lerp(eff(A, \"H_desc\"), eff(A, \"H_few\"), e);\n   195\t    if (e > 0) who = { m: A, frame: \"few-shot\" };\n   196\t  }\n   197\t  if (st.step >= 4) {\n   198\t    lit = lerp(eff(A, \"H_few\"), eff(B, \"H_few\"), easeInOut(at(4)));\n   199\t    if (at(4) > 0.5) who = { m: B, frame: \"few-shot\" };\n   200\t  }\n   201\t  const settled = st.t >= 1 || st.reduced || (st.step !== 2 && st.step !== 3 && st.step !== 4) || (st.step === 3 && at(3) < 0.55);\n   202\t  const fieldLabel = who.m ? `${who.m === A ? \"A\" : \"B\"} · ${who.frame}` : \"Census, top 2 000 surnames\";\n   203\t  const fieldValue = who.m ? eff(who.m, who.frame === \"described\" ? \"H_desc\" : \"H_few\") : total;\n   204\t  const fieldPath = who.m ? path(who.m, sk(who.frame === \"described\" ? \"H_desc\" : \"H_few\")) : \"reference.census_entropy_top2000\";\n   205\t  const curM = who.m ?? A;\n   206\t  const e3Rows = [\n   207\t    { name: \"Census\", v: sv(curM, \"top10_r\"), on: !who.m, fmtKind: \"pct\" as const },\n   208\t    { name: `${curM === A ? \"A\" : \"B\"} few-shot`, v: sv(curM, \"top10_few\"), on: who.frame === \"few-shot\", fmtKind: \"pct\" as const },\n   209\t    { name: `${curM === A ? \"A\" : \"B\"} described`, v: sv(curM, \"top10_desc\"), on: who.frame === \"described\", fmtKind: \"pct\" as const },\n   210\t  ];\n   211\t  // cards\n   212\t  const fewLines = fr.few.split(\"\\n\");\n   213\t  const itemLines = fewLines.filter((l) => /^\\d+\\.\\s*\\S/.test(l)).length;\n   214\t  const typed = st.step > 3 ? itemLines : st.step === 3 ? Math.floor(seg(at(3), 0, 0.5) * (itemLines + 0.999)) : 0;\n   215\t  const fewSlot = st.step > 3 || (st.step === 3 && at(3) >= 0.5);\n   216\t  const descSlot = st.step >= 0 && at(0) > 0 && st.step < 3;\n   217\t  let itemCount = 0;\n   218\t  const fewText = fewLines\n   219\t    .map((l) => {\n   220\t      if (/^\\d+\\.\\s*\\S/.test(l)) {\n   221\t        itemCount += 1;\n   222\t        return itemCount <= typed ? l : null;\n   223\t      }\n   224\t      if (/^\\d+\\.\\s*$/.test(l)) return fewSlot ? l : null;\n   225\t      return l;\n   226\t    })\n   227\t    .filter((l): l is string => l !== null)\n   228\t    .join(\"\\n\");\n   229\t  const pitch = Math.max(5, Math.min(9, Math.floor((W >= 560 ? W / 2 - 12 : W) / COLS)));\n   230\t  const side = W >= 560;\n   231\t  const topNames = topNamesOf(A, bundle);\n   232\t  const nullModels = bundle.models.filter((m) => !(isNum(sv(m, \"KL_few\")) || isNum(sv(m, \"KL_desc\"))));\n   233\t\n   234\t  const smithRows = [A, B].map((m, i) => ({ name: `${i === 0 ? \"A\" : \"B\"} ${m.label}`, v: sv(m, \"smith_plain\"), on: true, fmtKind: \"pct\" as const }));\n   235\t  const steps: StepSpec[] = [\n   640\t              </th>\n   641\t              <td className=\"n\">\n   642\t                {model.surnames ? <Num path={path(model, `surnames.${r.key}`)} fmt={r.kind} {...nullMeaning(r.key)} /> : \"—\"}\n   643\t              </td>\n   644\t              {compare.map((c) => (\n   645\t                <td key={c.id} className=\"n\">\n   646\t                  {c.surnames ? <Num path={path(c, `surnames.${r.key}`)} fmt={r.kind} {...nullMeaning(r.key)} /> : \"—\"}\n   647\t                </td>\n   648\t              ))}\n   649\t              <td className=\"n\">\n   650\t                {r.ref ? (\n   651\t                  <Num path={path(model, `surnames.${r.ref.path}`)} fmt={r.ref.kind} />\n   652\t                ) : r.key === \"surpr\" ? (\n   653\t                  <Num path=\"reference.census_self_entropy_all\" fmt=\"nats1\" />\n   654\t                ) : (\n   655\t                  <span className=\"ink3\">—</span>\n   656\t                )}\n   657\t              </td>\n   658\t            </tr>\n   659\t          ))}\n   660\t        </tbody>\n   661\t      </table>\n   662\t      {!bundle && null}\n   663\t    </div>\n   664\t  );\n   665\t}\n   666\t\n   667\t/** The reliability bin of `m` whose lower edge is `lo` (within 1e-9), or null. */\n   668\tfunction binAt(m: Model, lo: number | null): (number | null)[] | null {\n   669\t  const bins = m.selfboot?.reliability?.bins ?? [];\n   670\t  if (!isNum(lo)) return null;\n   671\t  return bins.find((b) => isNum(b[0]) && Math.abs(b[0] - lo) < 1e-9) ?? null;\n   672\t}\n   673\t\n   674\t/** True while the element scrolls sideways (content wider than its box): drives the \"scroll →\" cue. */\n   675\tfunction useOverflowX<T extends HTMLElement>(ref: React.RefObject<T>, deps: unknown[]): boolean {\n   676\t  const [over, setOver] = useState(false);\n   677\t  useEffect(() => {\n   678\t    const el = ref.current;\n   679\t    if (!el) return;\n   680\t    const check = () => setOver(el.scrollWidth > el.clientWidth + 1);\n   681\t    check();\n   682\t    if (typeof ResizeObserver === \"undefined\") return;\n   683\t    const ro = new ResizeObserver(check);\n   684\t    ro.observe(el);\n   685\t    return () => ro.disconnect();\n   686\t  }, deps);\n   687\t  return over;\n   688\t}\n   689\t\n   690\tfunction GenreTable({ model, compare, band }: { model: Model; compare: Model[]; band?: number }) {\n   691\t  const bundle = useBundle();\n   692\t  const [wrapRef, cw] = useWidth<HTMLDivElement>(900);\n   693\t  const scrollRef = useRef<HTMLDivElement>(null);\n   694\t  // Phones: the bar narrows and CE folds under the genre name, so the numbers stay on screen.\n   695\t  const narrow = cw < 600;\n   696\t  const barW = narrow ? 72 : 240;\n   697\t  const overflow = useOverflowX(scrollRef, [narrow, compare.length]);\n   698\t  const [sort, setSort] = useState<\"gap\" | \"runfrac\" | \"CE\" | \"genre\">(\"gap\");\n   699\t  const [asc, setAsc] = useState(true);\n   700\t  const maxGap = Math.max(\n   701\t    0.01,\n   702\t    ...bundle.models.flatMap((m) => Object.values(m.weird ?? {}).map((v) => (v && isNum(v[0]) ? Math.abs(v[0]) : 0))),\n   703\t  );\n   704\t  const entries = Object.entries(model.weird ?? {}).filter(([g]) => g !== \"ALL\");\n   705\t  const idx = { gap: 0, runfrac: 1, CE: 2 } as const;\n   706\t  entries.sort((a, b) => {\n   707\t    if (sort === \"genre\") return asc ? a[0].localeCompare(b[0]) : b[0].localeCompare(a[0]);\n   708\t    return cmpNullsLast(a[1]?.[idx[sort]], b[1]?.[idx[sort]], asc ? 1 : -1);\n   709\t  });\n   710\t  const all = model.weird?.ALL ? ([[\"ALL\", model.weird.ALL]] as typeof entries) : [];\n   711\t  const th = (k: typeof sort, label: string, n = true) => (\n   712\t    <th scope=\"col\" className={n ? \"n\" : undefined} aria-sort={sort === k ? (asc ? \"ascending\" : \"descending\") : \"none\"}>\n   713\t      <button\n   714\t        type=\"button\"\n   715\t        className=\"sort-btn\"\n     1\timport { Link } from \"react-router-dom\";\n     2\timport { ladder, ladderColumns, stageOrder, STAGE_CODE } from \"../data/derive\";\n     3\timport { fp, path } from \"../data/bundle\";\n     4\timport { SUB_META } from \"../data/method\";\n     5\timport { SUB_KEYS, type Bundle, type Model } from \"../data/types\";\n     6\timport { ChartFrame, Mark, TipBody } from \"../components/Chart\";\n     7\timport { GlyphShape } from \"../components/Glyph\";\n     8\timport { XAxis, xTitleExtra, YAxis } from \"../components/Axis\";\n     9\timport { fmt, fmtNum, fmtTick, isNum, type Fmt } from \"../lib/numfmt\";\n    10\timport { linear, log10Scale, niceTicks, textWidth, wrapText, type Scale } from \"../lib/scale\";\n    11\timport type { TailPair } from \"../findings\";\n    12\t\n    13\tconst href = (m: Model) => `/model/${encodeURIComponent(m.id)}`;\n    14\t\n    15\texport interface Metric {\n    16\t  key: string;\n    17\t  name: string;\n    18\t  value: (m: Model) => number | null;\n    19\t  pathOf: (m: Model) => string;\n    20\t  fmtKind: Fmt;\n    21\t  axis: string;\n    22\t  zero?: boolean;\n    23\t  band?: number;\n    24\t  /** reference line (e.g. none) */\n    25\t  ref?: { value: number; label: string };\n    26\t}\n    27\t\n    28\tfunction shortLabel(s: string, n = 14): string {\n    29\t  const t = s.replace(/\\s*\\(.*?\\)\\s*/g, \" \").trim();\n    30\t  return t.length > n ? t.slice(0, n - 1) + \"…\" : t;\n    31\t}\n    32\t\n    33\t/**\n    34\t * Short rung labels that stay distinguishable: a \"prefix · suffix\" label whose prefix another rung shares\n    35\t * (\"stage 2 · +5B\", \"stage 2 · +17B\") is shown by its suffix (\"+5B\", \"+17B\"); the stage glyph carries the rest.\n    36\t * Truncation happens only after that.\n    37\t */\n    38\texport function rungShortLabels(rungs: Model[], n: number): Map<string, string> {\n    39\t  const pre = (l: string) => (l.includes(\" · \") ? l.slice(0, l.lastIndexOf(\" · \")) : null);\n    40\t  const count = new Map<string, number>();\n    41\t  for (const r of rungs) {\n    42\t    const p = pre(r.label);\n    43\t    if (p !== null) count.set(p, (count.get(p) ?? 0) + 1);\n    44\t  }\n    45\t  return new Map(\n    46\t    rungs.map((r) => {\n    47\t      const p = pre(r.label);\n    48\t      const l = p !== null && (count.get(p) ?? 0) > 1 ? r.label.slice(p.length + 3) : r.label;\n    49\t      return [r.id, shortLabel(l, n)];\n    50\t    }),\n    51\t  );\n    52\t}\n    53\t\n    54\t/**\n    55\t * One family ladder: x = rung in order (parallel rungs share a column, not joined), y = metric (linear).\n    56\t * Optional lens panel for a sub-range, drawn on its own linear axis and joined by connector lines.\n    57\t */\n    58\texport function LadderChart({\n    59\t  rungs,\n    60\t  metric,\n    61\t  domain,\n    62\t  height = 200,\n    63\t  lens,\n    64\t  compact = false,\n    65\t}: {\n    66\t  rungs: Model[];\n    67\t  metric: Metric;\n    68\t  domain: [number, number];\n    69\t  height?: number;\n    70\t  lens?: [number, number];\n    71\t  compact?: boolean;\n    72\t}) {\n    73\t  const cols = ladderColumns(rungs);\n    74\t  const short = rungShortLabels(rungs, compact ? 12 : 16);\n    75\t  const aria = `${metric.name} along the ${rungs[0]?.family} ladder: ` + rungs.map((r) => `${r.label} ${fmt(metric.value(r), metric.fmtKind)}`).join(\" → \");\n    76\t  return (\n    77\t    <ChartFrame ariaLabel={aria}>\n    78\t      {(w) => {\n    79\t        const side = !!lens && w >= 560;\n    80\t        const L = 48;\n    81\t        // right margin leaves room for the last rotated rung label\n    82\t        const R = compact ? 24 : 44;\n    83\t        const panelW = lens ? (side ? (w - L * 2 - 40 - R) / 2 : w - L - R) : w - L - R;\n    84\t        const T = 16;\n    85\t        const tight = panelW / Math.max(1, cols.length) < 40;\n    86\t        const labelSpace = compact ? (tight ? 62 : 42) : tight ? 90 : 70;\n    87\t        const ph = height;\n    88\t        const x = linear([-0.5, cols.length - 0.5], [L, L + panelW]);\n    89\t        const colStep = panelW / Math.max(1, cols.length);\n    90\t        const y = linear(domain, [T + ph, T]);\n    91\t        const totalH1 = T + ph + labelSpace;\n    92\t        const lensOX = side ? L + panelW + 40 + L : L;\n    93\t        const lensOY = side ? 0 : totalH1 + 10;\n    94\t        const lx = lens ? linear([-0.5, cols.length - 0.5], [lensOX, lensOX + panelW]) : null;\n    95\t        const ly = lens ? linear(lens, [lensOY + T + ph, lensOY + T]) : null;\n    96\t        const totalH = side || !lens ? totalH1 : lensOY + totalH1;\n    97\t        const panel = (xs: Scale, ys: Scale, oy: number, isLens: boolean) => {\n    98\t          const pts = cols.map((col, ci) => col.map((m, si) => ({ m, si, x: xs(ci) + (col.length > 1 ? (si - (col.length - 1) / 2) * 12 : 0), v: metric.value(m) })));\n    99\t          const dom = ys.domain;\n   100\t          const clip = (v: number) => Math.max(Math.min(dom[0], dom[1]), Math.min(Math.max(dom[0], dom[1]), v));\n   101\t          const path2 = pts\n   102\t            .map((col) => col[col.length - 1])\n   103\t            .filter((p) => isNum(p.v))\n   104\t            .map((p) => `${p.x},${ys(clip(p.v!))}`)\n   105\t            .join(\" \");\n   106\t          const ticks = niceTicks(dom[0], dom[1], compact ? 4 : 6);\n   107\t          return (\n   108\t            <g>\n   109\t              {metric.band !== undefined && (\n   110\t                <rect x={xs.range[0]} width={xs.range[1] - xs.range[0]} y={ys(Math.min(metric.band, dom[1]))} height={ys(Math.max(-metric.band, dom[0])) - ys(Math.min(metric.band, dom[1]))} fill=\"var(--band)\" />\n   111\t              )}\n   112\t              <YAxis scale={ys} x={xs.range[0]} ticks={ticks} format={(v) => (metric.fmtKind === \"eff\" ? fmtNum(v, \"count\") : fmtTick(v, { pct: metric.fmtKind === \"pct\", signed: metric.fmtKind === \"gap\" }))} gridRight={xs.range[1]} />\n   113\t              {metric.zero && dom[0] <= 0 && dom[1] >= 0 && <line x1={xs.range[0]} x2={xs.range[1]} y1={ys(0)} y2={ys(0)} stroke=\"var(--zero)\" strokeWidth={1.5} />}\n   114\t              {metric.ref && <line x1={xs.range[0]} x2={xs.range[1]} y1={ys(metric.ref.value)} y2={ys(metric.ref.value)} stroke=\"var(--ink)\" strokeDasharray=\"4 3\" />}\n   115\t              {metric.ref && (\n   116\t                <text x={xs.range[1]} y={ys(metric.ref.value) - 4} textAnchor=\"end\">\n   117\t                  {metric.ref.label}\n   118\t                </text>\n   119\t              )}\n   120\t              <polyline points={path2} fill=\"none\" stroke=\"var(--ink)\" strokeWidth={1.5} />\n   121\t              {pts.flat().map((p) =>\n   122\t                isNum(p.v) ? (\n   123\t                  <Mark\n   124\t                    key={p.m.id + (isLens ? \"L\" : \"\")}\n   125\t                    x={p.x}\n   126\t                    y={ys(clip(p.v))}\n   127\t                    href={href(p.m)}\n   128\t                    label={`${p.m.label}, ${p.m.stage}: ${fmt(p.v, metric.fmtKind)}`}\n   129\t                    tip={<TipBody title={`${p.m.family} · ${p.m.label}`} lines={[`${metric.name}: ${fmt(p.v, metric.fmtKind)}`]} path={metric.pathOf(p.m)} />}\n   130\t                  >\n   131\t                    <GlyphShape stage={p.m.stage} x={p.x} y={ys(clip(p.v))} size={8} hollow={p.v < Math.min(dom[0], dom[1]) || p.v > Math.max(dom[0], dom[1])} />\n   132\t                  </Mark>\n   133\t                ) : (\n   134\t                  <text key={p.m.id} x={p.x} y={ys(dom[0]) - 4} textAnchor=\"middle\">\n   135\t                    —\n   136\t                  </text>\n   137\t                ),\n   138\t              )}\n   139\t              {isLens &&\n   140\t                pts.flat().map((p) =>\n   141\t                  isNum(p.v) && (p.v < Math.min(dom[0], dom[1]) || p.v > Math.max(dom[0], dom[1])) ? (\n   142\t                    <text key={\"o\" + p.m.id} x={p.x + 7} y={ys(clip(p.v)) + (p.v < dom[0] ? -4 : 12)} textAnchor=\"start\" style={{ fontSize: 11 }}>\n   143\t                      {p.v < dom[0] ? \"↓\" : \"↑\"}\n   144\t                    </text>\n   145\t                  ) : null,\n   146\t                )}\n   147\t              {!compact &&\n   148\t                colStep >= 56 &&\n   149\t                pts.flat().map((p) =>\n   150\t                  isNum(p.v) && !isLens ? (\n   151\t                    <text key={\"v\" + p.m.id} x={p.x + 7} y={ys(clip(p.v)) - 6} style={{ fontSize: 11, fill: \"var(--ink-2)\" }}>\n   152\t                      {fmtNum(p.v, metric.fmtKind === \"gap\" ? \"signed\" : metric.fmtKind)}\n   153\t                    </text>\n   154\t                  ) : null,\n   155\t                )}\n   156\t              {pts.flat().map((p) => {\n   157\t                // parallel rungs: one rotated baseline per rung, offset by a fixed 13px line step perpendicular to it\n   158\t                const a = ((tight ? 60 : 35) * Math.PI) / 180;\n   159\t                const lx0 = xs(cols.findIndex((c) => c.some((m) => m.id === p.m.id)));\n   160\t                const ox = -Math.sin(a) * 13 * p.si;\n   161\t                const oyy = Math.cos(a) * 13 * p.si;\n   162\t                return (\n   163\t                  <text key={\"l\" + p.m.id + isLens} transform={`translate(${lx0 + ox},${oy + T + ph + 14 + oyy}) rotate(${tight ? 60 : 35})`} style={{ fontSize: 11 }}>\n   164\t                    {short.get(p.m.id)}\n   165\t                  </text>\n   166\t                );\n   167\t              })}\n   168\t            </g>\n   169\t          );\n   170\t        };\n   171\t        return (\n   172\t          <svg width={w} height={totalH}>\n   173\t            <text x={4} y={10} style={{ fill: \"var(--ink-2)\" }}>\n   174\t              {metric.axis}\n   175\t            </text>\n   176\t            {panel(x, y, 0, false)}\n   177\t            {lens && lx && ly && (\n   178\t              <g>\n   179\t                {/* lens bracket on main axis */}\n   180\t                <rect x={L} y={y(lens[1])} width={panelW} height={y(lens[0]) - y(lens[1])} fill=\"none\" stroke=\"var(--rule-strong)\" />\n   181\t                {side ? (\n   182\t                  <>\n   183\t                    <line x1={L + panelW} y1={y(lens[1])} x2={lensOX} y2={ly(lens[1])} stroke=\"var(--rule-strong)\" />\n   184\t                    <line x1={L + panelW} y1={y(lens[0])} x2={lensOX} y2={ly(lens[0])} stroke=\"var(--rule-strong)\" />\n   185\t                  </>\n   186\t                ) : (\n   187\t                  <>\n   188\t                    <line x1={L} y1={y(lens[0])} x2={L} y2={ly(lens[1])} stroke=\"var(--rule-strong)\" />\n   189\t                    <line x1={L + panelW} y1={y(lens[0])} x2={L + panelW} y2={ly(lens[1])} stroke=\"var(--rule-strong)\" />\n   190\t                  </>\n   191\t                )}\n   192\t                <text x={lensOX} y={lensOY + 10} style={{ fill: \"var(--ink-2)\" }}>\n   193\t                  lens: {fmtNum(lens[0], \"signed\")} to {fmtNum(lens[1], \"signed\")} nats (linear)\n   194\t                </text>\n   195\t                {panel(lx, ly, lensOY, true)}\n   196\t              </g>\n   197\t            )}\n   198\t          </svg>\n   199\t        );\n   200\t      }}\n   201\t    </ChartFrame>\n   202\t  );\n   203\t}\n   204\t\n   205\t/** Small multiples of LadderChart for every family with ≥ 2 rungs, sharing the y scale. */\n   206\texport function LadderSmallMultiples({ bundle, metric }: { bundle: Bundle; metric: Metric }) {\n   207\t  const fams = Array.from(new Set(bundle.models.map((m) => m.family)))\n   208\t    .map((f) => ladder(bundle, f))\n   209\t    .filter((r) => r.length >= 2)\n   210\t    .sort((a, b) => b.length - a.length || a[0].family.localeCompare(b[0].family));\n   211\t  const vals = fams.flat().map(metric.value).filter(isNum);\n   212\t  let lo = Math.min(...vals, metric.zero ? 0 : Infinity);\n   213\t  let hi = Math.max(...vals, metric.zero ? 0 : -Infinity);\n   214\t  if (metric.band !== undefined) {\n   215\t    lo = Math.min(lo, -metric.band);\n   216\t    hi = Math.max(hi, metric.band);\n   217\t  }\n   218\t  const pad = (hi - lo) * 0.06;\n   219\t  const domain: [number, number] = [lo - pad, hi + pad];\n   220\t  return (\n","exit_code":0,"status":"completed"}}
