ign: right; }\n    93\t.page-head { padding: 32px 0 16px; }\n    94\t.section { padding: 32px 0 8px; border-top: 1px solid var(--rule); margin-top: 32px; scroll-margin-top: 64px; }\n    95\t.section:first-of-type { border-top: 0; margin-top: 0; }\n    96\t.section > h2 { margin-bottom: 12px; }\n    97\t\n    98\t/* ---------- top bar ---------- */\n    99\t.topbar { position: sticky; top: 0; z-index: 20; background: var(--bg); border-bottom: 1px solid var(--rule); }\n   100\t.topbar .container { display: flex; align-items: center; gap: 20px; min-height: 48px; }\n   101\t.wordmark { display: inline-flex; align-items: center; gap: 8px; text-decoration: none; color: var(--ink); font-family: var(--f-serif); font-weight: 600; font-size: 18px; white-space: nowrap; }\n   102\t.byline { font-family: var(--f-sans); font-size: 12px; color: var(--ink-2); padding-left: 10px; border-left: 1px solid var(--rule); text-decoration: none; white-space: nowrap; }\n   103\t.byline:hover { color: var(--ink); text-decoration: underline; }\n   104\t.nav { display: flex; gap: 18px; }\n   105\t.nav a { color: var(--ink-2); text-decoration: none; font-size: 14px; padding: 13px 0 11px; border-bottom: 2px solid transparent; white-space: nowrap; }\n   106\t.nav a:hover { color: var(--ink); }\n   107\t.nav a[aria-current=\"page\"] { color: var(--ink); border-bottom-color: var(--ink); }\n   108\t.topbar .spacer { flex: 1; }\n   109\t.stamp { font-family: var(--f-mono); font-size: 11px; color: var(--ink-3); white-space: nowrap; }\n   110\t.btn.menu-btn { display: none; }\n   111\t@media (max-width: 1099px) { .topbar .stamp { display: none; } }\n   112\t@media (max-width: 719px) {\n   113\t  .topbar .container { flex-wrap: wrap; gap: 8px 12px; }\n   114\t  .btn.menu-btn { display: inline-flex; margin-left: auto; }\n   115\t  .nav { display: none; width: 100%; flex-direction: column; gap: 0; padding-bottom: 8px; }\n   116\t  .nav.open { display: flex; }\n   117\t  .nav a { padding: 10px 0; min-height: 40px; }\n   118\t  .topbar .theme-switch { display: none; }\n   119\t  .byline { display: none; }\n   120\t}\n   121\t.notice { color: var(--ink-3); font-size: 12px; padding: 4px 0; border-bottom: 1px solid var(--rule); }\n   122\t\n   123\t/* ---------- controls ---------- */\n   124\t.btn {\n   125\t  display: inline-flex; align-items: center; gap: 6px; min-height: 32px; padding: 4px 10px; background: transparent;\n   126\t  border: 1px solid var(--control); border-radius: var(--radius); cursor: pointer; font-size: 13px; color: var(--ink);\n   127\t  transition: background var(--dur-1);\n   128\t}\n   129\t.btn:hover { background: var(--bg-raised); }\n   130\t.btn[aria-pressed=\"true\"] { background: var(--ink); color: var(--bg); border-color: var(--ink); }\n   131\t.btn[aria-pressed=\"true\"] svg path, .btn[aria-pressed=\"true\"] svg rect, .btn[aria-pressed=\"true\"] svg circle { }\n   132\t.seg { display: inline-flex; }\n   133\t.seg .btn { border-radius: 0; margin-left: -1px; }\n   134\t.seg .btn:first-child { border-radius: var(--radius) 0 0 var(--radius); margin-left: 0; }\n   135\t.seg .btn:last-child { border-radius: 0 var(--radius) var(--radius) 0; }\n   136\t@media (max-width: 719px) { .btn { min-height: 40px; } }\n   137\tinput[type=\"search\"], select, .input {\n   138\t  min-height: 32px; padding: 4px 8px; border: 1px solid var(--control); border-radius: var(--radius); background: var(--bg-raised); font-size: 13px;\n   139\t}\n   140\t@media (max-width: 719px) { input[type=\"search\"], select { min-height: 40px; } }\n   141\t.linkbtn { background: none; border: 0; padding: 0; color: var(--link); cursor: pointer; text-decoration: underline; text-underline-offset: 2px; font: inherit; }\n   142\t\n   143\t/* ---------- plates ---------- */\n   144\t.plate { background: var(--bg-plate); border-top: 1px solid var(--rule); padding: 20px; margin: 16px 0 24px; }\n   145\t@media (max-width: 719px) { .plate { padding: 12px; } }\n   146\t.plate figure { margin: 0; }\n   147\t.plate .figure { width: 100%; overflow: hidden; }\n   148\t.plate .figure svg { display: block; max-width: 100%; height: auto; }\n   149\t.caption { font-size: 12px; line-height: 16px; color: var(--ink-2); margin: 10px 0 0; max-width: 72ch; }\n   150\t.source-line { font-family: var(--f-mono); font-size: 11px; line-height: 14px; color: var(--ink-3); margin: 8px 0 0; overflow-wrap: anywhere; }\n   151\t.source-line div { margin: 0; }\n   152\tdetails.data { margin-top: 8px; font-size: 12px; }\n   153\tdetails.data > summary, details.disclosure > summary { cursor: pointer; color: var(--ink-2); font-size: 12px; list-style: none; display: inline-flex; align-items: center; gap: 4px; min-height: 24px; }\n   154\tdetails > summary::-webkit-details-marker { display: none; }\n   155\tdetails > summary .chev { transition: transform var(--dur-2); }\n   156\tdetails[open] > summary .chev { transform: rotate(90deg); }\n   157\tdetails.data .tbl-wrap { max-height: 360px; overflow: auto; margin-top: 6px; background: var(--bg-raised); }\n   158\t.data-note { border-top: 1px solid var(--rule-strong); border-bottom: 1px solid var(--rule-strong); padding: 6px 0; margin: 8px 0; font-size: 13px; color: var(--ink-2); }\n   159\t.data-note strong { color: var(--ink); }\n   160\t.nullplate {\n   161\t  padding: 20px; margin: 16px 0; color: var(--ink-2); font-size: 14px; background-color: var(--bg-plate);\n   162\t  background-image: repeating-linear-gradient(45deg, var(--rule-strong) 0 1px, transparent 1px 8px);\n   163\t  background-blend-mode: normal;\n   164\t}\n   165\t.nullplate span { background: var(--bg-plate); padding: 2px 6px; }\n   166\t.legend { display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: 12px; color: var(--ink-2); margin: 0 0 8px; padding: 0; list-style: none; }\n   167\t.legend li { display: inline-flex; align-items: center; gap: 6px; }\n   168\t.legend .code { font-weight: 600; color: var(--ink); }\n   169\t\n   170\t/* ---------- tables ---------- */\n   171\ttable.tbl { border-collapse: collapse; width: 100%; font-size: 13px; line-height: 18px; }\n   172\ttable.tbl th, table.tbl td { padding: 6px 8px; border-bottom: 1px solid var(--rule); text-align: left; vertical-align: middle; }\n   173\ttable.tbl th { font-weight: 500; color: var(--ink-2); font-size: 12px; background: var(--bg-raised); }\n   174\ttable.tbl td.n, table.tbl th.n { text-align: right; }\n   175\ttable.tbl tr.pinned td { font-weight: 600; }\n   176\ttable.tbl caption { text-align: left; font-size: 12px; color: var(--ink-3); padding-bottom: 4px; }\n   177\t.tbl-scroll { overflow-x: auto; max-width: 100%; }\n   178\t/* Block spacing after a table in reading pages, so the next paragraph does not sit on its last rule. */\n   179\t.prose .tbl-scroll, .prose table.tbl { margin: 0 0 16px; }\n   180\t.prose .tbl-scroll > table.tbl { margin: 0; }\n   181\ttable.tbl th.nw { white-space: nowrap; }\n   182\t.scroll-cue { margin: 0 0 4px; text-align: right; }\n   183\ttable.genre-tbl td.n { white-space: nowrap; width: 1%; }\n   184\t@media (max-width: 719px) { table.genre-tbl th, table.genre-tbl td { padding-left: 4px; padding-right: 4px; } }\n   185\t.sort-btn { background: none; border: 0; padding: 0; cursor: pointer; font: inherit; color: inherit; display: inline-flex; gap: 4px; align-items: center; text-align: inherit; }\n   186\t.sort-btn .tri { width: 8px; color: var(--ink-3); }\n   187\t\n   188\t/* ---------- Num & tooltip ---------- */\n   189\t.num { text-decoration: underline dotted var(--ink-3); text-decoration-thickness: 1px; text-underline-offset: 3px; cursor: help; position: relative; white-space: nowrap; }\n   190\t.num:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }\n   191\t.num .unit { margin-left: 0.25em; }\n   192\t.pop, .tooltip {\n   193\t  position: absolute; z-index: 50; background: var(--bg-raised); border: 1px solid var(--rule); padding: 6px 8px;\n   194\t  font-family: var(--f-mono); font-size: 11px; line-height: 15px; color: var(--ink); white-space: normal; width: max-content; max-width: min(360px, 86vw);\n   195\t  overflow-wrap: anywhere; font-style: normal; font-weight: 400; text-align: left; pointer-events: none;\n   196\t}\n   197\t.pop { left: 0; top: calc(100% + 4px); }\n   198\t.pop .def { color: var(--ink-3); }\n   199\t.tooltip { font-family: var(--f-sans); font-size: 12px; }\n   200\t.tooltip .path { font-family: var(--f-mono); font-size: 11px; color: var(--ink-3); }\n   201\t.chart-wrap { position: relative; }\n   202\t\n   203\t/* ---------- footer ---------- */\n   204\t.footer { border-top: 1px solid var(--rule); margin-top: 64px; padding: 24px 0 48px; font-size: 12px; color: var(--ink-2); }\n   205\t.footer .row { display: flex; flex-wrap: wrap; gap: 6px 14px; align-items: center; margin-bottom: 10px; }\n   206\t.footer .mono { font-size: 11px; color: var(--ink-3); }\n   207\t.footer a { color: var(--link); }\n   208\t\n   209\t/* ---------- misc ---------- */\n   210\t.skeleton-row { height: 34px; border-bottom: 1px solid var(--rule); }\n   211\t.skeleton-row::after { content: \"\"; display: block; height: 1px; margin-top: 16px; background: var(--rule); width: 60%; }\n   212\t.error-box { padding: 32px 0; font-family: var(--f-serif); font-size: 17px; }\n   213\t.copy-status { margin-left: 6px; font-size: 12px; color: var(--ink-3); }\n   214\t.statlist { display: grid; grid-template-columns: max-content 1fr; gap: 4px 16px; margin: 8px 0; font-size: 13px; }\n   215\t.statlist dt { color: var(--ink-2); }\n   216\t.statlist dd { margin: 0; text-align: left; }\n   217\t.statlist dd .ink3 { margin-left: 8px; }\n   218\t.stage-tag { display: inline-flex; align-items: center; gap: 4px; white-space: nowrap; }\n   219\t.stage-tag .code { font-size: 11px; font-weight: 600; letter-spacing: 0.04em; color: var(--ink-2); }\n   220\t.grid-3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }\n   221\t@media (max-width: 1099px) { .grid-3 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }\n   222\t@media (max-width: 719px) { .grid-3 { grid-template-columns: 1fr; } }\n   223\t.grid-2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }\n   224\t@media (max-width: 719px) { .grid-2 { grid-template-columns: 1fr; } }\n   225\t.cell-plate { background: var(--bg-raised); padding: 8px 10px; border-top: 1px solid var(--rule); min-width: 0; }\n   226\t.cell-plate h3 { font-family: var(--f-sans); font-size: 13px; font-weight: 600; }\n   227\tpre.code { background: var(--bg-raised); border: 1px solid var(--rule); padding: 12px; overflow-x: auto; font-size: 13px; line-height: 19px; position: relative; }\n   228\tpre.code .copy { position: absolute; right: 6px; top: 6px; }\n   229\t.prose code { font-size: 0.85em; background: var(--bg-raised); padding: 1px 4px; border: 1px solid var(--rule); }\n   230\t.prose pre code { border: 0; padding: 0; background: none; font-size: 13px; }\n   231\t.prose ul, .prose ol { padding-left: 1.3em; margin: 0 0 16px; }\n   232\t.prose li { margin-bottom: 4px; }\n   233\t.prose h2 { margin: 32px 0 12px; scroll-margin-top: 64px; }\n   234\t.prose h3 { margin: 24px 0 8px; scroll-margin-top: 64px; }\n   235\t.prose table { font-family: var(--f-sans); }\n   236\t.prose blockquote { margin: 0 0 16px; padding-left: 12px; border-left: 2px solid var(--rule-strong); color: var(--ink-2); }\n   237\t.explainer-slot { background: var(--bg-plate); border-top: 1px solid var(--rule); padding: 20px; margin: 16px 0 24px; font-family: var(--f-sans); }\n   238\t.explainer-slot .pending { color: var(--ink-3); font-size: 13px; }\n   239\t\n   240\t@media (prefers-reduced-motion: reduce) { * { scroll-behavior: auto !important; } }\n   241\t.mark .focus-ring { stroke: transparent; stroke-width: 2; }\n   242\t.mark:focus-visible .focus-ring { stroke: var(--focus); }\n     1\t/* ================= Leaderboard ================= */\n     2\t.lb-head { display: grid; grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); gap: 24px; padding: 32px 0 8px; align-items: start; }\n     3\t.lb-head h1 { margin-bottom: 4px; }\n     4\t.bundle-card { border-top: 1px solid var(--rule); padding-top: 8px; }\n     5\t.bundle-card .statlist { font-size: 13px; }\n     6\t@media (max-width: 719px) { .lb-head { grid-template-columns: 1fr; } }\n     7\t\n     8\t.lb-controls {\n     9\t  display: flex; flex-wrap: wrap; gap: 8px 14px; align-items: center; padding: 10px 0; background: var(--bg);\n    10\t  border-bottom: 1px solid var(--rule); font-size: 14px; z-index: 10;\n    11\t}\n    12\t@media (min-width: 720px) { .lb-controls { position: sticky; top: 48px; } }\n    13\t.ctl-group { display: inline-flex; flex-wrap: wrap; gap: 4px; align-items: center; position: relative; }\n    14\t.ctl-label { color: var(--ink-3); font-size: 12px; margin-right: 2px; }\n    15\t.chip { padding: 2px 8px; }\n    16\t.btn.chip[aria-pressed=\"true\"] svg * { stroke: var(--bg); }\n    17\t.ctl-count { color: var(--ink-3); font-size: 12px; margin-left: auto; }\n    18\t.fam-list {\n    19\t  position: absolute; top: calc(100% + 4px); left: 0; z-index: 30; background: var(--bg-raised); border: 1px solid var(--rule);\n    20\t  padding: 8px 12px; margin: 0; display: grid; gap: 2px; width: max-content; max-width: 86vw; max-height: 60vh; overflow: auto;\n    21\t}\n    22\t.fam-list label { display: flex; gap: 6px; align-items: center; min-height: 28px; font-size: 13px; }\n    23\t.sort-select { display: none; }\n    24\t\n    25\t.lb-table { margin-top: 0; }\n    26\t.lb-table thead th { position: sticky; top: calc(48px + var(--ctl-h, 0px)); z-index: 5; vertical-align: bottom; white-space: nowrap; }\n    27\t@media (max-width: 719px) { .lb-table thead th { position: static; } }\n    28\t.lb-table tbody tr { height: 34px; cursor: pointer; transition: background var(--dur-1); }\n    29\t.lb-table tbody tr:hover, .lb-table tbody tr:focus-within, .lb-table tbody tr.hl { background: var(--hl-40); }\n    30\t.lb-table td { padding-top: 5px; padding-bottom: 5px; }\n    31\t.lb-table .c-rank { width: 40px; }\n    32\t.lb-table .c-stage { width: 70px; }\n    33\t.lb-table .c-model .l1 { font-size: 13px; }\n    34\t.lb-table .c-model .l1 a { font-weight: 500; color: var(--ink); text-decoration: none; }\n    35\t.lb-table .c-model .l1 a:hover { text-decoration: underline; }\n    36\t.lb-table .c-model .fam { color: var(--ink-2); }\n    37\t.lb-table .c-model .l2 { font-size: 11px; line-height: 14px; color: var(--ink-3); overflow-wrap: anywhere; }\n    38\t.lb-table .size-inline { display: none; }\n    39\t.lb-table .cov { margin-left: 6px; font-size: 11px; color: var(--ink-3); border: 1px solid var(--rule-strong); padding: 0 3px; }\n    40\t.lb-table .c-size { white-space: nowrap; color: var(--ink-2); }\n    41\t.ov { display: inline-flex; align-items: center; gap: 8px; }\n    42\t.ov strong { font-size: 14px; font-weight: 600; min-width: 3.4ch; }\n    43\t.subcell { display: inline-flex; align-items: center; gap: 6px; }\n    44\t.subcell .v { font-size: 12px; color: var(--ink-2); min-width: 3.6ch; }\n    45\t.lb-table .c-micro { display: none; }\n    46\t\n    47\t@media (max-width: 1099px) {\n    48\t  .lb-table .c-size { display: none; }\n    49\t  .lb-table .size-inline { display: inline; }\n    50\t  .lb-table .c-sub .subcell .v { display: none; }\n    51\t}\n    52\t@media (max-width: 719px) {\n    53\t  .sort-select { display: inline-flex; }\n    54\t  .lb-table thead { display: none; }\n    55\t  .lb-table, .lb-table tbody { display: block; }\n    56\t  .lb-table tbody tr {\n    57\t    display: grid; height: auto; padding: 8px 0; border-bottom: 1px solid var(--rule);\n    58\t    grid-template-columns: 28px 22px minmax(0, 1fr) auto;\n    59\t    grid-template-areas: \"rank stage model overall\" \"micro micro micro micro\";\n    60\t    column-gap: 6px; row-gap: 6px; align-items: start;\n    61\t  }\n    62\t  /* table.tbl td (base.css) is 0,1,2: match its element+class form so the reset wins on phones; the tr carries the row rule. */\n    63\t  table.lb-table td { border: 0; padding: 0; }\n    64\t  .lb-table .c-rank { grid-area: rank; width: auto; }\n    65\t  .lb-table .c-stage { grid-area: stage; width: auto; }\n    66\t  .lb-table .c-stage .code { display: none; }\n    67\t  .lb-table .c-model { grid-area: model; min-width: 0; }\n    68\t  .lb-table .c-model .l1 { font-size: 14px; }\n    69\t  .lb-table .c-model .l2 { font-family: var(--f-sans); font-size: 12px; }\n    70\t  .lb-table .c-overall { grid-area: overall; }\n    71\t  .lb-table .c-overall svg { width: 64px; }\n    72\t  .lb-table .c-sub, .lb-table .c-size { display: none; }\n    73\t  .lb-table .c-micro { display: block; grid-area: micro; padding-left: 34px; }\n    74\t}\n    75\t.micro { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; }\n    76\t.micro > span { display: inline-flex; gap: 4px; align-items: center; font-size: 11px; color: var(--ink-2); min-width: 0; }\n    77\t.micro .k { font-weight: 600; color: var(--ink-3); }\n    78\t@media (max-width: 719px) { .micro svg { width: 26px; } }\n    79\t@media (max-width: 400px) { .lb-table .c-micro { padding-left: 0; } .micro { gap: 4px; } }\n    80\t\n    81\t/* Ladders view */\n    82\t.ladders { padding-top: 8px; }\n    83\t.lad-block { border-top: 1px solid var(--rule); padding: 14px 0 12px; }\n    84\t.lad-head { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 14px; margin-bottom: 10px; }\n    85\t.lad-head h3 { font-size: 17px; }\n    86\t.lad-rungs { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px 0; }\n    87\t.lad-col { display: flex; align-items: flex-start; }\n    88\t.lad-chev { margin: 22px 6px 0; flex: none; }\n    89\t.lad-stack { display: flex; flex-direction: column; gap: 6px; }\n    90\t.lad-stack .kicker { margin: 0; }\n    91\t.lad-rung { width: 132px; display: flex; flex-direction: column; gap: 4px; padding: 6px; text-decoration: none; color: var(--ink); border: 1px solid transparent; }\n    92\t.lad-rung:hover { background: var(--hl-40); }\n    93\t.lad-label { font-size: 13px; line-height: 16px; min-height: 32px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }\n    94\t.lad-score { display: inline-flex; gap: 6px; align-items: center; }\n    95\t.lad-singles { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 0 24px; }\n    96\t@media (max-width: 719px) {\n    97\t  .lad-rungs { flex-direction: column; }\n    98\t  .lad-chev { display: none; }\n    99\t  .lad-rung { width: 100%; flex-direction: row; flex-wrap: wrap; align-items: center; gap: 8px; min-height: 40px; }\n   100\t  .lad-label { min-height: 0; flex: 1 1 140px; }\n   101\t  .lad-col { width: 100%; }\n   102\t  .lad-stack { width: 100%; }\n   103\t}\n   104\t\n   105\t/* ================= Model page ================= */\n   106\t.crumb { font-size: 13px; color: var(--ink-3); margin-bottom: 8px; }\n   107\t.crumb a { color: var(--ink-2); }\n   108\t.mp-sub { display: flex; flex-wrap: wrap; gap: 6px 12px; align-items: center; color: var(--ink-2); margin: 6px 0; }\n   109\t.mp-id { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin: 6px 0 12px; }\n   110\t.mp-id code { font-size: 13px; overflow-wrap: anywhere; }\n   111\t.mp-overall { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px; }\n   112\t.mp-overall .big { font-family: var(--f-serif); font-size: 34px; line-height: 40px; font-weight: 600; }\n   113\t.compare-row { display: flex; flex-wrap: wrap; gap: 6px 10px; align-items: center; margin: 12px 0; font-size: 13px; }\n   114\t.compare-chip { display: inline-flex; align-items: center; gap: 4px; border: 1px solid var(--control); border-radius: var(--radius); padding: 2px 4px 2px 8px; }\n   115\t.compare-chip button { background: none; border: 0; cursor: pointer; padding: 2px 6px; font-size: 14px; color: var(--ink-2); min-width: 24px; min-height: 24px; }\n   116\t.combo { position: relative; display: inline-block; }\n   117\t.combo ul { position: absolute; z-index: 30; top: calc(100% + 2px); left: 0; margin: 0; padding: 4px 0; list-style: none; background: var(--bg-raised); border: 1px solid var(--rule); max-height: 280px; overflow: auto; width: max-content; max-width: 86vw; }\n   118\t.combo li { padding: 6px 10px; cursor: pointer; font-size: 13px; }\n   119\t.combo li[aria-selected=\"true\"], .combo li:hover { background: var(--hl-40); }\n   120\t.arith { font-family: var(--f-mono); font-size: 13px; margin: 12px 0 0; overflow-wrap: anywhere; }\n   121\t.ramps-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px 20px; }\n   122\t@media (max-width: 559px) { .ramps-grid { grid-template-columns: 1fr; } }\n   123\t.src-chip { font-family: var(--f-mono); font-size: 11px; color: var(--ink-3); border: 1px solid var(--rule); padding: 0 4px; }\n   124\t.margin-link { font-size: 13px; }\n   125\t.tail-table td .delta { display: block; font-size: 12px; color: var(--ink-3); }\n   126\t.fp-group { margin: 16px 0; }\n   127\t.fp-group h3 { font-family: var(--f-sans); font-size: 13px; font-weight: 600; margin-bottom: 4px; }\n   128\t.fp-table td.key { font-family: var(--f-mono); font-size: 12px; overflow-wrap: anywhere; }\n   129\t.fp-table td.desc { color: var(--ink-2); font-size: 12px; }\n   130\t.gauges { display: grid; gap: 6px; }\n   131\t\n   132\t/* ================= Findings ================= */\n   133\t.finding { padding: 32px 0 16px; border-top: 1px solid var(--rule); scroll-margin-top: 64px; }\n   134\t.finding .finding-title { margin: 0 0 4px; }\n   135\t.finding .claim { font-family: var(--f-serif); font-size: 26px; line-height: 34px; font-weight: 600; margin: 4px 0 12px; max-width: 30em; }\n   136\t@media (max-width: 719px) { .finding .finding-title { margin: 0 0 4px; }\n   137\t.finding .claim { font-size: 21px; line-height: 28px; } }\n   138\t.readoff { font-size: 13px; color: var(--ink-2); columns: 2 260px; column-gap: 24px; padding-left: 1.1em; }\n   139\t.readoff li { break-inside: avoid; margin-bottom: 2px; }\n   140\t.small-mult { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }\n   141\t@media (max-width: 1099px) { .small-mult { grid-template-columns: repeat(2, minmax(0, 1fr)); } }\n   142\t@media (max-width: 719px) { .small-mult { grid-template-columns: 1fr; } }\n   143\t.small-mult .cell-plate h3 { margin-bottom: 2px; }\n   144\t.metric-switch { margin: 0 0 12px; }\n   145\t.finding > h2:not(.kicker) { margin: 0 0 12px; }\n     1\t/* Identity tokens (DESIGN §2). Charts read every colour from these. */\n     2\t:root {\n     3\t  color-scheme: light;\n     4\t  --bg: #F5F3EE;\n     5\t  --bg-plate: #ECE8DF;\n     6\t  --bg-raised: #FBFAF7;\n     7\t  --ink: #1A1D21;\n     8\t  --ink-2: #4A4F57;\n     9\t  --ink-3: #5F646C;\n    10\t  --rule: #D8D2C4;\n    11\t  --rule-strong: #B9B1A0;\n    12\t  --control: #5F646C;\n    13\t  --track: #E3DED3;\n    14\t  --bar: #2A2E35;\n    15\t  --hl: #F3DD86;\n    16\t  --hl-40: rgba(243, 221, 134, 0.4);\n    17\t  --focus: #0B5CAD;\n    18\t  --link: #0B5CAD;\n    19\t  --zero: #4A4F57;\n    20\t  --band: rgba(30, 122, 106, 0.12);\n    21\t  --st-pre: #1E7A6A;\n    22\t  --st-anl: #A86B00;\n    23\t  --st-base: #3B5B9A;\n    24\t  --st-post: #B23A26;\n    25\t\n    26\t  --radius: 2px;\n    27\t  --hair: 1px;\n    28\t  --s1: 4px; --s2: 8px; --s3: 12px; --s4: 16px; --s5: 24px; --s6: 32px; --s7: 48px; --s8: 64px;\n    29\t  --dur-1: 120ms;\n    30\t  --dur-2: 180ms;\n    31\t  --dur-step: 160ms;\n    32\t  --dur-3: 600ms;\n    33\t  --ease-settle: cubic-bezier(.2, 0, 0, 1);\n    34\t  --ease-inout: cubic-bezier(.65, 0, .35, 1);\n    35\t\n    36\t  --f-serif: \"Source Serif 4 Variable\", \"Source Serif 4\", \"Iowan Old Style\", Georgia, serif;\n    37\t  --f-sans: \"IBM Plex Sans Condensed\", \"Tbb Condensed Fallback\", \"Arial Narrow\", \"Roboto Condensed\", system-ui, sans-serif;\n    38\t  --f-mono: \"IBM Plex Mono\", ui-monospace, \"SF Mono\", Menlo, Consolas, monospace;\n    39\t}\n    40\t\n    41\t@media (prefers-color-scheme: dark) {\n    42\t  :root:not([data-theme=\"light\"]) {\n    43\t    color-scheme: dark;\n    44\t    --bg: #111417; --bg-plate: #181C20; --bg-raised: #1E2328;\n    45\t    --ink: #E8E4DA; --ink-2: #B5B0A5; --ink-3: #8C887F;\n    46\t    --rule: #2C3238; --rule-strong: #434B53; --control: #8C887F; --track: #262C31; --bar: #DCD7CB;\n    47\t    --hl: #5C4E14; --hl-40: rgba(92, 78, 20, 0.55); --focus: #7FB2FF; --link: #7FB2FF; --zero: #B5B0A5;\n    48\t    --band: rgba(79, 191, 168, 0.14);\n    49\t    --st-pre: #4FBFA8; --st-anl: #E0A63A; --st-base: #8EA8E8; --st-post: #F07C62;\n    50\t  }\n    51\t}\n    52\t:root[data-theme=\"dark\"] {\n    53\t  color-scheme: dark;\n    54\t  --bg: #111417; --bg-plate: #181C20; --bg-raised: #1E2328;\n    55\t  --ink: #E8E4DA; --ink-2: #B5B0A5; --ink-3: #8C887F;\n    56\t  --rule: #2C3238; --rule-strong: #434B53; --control: #8C887F; --track: #262C31; --bar: #DCD7CB;\n    57\t  --hl: #5C4E14; --hl-40: rgba(92, 78, 20, 0.55); --focus: #7FB2FF; --link: #7FB2FF; --zero: #B5B0A5;\n    58\t  --band: rgba(79, 191, 168, 0.14);\n    59\t  --st-pre: #4FBFA8; --st-anl: #E0A63A; --st-base: #8EA8E8; --st-post: #F07C62;\n    60\t}\n    61\t\n    62\t@media (prefers-reduced-motion: reduce) {\n    63\t  :root { --dur-1: 0ms; --dur-2: 0ms; --dur-step: 0ms; --dur-3: 0ms; }\n    64\t}\n    65\t:root[data-reduce-motion] { --dur-1: 0ms; --dur-2: 0ms; --dur-step: 0ms; --dur-3: 0ms; }\n    66\t\n    67\t/* size-adjusted fallback to limit layout shift while Plex Sans Condensed loads */\n    68\t@font-face {\n    69\t  font-family: \"Tbb Condensed Fallback\";\n    70\t  src: local(\"Arial Narrow\"), local(\"Roboto Condensed\"), local(\"Arial\");\n    71\t  size-adjust: 92%;\n    72\t}\n","exit_code":0,"status":"completed"}}
