,\n      \"gzip_ratio\": 0.3242422260495469,\n      \"vocab\": 4465\n    }\n  },\n  \"tail\": {\n    \"tf\": {\n      \"s>7\": 0.09620432230576609,\n      \"s>10\": 0.0340179610006939,\n      \"rank>100\": 0.05159010837610161,\n      \"rank>1000\": 0.010311317307660075,\n      \"CE\": 2.328575611114502,\n      \"H\": 1.394086480140686,\n      \"s_p99\": 12.7802734375,\n      \"gap_hiH\": -0.9623379707336426\n    },\n    \"tf_fresh\": {\n      \"s>7\": 0.09093757418217151,\n      \"s>10\": 0.031936115972628715,\n      \"rank>100\": 0.04798010701400265,\n      \"rank>1000\": 0.009701000694455708,\n      \"CE\": 2.1233067512512207,\n      \"H\": 1.2064894437789917,\n      \"s_p99\": 12.7421875,\n      \"gap_hiH\": -1.0825035572052002\n    },\n    \"tf_weird\": {\n      \"s>7\": 0.11356549652105082,\n      \"s>10\": 0.03935957596616826,\n      \"rank>100\": 0.06550745426635937,\n      \"rank>1000\": 0.012009043955899782,\n      \"CE\": 2.5741348266601562,\n      \"H\": 1.4763801097869873,\n      \"s_p99\": 13.2421875,\n      \"gap_hiH\": -1.0975475311279297\n    }\n  }\n}\n","exit_code":0,"status":"completed"}}
