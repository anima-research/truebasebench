score.py:167:            r = rollout_group(model, tok, batch, args.rollout_steps, args.temperature,\ndocs/vh_score.py:326:    ap.add_argument(\"--corpus\", default=\"/models/varentropy/corpus/pile10k_sel.json\")\ndocs/vh_score.py:335:    ap.add_argument(\"--temperature\", type=float, default=1.0)\ndocs/vh_score.py:340:    ap.add_argument(\"--extra-corpus\", action=\"append\", default=[], help=\"NAME=PATH (repeatable) or PATH; extra TF-only corpora\")\ndocs/vh_score.py:357:    corpus = build_corpus(args.corpus, args.arrow, n_tf=max(args.n_tf, 400), n_openers=64)\ndocs/vh_score.py:358:    log(f\"corpus: {len(corpus['tf'])} tf docs, {len(corpus['openers'])} openers; using {args.n_tf} tf docs\")\ndocs/vh_score.py:408:        teacher_forced(model, tok, corpus[\"tf\"][: args.n_tf], args.max_len, out_dir)\ndocs/vh_score.py:410:        rollouts(model, tok, corpus, args, out_dir)\ndocs/vh_score.py:411:    for spec in args.extra_corpus:\ndocs/vh_score.py:414:            log(f\"extra corpus {name} already done, skipping\"); continue\ndocs/vh_score.py:415:        extra = load_corpus(path)\ndocs/vh_score.py:416:        log(f\"extra corpus {name} ({path}): {len(extra['tf'])} docs\")\ndocs/vh_selfboot.py:2:\"\"\"Probe-free / self-bootstrapped statistics from existing results.\ndocs/vh_selfboot.py:3: A. top-1 reliability on post-cutoff text (tf_fresh.npz, falls back to tf.npz): ECE and over-confidence by bin.\ndocs/vh_selfboot.py:4: B. lexical law of the model's own bare-BOS samples (rollouts.jsonl) vs real text (the Pile corpus) at the\ndocs/vh_selfboot.py:6:Usage: vh_selfboot.py RESULTS_DIR [--corpus corpus.json]\"\"\"\ndocs/vh_selfboot.py:11:corpus_path = \"/models/varentropy/corpus/pile10k_sel.json\"\ndocs/vh_selfboot.py:61:corpus = json.load(open(corpus_path))\ndocs/vh_selfboot.py:63:ref_texts = [d[\"text\"] for d in corpus[\"tf\"]][:200]\ndocs/vh_selfboot.py:85:print(\"\\nECE: expected |hit-rate − p1| over 10 confidence bins (lower = better calibrated); acc-conf@p1>.9: negative = over-confident where most sure.\")\ndocs/vh_analyze.py:58:    \"\"\"Token-align two tf results (same tokenizer, same corpus). Returns boolean masks into a and b.\"\"\"\ndocs/vh_analyze.py:173:def fingerprint(tf, ro, corpus=None, extra=None, rollout_texts=None, fresh=None):\ndocs/vh_analyze.py:177:    # tokenizer normalisation: chars per token on the shared corpus\ndocs/vh_analyze.py:178:    if corpus is not None:\ndocs/vh_analyze.py:179:        chars = sum(len(corpus[\"tf\"][m[\"doc\"]][\"text\"]) if m[\"ntok\"] < 2048 else None or 0 for m in tf[\"docs\"])\ndocs/vh_analyze.py:181:        chars = sum(len(corpus[\"tf\"][m[\"doc\"]][\"text\"]) for m in full); toks = sum(m[\"ntok\"] for m in full)\ndocs/vh_analyze.py:288:def fingerprint_table(results_dir, names, corpus_path=None, out=None):\ndocs/vh_analyze.py:289:    corpus = json.load(open(corpus_path)) if corpus_path and os.path.exists(corpus_path) else None\ndocs/vh_analyze.py:307:        rows[n] = fingerprint(load_tf(d), load_ro(d), corpus, extra, load_rollout_texts(d), fresh)\ndocs/vh_analyze.py:325:    ap.add_argument(\"--corpus\", default=\"/models/varentropy/corpus/pile10k_sel.json\")\ndocs/vh_analyze.py:341:        fingerprint_table(args.results, allnames, args.corpus, os.path.join(out, \"fingerprints.json\"))\nsite/src/findings.ts:88:          : \"no pre-anneal checkpoint with a post-cutoff gap in this bundle\",\nsite/src/findings.ts:96:        note: `a pre-anneal checkpoint has a post-cutoff domain gap below −${FINDING_DEFS.PRE_BAND_MAX}: ${domBad.map((x) => x.model.label).join(\", \")}`,\nsite/src/pages/Measure.tsx:11:/** The fixed measurement inputs, published under corpus/ in the data bucket (tools/upload_data.py --corpus-dir). */\nsite/src/pages/Measure.tsx:16:  const root = base ? `${base}/corpus` : \"<data bucket>/corpus\";\nsite/src/pages/Measure.tsx:18:    \"mkdir -p corpus && cd corpus\",\nsite/src/pages/Measure.tsx:22:    \"sha256sum -c SHA256SUMS && cd ..\",\nsite/src/pages/Measure.tsx:39:          under <span className=\"mono\">corpus/</span> next to the published bundles.\ndocs/vh_report.py:116:    out.append(f'<text x=\"{left+pw/2:.1f}\" y=\"{h-6}\" class=\"axis\" text-anchor=\"middle\">calibration gap on post-cutoff text, mean(H − s) in nats · 0 = calibrated, negative = over-confident</text>')\ndocs/vh_report.py:249: <div class=\"kpi\"><b>+0.008</b><span>Trinity TrueBase gap on post-cutoff text (calibrated)</span></div>\ndocs/vh_report.py:256:<p>For every model: the full-vocabulary next-token distribution at every position of three fixed corpora, teacher-forced, and at every step of 64 free-running samples at temperature 1 with no truncation. From each distribution: entropy <span class=\"mono\">H</span>, varentropy <span class=\"mono\">V = Var[−log p]</span>, the surprisal <span class=\"mono\">s</span> of the token that actually came next, top-1 probability and the rank of the actual token.</p>\ndocs/vh_report.py:260:<dt>Post-cutoff</dt><dd>900 documents from UncheatableEval 2026-04 (ao3, arXiv, bioRxiv, BBC, GitHub, Wikipedia in 15 categories), ≈1.3M tokens. Written after every model's cutoff, so nothing here can be recalled.</dd>\ndocs/vh_report.py:269:<figcaption>Calibration gap <span class=\"mono\">mean(H − s)</span> in nats per token on the post-cutoff corpus (Pile where the fresh pass is still pending, marked in the table). Dashed marks are clipped at −0.30; their values are printed.</figcaption>\ndocs/vh_report.py:281:<figcaption>Each point is a checkpoint. Horizontal: calibration gap on post-cutoff text (clipped at −1.0). Vertical: fraction of 32 bare-BOS samples with at least one chat/instruction marker (<span class=\"mono\">Assistant:</span>, <span class=\"mono\">### Instruction</span>, <span class=\"mono\">You will be given</span>, <span class=\"mono\">step by step</span>, …). Pre-anneal checkpoints sit in the top-left corner of the lower-right block: near 0 and near 0%.</figcaption>\ndocs/vh_report.py:284:<p><strong>What does not work.</strong> Free-running collapse is not the signal. At temperature 1, both Trinity TrueBase and Base fall into single-glyph attractors (<span class=\"mono\">‚‚‚‚</span>, <span class=\"mono\">❨❨❨</span>) in a quarter to a third of 1536-step rollouts, and TrueBase is slightly worse; the instruct Preview is the least degenerate of the three. Varentropy at matched entropy drops with annealing (V 3.10 → 2.76 on Pile) but moves non-monotonically across families, so it is reported but not scored.</p>\ndocs/vh_report.py:287:<p>The calibration gap can be read without any designed probe. Bin every position of the post-cutoff corpus by the model's top-1 probability and compare with how often that token actually came next; the expected gap is the ECE. Pre-anneal and annealed bases sit at 0.005–0.012; post-training moves it to 0.03–0.12, and within every family the share of positions where the model is at least 90% sure rises while its top-1 accuracy falls.</p>\ndocs/vh_report.py:290:<figcaption>Top-1 expected calibration error on the post-cutoff corpus (10 confidence bins). Any natural text works; this needs no prompt.</figcaption>\ndocs/vh_report.py:294:<p>Asked for random American surnames, does the model reproduce the population frequency distribution? Reference: 2010 Census surname counts. For the first list slot the distribution over the 2,000 most common surnames is computed exactly (both Title-case and ALL-CAPS spellings scored), under three prompt frames that differ in how \"random\" is phrased; sixteen 400-token lists are then sampled at temperature 1 per frame. Two things confound the naive version. Told in words that a list is random, every model answers with the <em>genre</em> \"list of common surnames\", which in training data begins Smith, Johnson, Williams — pre-anneal Trinity puts 38–56% on Smith at item 1 — and post-training sharpens this reflex into verbatim recitation of the ranked Census list (DeepSeek-V3-Base 12% on Smith, V3 chat 84%). Given six genuine Census draws as items 1–6 instead, the genre is broken and item 7 reads the prior itself; that is the number charted. Absolute KL also carries the internet's tilt toward famous names, so within-family deltas are the cleanest reading.</p>\ndocs/vh_report.py:305:<p>Recitation measured on Wikipedia is expected: it is in every anneal mix. The rarer Pile genres separate \"memorised the anneal mix\" from \"memorised the corpus\", and calibration on strange text is the harder test. Cells show the calibration gap and, in grey, the share of tokens inside verbatim runs.</p>\ndocs/vh_report.py:313:<dt>calib</dt><dd>gap on post-cutoff text: 0 → 1, −0.10 → 0</dd>\ndocs/vh_report.py:314:<dt>spread</dt><dd>mean |per-domain gap| on post-cutoff text: 0.015 → 1, 0.10 → 0</dd>\ndocs/vh_report.py:330:<div class=\"note\">Caveats: 24–150 Wikipedia documents is a small sample for the memorization share; the marker list is a heuristic and 32 samples give ±8% resolution; gaps are in nats per token and compare directly only within a tokenizer family (chars per token range 4.2–4.6 here, so cross-family rankings are unaffected). Pile gaps run about 0.02 lower than post-cutoff gaps for models that trained on the Pile. gemma-4-31B-it is excluded: it produced garbage under this loading path (cross-entropy 6.0 nats on Pile, bare-BOS samples are glyph strings) while Gemma-4-31B-Base loaded correctly through the same code. MiMo-V2.5 is excluded: neither transformers (FP8 quantizer vs. the checkpoint's custom expert layout) nor vLLM 0.30 (FP8 QKV sharding of its mixed 4/8-KV-head layers) loads it correctly yet. Kimi K2 was loaded through transformers' native DeepSeek-V3 class (identical architecture) and Cogito 671B through vLLM in bf16; both FP8 giants (DeepSeek-V3, K2) run in their native fine-grained FP8. The FP8 MoE models used a 300-document subset of the post-cutoff corpus (20 per category) and 1024-step rollouts.</div>\ndocs/vh_report.py:333:<p>Code and results on node1 under <span class=\"mono\">/models/varentropy/</span>: <span class=\"mono\">scripts/vh_score.py</span> (measurement), <span class=\"mono\">vh_analyze.py --all</span> (fingerprints), <span class=\"mono\">vh_memo.py</span> (memorization), <span class=\"mono\">vh_truebase.py</span> (score), <span class=\"mono\">vh_report.py</span> (this page). To fingerprint a new checkpoint: <span class=\"mono\">python scripts/vh_score.py --model PATH --extra-corpus tf_wiki=corpus/pile10k_wiki.json --extra-corpus tf_fresh=corpus/uncheat.json</span>, then re-run the analysis.</p>\nsite/src/pages/Methodology.tsx:15:  spread: \"pre-anneal checkpoints are near-zero in every post-cutoff domain\",\nsite/src/pages/Findings.tsx:96:    axis: \"calibration gap on post-cutoff text, mean(H − s), nats\",\nsite/src/pages/Findings.tsx:117:      axis: \"expected calibration error of top-1, post-cutoff text\",\nsite/src/pages/Findings.tsx:536:          axisTitle=\"gap at H > 4, nats (post-cutoff)\"\nsite/src/pages/ModelPage.tsx:156:  { key: \"tf_fresh\", label: \"tf_fresh (post-cutoff)\" },\nsite/src/pages/ModelPage.tsx:349:                    label=\"Plate M3 · Top-1 reliability on post-cutoff text\"\nsite/src/pages/ModelPage.tsx:350:                    caption=\"x = mean top-1 confidence per bin, y = accuracy; glyph area ∝ positions in the bin. Points below the diagonal are over-confident. The key is named selfboot but it is computed on teacher-forced post-cutoff text.\"\nsite/src/pages/ModelPage.tsx:353:                      columns: [\"bin\", \"positions\", \"confidence\", \"accuracy\", ...compare.map((c) => `${c.label} acc.`)],\nsite/src/pages/ModelPage.tsx:385:                [\"F_calib_gap (post-cutoff)\", <Num path={P(\"fingerprint.F_calib_gap\")} fmt=\"gap\" />],\nsite/src/pages/ModelPage.tsx:401:              label=\"Plate M3b · Cross-entropy per post-cutoff domain\"\nsite/src/pages/ModelPage.tsx:410:              <DotRows rows={domainRows(both, \"F_CE_\", model)} model={model} compare={compare} axisTitle=\"cross-entropy on post-cutoff text, nats\" />\nsite/src/pages/ModelPage.tsx:468:              caption=\"Calibration gap restricted to post-cutoff positions with entropy above 4 nats. Negative = over-confident exactly where uncertain. This checkpoint is highlighted; compare models are outlined.\"\nsite/src/pages/ModelPage.tsx:476:                axisTitle=\"gap at H > 4, mean(H − s), nats (post-cutoff)\"\nsite/src/pages/ModelPage.tsx:734:        Rare-genre <strong>Pile</strong> documents (not post-cutoff text). Gap bars share one scale across the bundle (±{fmtNum(maxGap, \"num3\")} nats); the\nsite/src/pages/ModelPage.tsx:735:        shaded band is ± the widest pre-anneal post-cutoff gap; dashed ticks are compare models.\nsite/src/pages/ModelPage.tsx:798:  const order = [\"Pile teacher-forced\", \"Wikipedia / GitHub (X_)\", \"Post-cutoff (F_)\", \"Own samples (roll_, W1)\"];\nsite/src/data/types.ts:15:/** [lo, hi, count, mean_confidence, accuracy] */\nsite/src/data/method.ts:33:    readsAs: \"over-confidence; pre-anneal checkpoints sit near 0\",\nsite/src/data/glossary.ts:61:  F_CE: \"cross-entropy on post-cutoff text (nats)\",\nsite/src/data/glossary.ts:62:  F_H: \"mean entropy on post-cutoff text (nats)\",\nsite/src/data/glossary.ts:63:  F_calib_gap: \"calibration gap mean(H − s), post-cutoff text\",\nsite/src/data/glossary.ts:64:  F_H_over_s: \"mean H / mean s, post-cutoff text\",\nsite/src/data/glossary.ts:65:  F_gap_domain_min: \"most negative per-domain gap, post-cutoff\",\nsite/src/data/glossary.ts:66:  F_gap_domain_absmean: \"mean |per-domain gap|, post-cutoff\",\nsite/src/data/glossary.ts:67:  F_verbatim_run_frac: \"share of post-cutoff tokens in verbatim runs\",\nsite/src/data/glossary.ts:68:  \"F_frac_H<0.1\": \"share of post-cutoff positions with H < 0.1\",\nsite/src/data/glossary.ts:69:  \"F_V/H|H>1\": \"mean V/H where H > 1, post-cutoff\",\nsite/src/data/glossary.ts:76:    return d ? `cross-entropy on post-cutoff ${d}` : null;\nsite/src/data/glossary.ts:80:    return d ? `calibration gap on post-cutoff ${d}` : null;\nsite/src/data/glossary.ts:93:  fingerprint: \"all scalar features (teacher-forced, wiki/GitHub, post-cutoff, own samples)\",\nsite/src/data/glossary.ts:96:  selfboot: \"reliability (top-1, post-cutoff) and own-sample lexical stats\",\nsite/src/data/glossary.ts:102:  { name: \"Post-cutoff (F_)\", test: (k) => k.startsWith(\"F_\") },\nsite/src/content/about.md:13:Every model reads the same fixed text, and every feature is a statistic of its own next-token distribution: how well its expected surprise matches its realised surprise on text written after its training cutoff, how much of Wikipedia it recites verbatim, and how often it writes chat or instruction markers when asked to write from nothing. Four sub-scores, each a clipped linear ramp between a true-base anchor and a post-trained anchor, are averaged into the overall score. A surname-distribution test, tail statistics and lexical statistics of the model's own samples are shown alongside. [Methodology](/methodology) defines each of these precisely; [Findings](/findings) gives the results.\nsite/src/content/about.md:24:The bench is maintained by Anima Labs. New checkpoints are added through pull requests that include a bundle produced with the published scripts (see [Measure your model](/measure)), and by the maintainers as notable checkpoints are released. Changes to the method, such as new anchors, a new post-cutoff corpus or a new feature, are made only in a new bundle version, described in the pull request that introduces it; a model's score is always reported against a named bundle version.\nsite/src/content/about.md:26:The post-cutoff corpus has a date. Once checkpoints trained on data from after that date appear, the corpus has to be replaced by a newer one, in a new bundle version, with the existing models re-measured on it.\nsite/src/content/about.md:38:The surname test follows a proposal by Gwern Branwen. The post-cutoff text comes from UncheatableEval, the Pile selection from NeelNanda/pile-10k, and the surname reference from the 2010 US Census surname file. The anchors were set using checkpoints released by Arcee AI (Trinity) and the Allen Institute for AI (OLMo-2), whose publication of intermediate checkpoints makes a measurement like this possible.\nsite/src/explainers/surnames.tsx:379:        <p className=\"xp-sub-label\">E5 · Sampled lists at temperature 1</p>\nsite/src/content/measure.md:10:- **Paths.** The script defaults point at `/models/varentropy/...` on the original machine. Pass `--corpus` and `--out` explicitly. Two analysis scripts still have the path in their source: `vh_selfboot.py` (`corpus_path`) and `vh_tail.py` (`res`). Edit those two lines to point at your corpus file and results directory.\nsite/src/content/measure.md:14:Every model must read exactly the same documents, so download the published corpus files rather than rebuilding them. They live next to the data bundles, under `corpus/` in the bench's data bucket, with a `SHA256SUMS` file; check your copies against it before measuring. All four teacher-forced corpora are JSON files of the form `{\"tf\": [{\"idx\", \"set\", \"text\"}, ...], \"openers\": [...]}`.\nsite/src/content/measure.md:18:| `pile10k_sel.json` (`--corpus`) | `tf`, own-sample openers | 400 Pile documents plus 64 openers, a fixed seeded selection from NeelNanda/pile-10k |\nsite/src/content/measure.md:19:| `wiki_gh.json` (`--extra-corpus tf_wiki=PATH`) | `tf_wiki` | 150 Wikipedia and 60 GitHub documents |\nsite/src/content/measure.md:20:| `uncheatable_2026_04.json` (`--extra-corpus tf_fresh=PATH`) | `tf_fresh` | 900 post-cutoff documents in 15 categories (UncheatableEval 2026-04) |\nsite/src/content/measure.md:21:| `weird.json` (`--extra-corpus tf_weird=PATH`) | `tf_weird` | 199 documents from 12 rare Pile genres |\nsite/src/content/measure.md:26:If `--corpus` points at a file that does not exist, `vh_score.py` builds the Pile selection from the pile-10k Arrow file given by `--arrow` (seed 0, documents of at least 400 characters) and writes it there. Only do this to reproduce the published file; a different selection makes your numbers incomparable.\nsite/src/content/measure.md:28:The `tf_fresh` texts post-date the training cutoff of every model in v1. If your checkpoint's data extends past April 2026, its `tf_fresh` pass is no longer post-cutoff; say so in the pull request.\nsite/src/content/measure.md:36:  --out results --corpus corpus/pile10k_sel.json \\\nsite/src/content/measure.md:37:  --extra-corpus tf_wiki=corpus/wiki_gh.json \\\nsite/src/content/measure.md:38:  --extra-corpus tf_fresh=corpus/uncheatable_2026_04.json \\\nsite/src/content/measure.md:39:  --extra-corpus tf_weird=corpus/weird.json \\\nsite/src/content/measure.md:40:  --names-probe corpus/names.json --max-mem-gib 165\nsite/src/content/measure.md:57:  --out results --corpus corpus/pile10k_sel.json --tp 8 --trust-remote-code \\\nsite/src/content/measure.md:58:  --extra-corpus tf_wiki=corpus/wiki_gh.json \\\nsite/src/content/measure.md:59:  --extra-corpus tf_fresh=corpus/uncheatable_2026_04.json \\\nsite/src/content/measure.md:60:  --extra-corpus tf_weird=corpus/weird.json \\\nsite/src/content/measure.md:61:  --names-probe corpus/names.json --rollout-steps 1024\nsite/src/content/measure.md:64:- `--prepend-bos` adds the BOS token when the tokenizer does not (DeepSeek V4 needs it). Check that your tokenizer's first token on the corpus is BOS on either path.\nsite/src/content/measure.md:71:The work is fixed: about 290k Pile tokens, 1.3M post-cutoff tokens, the Wikipedia/GitHub and rare-genre sets, 64 sampled sequences of 1536 steps, 6 × 2,000 surname scorings and 6 × 16 sampled surname lists. Every position keeps the full vocabulary distribution, so throughput is lower than for an ordinary evaluation run. Runtime therefore scales with parameter count and vocabulary size: on the reference node, expect minutes to tens of minutes per pass for a small dense model and hours in total for the largest MoE checkpoints. On the vLLM path teacher forcing costs more than a single forward pass per document, because each document is replayed step by step. The load time is written to `run.json` in the result directory, and every phase logs its own timing.\nsite/src/content/measure.md:78:python docs/vh_analyze.py results --all --corpus corpus/pile10k_sel.json   # fingerprints.json\nsite/src/content/measure.md:103:- the checkpoint id (a Hugging Face repo id and revision, or a public download location), its family, stage and position in the family ladder;\nsite/src/content/findings.md:11:On post-cutoff text a pre-anneal checkpoint expects as much surprise as it gets, overall and in every UncheatableEval domain. Each later stage moves the gap negative. The anneal itself barely moves the specimen ladder; SFT moves it far more than the anneal did, and DPO and RLVR push it further still. A negative gap of this size means the model's real surprisal on fresh text exceeds its entropy by most of a nat per token: it is confidently wrong far more often than its distribution admits.\nsite/src/content/findings.md:57:Sampled at temperature 1 with no truncation, many checkpoints eventually fall into attractors: single-glyph repetition or short loops where entropy drops near zero and stays there. It is tempting to read this as a post-training artefact. It is not: pre-anneal and annealed checkpoints do it as readily as post-trained ones. Collapse is shown on model pages but is not part of the score.\nsite/src/content/findings.md:85:On post-cutoff text, post-training raises the share of real tokens the model found near-impossible: surprisal above 10 nats, a probability below about 1 in 22,000. The paired chart below shows every base / post-trained pair, including the ones where the rise is small.\nsite/src/content/findings.md:87:The over-confidence concentrates where the model is uncertain. At positions with H > 4 nats, bases have a gap near zero, while most post-trained models are well below it; the exceptions are named in the claim above and visible in the strip. Post-training does not just sharpen confident predictions; it removes the hedging from uncertain ones.\nsite/src/explainers/calibrationGap.tsx:32:/** F_calib_gap, or the Pile calib_gap when the post-cutoff value is missing. */\nsite/src/explainers/calibrationGap.tsx:151:  const c2Title = \"calibration gap, mean(H − s) on post-cutoff text, nats (linear)\";\nsite/src/explainers/calibrationGap.tsx:245:          On real post-cutoff text, {A.label} has H <N m={A} k={fk(\"F_H\")} f=\"nats\" /> and s <N m={A} k={fk(\"F_CE\")} f=\"nats\" />, a gap of{\" \"}\nsite/src/explainers/calibrationGap.tsx:296:          <N m={A} k={[\"tail\", \"tf_fresh\", \"gap_hiH\"]} f=\"gap\" />. Over-confidence concentrates where the model is unsure.\nsite/src/explainers/calibrationGap.tsx:305:          C3: the gap per rare-genre Pile document set (not post-cutoff text) for A and B, and top-1 reliability on post-cutoff text, ECE{\" \"}\nsite/src/explainers/calibrationGap.tsx:307:          <em>Spread</em> is mean |per-domain gap| on post-cutoff text: <N m={A} k={fk(\"F_gap_domain_absmean\")} f=\"nats\" /> for A,{\" \"}\nsite/src/explainers/calibrationGap.tsx:600:            Gap per rare-genre Pile document set (not post-cutoff text)\nsite/src/explainers/calibrationGap.tsx:606:            Top-1 reliability on post-cutoff text · ECE A {tx(A, [\"selfboot\", \"reliability\", \"ECE\"], \"num3\")}, B {tx(B, [\"selfboot\", \"reliability\", \"ECE\"], \"num3\")}\nsite/src/explainers/calibrationGap.tsx:659:          not post-cutoff text. Checkpoints without a post-cutoff gap would use the Pile calib_gap and say so in their tooltip.\nsite/src/content/methodology.md:17:| `tf` | Pile documents (NeelNanda/pile-10k, fixed seeded selection, at least 400 characters) | 400 documents, at most 2048 tokens each, about 290k tokens | in most pretraining sets, so it also measures recall; fallback for features that need post-cutoff text |\nsite/src/content/methodology.md:19:| `tf_fresh` | UncheatableEval 2026-04: AO3, arXiv, bioRxiv, BBC, GitHub, Wikipedia and others, 15 categories | 900 documents, about 1.3M tokens | written after every measured model's cutoff; drives the calibration scores |\nsite/src/content/methodology.md:22:**Own samples.** 32 sequences from a bare `<bos>` and 32 continued from 32-token document openers, 1536 steps each (1024 for the FP8 giants, to fit memory), at temperature 1 with no truncation. Sampling continues past end-of-text. H, V, s and p1 are recorded at every step, where s is now the surprisal of the token the model itself sampled.\nsite/src/content/methodology.md:40:## Teacher forcing on a fixed corpus {#teacher-forcing}\nsite/src/content/methodology.md:42:Teacher forcing feeds the real document one token at a time and records the distribution before each real token. Nothing is sampled and nothing is judged; the model's choice never changes what it sees next. Because every checkpoint reads exactly the same tokens of exactly the same documents (re-tokenised by its own tokenizer), per-corpus means are directly comparable across models with the same tokenizer and comparable in shape across tokenizers.\nsite/src/content/methodology.md:50:The calibration gap on a corpus is\nsite/src/content/methodology.md:56:Recalled text breaks this logic in the other direction (a memorised document is less surprising than the model's entropy implies), so the scored feature is read on post-cutoff text:\nsite/src/content/methodology.md:61:In this bundle every pre-anneal checkpoint sits within ±{{val:pre-band}} of zero on post-cutoff text, and the most negative single-domain gap of any of them is {{val:pre-domain-min}}. For comparison, specimen A ({{val:spec-a}}) reads {{val:spec-a-gap}} and specimen B ({{val:spec-b}}) reads {{val:spec-b-gap}}.\nsite/src/content/methodology.md:95:**Sampled lists.** Under each frame, 16 lists of 400 tokens at temperature 1. From the parsed names: the distinct share, the junk share (names not among the {{def:CENSUS_SURNAMES|count}} Census surnames) and the mean −log p_Census(name) of generated in-Census names, against the Census self-entropy of {{num:reference.census_self_entropy_all|nats1}}. A model that only produces the most common names scores far below the self-entropy; a model that invents names shows a high junk share.\nsite/src/content/methodology.md:103:For each teacher-forced corpus (`tf`, `tf_fresh`, `tf_weird`) `vh_tail.py` records how the real text falls in the model's tail: the share of real tokens with s > 7 and s > 10 nats, the share with rank > 100 and rank > 1000, mean cross-entropy, mean entropy, the 99th percentile of s and the gap at positions with H > 4. A token at s > 10 is one the model gave less than about 1 in 22,000; on post-cutoff text these are real tokens the model treated as near-impossible. Shown, not scored.\nsite/src/content/methodology.md:119:For calib, a positive gap is clipped to 0 before the ramp, so under-confidence is not rewarded beyond a perfect score. The anchors were set from the Trinity TrueBase / Base / Preview triple and checked against the OLMo-2 ladder.\nsite/src/content/methodology.md:130:- The post-cutoff corpus is post-cutoff for every model measured so far. A checkpoint trained on data from after April 2026 needs a newer corpus, and the bundle would need a new version.\nsite/src/explainers/types.ts:10:  \"teacher-forcing\": \"Teacher forcing on a fixed corpus vs the model's own samples\",\nsite/src/explainers/teacherForcing.tsx:2: * Explainer (b) Teacher forcing on a fixed corpus vs the model's own samples (DESIGN §8 b).\nsite/src/explainers/teacherForcing.tsx:35:  { key: \"tf_fresh\", name: \"tf_fresh\", source: \"post-cutoff\", q: \"calibration on unseen text\" },\nsite/src/explainers/teacherForcing.tsx:192:    [\"teacher-forced (post-cutoff)\", tfH],\nsite/src/explainers/teacherForcing.tsx:231:    <svg width={width} height={axisY + 40} viewBox={`0 0 ${width} ${axisY + 40}`} role=\"img\" aria-label=\"Cross-entropy per post-cutoff domain\">\nsite/src/explainers/teacherForcing.tsx:277:  // per forced step: which confidence bin gets the count (drawn from the real bin shares), which rank was real\nsite/src/explainers/teacherForcing.tsx:324:          the model predicted. One count drops into a histogram of top-1 confidence.\nsite/src/explainers/teacherForcing.tsx:327:      summary: \"At each position the distribution is recorded and the real token is forced in; one count drops into the confidence histogram.\",\nsite/src/explainers/teacherForcing.tsx:333:          Over the whole post-cutoff pass the histogram fills to the exact shape of {M.label}’s real counts, and the counter runs to{\" \"}\nsite/src/explainers/teacherForcing.tsx:338:      summary: `The histogram fills to the real counts over ${fmtCount(total)} positions of post-cutoff text.`,\nsite/src/explainers/teacherForcing.tsx:344:          Pile text is in most pretraining sets, so it measures recall plus calibration. Wikipedia and GitHub measure memorisation. Post-cutoff text\nsite/src/explainers/teacherForcing.tsx:348:      summary: \"Four teacher-forced passes: Pile, Wikipedia and GitHub, post-cutoff text, rare genres.\",\nsite/src/explainers/teacherForcing.tsx:354:          In the own-sample pass the next token is drawn from the model’s distribution and appended, at temperature 1, and sampling continues past\nsite/src/explainers/teacherForcing.tsx:370:      summary: `Cross-entropy per post-cutoff domain for ${M.label} and ${C.label}.`,\nsite/src/explainers/teacherForcing.tsx:393:        <Histogram width={lw} bins={bins} units={units} morph={morph} label=\"top-1 confidence (10 bins)\" />\nsite/src/explainers/teacherForcing.tsx:430:          Cross-entropy per post-cutoff domain ·{\" \"}\nsite/src/explainers/teacherForcing.tsx:441:  const label = `Teacher forcing for ${M.label}: ${fmtCount(total)} post-cutoff positions in 10 top-1 confidence bins; free-running entropy ${tx(M, fk(\"roll_H_bos\"), \"nats\")} against teacher-forced ${tx(M, fk(\"F_H\"), \"nats\")}.`;\nsite/src/explainers/teacherForcing.tsx:467:          on post-cutoff text. Pass sizes are shown when the bundle carries reference.passes.\nsite/src/explainers/teacherForcing.tsx:477:          columns: [\"confidence bin\", \"positions\", \"mean confidence\", \"accuracy\"],\nsite/src/explainers/verbatimRuns.tsx:149:  const [corpus, setCorpus] = useState<\"auto\" | \"wiki\" | \"gh\">(\"auto\");\nsite/src/explainers/verbatimRuns.tsx:155:  const useGh = corpus === \"gh\" || (corpus === \"auto\" && st.step === 4);\nsite/src/explainers/position.tsx:156:        {cur.measured ? \"measured at one post-cutoff position\" : \"distribution shape constructed; H and s from bundle\"}\nsite/src/explainers/position.tsx:311:              The shape is constructed so that its entropy equals <N m={A} k={fk(\"F_H\")} f=\"nats\" />, the mean entropy of {A.label} on post-cutoff\nsite/src/explainers/position.tsx:334:          model’s mean on post-cutoff text.\nsite/src/explainers/position.tsx:344:          text, the median varentropy at positions with 2 ≤ H &lt; 3 nats is <N m={A} k={fk(\"Vmed|H2-3\")} f=\"num3\" />; on post-cutoff text, V/H at\nsite/src/explainers/position.tsx:354:          Then the real next token is revealed. Its surprisal s = −log p(real token). Averaged over post-cutoff text, {A.label} pays s ={\" \"}\nsite/src/explainers/position.tsx:365:          got. Averaged over a corpus, this is the calibration gap.\nsite/src/explainers/position.tsx:376:          <N m={B} k={fk(\"F_calib_gap\")} f=\"gap\" />. Over a corpus that is over-confidence: see <a href=\"#calibration-gap\">the calibration gap</a>.\nsite/src/explainers/position.tsx:420:    [\"F_H\", \"entropy H, post-cutoff mean\", \"nats\"],\nsite/src/explainers/position.tsx:424:    [\"F_V/H|H>1\", \"V/H at H > 1, post-cutoff text\", \"num3\"],\nsite/src/explainers/position.tsx:456:          <>Measured at one post-cutoff position: the real top-{N_BARS} probabilities, H, V and s of each model (bundle.explainers.position).</>\nsite/src/test/scoring.test.ts:47:  it(\"falls back to the Pile features when post-cutoff ones are missing\", () => {\nsite/src/charts/ModelCharts.tsx:82:    `Top-1 reliability on post-cutoff text for ${model.label}: ` +\nsite/src/charts/ModelCharts.tsx:83:    (main?.bins ?? []).map((b) => `confidence ${fmtNum(b[3], \"num2\")} accuracy ${fmtNum(b[4], \"num2\")}`).join(\"; \");\nsite/src/charts/ModelCharts.tsx:113:              mean top-1 confidence (bins[i][3])\nsite/src/charts/ModelCharts.tsx:137:                        label={`${s.m.label}, bin ${fmtNum(b[0], \"num2\")}–${fmtNum(b[1], \"num2\")}: confidence ${fmtNum(b[3], \"num3\")}, accuracy ${fmtNum(b[4], \"num3\")}, ${fmt(b[2], \"count\")} positions`}\nsite/src/charts/ModelCharts.tsx:141:                            lines={[`confidence ${fmtNum(b[3], \"num3\")}`, `accuracy ${fmtNum(b[4], \"num3\")}`, `${fmt(b[2], \"count\")} positions`]}\nsite/src/charts/ModelCharts.tsx:160:              positions per confidence bin (max {fmt(maxMain, \"count\")})\nsite/src/charts/FindingCharts.tsx:361:            <XAxis scale={x} y={T + H} ticks={niceTicks(x.domain[0], x.domain[1], w < 480 ? 4 : 8)} format={(v) => fmtTick(v, { signed: true })} gridTop={T} title=\"calibration gap on post-cutoff text, mean(H − s), nats\" />\n.env.example:23:VITE_DATA_BASE_URL=\n.env.example:25:VITE_SOURCE_REPO_URL=\nsite/README.md:16:The site fetches `${VITE_DATA_BASE_URL}/manifest.json`, picks the `bench_v<N>.json` with the highest N,\nsite/README.md:18:notice if the live source fails. Leave `VITE_DATA_BASE_URL` empty to use the repo copy only (see\nsite/README.md:22:Optional: `VITE_SOURCE_REPO_URL` (e.g. `https://github.com/<org>/<repo>`) turns script names into links.\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_51","type":"command_execution","command":"/bin/zsh -lc \"PYTHONDONTWRITEBYTECODE=1 python3 -c 'import json,hashlib,collections\nb=json.load(open(\\\"data/bench_v3.json\\\"));ms=b[\\\"models\\\"];by={m[\\\"id\\\"]:m for m in ms}\nerrs=[]\nfor m in ms:\n r=m[\\\"selfboot\\\"][\\\"reliability\\\"]; n=sum(x[2] for x in r[\\\"bins\\\"]);ece=sum(x[2]*abs(x[3]-x[4]) for x in r[\\\"bins\\\"])/n\n errs.append(abs(ece-r[\\\"ECE\\\"]))\nprint(\\\"max ECE vs bin recomputation error\\\",max(errs))\na=by[\\\"Olmo-3-32B-stage1\\\"][\\\"fingerprint\\\"];c=by[\\\"Olmo-3-1125-32B\\\"][\\\"fingerprint\\\"]\nprint(\\\"Olmo3 deltas\\\",{k:c[k]-a[k] for k in [\\\"F_CE\\\",\\\"F_H\\\",\\\"F_calib_gap\\\"]})\nprint(\\\"weird genres\\\",len(by[\\\"Trinity-Large-TrueBase\\\"][\\\"weird\\\"])-1,list(by[\\\"Trinity-Large-TrueBase\\\"][\\\"weird\\\"]))\nprint(\\\"lex min\\\",[(m[\\\"id\\\"],m[\\\"selfboot\\\"][\\\"lexical\\\"][\\\"n_texts\\\"]) for m in ms if m[\\\"selfboot\\\"][\\\"lexical\\\"][\\\"n_texts\\\"]<15])\nfor name in [\\\"bench_v1.json\\\",\\\"bench_v2.json\\\",\\\"bench_v3.json\\\",\\\"manifest.json\\\"]:\n raw=open(\\\"data/\\\"+name,\\\"rb\\\").read();dist=open(\\\"site/dist/data/\\\"+name,\\\"rb\\\").read()\n print(name,\\\"size\\\",len(raw),\\\"dist matches\\\",raw==dist,\\\"sha256\\\",hashlib.sha256(raw).hexdigest())\nprint(\\\"all surnames topnames absent\\\",all(not (m.get(\\\"surnames\\\") or {}).get(\\\"top_names\\\") for m in ms))\nprint(\\\"duplicates truncated\\\",{s:s[:10] for s in [\\\"wikipedia_english\\\",\\\"wikipedia_nonenglish\\\"]})'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
