{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc 'nl -ba docs/vh_analyze.py'","aggregated_output":"     1\t#!/usr/bin/env python\n     2\t\"\"\"Analysis of vh_score.py outputs: per-model summaries, paired (token-aligned) comparisons,\n     3\trollout trajectories and collapse detection. Usage:\n     4\t    vh_analyze.py RESULTS_DIR --pair A B [--pair C D ...] [--out figs]\n     5\tA, B are result subdirectory names; the first of a pair is the reference (e.g. the base / TrueBase).\n     6\t\"\"\"\n     7\timport argparse, json, os, sys\n     8\timport numpy as np\n     9\t\n    10\tMINI = 1e-6\n    11\t\n    12\t\n    13\tdef load_tf(d):\n    14\t    z = np.load(os.path.join(d, \"tf.npz\"))\n    15\t    r = {k: z[k] for k in z.files}\n    16\t    for k in [\"H\", \"V\", \"s\", \"p1\"]:\n    17\t        r[k] = r[k].astype(np.float32)\n    18\t    r[\"docs\"] = json.load(open(os.path.join(d, \"tf_docs.json\")))\n    19\t    return r\n    20\t\n    21\t\n    22\tdef load_ro(d):\n    23\t    p = os.path.join(d, \"rollouts.npz\")\n    24\t    if not os.path.exists(p):\n    25\t        return None\n    26\t    z = np.load(p)\n    27\t    return {k: (z[k].astype(np.float32) if z[k].dtype == np.float16 else z[k]) for k in z.files}\n    28\t\n    29\t\n    30\tdef summary(r, label):\n    31\t    H, V, s, p1 = r[\"H\"], r[\"V\"], r[\"s\"], r[\"p1\"]\n    32\t    out = {\n    33\t        \"tokens\": int(len(H)),\n    34\t        \"CE(nats)\": float(s.mean()),\n    35\t        \"H_mean\": float(H.mean()), \"H_median\": float(np.median(H)),\n    36\t        \"V_mean\": float(V.mean()), \"V_median\": float(np.median(V)),\n    37\t        \"frac_H<0.1\": float((H < 0.1).mean()),\n    38\t        \"frac_H>3\": float((H > 3).mean()),\n    39\t        \"frac_p1>0.99\": float((p1 > 0.99).mean()),\n    40\t        \"frac_rank0\": float((r[\"rank\"] == 0).mean()),\n    41\t        \"calib_gap(H-s)\": float((H - s).mean()),  # <0: model more surprised than its own entropy predicts\n    42\t    }\n    43\t    return out\n    44\t\n    45\t\n    46\tdef per_set(r):\n    47\t    sets = {}\n    48\t    docset = {m[\"doc\"]: m[\"set\"] for m in r[\"docs\"]}\n    49\t    ds = np.array([docset[int(d)] for d in r[\"doc\"]])\n    50\t    for name in sorted(set(ds)):\n    51\t        m = ds == name\n    52\t        sets[name] = {\"n\": int(m.sum()), \"CE\": float(r[\"s\"][m].mean()), \"H\": float(r[\"H\"][m].mean()),\n    53\t                      \"V\": float(r[\"V\"][m].mean()), \"frac_H<0.1\": float((r[\"H\"][m] < 0.1).mean())}\n    54\t    return sets\n    55\t\n    56\t\n    57\tdef align(a, b):\n    58\t    \"\"\"Token-align two tf results (same tokenizer, same corpus). Returns boolean masks into a and b.\"\"\"\n    59\t    ka = a[\"doc\"].astype(np.int64) * 100000 + a[\"pos\"]\n    60\t    kb = b[\"doc\"].astype(np.int64) * 100000 + b[\"pos\"]\n    61\t    common, ia, ib = np.intersect1d(ka, kb, return_indices=True)\n    62\t    assert np.array_equal(a[\"tok\"][ia], b[\"tok\"][ib]), \"token mismatch between models — tokenizers differ?\"\n    63\t    return ia, ib\n    64\t\n    65\t\n    66\tdef paired(a, b, la, lb):\n    67\t    ia, ib = align(a, b)\n    68\t    Ha, Hb = a[\"H\"][ia], b[\"H\"][ib]\n    69\t    Va, Vb = a[\"V\"][ia], b[\"V\"][ib]\n    70\t    sa, sb = a[\"s\"][ia], b[\"s\"][ib]\n    71\t    res = {\"n_aligned\": int(len(ia)),\n    72\t           \"dH_mean(b-a)\": float((Hb - Ha).mean()), \"dV_mean(b-a)\": float((Vb - Va).mean()),\n    73\t           \"dCE(b-a)\": float((sb - sa).mean()),\n    74\t           \"corr_H\": float(np.corrcoef(Ha, Hb)[0, 1]), \"corr_V\": float(np.corrcoef(Va, Vb)[0, 1])}\n    75\t    # conditional table: given reference entropy bin, what happens in the other model\n    76\t    bins = [0, 0.1, 0.5, 1, 2, 3, 4, 6, 20]\n    77\t    tab = []\n    78\t    for lo, hi in zip(bins[:-1], bins[1:]):\n    79\t        m = (Ha >= lo) & (Ha < hi)\n    80\t        if m.sum() < 50:\n    81\t            continue\n    82\t        tab.append({\"H_ref_bin\": f\"[{lo},{hi})\", \"n\": int(m.sum()),\n    83\t                    \"H_ref\": float(Ha[m].mean()), \"H_other\": float(Hb[m].mean()),\n    84\t                    \"V_ref\": float(Va[m].mean()), \"V_other\": float(Vb[m].mean()),\n    85\t                    \"P(other H<0.3)\": float((Hb[m] < 0.3).mean()),\n    86\t                    \"P(other H<0.3 & its top1==actual)\": float(((Hb[m] < 0.3) & (b[\"rank\"][ib][m] == 0)).mean()),\n    87\t                    \"CE_ref\": float(sa[m].mean()), \"CE_other\": float(sb[m].mean())})\n    88\t    res[\"by_ref_H_bin\"] = tab\n    89\t    # \"collapsed branch points\": reference sees a genuine branch (H>=2), other is near-deterministic\n    90\t    m = (Ha >= 2) & (Hb < 0.3)\n    91\t    res[\"collapsed_branch_points\"] = {\"n\": int(m.sum()), \"frac_of_ref_H>=2\": float(m.sum() / max((Ha >= 2).sum(), 1)),\n    92\t                                      \"other_top1_was_actual\": float((b[\"rank\"][ib][m] == 0).mean()) if m.sum() else None,\n    93\t                                      \"other_CE_there\": float(sb[m].mean()) if m.sum() else None,\n    94\t                                      \"ref_CE_there\": float(sa[m].mean()) if m.sum() else None}\n    95\t    m2 = (Hb >= 2) & (Ha < 0.3)\n    96\t    res[\"reverse_branch_points\"] = {\"n\": int(m2.sum()), \"frac_of_other_H>=2\": float(m2.sum() / max((Hb >= 2).sum(), 1))}\n    97\t    # varentropy-given-entropy curve: median V in H bins, both models (shape of the distribution at fixed H)\n    98\t    hb = np.linspace(0, 8, 33)\n    99\t    curve = []\n   100\t    for lo, hi in zip(hb[:-1], hb[1:]):\n   101\t        ma = (Ha >= lo) & (Ha < hi); mb = (Hb >= lo) & (Hb < hi)\n   102\t        if ma.sum() > 100 and mb.sum() > 100:\n   103\t            curve.append({\"H\": float((lo + hi) / 2), f\"V_med_{la}\": float(np.median(Va[ma])), f\"V_med_{lb}\": float(np.median(Vb[mb])),\n   104\t                          f\"n_{la}\": int(ma.sum()), f\"n_{lb}\": int(mb.sum())})\n   105\t    res[\"V_given_H\"] = curve\n   106\t    return res, (ia, ib)\n   107\t\n   108\t\n   109\tdef repetition(tokens, n=8):\n   110\t    \"\"\"fraction of positions t whose n-gram ending at t already occurred earlier in the same sequence.\"\"\"\n   111\t    B, T = tokens.shape\n   112\t    out = np.zeros((B, T), dtype=bool)\n   113\t    for b in range(B):\n   114\t        seen = set()\n   115\t        row = tokens[b]\n   116\t        for t in range(n - 1, T):\n   117\t            g = tuple(row[t - n + 1: t + 1].tolist())\n   118\t            if g in seen:\n   119\t                out[b, t] = True\n   120\t            seen.add(g)\n   121\t    return out\n   122\t\n   123\t\n   124\tdef rollout_summary(ro, label, window=64):\n   125\t    res = {}\n   126\t    for g in [\"bos\", \"openers\"]:\n   127\t        if f\"{g}_H\" not in ro:\n   128\t            continue\n   129\t        H, V, tok = ro[f\"{g}_H\"], ro[f\"{g}_V\"], ro[f\"{g}_tok\"]\n   130\t        B, T = H.shape\n   131\t        rep = repetition(tok)\n   132\t        # running mean of H over trailing window; \"collapsed\" once it stays < 0.2 for the rest of the sequence\n   133\t        cs = np.cumsum(np.pad(H, ((0, 0), (1, 0))), axis=1)\n   134\t        run = (cs[:, window:] - cs[:, :-window]) / window  # (B, T-window+1)\n   135\t        low = run < 0.2\n   136\t        collapsed_from = np.full(B, -1)\n   137\t        for b in range(B):\n   138\t            idx = np.where(low[b])[0]\n   139\t            if len(idx):\n   140\t                # first index after which it stays low\n   141\t                last_high = np.where(~low[b])[0]\n   142\t                start = (last_high[-1] + 1) if len(last_high) else 0\n   143\t                if start < low.shape[1] - 1:\n   144\t                    collapsed_from[b] = start + window\n   145\t        q = [0, T // 4, T // 2, 3 * T // 4]\n   146\t        res[g] = {\"B\": B, \"T\": T,\n   147\t                  \"H_by_quarter\": [float(H[:, a:a + T // 4].mean()) for a in q],\n   148\t                  \"V_by_quarter\": [float(V[:, a:a + T // 4].mean()) for a in q],\n   149\t                  \"rep8_by_quarter\": [float(rep[:, a:a + T // 4].mean()) for a in q],\n   150\t                  \"frac_seqs_collapsed\": float((collapsed_from >= 0).mean()),\n   151\t                  \"collapse_step_median\": float(np.median(collapsed_from[collapsed_from >= 0])) if (collapsed_from >= 0).any() else None,\n   152\t                  \"frac_steps_H<0.1\": float((H < 0.1).mean()),\n   153\t                  \"frac_steps_H<0.1_last_quarter\": float((H[:, 3 * T // 4:] < 0.1).mean()),\n   154\t                  \"seq_meanH_min/med/max\": [float(x) for x in np.percentile(H.mean(1), [0, 50, 100])]}\n   155\t    return res\n   156\t\n   157\t\n   158\tdef wasserstein1(a, b, lo=0.0, hi=10.0, nb=200):\n   159\t    ha, _ = np.histogram(np.clip(a, lo, hi), bins=nb, range=(lo, hi)); hb, _ = np.histogram(np.clip(b, lo, hi), bins=nb, range=(lo, hi))\n   160\t    ca = np.cumsum(ha) / max(ha.sum(), 1); cb = np.cumsum(hb) / max(hb.sum(), 1)\n   161\t    return float(np.abs(ca - cb).sum() * (hi - lo) / nb)\n   162\t\n   163\t\n   164\tMARKERS = [\"Assistant:\", \"\\nHuman:\", \"\\nUser:\", \"### Instruction\", \"### Response\", \"You will be given\", \"<|im_start|>\",\n   165\t           \"<|start_header_id|>\", \"Let's think step by step\", \"I hope this helps\", \"As an AI\", \"Sure! Here\", \"Sure, here\",\n   166\t           \"Certainly!\", \"Here's a\", \"Here is a\", \"step by step\", \"Final Answer\", \"\\\\boxed{\"]\n   167\t\n   168\t\n   169\tdef marker_rate(texts):\n   170\t    return float(np.mean([any(m in t for m in MARKERS) for t in texts])) if texts else float(\"nan\")\n   171\t\n   172\t\n   173\tdef fingerprint(tf, ro, corpus=None, extra=None, rollout_texts=None, fresh=None):\n   174\t    \"\"\"Reference-free per-model features for 'true-baseness' scoring.\"\"\"\n   175\t    H, V, s, p1, pos = tf[\"H\"], tf[\"V\"], tf[\"s\"], tf[\"p1\"], tf[\"pos\"]\n   176\t    f = {}\n   177\t    # tokenizer normalisation: chars per token on the shared corpus\n   178\t    if corpus is not None:\n   179\t        chars = sum(len(corpus[\"tf\"][m[\"doc\"]][\"text\"]) if m[\"ntok\"] < 2048 else None or 0 for m in tf[\"docs\"])\n   180\t        full = [m for m in tf[\"docs\"] if m[\"ntok\"] < 2048]\n   181\t        chars = sum(len(corpus[\"tf\"][m[\"doc\"]][\"text\"]) for m in full); toks = sum(m[\"ntok\"] for m in full)\n   182\t        f[\"chars_per_tok\"] = chars / max(toks, 1)\n   183\t    else:\n   184\t        f[\"chars_per_tok\"] = float(\"nan\")\n   185\t    cpt = f[\"chars_per_tok\"]\n   186\t    f[\"CE_tok\"] = float(s.mean()); f[\"CE_char\"] = float(s.mean() / cpt)\n   187\t    f[\"H_tok\"] = float(H.mean()); f[\"H_char\"] = float(H.mean() / cpt)\n   188\t    f[\"calib_gap\"] = float((H - s).mean()); f[\"H_over_s\"] = float(H.mean() / s.mean())\n   189\t    f[\"frac_H<0.1\"] = float((H < 0.1).mean()); f[\"frac_p1>0.99\"] = float((p1 > 0.99).mean())\n   190\t    f[\"frac_H>3\"] = float((H > 3).mean())\n   191\t    for lo, hi in [(1, 2), (2, 3), (3, 4)]:\n   192\t        m = (H >= lo) & (H < hi)\n   193\t        f[f\"Vmed|H{lo}-{hi}\"] = float(np.median(V[m])) if m.sum() > 100 else float(\"nan\")\n   194\t    m = H > 1\n   195\t    f[\"V/H|H>1\"] = float((V[m] / H[m]).mean())\n   196\t    f[\"H_pos<64\"] = float(H[pos < 64].mean()); f[\"H_pos>512\"] = float(H[pos > 512].mean())\n   197\t    f[\"H_ctx_drop\"] = f[\"H_pos<64\"] - f[\"H_pos>512\"]\n   198\t\n   199\t    # domain structure + memorization (reference-free)\n   200\t    if tf.get(\"docs\"):\n   201\t        docset = {m[\"doc\"]: m[\"set\"] for m in tf[\"docs\"]}\n   202\t        ds = np.array([docset[int(d)] for d in tf[\"doc\"]])\n   203\t        def ce(setname):\n   204\t            m = ds == setname\n   205\t            return float(s[m].mean()) if m.sum() > 500 else float(\"nan\")\n   206\t        web = np.nanmean([ce(\"Pile-CC\"), ce(\"OpenWebText2\")])\n   207\t        f[\"CE_web\"] = float(web); f[\"CE_wiki/web\"] = ce(\"Wikipedia (en)\") / web; f[\"CE_github/web\"] = ce(\"Github\") / web\n   208\t        f[\"CE_stackex/web\"] = ce(\"StackExchange\") / web; f[\"CE_pubmed/web\"] = ce(\"PubMed Abstracts\") / web\n   209\t        gaps = []\n   210\t        for name in set(ds):\n   211\t            m = ds == name\n   212\t            if m.sum() > 2000:\n   213\t                gaps.append(float((H[m] - s[m]).mean()))\n   214\t        f[\"calib_gap_domain_min\"] = float(min(gaps)); f[\"calib_gap_domain_absmean\"] = float(np.mean(np.abs(gaps)))\n   215\t        try:\n   216\t            import vh_memo\n   217\t            rm = vh_memo.runs_mask(H, tf[\"rank\"], tf[\"doc\"])\n   218\t            f[\"verbatim_run_frac\"] = float(rm.mean()); f[\"verbatim_run_frac_wiki\"] = float(rm[ds == \"Wikipedia (en)\"].mean())\n   219\t            f[\"verbatim_run_frac_nocode\"] = float(rm[ds != \"Github\"].mean())\n   220\t            docs, dce, dH, dn = vh_memo.per_doc(tf)\n   221\t            med = np.median(dce)\n   222\t            f[\"doc_CE_p5/med\"] = float(np.percentile(dce, 5) / med); f[\"frac_docs_CE<0.33med\"] = float((dce < med / 3).mean())\n   223\t        except Exception as e:\n   224\t            print(\"memo features failed:\", e)\n   225\t    # tail of the surprisal distribution: how often the model is very surprised by real text\n   226\t    f[\"frac_s>8\"] = float((s > 8).mean())\n   227\t    if ro is not None and \"bos_H\" in ro:\n   228\t        Hb, Vb, tb = ro[\"bos_H\"], ro[\"bos_V\"], ro[\"bos_tok\"]\n   229\t        T = Hb.shape[1]\n   230\t        f[\"roll_H_bos\"] = float(Hb.mean()); f[\"roll_V_bos\"] = float(Vb.mean())\n   231\t        f[\"roll/TF_H\"] = float(Hb.mean() / H.mean())\n   232\t        f[\"roll_H_q1\"] = float(Hb[:, : T // 4].mean()); f[\"roll_H_q4\"] = float(Hb[:, 3 * T // 4:].mean())\n   233\t        f[\"roll_H_slope\"] = f[\"roll_H_q4\"] - f[\"roll_H_q1\"]\n   234\t        f[\"roll_frac_H<0.1\"] = float((Hb < 0.1).mean())\n   235\t        f[\"roll_rep8_q4\"] = float(repetition(tb)[:, 3 * T // 4:].mean())\n   236\t        f[\"roll_seqH_std\"] = float(Hb.mean(1).std())\n   237\t        f[\"W1(TF_H, roll_H)\"] = wasserstein1(H, Hb.ravel())\n   238\t        f[\"W1(TF_V, roll_V)\"] = wasserstein1(V, Vb.ravel())\n   239\t        if \"openers_H\" in ro:\n   240\t            Ho = ro[\"openers_H\"]; f[\"roll_H_open\"] = float(Ho.mean()); f[\"W1(TF_H, open_H)\"] = wasserstein1(H, Ho.ravel())\n   241\t    if rollout_texts:\n   242\t        f[\"roll_instr_marker_rate\"] = marker_rate(rollout_texts.get(\"bos\", []))\n   243\t        f[\"roll_instr_marker_rate_open\"] = marker_rate(rollout_texts.get(\"openers\", []))\n   244\t    if extra is not None:\n   245\t        import vh_memo\n   246\t        rm = vh_memo.runs_mask(extra[\"H\"], extra[\"rank\"], extra[\"doc\"])\n   247\t        eset = {m[\"doc\"]: m[\"set\"] for m in extra[\"docs\"]}\n   248\t        eds = np.array([eset[int(d)] for d in extra[\"doc\"]])\n   249\t        for nm, key in [(\"wiki\", \"Wikipedia (en)\"), (\"gh\", \"Github\")]:\n   250\t            m = eds == key\n   251\t            if m.sum() > 1000:\n   252\t                f[f\"X_CE_{nm}\"] = float(extra[\"s\"][m].mean()); f[f\"X_gap_{nm}\"] = float((extra[\"H\"][m] - extra[\"s\"][m]).mean())\n   253\t                f[f\"X_runfrac_{nm}\"] = float(rm[m].mean())\n   254\t                docs, dce, dH, dn = vh_memo.per_doc({k: extra[k][m] for k in [\"s\", \"H\", \"doc\"]})\n   255\t                f[f\"X_docCE_p10/med_{nm}\"] = float(np.percentile(dce, 10) / np.median(dce))\n   256\t                f[f\"X_frac_docs_CE<0.33med_{nm}\"] = float((dce < np.median(dce) / 3).mean())\n   257\t        f[\"X_CE_wiki/web\"] = f.get(\"X_CE_wiki\", float(\"nan\")) / f[\"CE_web\"]\n   258\t    if fresh is not None:\n   259\t        import vh_memo\n   260\t        Hf, sf = fresh[\"H\"], fresh[\"s\"]\n   261\t        f[\"F_CE\"] = float(sf.mean()); f[\"F_H\"] = float(Hf.mean()); f[\"F_calib_gap\"] = float((Hf - sf).mean())\n   262\t        f[\"F_H_over_s\"] = float(Hf.mean() / sf.mean())\n   263\t        fset = {m[\"doc\"]: m[\"set\"] for m in fresh[\"docs\"]}\n   264\t        fds = np.array([fset[int(d)] for d in fresh[\"doc\"]])\n   265\t        gaps = {}\n   266\t        for name in sorted(set(fds)):\n   267\t            m = fds == name\n   268\t            if m.sum() > 2000:\n   269\t                gaps[name] = float((Hf[m] - sf[m]).mean()); f[f\"F_CE_{name[:10]}\"] = float(sf[m].mean())\n   270\t        f[\"F_gap_domain_min\"] = float(min(gaps.values())); f[\"F_gap_domain_absmean\"] = float(np.mean(np.abs(list(gaps.values()))))\n   271\t        rm = vh_memo.runs_mask(Hf, fresh[\"rank\"], fresh[\"doc\"])\n   272\t        f[\"F_verbatim_run_frac\"] = float(rm.mean())\n   273\t        f[\"F_frac_H<0.1\"] = float((Hf < 0.1).mean())\n   274\t        m = Hf > 1; f[\"F_V/H|H>1\"] = float((fresh[\"V\"][m] / Hf[m]).mean())\n   275\t    return f\n   276\t\n   277\t\n   278\tdef load_rollout_texts(d):\n   279\t    p = os.path.join(d, \"rollouts.jsonl\")\n   280\t    if not os.path.exists(p):\n   281\t        return None\n   282\t    out = {}\n   283\t    for line in open(p):\n   284\t        r = json.loads(line); out.setdefault(r[\"group\"], []).append(r[\"text\"])\n   285\t    return out\n   286\t\n   287\t\n   288\tdef fingerprint_table(results_dir, names, corpus_path=None, out=None):\n   289\t    corpus = json.load(open(corpus_path)) if corpus_path and os.path.exists(corpus_path) else None\n   290\t    rows = {}\n   291\t    for n in names:\n   292\t        d = os.path.join(results_dir, n)\n   293\t        if not os.path.exists(os.path.join(d, \"tf.npz\")):\n   294\t            continue\n   295\t        extra = None\n   296\t        if os.path.exists(os.path.join(d, \"tf_wiki.npz\")):\n   297\t            z = np.load(os.path.join(d, \"tf_wiki.npz\")); extra = {k: z[k] for k in z.files}\n   298\t            for k in [\"H\", \"V\", \"s\", \"p1\"]:\n   299\t                extra[k] = extra[k].astype(np.float32)\n   300\t            extra[\"docs\"] = json.load(open(os.path.join(d, \"tf_wiki_docs.json\")))\n   301\t        fresh = None\n   302\t        if os.path.exists(os.path.join(d, \"tf_fresh.npz\")):\n   303\t            z = np.load(os.path.join(d, \"tf_fresh.npz\")); fresh = {k: z[k] for k in z.files}\n   304\t            for k in [\"H\", \"V\", \"s\", \"p1\"]:\n   305\t                fresh[k] = fresh[k].astype(np.float32)\n   306\t            fresh[\"docs\"] = json.load(open(os.path.join(d, \"tf_fresh_docs.json\")))\n   307\t        rows[n] = fingerprint(load_tf(d), load_ro(d), corpus, extra, load_rollout_texts(d), fresh)\n   308\t    keys = sorted({k for r in rows.values() for k in r})\n   309\t    w = max(len(n) for n in rows) + 1\n   310\t    print(\"feature\".ljust(22) + \"\".join(n[-18:].rjust(19) for n in rows))\n   311\t    for k in keys:\n   312\t        print(k.ljust(22) + \"\".join(f\"{rows[n].get(k, float('nan')):19.3f}\" for n in rows))\n   313\t    if out:\n   314\t        with open(out, \"w\") as fh:\n   315\t            json.dump(rows, fh, indent=1)\n   316\t    return rows\n   317\t\n   318\t\n   319\tdef main():\n   320\t    ap = argparse.ArgumentParser()\n   321\t    ap.add_argument(\"results\")\n   322\t    ap.add_argument(\"--pair\", nargs=\"+\", action=\"append\", default=[], help=\"A B [C ...]: A is the reference\")\n   323\t    ap.add_argument(\"--out\", default=None)\n   324\t    ap.add_argument(\"--all\", action=\"store_true\", help=\"fingerprint every result dir\")\n   325\t    ap.add_argument(\"--corpus\", default=\"/models/varentropy/corpus/pile10k_sel.json\")\n   326\t    args = ap.parse_args()\n   327\t    out = args.out or os.path.join(args.results, \"analysis\")\n   328\t    os.makedirs(out, exist_ok=True)\n   329\t    cache = {}\n   330\t\n   331\t    def get(n):\n   332\t        if n not in cache:\n   333\t            d = os.path.join(args.results, n)\n   334\t            cache[n] = (load_tf(d), load_ro(d))\n   335\t        return cache[n]\n   336\t\n   337\t    report = {\"models\": {}, \"pairs\": []}\n   338\t    names = sorted({n for p in args.pair for n in p})\n   339\t    if args.all:\n   340\t        allnames = sorted(d for d in os.listdir(args.results) if os.path.exists(os.path.join(args.results, d, \"tf.npz\")))\n   341\t        fingerprint_table(args.results, allnames, args.corpus, os.path.join(out, \"fingerprints.json\"))\n   342\t    for n in names:\n   343\t        tf, ro = get(n)\n   344\t        report[\"models\"][n] = {\"summary\": summary(tf, n), \"per_set\": per_set(tf),\n   345\t                               \"rollouts\": rollout_summary(ro, n) if ro else None}\n   346\t        print(f\"== {n}: {json.dumps(report['models'][n]['summary'])}\")\n   347\t        if ro:\n   348\t            print(\"   rollouts:\", json.dumps(report[\"models\"][n][\"rollouts\"]))\n   349\t    for p in args.pair:\n   350\t        ref = p[0]\n   351\t        for other in p[1:]:\n   352\t            a, _ = get(ref); b, _ = get(other)\n   353\t            res, _ = paired(a, b, ref, other)\n   354\t            res[\"ref\"], res[\"other\"] = ref, other\n   355\t            report[\"pairs\"].append(res)\n   356\t            print(f\"== pair {ref} -> {other}: n={res['n_aligned']} dH={res['dH_mean(b-a)']:+.3f} dV={res['dV_mean(b-a)']:+.3f} \"\n   357\t                  f\"dCE={res['dCE(b-a)']:+.3f} corrH={res['corr_H']:.3f} collapsed_branch_points={res['collapsed_branch_points']}\")\n   358\t            for row in res[\"by_ref_H_bin\"]:\n   359\t                print(\"   \", json.dumps(row))\n   360\t    with open(os.path.join(out, \"report.json\"), \"w\") as f:\n   361\t        json.dump(report, f, indent=1)\n   362\t    print(\"wrote\", os.path.join(out, \"report.json\"))\n   363\t\n   364\t\n   365\tif __name__ == \"__main__\":\n   366\t    main()\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc 'nl -ba docs/vh_truebase.py && nl -ba docs/vh_names_table.py && nl -ba docs/vh_selfboot.py'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc 'nl -ba docs/vh_truebase.py && nl -ba docs/vh_names_table.py && nl -ba docs/vh_selfboot.py'","aggregated_output":"     1\t#!/usr/bin/env python\n     2\t\"\"\"True-baseness index from reference-free fingerprints (results/analysis/fingerprints.json).\n     3\t\n     4\tSub-scores in [0,1] (1 = looks like a pre-anneal base), each a clipped linear ramp between two anchors\n     5\tthat were set from the Trinity ladder; refine the anchors once the OLMo-2 ladder is in:\n     6\t  calib   : calibration gap mean(H - s) on fresh post-cutoff text (falls back to Pile).  0 -> 1, -0.10 -> 0\n     7\t  spread  : mean |per-domain gap| on fresh text.                                        0.015 -> 1, 0.10 -> 0\n     8\t  memo    : Wikipedia verbatim-run fraction (150-doc set; falls back to the 24-doc set). 0.02 -> 1, 0.12 -> 0\n     9\t  prior   : instruction/chat-marker rate in 32 bare-BOS T=1 samples.                     0 -> 1, 0.40 -> 0\n    10\toverall = mean of available sub-scores (printed with which were available).\n    11\t\"\"\"\n    12\timport json, sys, os, math\n    13\t\n    14\tRAMPS = {  # feature -> (good_value, bad_value); sign handled by the ramp direction\n    15\t    \"calib\": (0.0, -0.10),\n    16\t    \"spread\": (0.015, 0.10),\n    17\t    \"memo\": (0.02, 0.12),\n    18\t    \"prior\": (0.0, 0.40),\n    19\t}\n    20\t\n    21\t\n    22\tdef ramp(x, good, bad):\n    23\t    if x is None or (isinstance(x, float) and math.isnan(x)):\n    24\t        return None\n    25\t    t = (x - bad) / (good - bad)\n    26\t    return max(0.0, min(1.0, t))\n    27\t\n    28\t\n    29\tdef pick(f, *keys):\n    30\t    for k in keys:\n    31\t        v = f.get(k)\n    32\t        if v is not None and not (isinstance(v, float) and math.isnan(v)):\n    33\t            return v, k\n    34\t    return None, None\n    35\t\n    36\t\n    37\tdef score(f):\n    38\t    out = {}\n    39\t    calib, src = pick(f, \"F_calib_gap\", \"calib_gap\")\n    40\t    out[\"calib\"] = (ramp(min(calib, 0.0) if calib is not None else None, *RAMPS[\"calib\"]), calib, src)\n    41\t    spread, src = pick(f, \"F_gap_domain_absmean\", \"calib_gap_domain_absmean\")\n    42\t    out[\"spread\"] = (ramp(spread, *RAMPS[\"spread\"]), spread, src)\n    43\t    memo, src = pick(f, \"X_runfrac_wiki\", \"verbatim_run_frac_wiki\")\n    44\t    out[\"memo\"] = (ramp(memo, *RAMPS[\"memo\"]), memo, src)\n    45\t    prior, src = pick(f, \"roll_instr_marker_rate\")\n    46\t    out[\"prior\"] = (ramp(prior, *RAMPS[\"prior\"]), prior, src)\n    47\t    avail = [v[0] for v in out.values() if v[0] is not None]\n    48\t    out[\"overall\"] = sum(avail) / len(avail) if avail else None\n    49\t    out[\"n_avail\"] = len(avail)\n    50\t    return out\n    51\t\n    52\t\n    53\tdef main():\n    54\t    path = sys.argv[1] if len(sys.argv) > 1 else \"/models/varentropy/results/analysis/fingerprints.json\"\n    55\t    fps = json.load(open(path))\n    56\t    rows = {n: score(f) for n, f in fps.items() if not n.startswith(\"smoke_\")}\n    57\t    order = sorted(rows, key=lambda n: -(rows[n][\"overall\"] or -1))\n    58\t    print(f\"{'model':34} {'overall':>7} | {'calib':>6} {'(gap)':>8} | {'spread':>6} {'(|gap|)':>8} | {'memo':>6} {'(wiki run)':>10} | {'prior':>6} {'(marker)':>8}  src\")\n    59\t    for n in order:\n    60\t        r = rows[n]\n    61\t        def fmt(k, w=8):\n    62\t            s, v, src = r[k]\n    63\t            return (f\"{s:6.2f} \" if s is not None else f\"{'-':>6} \") + (f\"{v:{w}.3f}\" if v is not None else f\"{'-':>{w}}\")\n    64\t        srcs = \",\".join((\"F\" if (r[k][2] or \"\").startswith(\"F_\") else \"X\" if (r[k][2] or \"\").startswith(\"X_\") else \"p\") for k in [\"calib\", \"spread\", \"memo\"])\n    65\t        print(f\"{n[:34]:34} {r['overall'] if r['overall'] is not None else float('nan'):7.2f} | {fmt('calib')} | {fmt('spread')} | {fmt('memo', 10)} | {fmt('prior')}  {srcs}\")\n    66\t    out = os.path.join(os.path.dirname(path), \"truebase_scores.json\")\n    67\t    json.dump({n: {k: (v if k in (\"overall\", \"n_avail\") else {\"score\": v[0], \"value\": v[1], \"source\": v[2]}) for k, v in r.items()} for n, r in rows.items()}, open(out, \"w\"), indent=1)\n    68\t    print(\"wrote\", out, \"(src column: F=fresh corpus, X=150-doc wiki set, p=Pile main corpus)\")\n    69\t\n    70\t\n    71\tif __name__ == \"__main__\":\n    72\t    main()\n     1\t#!/usr/bin/env python\n     2\t\"\"\"Tables for the surname-distribution probe (results/<model>/names.json) and the weird-genre corpus\n     3\t(results/<model>/tf_weird.npz). Usage: vh_names_table.py RESULTS_DIR\"\"\"\n     4\timport sys, os, json, math\n     5\timport numpy as np\n     6\tsys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))\n     7\timport vh_memo\n     8\t\n     9\tres = sys.argv[1]\n    10\tmodels = sorted(d for d in os.listdir(res) if os.path.exists(os.path.join(res, d, \"names.json\")) and not d.startswith(\"smoke\"))\n    11\tif \"--all\" in sys.argv:\n    12\t    models = sorted(d for d in os.listdir(res) if os.path.exists(os.path.join(res, d, \"names.json\")))\n    13\t\n    14\tprint(\"=== surnames: exact distribution over Census top-2000. desc = mean of 3 description frames; few = mean of 3 few-shot frames (6 Census draws given)\")\n    15\tprint(f\"{'model':30}{'KL_desc':>8}{'KL_few':>8}{'H_desc':>7}{'H_few':>7}{'H_ref':>6}{'top10_d':>8}{'top10_f':>8}{'Smith@plain':>12} | sampled(desc): {'junk':>5}{'distinct':>9}{'surpr':>6}\")\n    16\tfor_later = True\n    17\trows = {}\n    18\tfor m in models:\n    19\t    j = json.load(open(os.path.join(res, m, \"names.json\")))[\"surnames\"]\n    20\t    if not j:\n    21\t        continue\n    22\t    ex = [v[\"exact\"] for v in j.values()]; sm = [v[\"sampled\"] for v in j.values()]\n    23\t    ex_desc = [v[\"exact\"] for k, v in j.items() if not k.startswith(\"fewshot\")]; ex_few = [v[\"exact\"] for k, v in j.items() if k.startswith(\"fewshot\")]\n    24\t    sm_desc = [v[\"sampled\"] for k, v in j.items() if not k.startswith(\"fewshot\")]\n    25\t    def mean(k, lst=ex):\n    26\t        vals = [x[k] for x in lst if x.get(k) is not None]\n    27\t        return float(np.mean(vals)) if vals else float(\"nan\")\n    28\t    def worst(k, lst=ex, hi=True):\n    29\t        vals = [x[k] for x in lst if x.get(k) is not None]\n    30\t        return (max(vals) if hi else min(vals)) if vals else float(\"nan\")\n    31\t    r = {\"KL_cm\": mean(\"KL(ref||model)\"), \"KL_cm_worst\": worst(\"KL(ref||model)\"),\n    32\t         \"KL_desc\": mean(\"KL(ref||model)\", ex_desc), \"KL_few\": mean(\"KL(ref||model)\", ex_few) if ex_few else None,\n    33\t         \"H_desc\": mean(\"H_model\", ex_desc), \"H_few\": mean(\"H_model\", ex_few) if ex_few else None,\n    34\t         \"top10_desc\": mean(\"top10_model\", ex_desc), \"top10_few\": mean(\"top10_model\", ex_few) if ex_few else None,\n    35\t         \"smith_plain\": next((v[\"exact\"][\"top5_model\"][0][1] for k, v in j.items() if k == \"plain\" and v[\"exact\"][\"top5_model\"][0][0] == \"Smith\"), None), \"KL_mc\": mean(\"KL(model||ref)\"), \"H_m\": mean(\"H_model\"), \"H_r\": mean(\"H_ref\"),\n    36\t         \"top10_m\": mean(\"top10_model\"), \"top10_r\": mean(\"top10_ref\"), \"zipf_m\": mean(\"zipf_slope_model\"), \"zipf_r\": mean(\"zipf_slope_ref\"), \"inset\": mean(\"mass_in_set\"),\n    37\t         \"junk\": mean(\"junk_frac\", sm), \"distinct\": mean(\"distinct_frac\", sm), \"surpr\": mean(\"mean_ref_surprise_nats\", sm), \"top10sh\": mean(\"top10_share\", sm), \"stepH\": mean(\"mean_step_H\", sm)}\n    38\t    rows[m] = r\n    39\t    f = lambda v, w=8, d=3: (f\"{v:{w}.{d}f}\" if v is not None and not (isinstance(v, float) and math.isnan(v)) else \" \" * (w - 1) + \"–\")\n    40\t    print(f\"{m[:30]:30}{f(r['KL_desc'])}{f(r['KL_few'])}{f(r['H_desc'],7,2)}{f(r['H_few'],7,2)}{r['H_r']:6.2f}{f(r['top10_desc'],8,2)}{f(r['top10_few'],8,2)}{f(r['smith_plain'],12,3)} |                {f(r['junk'],5,2)}{f(r['distinct'],9,2)}{f(r['surpr'],6,2)}\")\n    41\tjson.dump(rows, open(os.path.join(res, \"analysis\", \"names_summary.json\"), \"w\"), indent=1)\n    42\tprint(\"\\nH_ref/top10_ref/zipf_ref: Census 2010 restricted to the same 2000 names. inset: model's total next-name mass on those 2000 names.\")\n    43\tprint(\"surpr: mean −log p_census(name) of generated in-Census names (Census self-entropy over all 162k names ≈ 10.4 nats; a collapsed model scores well below it).\")\n    44\t\n    45\tprint(\"\\n=== per-frame detail: top-5 names (model prob) and a sample list\")\n    46\tfor m in models:\n    47\t    j = json.load(open(os.path.join(res, m, \"names.json\")))[\"surnames\"]\n    48\t    for frame, v in j.items():\n    49\t        t5 = \", \".join(f\"{n} {p:.3f}\" for n, p in v[\"exact\"][\"top5_model\"])\n    50\t        samp = v[\"sampled\"].get(\"sample_text\", \"\").replace(\"\\n\", \" | \")[:140]\n    51\t        print(f\"{m[:26]:26} {frame:6} top5: {t5:70} | {samp}\")\n    52\t\n    53\tprint(\"\\n=== weird-genre corpus: calibration gap and verbatim-run share per genre\")\n    54\tgenres = None\n    55\ttable = {}\n    56\tfor m in sorted(os.listdir(res)):\n    57\t    p = os.path.join(res, m, \"tf_weird.npz\")\n    58\t    if not os.path.exists(p) or m.startswith(\"smoke\"):\n    59\t        continue\n    60\t    z = np.load(p); H = z[\"H\"].astype(np.float32); s = z[\"s\"].astype(np.float32)\n    61\t    docs = json.load(open(os.path.join(res, m, \"tf_weird_docs.json\"))); dset = {d[\"doc\"]: d[\"set\"] for d in docs}\n    62\t    ds = np.array([dset[int(d)] for d in z[\"doc\"]])\n    63\t    rm = vh_memo.runs_mask(H, z[\"rank\"], z[\"doc\"])\n    64\t    row = {\"ALL\": (float((H - s).mean()), float(rm.mean()), float(s.mean()))}\n    65\t    for g in sorted(set(ds)):\n    66\t        mm = ds == g\n    67\t        if mm.sum() > 1500:\n    68\t            row[g] = (float((H[mm] - s[mm]).mean()), float(rm[mm].mean()), float(s[mm].mean()))\n    69\t    table[m] = row\n    70\t    genres = sorted(set(row) - {\"ALL\"}) if genres is None else genres\n    71\tjson.dump(table, open(os.path.join(res, \"analysis\", \"weird_summary.json\"), \"w\"), indent=1)\n    72\tif table:\n    73\t    gshort = {g: g[:9] for g in genres}\n    74\t    print(f\"{'model':28}{'ALL gap':>8}{'ALL run':>8}\" + \"\".join(f\"{gshort[g]:>10}\" for g in genres) + \"   (gap / verbatim-run share)\")\n    75\t    for m, row in table.items():\n    76\t        print(f\"{m[:28]:28}{row['ALL'][0]:8.3f}{row['ALL'][1]:8.3f}\" + \"\".join((f\"{row[g][0]:+.2f}/{row[g][1]:.2f}\".rjust(10) if g in row else \" \" * 10) for g in genres))\n     1\t#!/usr/bin/env python\n     2\t\"\"\"Probe-free / self-bootstrapped statistics from existing results.\n     3\t A. top-1 reliability on post-cutoff text (tf_fresh.npz, falls back to tf.npz): ECE and over-confidence by bin.\n     4\t B. lexical law of the model's own bare-BOS samples (rollouts.jsonl) vs real text (the Pile corpus) at the\n     5\t    same word budget: type-token ratio, hapax share, Zipf slope, distinct 4-gram ratio, gzip ratio.\n     6\tUsage: vh_selfboot.py RESULTS_DIR [--corpus corpus.json]\"\"\"\n     7\timport sys, os, json, re, gzip, math\n     8\timport numpy as np\n     9\t\n    10\tres = sys.argv[1]\n    11\tcorpus_path = \"/models/varentropy/corpus/pile10k_sel.json\"\n    12\tWORD = re.compile(r\"[A-Za-z]+(?:'[a-z]+)?\")\n    13\t\n    14\t\n    15\tdef lexical(texts, budget):\n    16\t    \"\"\"texts: list of strings; use the first `budget` words of each (equal budget per text).\"\"\"\n    17\t    words_all, ttr, hapax, d4 = [], [], [], []\n    18\t    for t in texts:\n    19\t        w = [x.lower() for x in WORD.findall(t)][:budget]\n    20\t        if len(w) < budget * 0.6:\n    21\t            continue\n    22\t        words_all += w\n    23\t        ttr.append(len(set(w)) / len(w))\n    24\t        c = {}\n    25\t        for x in w:\n    26\t            c[x] = c.get(x, 0) + 1\n    27\t        hapax.append(sum(1 for v in c.values() if v == 1) / len(w))\n    28\t        g = list(zip(w, w[1:], w[2:], w[3:]))\n    29\t        d4.append(len(set(g)) / max(len(g), 1))\n    30\t    if not words_all:\n    31\t        return None\n    32\t    c = {}\n    33\t    for x in words_all:\n    34\t        c[x] = c.get(x, 0) + 1\n    35\t    freq = np.array(sorted(c.values(), reverse=True), float)\n    36\t    r = np.arange(1, len(freq) + 1)\n    37\t    n = min(2000, len(freq))\n    38\t    slope = float(np.polyfit(np.log(r[:n]), np.log(freq[:n]), 1)[0])\n    39\t    raw = \" \".join(words_all).encode()\n    40\t    gz = len(gzip.compress(raw)) / len(raw)\n    41\t    return {\"n_texts\": len(ttr), \"ttr\": float(np.mean(ttr)), \"hapax\": float(np.mean(hapax)), \"distinct4\": float(np.mean(d4)),\n    42\t            \"zipf_slope\": slope, \"gzip_ratio\": gz, \"vocab\": len(c)}\n    43\t\n    44\t\n    45\tdef reliability(z, nb=10):\n    46\t    p1 = z[\"p1\"].astype(np.float32); hit = (z[\"rank\"] == 0).astype(np.float32)\n    47\t    edges = np.linspace(0, 1, nb + 1)\n    48\t    rows, ece = [], 0.0\n    49\t    for lo, hi in zip(edges[:-1], edges[1:]):\n    50\t        m = (p1 >= lo) & (p1 < hi) if hi < 1 else (p1 >= lo)\n    51\t        if m.sum() == 0:\n    52\t            continue\n    53\t        conf, acc = float(p1[m].mean()), float(hit[m].mean())\n    54\t        ece += m.mean() * abs(conf - acc)\n    55\t        rows.append((lo, hi, int(m.sum()), conf, acc))\n    56\t    hi_m = p1 >= 0.9\n    57\t    return {\"ECE\": float(ece), \"acc_minus_conf_p1>0.9\": float(hit[hi_m].mean() - p1[hi_m].mean()) if hi_m.any() else None,\n    58\t            \"frac_p1>0.9\": float(hi_m.mean()), \"top1_acc\": float(hit.mean()), \"mean_p1\": float(p1.mean()), \"bins\": rows}\n    59\t\n    60\t\n    61\tcorpus = json.load(open(corpus_path))\n    62\tbudget = 700\n    63\tref_texts = [d[\"text\"] for d in corpus[\"tf\"]][:200]\n    64\tref = lexical(ref_texts, budget)\n    65\tprint(f\"REFERENCE (Pile docs, {budget} words each, n={ref['n_texts']}): ttr {ref['ttr']:.3f} hapax {ref['hapax']:.3f} distinct4 {ref['distinct4']:.3f} zipf {ref['zipf_slope']:.2f} gzip {ref['gzip_ratio']:.3f}\")\n    66\tprint(f\"\\n{'model':30}{'ECE':>7}{'acc-conf@p1>.9':>15}{'frac>.9':>8}{'acc':>6} | {'ttr':>6}{'hapax':>7}{'dist4':>7}{'zipf':>6}{'gzip':>6}{'n':>4}  (lexical: own BOS samples vs ref)\")\n    67\tout = {}\n    68\tfor m in sorted(os.listdir(res)):\n    69\t    d = os.path.join(res, m)\n    70\t    if m.startswith(\"smoke\") or m.startswith(\"vsmoke\") or not os.path.isdir(d):\n    71\t        continue\n    72\t    p = os.path.join(d, \"tf_fresh.npz\") if os.path.exists(os.path.join(d, \"tf_fresh.npz\")) else os.path.join(d, \"tf.npz\")\n    73\t    if not os.path.exists(p):\n    74\t        continue\n    75\t    rel = reliability(np.load(p))\n    76\t    lex = None\n    77\t    rp = os.path.join(d, \"rollouts.jsonl\")\n    78\t    if os.path.exists(rp):\n    79\t        texts = [json.loads(l)[\"text\"] for l in open(rp) if json.loads(l)[\"group\"] == \"bos\"]\n    80\t        lex = lexical(texts, budget)\n    81\t    out[m] = {\"reliability\": rel, \"lexical\": lex}\n    82\t    lx = f\"{lex['ttr']:6.3f}{lex['hapax']:7.3f}{lex['distinct4']:7.3f}{lex['zipf_slope']:6.2f}{lex['gzip_ratio']:6.3f}{lex['n_texts']:4d}\" if lex else \" \" * 36\n    83\t    print(f\"{m[:30]:30}{rel['ECE']:7.3f}{(rel['acc_minus_conf_p1>0.9'] if rel['acc_minus_conf_p1>0.9'] is not None else float('nan')):15.3f}{rel['frac_p1>0.9']:8.3f}{rel['top1_acc']:6.2f} | {lx}\")\n    84\tjson.dump({\"reference\": ref, \"models\": out}, open(os.path.join(res, \"analysis\", \"selfboot.json\"), \"w\"), indent=1)\n    85\tprint(\"\\nECE: expected |hit-rate − p1| over 10 confidence bins (lower = better calibrated); acc-conf@p1>.9: negative = over-confident where most sure.\")\n    86\tprint(\"Lexical: own samples with ttr/hapax/zipf far below the reference = mode-collapsed language; n = samples with ≥60% of the word budget.\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_9","type":"agent_message","text":"The journal itself limits the central claim: OLMo-2’s anneal largely preserves calibration, while Trinity’s shifts it. I’m checking whether the site retains that distinction and whether the composite score and surname summaries recompute from the published data.\n"}}
