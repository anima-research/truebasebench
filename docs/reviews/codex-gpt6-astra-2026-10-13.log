{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc 'nl -ba docs/vh_score.py'","aggregated_output":"     1\t#!/usr/bin/env python\n     2\t\"\"\"Per-token entropy / varentropy profiling of a causal LM.\n     3\t\n     4\tTwo measurements, both with the *full* next-token distribution (no top-k approximation):\n     5\t\n     6\t  1. teacher-forced: run a fixed shared corpus through the model and record, at every position,\n     7\t     H (entropy, nats), V (varentropy = Var_{x~p}[-log p(x)]), s (surprisal of the actual next\n     8\t     token), p1 / top1 (prob and id of the argmax), rank (rank of the actual token).\n     9\t  2. rollouts: free-running sampling at temperature T (default 1.0, no truncation) from\n    10\t     (a) a bare document-start token and (b) short document openers; the same statistics are\n    11\t     recorded at every sampled step (s = surprisal of the token that was sampled).\n    12\t\n    13\tEverything is plain HF transformers with device_map=\"auto\" (pipeline over all visible GPUs), so\n    14\tthe same code path serves dense and MoE checkpoints and arbitrary sizes.\n    15\t\"\"\"\n    16\timport argparse, json, os, sys, time, math\n    17\timport numpy as np\n    18\timport torch\n    19\timport torch.nn.functional as F\n    20\tfrom transformers import AutoTokenizer, AutoModelForCausalLM\n    21\t\n    22\t\n    23\tdef log(*a):\n    24\t    print(time.strftime(\"%H:%M:%S\"), *a, flush=True)\n    25\t\n    26\t\n    27\tdef dist_stats(logits):\n    28\t    \"\"\"logits: (N, V) any float dtype on GPU -> dict of (N,) tensors + logp (N, V) float32.\"\"\"\n    29\t    logp = F.log_softmax(logits.float(), dim=-1)\n    30\t    p = logp.exp()\n    31\t    H = -(p * logp).sum(-1)\n    32\t    V = (p * (logp + H[:, None]) ** 2).sum(-1)\n    33\t    p1, t1 = p.max(-1)\n    34\t    return H, V, p1, t1, logp\n    35\t\n    36\t\n    37\tdef load_corpus(path):\n    38\t    with open(path) as f:\n    39\t        return json.load(f)\n    40\t\n    41\t\n    42\tdef build_corpus(out_path, arrow_path, n_tf, n_openers, min_chars=400, seed=0):\n    43\t    \"\"\"Fixed shared selection from pile-10k; written once, reused by every model.\"\"\"\n    44\t    if os.path.exists(out_path):\n    45\t        return load_corpus(out_path)\n    46\t    from datasets import Dataset\n    47\t    ds = Dataset.from_file(arrow_path)\n    48\t    rng = np.random.RandomState(seed)\n    49\t    order = rng.permutation(len(ds))\n    50\t    tf, op = [], []\n    51\t    for i in order:\n    52\t        r = ds[int(i)]\n    53\t        txt = r[\"text\"]\n    54\t        if len(txt) < min_chars:\n    55\t            continue\n    56\t        item = {\"idx\": int(i), \"set\": r[\"meta\"].get(\"pile_set_name\"), \"text\": txt}\n    57\t        if len(tf) < n_tf:\n    58\t            tf.append(item)\n    59\t        elif len(op) < n_openers:\n    60\t            op.append(item)\n    61\t        else:\n    62\t            break\n    63\t    corpus = {\"source\": \"NeelNanda/pile-10k\", \"seed\": seed, \"tf\": tf, \"openers\": op}\n    64\t    with open(out_path, \"w\") as f:\n    65\t        json.dump(corpus, f)\n    66\t    return corpus\n    67\t\n    68\t\n    69\t@torch.no_grad()\n    70\tdef teacher_forced(model, tok, docs, max_len, out_dir, chunk=512, tag=\"tf\"):\n    71\t    cols = {k: [] for k in [\"H\", \"V\", \"s\", \"p1\", \"top1\", \"rank\", \"tok\", \"doc\", \"pos\"]}\n    72\t    meta = []\n    73\t    t0 = time.time()\n    74\t    ntok = 0\n    75\t    for di, d in enumerate(docs):\n    76\t        ids = tok(d[\"text\"], add_special_tokens=True, truncation=True, max_length=max_len)[\"input_ids\"]\n    77\t        if len(ids) < 8:\n    78\t            continue\n    79\t        x = torch.tensor(ids, device=model.device)[None]\n    80\t        try:\n    81\t            logits = model(input_ids=x, use_cache=False).logits[0]  # (L, V)\n    82\t        except torch.cuda.OutOfMemoryError:\n    83\t            log(f\"OOM on doc {di} (len {len(ids)}), skipping\")\n    84\t            torch.cuda.empty_cache()\n    85\t            continue\n    86\t        L = logits.shape[0] - 1  # predictions for positions 0..L-1 -> targets 1..L\n    87\t        tgt = x[0, 1:]\n    88\t        for a in range(0, L, chunk):\n    89\t            b = min(a + chunk, L)\n    90\t            lg = logits[a:b]\n    91\t            H, V, p1, t1, logp = dist_stats(lg)\n    92\t            tg = tgt[a:b]\n    93\t            s = -logp.gather(1, tg[:, None])[:, 0]\n    94\t            tl = lg.float().gather(1, tg[:, None])\n    95\t            rank = (lg.float() > tl).sum(-1)\n    96\t            cols[\"H\"].append(H.half().cpu()); cols[\"V\"].append(V.half().cpu())\n    97\t            cols[\"s\"].append(s.half().cpu()); cols[\"p1\"].append(p1.half().cpu())\n    98\t            cols[\"top1\"].append(t1.int().cpu()); cols[\"rank\"].append(rank.int().cpu())\n    99\t            cols[\"tok\"].append(tg.int().cpu())\n   100\t            cols[\"doc\"].append(torch.full((b - a,), di, dtype=torch.int32))\n   101\t            cols[\"pos\"].append(torch.arange(a, b, dtype=torch.int32))\n   102\t        meta.append({\"doc\": di, \"idx\": d[\"idx\"], \"set\": d[\"set\"], \"ntok\": L + 1})\n   103\t        ntok += L\n   104\t        del logits\n   105\t        if di % 20 == 0:\n   106\t            el = time.time() - t0\n   107\t            log(f\"tf doc {di}/{len(docs)} len={L+1} total_tok={ntok} {ntok/el:.0f} tok/s\")\n   108\t    arrs = {k: torch.cat(v).numpy() for k, v in cols.items()}\n   109\t    np.savez_compressed(os.path.join(out_dir, f\"{tag}.npz\"), **arrs)\n   110\t    with open(os.path.join(out_dir, f\"{tag}_docs.json\"), \"w\") as f:\n   111\t        json.dump(meta, f)\n   112\t    log(f\"tf done: {ntok} tokens in {time.time()-t0:.0f}s\")\n   113\t\n   114\t\n   115\t@torch.no_grad()\n   116\tdef rollout_group(model, tok, prompt_ids, steps, temperature, seed, tag):\n   117\t    \"\"\"prompt_ids: list of equal-length id lists. Returns dict of (B, steps) arrays.\"\"\"\n   118\t    from transformers import DynamicCache\n   119\t    B = len(prompt_ids)\n   120\t    x = torch.tensor(prompt_ids, device=model.device)\n   121\t    past = DynamicCache(config=model.config) if \"config\" in DynamicCache.__init__.__code__.co_varnames else DynamicCache()\n   122\t    rec = {k: torch.empty((B, steps), dtype=torch.float16) for k in [\"H\", \"V\", \"s\", \"p1\"]}\n   123\t    rec[\"top1\"] = torch.empty((B, steps), dtype=torch.int32)\n   124\t    rec[\"tok\"] = torch.empty((B, steps), dtype=torch.int32)\n   125\t    gen = None\n   126\t    t0 = time.time()\n   127\t    out = model(input_ids=x, past_key_values=past, use_cache=True, logits_to_keep=1)\n   128\t    for t in range(steps):\n   129\t        logits = out.logits[:, -1, :].float()\n   130\t        if gen is None:\n   131\t            gen = torch.Generator(device=logits.device).manual_seed(seed)\n   132\t        H, V, p1, t1, logp_raw = dist_stats(logits)\n   133\t        if temperature == 1.0:\n   134\t            logp = logp_raw\n   135\t        else:\n   136\t            logp = F.log_softmax(logits / temperature, dim=-1)\n   137\t        nxt = torch.multinomial(logp.exp(), 1, generator=gen)  # (B,1)\n   138\t        s = -logp_raw.gather(1, nxt)[:, 0]  # surprisal under the raw (T=1) distribution\n   139\t        rec[\"H\"][:, t] = H.half().cpu(); rec[\"V\"][:, t] = V.half().cpu()\n   140\t        rec[\"s\"][:, t] = s.half().cpu(); rec[\"p1\"][:, t] = p1.half().cpu()\n   141\t        rec[\"top1\"][:, t] = t1.int().cpu(); rec[\"tok\"][:, t] = nxt[:, 0].int().cpu()\n   142\t        out = model(input_ids=nxt.to(model.device), past_key_values=past, use_cache=True, logits_to_keep=1)\n   143\t        if t % 200 == 0:\n   144\t            el = time.time() - t0\n   145\t            log(f\"rollout[{tag}] step {t}/{steps} {(t+1)*B/max(el,1e-6):.0f} tok/s meanH={H.mean():.2f}\")\n   146\t    del past, out\n   147\t    torch.cuda.empty_cache()\n   148\t    return {k: v.numpy() for k, v in rec.items()}\n   149\t\n   150\t\n   151\tdef rollouts(model, tok, corpus, args, out_dir):\n   152\t    start_id = tok.bos_token_id if tok.bos_token_id is not None else tok.eos_token_id\n   153\t    groups = {}\n   154\t    if args.n_bos > 0:\n   155\t        groups[\"bos\"] = [[start_id]] * args.n_bos\n   156\t    if args.n_openers > 0:\n   157\t        ops = []\n   158\t        for d in corpus[\"openers\"][: args.n_openers]:\n   159\t            ids = tok(d[\"text\"], add_special_tokens=True, truncation=True, max_length=args.opener_len)[\"input_ids\"]\n   160\t            if len(ids) == args.opener_len:\n   161\t                ops.append(ids)\n   162\t        groups[\"openers\"] = ops\n   163\t    res = {}\n   164\t    for name, prompts in groups.items():\n   165\t        for i in range(0, len(prompts), args.rollout_batch):\n   166\t            batch = prompts[i: i + args.rollout_batch]\n   167\t            r = rollout_group(model, tok, batch, args.rollout_steps, args.temperature,\n   168\t                              seed=args.seed + i, tag=f\"{name}:{i}\")\n   169\t            for k, v in r.items():\n   170\t                res.setdefault(f\"{name}_{k}\", []).append(v)\n   171\t            res.setdefault(f\"{name}_prompt\", []).append(np.array(batch, dtype=np.int32))\n   172\t    arrs = {k: np.concatenate(v, 0) for k, v in res.items()}\n   173\t    arrs[\"start_id\"] = np.array(start_id)\n   174\t    np.savez_compressed(os.path.join(out_dir, \"rollouts.npz\"), **arrs)\n   175\t    # human-readable dump\n   176\t    with open(os.path.join(out_dir, \"rollouts.jsonl\"), \"w\") as f:\n   177\t        for name in groups:\n   178\t            toks = arrs[f\"{name}_tok\"]; pr = arrs[f\"{name}_prompt\"]\n   179\t            for i in range(toks.shape[0]):\n   180\t                f.write(json.dumps({\"group\": name, \"i\": i,\n   181\t                                    \"prompt\": tok.decode(pr[i].tolist()),\n   182\t                                    \"text\": tok.decode(toks[i].tolist()),\n   183\t                                    \"meanH\": float(arrs[f\"{name}_H\"][i].astype(np.float32).mean()),\n   184\t                                    \"meanV\": float(arrs[f\"{name}_V\"][i].astype(np.float32).mean())}) + \"\\n\")\n   185\t    log(\"rollouts done\")\n   186\t\n   187\t\n   188\t# ---------------- names distribution probe (Gwern's surname test) ----------------\n   189\tSURNAME_PROMPTS = {\n   190\t    \"pop\": \"Below is a list of 100 American surnames drawn at random from the U.S. population, so common surnames appear more often than rare ones. The list is in random order, not alphabetical.\\n\\n1.\",\n   191\t    \"census\": \"Random sample of 100 U.S. last names, drawn in proportion to their frequency in the 2010 Census, listed in the order they were drawn:\\n\\n1.\",\n   192\t    \"plain\": \"Here are the last names of 100 randomly chosen Americans, in no particular order:\\n\\n1.\",\n   193\t    \"fewshot1\": \"Last names of six randomly selected U.S. residents:\\n\\n1. Collins\\n2. Johnson\\n3. Whitaker\\n4. Matias\\n5. Trujillo\\n6. Oneill\\n7.\",\n   194\t    \"fewshot2\": \"Last names of six randomly selected U.S. residents:\\n\\n1. Watson\\n2. Rubio\\n3. Adkins\\n4. Beltz\\n5. Evans\\n6. Carlson\\n7.\",\n   195\t    \"fewshot3\": \"Last names of six randomly selected U.S. residents:\\n\\n1. Graham\\n2. Brock\\n3. Calderon\\n4. Medina\\n5. Danforth\\n6. Morris\\n7.\",\n   196\t}\n   197\tFIRSTNAME_PROMPTS = {\n   198\t    \"pop\": \"Below is a list of 100 American first names drawn at random from the U.S. population, so common names appear more often than rare ones. The list is in random order, not alphabetical.\\n\\n1.\",\n   199\t    \"plain\": \"Here are the first names of 100 randomly chosen Americans, in no particular order:\\n\\n1.\",\n   200\t}\n   201\t\n   202\t\n   203\t@torch.no_grad()\n   204\tdef score_candidates(model, tok, prompt, cands, bs=96):\n   205\t    \"\"\"log P(name | prompt), exact: name tokens only (no terminator), summed over Title-case and ALL-CAPS spellings.\"\"\"\n   206\t    pid = tok(prompt, add_special_tokens=True)[\"input_ids\"]\n   207\t    variants = [[tok(\" \" + c, add_special_tokens=False)[\"input_ids\"], tok(\" \" + c.upper(), add_special_tokens=False)[\"input_ids\"]] for c in cands]\n   208\t    flat = [v for vs in variants for v in vs]\n   209\t    out = []\n   210\t    pad = tok.pad_token_id if tok.pad_token_id is not None else 0\n   211\t    for a in range(0, len(flat), bs):\n   212\t        chunk = flat[a:a + bs]\n   213\t        L = max(len(c) for c in chunk)\n   214\t        ids = torch.full((len(chunk), len(pid) + L), pad, dtype=torch.long)\n   215\t        mask = torch.zeros_like(ids)\n   216\t        for i, c in enumerate(chunk):\n   217\t            seq = pid + c\n   218\t            ids[i, :len(seq)] = torch.tensor(seq); mask[i, :len(seq)] = 1\n   219\t        ids, mask = ids.to(model.device), mask.to(model.device)\n   220\t        logits = model(input_ids=ids, attention_mask=mask, use_cache=False).logits.float()\n   221\t        logp = torch.log_softmax(logits, -1)\n   222\t        for i, c in enumerate(chunk):\n   223\t            lp = 0.0\n   224\t            for j, t in enumerate(c):\n   225\t                lp += float(logp[i, len(pid) - 1 + j, t])\n   226\t            out.append(lp)\n   227\t    out = np.array(out).reshape(len(cands), 2)\n   228\t    return np.logaddexp(out[:, 0], out[:, 1])\n   229\t\n   230\t\n   231\tdef dist_metrics(logp_model, counts):\n   232\t    \"\"\"Compare the model's (unnormalised) log-probs over a candidate set with reference counts.\"\"\"\n   233\t    lp = np.array(logp_model, np.float64); c = np.array(counts, np.float64)\n   234\t    mass_in_set = float(np.exp(lp).sum())\n   235\t    pm = np.exp(lp - lp.max()); pm /= pm.sum()\n   236\t    pc = c / c.sum()\n   237\t    eps = 1e-12\n   238\t    kl_cm = float((pc * np.log((pc + eps) / (pm + eps))).sum()); kl_mc = float((pm * np.log((pm + eps) / (pc + eps))).sum())\n   239\t    Hm = float(-(pm * np.log(pm + eps)).sum()); Hc = float(-(pc * np.log(pc + eps)).sum())\n   240\t    order = np.argsort(-pm)\n   241\t    top10 = float(pm[order[:10]].sum()); top10c = float(pc[:10].sum())\n   242\t    r = np.arange(1, len(pm) + 1)\n   243\t    slope = float(np.polyfit(np.log(r[:500]), np.log(pm[order][:500] + eps), 1)[0])\n   244\t    slope_c = float(np.polyfit(np.log(r[:500]), np.log(pc[:500] + eps), 1)[0])\n   245\t    return {\"mass_in_set\": mass_in_set, \"KL(ref||model)\": kl_cm, \"KL(model||ref)\": kl_mc, \"H_model\": Hm, \"H_ref\": Hc,\n   246\t            \"top10_model\": top10, \"top10_ref\": top10c, \"zipf_slope_model\": slope, \"zipf_slope_ref\": slope_c,\n   247\t            \"top5_model\": [(int(i), round(float(pm[i]), 4)) for i in order[:5]], \"p_rank1_ref_name\": float(pm[0])}\n   248\t\n   249\t\n   250\tdef parse_list(text, allowed=None):\n   251\t    import re\n   252\t    names = []\n   253\t    for line in text.split(\"\\n\"):\n   254\t        m = re.match(r\"^\\s*(\\d{1,3})[.)]\\s+([A-Z][A-Za-z'\\-]+(?: [A-Z][A-Za-z'\\-]+){0,2})\\s*$\", line)\n   255\t        if m:\n   256\t            names.append(m.group(2).strip().title())\n   257\t    return names\n   258\t\n   259\t\n   260\tdef sample_metrics(names, ref_counts_by_name, ref_total):\n   261\t    \"\"\"names: generated list; ref: dict name->count. Returns diversity + census-surprise metrics.\"\"\"\n   262\t    import math\n   263\t    n = len(names)\n   264\t    if n == 0:\n   265\t        return {\"n\": 0}\n   266\t    cnt = {}\n   267\t    for x in names:\n   268\t        cnt[x] = cnt.get(x, 0) + 1\n   269\t    distinct = len(cnt)\n   270\t    in_ref = [x for x in names if x in ref_counts_by_name]\n   271\t    junk = 1 - len(in_ref) / n\n   272\t    surprise = [-math.log(ref_counts_by_name[x] / ref_total) for x in in_ref]\n   273\t    top = sorted(cnt.items(), key=lambda kv: -kv[1])[:10]\n   274\t    simpson = sum(v * v for v in cnt.values()) / (n * n)\n   275\t    return {\"n\": n, \"distinct_frac\": distinct / n, \"junk_frac\": junk, \"mean_ref_surprise_nats\": float(np.mean(surprise)) if surprise else None,\n   276\t            \"median_ref_rank_logcount\": None, \"top10_share\": sum(v for _, v in top) / n, \"simpson\": simpson, \"top10\": top}\n   277\t\n   278\t\n   279\tdef names_probe(model, tok, out_dir, names_path, args):\n   280\t    import json as _json\n   281\t    data = _json.load(open(names_path))\n   282\t    res = {\"surnames\": {}, \"firstnames\": {}}\n   283\t    for key, prompts, ref in [(\"surnames\", SURNAME_PROMPTS, data[\"surnames\"]), (\"firstnames\", FIRSTNAME_PROMPTS, data.get(\"firstnames\", []))]:\n   284\t        if not ref:\n   285\t            continue\n   286\t        top = ref[: args.names_topk]\n   287\t        cands = [n for n, _ in top]; counts = [c for _, c in top]\n   288\t        ref_by_name = {n: c for n, c in ref}; ref_total = sum(c for _, c in ref)\n   289\t        for pname, prompt in prompts.items():\n   290\t            t0 = time.time()\n   291\t            lp = score_candidates(model, tok, prompt, cands)\n   292\t            m = dist_metrics(lp, counts); m[\"top5_model\"] = [(cands[i], p) for i, p in m[\"top5_model\"]]\n   293\t            m[\"logp_top50\"] = {cands[i]: round(float(lp[i]), 3) for i in np.argsort(-lp)[:50]}\n   294\t            # sampled lists (skipped when --names-lists 0)\n   295\t            B = args.names_lists\n   296\t            if B > 0:\n   297\t                pid = tok(prompt, add_special_tokens=True)[\"input_ids\"]\n   298\t                r = rollout_group(model, tok, [pid] * B, args.names_steps, 1.0, seed=args.seed + 7, tag=f\"names:{key}:{pname}\")\n   299\t                texts = [tok.decode(r[\"tok\"][i].tolist()) for i in range(B)]\n   300\t                gen = []\n   301\t                per_list_distinct = []\n   302\t                for t in texts:\n   303\t                    ns = parse_list(\"1.\" + t)\n   304\t                    gen += ns; per_list_distinct.append(len(set(ns)) / max(len(ns), 1))\n   305\t                sm = sample_metrics(gen, ref_by_name, ref_total)\n   306\t                sm[\"within_list_distinct_frac\"] = float(np.mean(per_list_distinct))\n   307\t                sm[\"sample_text\"] = texts[0][:600]\n   308\t                sm[\"mean_step_H\"] = float(r[\"H\"].astype(np.float32).mean())\n   309\t            else:\n   310\t                sm = {\"n\": 0}\n   311\t            res[key][pname] = {\"exact\": m, \"sampled\": sm, \"secs\": time.time() - t0}\n   312\t            log(f\"names[{key}/{pname}] KL(ref||m)={m['KL(ref||model)']:.3f} H_m={m['H_model']:.2f} H_ref={m['H_ref']:.2f} top10_m={m['top10_model']:.3f} mass_in_set={m['mass_in_set']:.3f} | sampled n={sm.get('n')} distinct={sm.get('distinct_frac')} junk={sm.get('junk_frac')} surprise={sm.get('mean_ref_surprise_nats')}\")\n   313\t            if B == 0:\n   314\t                res[key][pname][\"sampled\"] = {\"n\": 0}\n   315\t    # reference self-entropy of the full distribution for context\n   316\t    with open(os.path.join(out_dir, \"names.json\"), \"w\") as f:\n   317\t        _json.dump(res, f, indent=1)\n   318\t    log(\"names probe done\")\n   319\t\n   320\t\n   321\tdef main():\n   322\t    ap = argparse.ArgumentParser()\n   323\t    ap.add_argument(\"--model\", required=True)\n   324\t    ap.add_argument(\"--name\", default=None)\n   325\t    ap.add_argument(\"--out\", default=\"/models/varentropy/results\")\n   326\t    ap.add_argument(\"--corpus\", default=\"/models/varentropy/corpus/pile10k_sel.json\")\n   327\t    ap.add_argument(\"--arrow\", default=\"/models/huggingface/datasets/NeelNanda___pile-10k/default/0.0.0/127bfedcd5047750df5ccf3a12979a47bfa0bafa/pile-10k-train.arrow\")\n   328\t    ap.add_argument(\"--n-tf\", type=int, default=400)\n   329\t    ap.add_argument(\"--max-len\", type=int, default=2048)\n   330\t    ap.add_argument(\"--n-bos\", type=int, default=32)\n   331\t    ap.add_argument(\"--n-openers\", type=int, default=32)\n   332\t    ap.add_argument(\"--opener-len\", type=int, default=32)\n   333\t    ap.add_argument(\"--rollout-steps\", type=int, default=1536)\n   334\t    ap.add_argument(\"--rollout-batch\", type=int, default=32)\n   335\t    ap.add_argument(\"--temperature\", type=float, default=1.0)\n   336\t    ap.add_argument(\"--seed\", type=int, default=1234)\n   337\t    ap.add_argument(\"--max-mem-gib\", type=int, default=165)\n   338\t    ap.add_argument(\"--experts-impl\", default=None, help=\"HF experts_implementation (eager|batched_mm|grouped_mm)\")\n   339\t    ap.add_argument(\"--attn\", default=\"sdpa\")\n   340\t    ap.add_argument(\"--extra-corpus\", action=\"append\", default=[], help=\"NAME=PATH (repeatable) or PATH; extra TF-only corpora\")\n   341\t    ap.add_argument(\"--extra-name\", default=\"tf_wiki\")\n   342\t    ap.add_argument(\"--trust-remote-code\", action=\"store_true\")\n   343\t    ap.add_argument(\"--arch\", default=None, help=\"force a native transformers class, e.g. deepseek_v3 (for Kimi K2 / DSV3 custom-code checkpoints)\")\n   344\t    ap.add_argument(\"--quantize-fp8\", action=\"store_true\", help=\"quantize a bf16 checkpoint to fine-grained FP8 (block 128) at load\")\n   345\t    ap.add_argument(\"--fp8-dequantize\", action=\"store_true\", help=\"dequantize a fine-grained FP8 checkpoint to bf16 at load (for remote-code MoE the FP8 quantizer cannot wrap)\")\n   346\t    ap.add_argument(\"--names-probe\", default=None, help=\"names.json (census surnames / SSA first names) → names distribution probe\")\n   347\t    ap.add_argument(\"--names-topk\", type=int, default=2000)\n   348\t    ap.add_argument(\"--names-lists\", type=int, default=16)\n   349\t    ap.add_argument(\"--names-steps\", type=int, default=400)\n   350\t    ap.add_argument(\"--skip-tf\", action=\"store_true\")\n   351\t    ap.add_argument(\"--skip-rollouts\", action=\"store_true\")\n   352\t    args = ap.parse_args()\n   353\t\n   354\t    name = args.name or os.path.basename(args.model.rstrip(\"/\"))\n   355\t    out_dir = os.path.join(args.out, name)\n   356\t    os.makedirs(out_dir, exist_ok=True)\n   357\t    corpus = build_corpus(args.corpus, args.arrow, n_tf=max(args.n_tf, 400), n_openers=64)\n   358\t    log(f\"corpus: {len(corpus['tf'])} tf docs, {len(corpus['openers'])} openers; using {args.n_tf} tf docs\")\n   359\t\n   360\t    if args.trust_remote_code:\n   361\t        # transformers 5 removed gpt2.tokenization_gpt2.bytes_to_unicode; Kimi K2's tokenization_kimi.py imports it\n   362\t        import transformers.models.gpt2.tokenization_gpt2 as _g\n   363\t        if not hasattr(_g, \"bytes_to_unicode\"):\n   364\t            def _b2u():\n   365\t                bs = list(range(ord(\"!\"), ord(\"~\") + 1)) + list(range(ord(\"¡\"), ord(\"¬\") + 1)) + list(range(ord(\"®\"), ord(\"ÿ\") + 1))\n   366\t                cs = bs[:]; n = 0\n   367\t                for b in range(2 ** 8):\n   368\t                    if b not in bs:\n   369\t                        bs.append(b); cs.append(2 ** 8 + n); n += 1\n   370\t                return dict(zip(bs, [chr(c) for c in cs]))\n   371\t            _g.bytes_to_unicode = _b2u\n   372\t    tok = AutoTokenizer.from_pretrained(args.model, trust_remote_code=args.trust_remote_code)\n   373\t    ngpu = torch.cuda.device_count()\n   374\t    max_memory = {i: f\"{args.max_mem_gib}GiB\" for i in range(ngpu)}\n   375\t    kw = dict(dtype=torch.bfloat16, device_map=\"auto\", max_memory=max_memory, attn_implementation=args.attn)\n   376\t    if args.experts_impl:\n   377\t        kw[\"experts_implementation\"] = args.experts_impl\n   378\t    if args.trust_remote_code:\n   379\t        kw[\"trust_remote_code\"] = True\n   380\t    if args.quantize_fp8:\n   381\t        from transformers import FineGrainedFP8Config\n   382\t        kw[\"quantization_config\"] = FineGrainedFP8Config(weight_block_size=(128, 128))\n   383\t    if args.fp8_dequantize:\n   384\t        from transformers import FineGrainedFP8Config\n   385\t        kw[\"quantization_config\"] = FineGrainedFP8Config(dequantize=True)\n   386\t    loader = AutoModelForCausalLM\n   387\t    if args.arch == \"deepseek_v3\":\n   388\t        from transformers import DeepseekV3Config, DeepseekV3ForCausalLM\n   389\t        cfg = DeepseekV3Config.from_pretrained(args.model)  # ignores model_type/auto_map (Kimi K2 is the same architecture)\n   390\t        kw[\"config\"] = cfg; kw.pop(\"trust_remote_code\", None)\n   391\t        loader = DeepseekV3ForCausalLM\n   392\t    t0 = time.time()\n   393\t    log(f\"loading {args.model} on {ngpu} GPUs with {kw}\")\n   394\t    try:\n   395\t        model = loader.from_pretrained(args.model, **kw)\n   396\t    except TypeError as e:\n   397\t        log(f\"retry load without experts_implementation ({e})\")\n   398\t        kw.pop(\"experts_implementation\", None)\n   399\t        model = loader.from_pretrained(args.model, **kw)\n   400\t    model.eval()\n   401\t    log(f\"loaded in {time.time()-t0:.0f}s; device={model.device}; \"\n   402\t        f\"mem/GPU GiB: {[round(torch.cuda.memory_allocated(i)/2**30,1) for i in range(ngpu)]}\")\n   403\t    with open(os.path.join(out_dir, \"run.json\"), \"w\") as f:\n   404\t        json.dump({\"args\": vars(args), \"model_type\": model.config.model_type, \"vocab\": tok.vocab_size,\n   405\t                   \"bos\": tok.bos_token_id, \"eos\": tok.eos_token_id, \"ngpu\": ngpu,\n   406\t                   \"load_s\": time.time() - t0, \"transformers\": __import__(\"transformers\").__version__}, f, indent=1)\n   407\t    if not args.skip_tf:\n   408\t        teacher_forced(model, tok, corpus[\"tf\"][: args.n_tf], args.max_len, out_dir)\n   409\t    if not args.skip_rollouts:\n   410\t        rollouts(model, tok, corpus, args, out_dir)\n   411\t    for spec in args.extra_corpus:\n   412\t        name, path = spec.split(\"=\", 1) if \"=\" in spec else (args.extra_name, spec)\n   413\t        if os.path.exists(os.path.join(out_dir, f\"{name}.npz\")):\n   414\t            log(f\"extra corpus {name} already done, skipping\"); continue\n   415\t        extra = load_corpus(path)\n   416\t        log(f\"extra corpus {name} ({path}): {len(extra['tf'])} docs\")\n   417\t        teacher_forced(model, tok, extra[\"tf\"], args.max_len, out_dir, tag=name)\n   418\t    if args.names_probe:\n   419\t        names_probe(model, tok, out_dir, args.names_probe, args)\n   420\t    log(\"ALL DONE\")\n   421\t\n   422\t\n   423\tif __name__ == \"__main__\":\n   424\t    main()\n","exit_code":0,"status":"completed"}}
