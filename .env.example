# True Base Bench: environment variables. Copy to .env (gitignored) for local use.
# tools/upload_data.py reads ./.env automatically; real environment variables win.

# ---- OVH Object Storage (S3-compatible): tools/upload_data.py, GitHub Actions secrets of the same names
# Endpoint of the bucket's region, e.g. https://s3.gra.io.cloud.ovh.net (gra, sbg, de, uk, waw, bhs, ...)
OVH_S3_ENDPOINT=https://s3.gra.io.cloud.ovh.net
OVH_S3_BUCKET=truebasebench-data
OVH_S3_REGION=gra
# S3 credentials of the OVH Public Cloud user that owns the bucket (Public Cloud > Users & Roles > S3 credentials)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: key prefix inside the bucket (no slashes needed), public base URL override, addressing style
OVH_S3_PREFIX=
OVH_S3_PUBLIC_URL=
OVH_S3_ADDRESSING=virtual
# Optional: the site's origin, used by `upload_data.py --verify` to check the bucket's CORS answer
SITE_ORIGIN=

# ---- Site build (Railway service variables; passed to the Docker build as build args)
# Public base URL of the bucket: https://<bucket>.s3.<region>.io.cloud.ovh.net[/<prefix>], no trailing slash.
# Empty = the site uses only the repo copy in data/ (shipped inside the image).
# For `npm run dev`, put this in site/.env instead (Vite reads env files from site/).
VITE_DATA_BASE_URL=
# Optional: repository URL (e.g. https://github.com/anima-research/<repo>); turns script names on the site into links.
VITE_SOURCE_REPO_URL=
