{
  "name": "truebasebench-site",
  "private": true,
  "version": "1.0.0",
  "description": "True Base Bench, by Anima Labs: static site (Vite + React + TypeScript).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "og": "node ../tools/og.mjs"
  },
  "dependencies": {
    "@fontsource-variable/source-serif-4": "5.1.0",
    "@fontsource/ibm-plex-mono": "5.1.0",
    "@fontsource/ibm-plex-sans-condensed": "5.1.0",
    "marked": "14.1.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.26.2"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "20.16.10",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.2",
    "ajv": "8.17.1",
    "typescript": "5.6.2",
    "vite": "5.4.8",
    "vitest": "2.1.2"
  }
}
