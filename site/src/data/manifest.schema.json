{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "True Base Bench manifest",
  "type": "object",
  "required": ["bundles"],
  "properties": {
    "manifest_version": { "type": "integer" },
    "latest": { "type": "string" },
    "bundles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "type": "string", "pattern": "^bench_v\\d+\\.json$" },
          {
            "type": "object",
            "required": ["file"],
            "properties": {
              "file": { "type": "string", "pattern": "^bench_v\\d+\\.json$" },
              "schema_version": { "type": "integer" },
              "generated": { "type": "string" },
              "n_models": { "type": "integer" }
            }
          }
        ]
      }
    }
  }
}
